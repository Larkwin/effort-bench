    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel — split trip costs fairly</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --harbour:#1F3A4D;\n    --harbour-deep:#15293A;\n    --harbour-tint:#E6ECF0;\n    --signal:#C2462B;\n    --signal-deep:#A23A23;\n    --signal-tint:#FBEAE5;\n    --sea:#1E6B4F;\n    --sea-tint:#E3F1EA;\n    --paper:#F6F3EE;\n    --card:#FFFFFF;\n    --ink:#1B2730;\n    --ink-soft:#4F5F6B;\n    --line:#D8DEE3;\n    --radius:10px;\n    --focus:0 0 0 3px #fff, 0 0 0 6px var(--signal);\n  }\n  *{box-sizing:border-box}\n  html{-webkit-text-size-adjust:100%}\n  body{\n    margin:0;background:var(--paper);color:var(--ink);\n    font-family:\"Inter\",system-ui,sans-serif;font-size:16px;line-height:1.5;\n  }\n  h1,h2,h3{font-family:\"Fraunces\",Georgia,serif;font-weight:600;letter-spacing:-0.01em;margin:0}\n  a{color:var(--harbour)}\n  :focus-visible{outline:none;box-shadow:var(--focus)}\n\n  header.site{\n    background:var(--harbour);color:#fff;\n    padding:20px 16px 26px;\n  }\n  .wrap{max-width:1080px;margin:0 auto}\n  .brand{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}\n  .brand h1{font-size:1.9rem;font-weight:600;line-height:1.1}\n  .brand h1 span{color:#F2B9AB}\n  .brand p{margin:0;color:#C5D2DB;font-size:.95rem}\n  .keel{display:inline-block;width:18px;height:18px;border-radius:50%;background:var(--signal);vertical-align:-2px;margin-right:8px}\n\n  main{padding:20px 16px 48px}\n  .grid{display:grid;gap:20px;grid-template-columns:1fr}\n  @media (min-width:820px){\n    .grid{grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:start}\n  }\n  .col{display:grid;gap:20px;min-width:0}\n\n  section.card{\n    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);\n    padding:20px;min-width:0;\n  }\n  .card > h2{font-size:1.35rem;color:var(--harbour);margin-bottom:4px}\n  .card > .lede{margin:0 0 16px;color:var(--ink-soft);font-size:.95rem}\n\n  label{display:block;font-weight:500;font-size:.92rem;margin-bottom:6px;color:var(--harbour-deep)}\n  .field{margin-bottom:14px;min-width:0}\n  input[type=text],input[type=number],select{\n    width:100%;font:inherit;padding:10px 12px;border:1.5px solid #AEB9C2;border-radius:8px;\n    background:#fff;color:var(--ink);min-height:44px;\n  }\n  input:focus-visible,select:focus-visible{border-color:var(--harbour)}\n  .hint{font-size:.85rem;color:var(--ink-soft);margin:4px 0 0}\n  .row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}\n  .row .field{flex:1 1 180px;margin-bottom:0}\n\n  button{\n    font:inherit;font-weight:600;cursor:pointer;border-radius:8px;\n    min-height:44px;padding:10px 18px;border:1.5px solid transparent;\n  }\n  .btn-primary{background:var(--signal);color:#fff}\n  .btn-primary:hover{background:var(--signal-deep)}\n  .btn-ghost{background:transparent;color:var(--harbour);border-color:#AEB9C2;min-height:36px;padding:6px 12px;font-size:.88rem}\n  .btn-ghost:hover{background:var(--harbour-tint);border-color:var(--harbour)}\n  .btn-block{margin-top:4px}\n\n  .error{\n    margin:0 0 12px;padding:10px 12px;border-radius:8px;\n    background:var(--signal-tint);color:var(--signal-deep);border-left:4px solid var(--signal);\n    font-size:.93rem;font-weight:500;\n  }\n  .empty{\n    margin:0;padding:16px;border:1.5px dashed #BFC9D1;border-radius:8px;\n    color:var(--ink-soft);font-size:.95rem;background:var(--paper);\n  }\n\n  ul.plain{list-style:none;margin:0;padding:0}\n  .people{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}\n  .people li{\n    background:var(--harbour-tint);color:var(--harbour-deep);\n    padding:6px 12px;border-radius:999px;font-weight:500;font-size:.95rem;\n    display:flex;align-items:center;gap:8px;\n  }\n  .people li .n{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--harbour);color:#fff;font-size:.75rem;font-weight:600}\n\n  fieldset{border:1.5px solid var(--line);border-radius:8px;padding:10px 12px 6px;margin:0 0 14px;min-width:0}\n  legend{font-weight:500;font-size:.92rem;color:var(--harbour-deep);padding:0 6px}\n  .checks{display:flex;flex-wrap:wrap;gap:4px 14px}\n  .checks label{display:flex;align-items:center;gap:8px;font-weight:400;margin:0;min-height:36px;cursor:pointer}\n  .checks input{width:20px;height:20px;accent-color:var(--harbour);margin:0}\n  .checks-tools{display:flex;gap:12px;margin-top:4px}\n  .linkbtn{background:none;border:0;color:var(--harbour);text-decoration:underline;padding:4px;min-height:32px;font-weight:500;font-size:.88rem}\n\n  .expenses li{\n    display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;\n    padding:14px 0;border-top:1px solid var(--line);align-items:start;\n  }\n  .expenses li:first-child{border-top:0;padding-top:4px}\n  .expenses .desc{font-weight:600;color:var(--harbour-deep);overflow-wrap:anywhere}\n  .expenses .amt{font-family:\"Fraunces\",Georgia,serif;font-size:1.25rem;font-weight:600;color:var(--harbour);white-space:nowrap;text-align:right}\n  .expenses .meta{grid-column:1 / -1;color:var(--ink-soft);font-size:.9rem;overflow-wrap:anywhere}\n  .expenses .meta strong{color:var(--ink);font-weight:500}\n  .expenses .actions{grid-column:1 / -1;display:flex;justify-content:flex-end}\n\n  .balances li{\n    display:flex;justify-content:space-between;align-items:center;gap:12px;\n    padding:12px 0;border-top:1px solid var(--line);\n  }\n  .balances li:first-child{border-top:0;padding-top:4px}\n  .balances .name{font-weight:500;overflow-wrap:anywhere}\n  .balances .state{display:block;font-size:.85rem;color:var(--ink-soft);font-weight:400}\n  .balances .val{font-family:\"Fraunces\",Georgia,serif;font-size:1.25rem;font-weight:600;white-space:nowrap}\n  .pos{color:var(--sea)} .neg{color:var(--signal-deep)} .zero{color:var(--ink-soft)}\n\n  .transfers li{\n    display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;align-items:center;\n    padding:12px 14px;border-radius:8px;background:var(--sea-tint);margin-top:8px;\n  }\n  .transfers .who{font-weight:500;overflow-wrap:anywhere}\n  .transfers .who .arrow{color:var(--sea);margin:0 6px}\n  .transfers .val{font-family:\"Fraunces\",Georgia,serif;font-size:1.2rem;font-weight:600;color:var(--sea);white-space:nowrap}\n  .settled{background:var(--sea-tint);color:var(--sea);border-color:transparent}\n\n  footer.site{padding:0 16px 32px;color:var(--ink-soft);font-size:.85rem;text-align:center}\n  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n</style>\n</head>\n<body>\n<header class=\"site\">\n  <div class=\"wrap brand\">\n    <h1><span class=\"keel\" aria-hidden=\"true\"></span>Even Keel</h1>\n    <p>Log who paid for what. See who owes whom. End the trip even.</p>\n  </div>\n</header>\n\n<main data-testid=\"app\" class=\"wrap\">\n  <div class=\"grid\">\n    <div class=\"col\">\n\n      <section class=\"card\" aria-labelledby=\"h-people\">\n        <h2 id=\"h-people\">People</h2>\n        <p class=\"lede\">Everyone on the trip, in the order you add them.</p>\n        <form id=\"person-form\" novalidate>\n          <div id=\"person-error-slot\"></div>\n          <div class=\"row\">\n            <div class=\"field\">\n              <label for=\"person-name\">Name</label>\n              <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" maxlength=\"40\" placeholder=\"e.g. Ana\">\n            </div>\n            <button type=\"submit\" class=\"btn-primary\" data-testid=\"add-person\">Add person</button>\n          </div>\n        </form>\n        <div id=\"people-list\" style=\"margin-top:16px\"></div>\n      </section>\n\n      <section class=\"card\" aria-labelledby=\"h-add\">\n        <h2 id=\"h-add\">Add an expense</h2>\n        <p class=\"lede\">The amount is split equally between the people you tick.</p>\n        <form id=\"expense-form\" novalidate>\n          <div id=\"expense-error-slot\"></div>\n          <div class=\"field\">\n            <label for=\"expense-desc\">What was it for?</label>\n            <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\" maxlength=\"80\" placeholder=\"e.g. Ferry tickets\">\n          </div>\n          <div class=\"row\" style=\"margin-bottom:14px\">\n            <div class=\"field\">\n              <label for=\"expense-amount\">Amount (CAD)</label>\n              <input type=\"text\" inputmode=\"decimal\" id=\"expense-amount\" data-testid=\"expense-amount\" autocomplete=\"off\" placeholder=\"0.00\">\n            </div>\n            <div class=\"field\">\n              <label for=\"expense-payer\">Who paid?</label>\n              <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n            </div>\n          </div>\n          <fieldset>\n            <legend>Split between</legend>\n            <div class=\"checks\" id=\"expense-split\" data-testid=\"expense-split\"></div>\n            <div class=\"checks-tools\" id=\"split-tools\" hidden>\n              <button type=\"button\" class=\"linkbtn\" id=\"split-all\">Everyone</button>\n              <button type=\"button\" class=\"linkbtn\" id=\"split-none\">No one</button>\n            </div>\n          </fieldset>\n          <button type=\"submit\" class=\"btn-primary btn-block\" data-testid=\"add-expense\">Add expense</button>\n        </form>\n      </section>\n\n    </div>\n    <div class=\"col\">\n\n      <section class=\"card\" aria-labelledby=\"h-expenses\">\n        <h2 id=\"h-expenses\">Expenses</h2>\n        <p class=\"lede\" id=\"expenses-lede\">Newest first.</p>\n        <div id=\"expense-list\"></div>\n      </section>\n\n      <section class=\"card\" aria-labelledby=\"h-balances\">\n        <h2 id=\"h-balances\">Balances</h2>\n        <p class=\"lede\">What each person paid, minus their share. Owing a friend is normal — this just keeps count.</p>\n        <div id=\"balance-list\"></div>\n      </section>\n\n      <section class=\"card\" aria-labelledby=\"h-settle\">\n        <h2 id=\"h-settle\">Settle up</h2>\n        <p class=\"lede\">The fewest transfers that bring everyone back to even.</p>\n        <div id=\"transfer-list\"></div>\n      </section>\n\n    </div>\n  </div>\n</main>\n<footer class=\"site\">Everything is saved in this browser only. Nothing is sent anywhere.</footer>\n\n<script>\n(function(){\n  'use strict';\n  const STORE_KEY = 'evenkeel.v1';\n  const fmt = new Intl.NumberFormat('en-CA', { style:'currency', currency:'CAD' });\n  const money = c => fmt.format(c / 100);\n\n  let state = { people: [], expenses: [] };\n\n  function load(){\n    try{\n      const raw = localStorage.getItem(STORE_KEY);\n      if(!raw) return;\n      const d = JSON.parse(raw);\n      if(Array.isArray(d.people) && Array.isArray(d.expenses)){\n        state.people = d.people.filter(p => typeof p === 'string');\n        state.expenses = d.expenses.filter(e => e && typeof e.desc==='string' && Number.isInteger(e.cents) && typeof e.payer==='string' && Array.isArray(e.split));\n      }\n    }catch(e){ /* start fresh */ }\n  }\n  function save(){\n    try{ localStorage.setItem(STORE_KEY, JSON.stringify(state)); }catch(e){}\n  }\n\n  const $ = id => document.getElementById(id);\n  const el = (tag, attrs, ...kids) => {\n    const n = document.createElement(tag);\n    if(attrs) for(const k in attrs){\n      if(k==='class') n.className = attrs[k];\n      else if(k.startsWith('data-') || k==='for' || k==='role' || k.startsWith('aria-')) n.setAttribute(k, attrs[k]);\n      else n[k] = attrs[k];\n    }\n    for(const k of kids){ if(k==null) continue; n.append(k.nodeType ? k : document.createTextNode(k)); }\n    return n;\n  };\n\n  function showError(slotId, msg){\n    const slot = $(slotId);\n    slot.replaceChildren(el('p', {class:'error', role:'alert', 'data-testid':'form-error'}, msg));\n  }\n  function clearError(slotId){ $(slotId).replaceChildren(); }\n\n  // ---------- computations ----------\n  function sharesFor(exp){\n    const members = state.people.filter(p => exp.split.includes(p));\n    const n = members.length, out = {};\n    if(!n) return out;\n    const base = Math.floor(exp.cents / n), rem = exp.cents % n;\n    members.forEach((p, i) => { out[p] = base + (i < rem ? 1 : 0); });\n    return out;\n  }\n  function balances(){\n    const b = {};\n    state.people.forEach(p => b[p] = 0);\n    state.expenses.forEach(e => {\n      if(e.payer in b) b[e.payer] += e.cents;\n      const s = sharesFor(e);\n      for(const p in s) b[p] -= s[p];\n    });\n    return b;\n  }\n  function settle(b){\n    const debtors = [], creditors = [];\n    state.people.forEach(p => {\n      if(b[p] < 0) debtors.push({p, amt:-b[p]});\n      else if(b[p] > 0) creditors.push({p, amt:b[p]});\n    });\n    debtors.sort((a,c)=>c.amt-a.amt); creditors.sort((a,c)=>c.amt-a.amt);\n    const out = []; let i=0, j=0;\n    while(i<debtors.length && j<creditors.length){\n      const d = debtors[i], c = creditors[j];\n      const t = Math.min(d.amt, c.amt);\n      if(t>0) out.push({from:d.p, to:c.p, cents:t});\n      d.amt -= t; c.amt -= t;\n      if(d.amt===0) i++;\n      if(c.amt===0) j++;\n    }\n    return out;\n  }\n\n  // ---------- render ----------\n  function renderPeople(){\n    const box = $('people-list');\n    if(!state.people.length){\n      box.replaceChildren(el('p',{class:'empty'},'No one on the trip yet. Add the first person above — you can include yourself.'));\n      return;\n    }\n    const ul = el('ul',{class:'plain people'});\n    state.people.forEach((p,i)=> ul.append(el('li',{'data-testid':'person'}, el('span',{class:'n','aria-hidden':'true'}, String(i+1)), p)));\n    box.replaceChildren(ul);\n  }\n\n  function renderExpenseForm(resetSplit){\n    const sel = $('expense-payer');\n    const prevPayer = sel.value;\n    sel.replaceChildren();\n    if(!state.people.length){\n      sel.append(el('option',{value:''},'Add people first'));\n      sel.disabled = true;\n    } else {\n      sel.disabled = false;\n      state.people.forEach(p => sel.append(el('option',{value:p},p)));\n      if(state.people.includes(prevPayer)) sel.value = prevPayer;\n    }\n\n    const box = $('expense-split');\n    const prev = {};\n    box.querySelectorAll('input').forEach(c => prev[c.value] = c.checked);\n    box.replaceChildren();\n    if(!state.people.length){\n      box.append(el('p',{class:'hint',style:'margin:4px 0 6px'},'The people you add will appear here, all ticked.'));\n    } else {\n      state.people.forEach((p,i)=>{\n        const id = 'split-' + i;\n        const cb = el('input',{type:'checkbox',id,value:p});\n        cb.checked = resetSplit || !(p in prev) ? true : prev[p];\n        box.append(el('label',{for:id}, cb, p));\n      });\n    }\n    $('split-tools').hidden = !state.people.length;\n  }\n\n  function renderExpenses(){\n    const box = $('expense-list');\n    $('expenses-lede').textContent = state.expenses.length ? 'Newest first.' : 'Nothing logged yet.';\n    if(!state.expenses.length){\n      box.replaceChildren(el('p',{class:'empty'}, state.people.length\n        ? 'No expenses yet. Log the first thing someone paid for and the balances will follow.'\n        : 'Once there are people on the trip, you can log what they paid for.'));\n      return;\n    }\n    const ul = el('ul',{class:'plain expenses'});\n    [...state.expenses].reverse().forEach(e => {\n      const members = state.people.filter(p => e.split.includes(p));\n      const splitText = members.length === state.people.length && members.length>1 ? 'everyone (' + members.join(', ') + ')' : members.join(', ');\n      const del = el('button',{type:'button',class:'btn-ghost','data-testid':'delete-expense','aria-label':'Remove ' + e.desc},'Remove');\n      del.addEventListener('click', ()=>{\n        state.expenses = state.expenses.filter(x => x.id !== e.id);\n        save(); renderAll();\n      });\n      ul.append(el('li',{'data-testid':'expense'},\n        el('span',{class:'desc'}, e.desc),\n        el('span',{class:'amt'}, money(e.cents)),\n        el('span',{class:'meta'}, 'Paid by ', el('strong',null,e.payer), ' · split between ', el('strong',null,splitText)),\n        el('div',{class:'actions'}, del)\n      ));\n    });\n    box.replaceChildren(ul);\n  }\n\n  function renderBalances(b){\n    const box = $('balance-list');\n    if(!state.people.length){\n      box.replaceChildren(el('p',{class:'empty'},'Balances show up as soon as there are people on the trip.'));\n      return;\n    }\n    const ul = el('ul',{class:'plain balances'});\n    state.people.forEach(p=>{\n      const c = b[p];\n      const cls = c>0?'pos':c<0?'neg':'zero';\n      const word = c>0?'is owed':c<0?'owes':'is even';\n      ul.append(el('li',{'data-testid':'balance','data-person':p,'data-cents':String(c)},\n        el('span',{class:'name'}, p, el('span',{class:'state'}, word)),\n        el('span',{class:'val '+cls}, (c>0?'+':c<0?'−':'') + money(Math.abs(c)))\n      ));\n    });\n    box.replaceChildren(ul);\n  }\n\n  function renderTransfers(b){\n    const box = $('transfer-list');\n    if(!state.people.length || !state.expenses.length){\n      box.replaceChildren(el('p',{class:'empty'},'Log a few expenses and you’ll see exactly who pays whom.'));\n      return;\n    }\n    const t = settle(b);\n    if(!t.length){\n      box.replaceChildren(el('p',{class:'empty settled'},'You’re all even. Nothing to settle.'));\n      return;\n    }\n    const ul = el('ul',{class:'plain transfers'});\n    t.forEach(x => ul.append(el('li',{'data-testid':'transfer','data-from':x.from,'data-to':x.to,'data-cents':String(x.cents)},\n      el('span',{class:'who'}, x.from, el('span',{class:'arrow','aria-hidden':'true'},'→'), el('span',{class:'sr-only'},' pays '), x.to),\n      el('span',{class:'val'}, money(x.cents))\n    )));\n    box.replaceChildren(ul);\n  }\n\n  function renderAll(resetSplit){\n    renderPeople();\n    renderExpenseForm(!!resetSplit);\n    renderExpenses();\n    const b = balances();\n    renderBalances(b);\n    renderTransfers(b);\n  }\n\n  // ---------- handlers ----------\n  $('person-form').addEventListener('submit', ev=>{\n    ev.preventDefault();\n    const input = $('person-name');\n    const name = input.value.trim();\n    if(!name){ showError('person-error-slot','Type a name before adding someone.'); input.focus(); return; }\n    const dup = state.people.find(p => p.toLowerCase() === name.toLowerCase());\n    if(dup){ showError('person-error-slot', `${dup} is already on the trip. Names need to be different, ignoring capitals.`); input.focus(); input.select(); return; }\n    clearError('person-error-slot');\n    state.people.push(name);\n    save();\n    input.value = '';\n    renderAll();\n    input.focus();\n  });\n  $('person-name').addEventListener('input', ()=> clearError('person-error-slot'));\n\n  function parseCents(str){\n    let s = str.trim().replace(/^\\$/,'').replace(/,/g,'').trim();\n    const m = /^(\\d+)(?:\\.(\\d{1,2}))?$/.exec(s);\n    if(!m) return null;\n    const dollars = parseInt(m[1],10);\n    const frac = (m[2] || '').padEnd(2,'0');\n    return dollars*100 + parseInt(frac,10);\n  }\n\n  $('expense-form').addEventListener('submit', ev=>{\n    ev.preventDefault();\n    const descI = $('expense-desc'), amtI = $('expense-amount'), payerI = $('expense-payer');\n    const desc = descI.value.trim();\n    const amtRaw = amtI.value;\n    const payer = payerI.value;\n    const split = [...$('expense-split').querySelectorAll('input:checked')].map(c=>c.value);\n\n    if(!state.people.length){ showError('expense-error-slot','Add at least one person to the trip before logging an expense.'); $('person-name').focus(); return; }\n    if(!desc){ showError('expense-error-slot','Say what the expense was for.'); descI.focus(); return; }\n    const cents = parseCents(amtRaw);\n    if(amtRaw.trim()===''){ showError('expense-error-slot','Enter the amount paid.'); amtI.focus(); return; }\n    if(cents===null){ showError('expense-error-slot','The amount needs to be a number with at most 2 decimal places, like 42 or 42.50.'); amtI.focus(); amtI.select(); return; }\n    if(cents<=0){ showError('expense-error-slot','The amount needs to be more than $0.00.'); amtI.focus(); amtI.select(); return; }\n    if(!payer || !state.people.includes(payer)){ showError('expense-error-slot','Choose who paid.'); payerI.focus(); return; }\n    if(!split.length){ showError('expense-error-slot','Tick at least one person to split this between.'); $('expense-split').querySelector('input').focus(); return; }\n\n    clearError('expense-error-slot');\n    state.expenses.push({ id: Date.now().toString(36)+Math.random().toString(36).slice(2,7), desc, cents, payer, split });\n    save();\n    descI.value=''; amtI.value='';\n    renderAll(true);\n    descI.focus();\n  });\n  ['expense-desc','expense-amount','expense-payer'].forEach(id => $(id).addEventListener('input', ()=> clearError('expense-error-slot')));\n  $('expense-split').addEventListener('change', ()=> clearError('expense-error-slot'));\n  $('split-all').addEventListener('click', ()=> $('expense-split').querySelectorAll('input').forEach(c=>c.checked=true));\n  $('split-none').addEventListener('click', ()=> $('expense-split').querySelectorAll('input').forEach(c=>c.checked=false));\n\n  load();\n  renderAll(true);\n})();\n</script>\n</body>\n</html>"
    }
  ],

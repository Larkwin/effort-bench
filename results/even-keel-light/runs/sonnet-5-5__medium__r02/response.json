    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Even Keel · Trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;--harbour-2:#2E5470;--signal:#C2462B;--signal-dark:#A33820;\n  --paper:#F5F1E8;--card:#FFFDF8;--ink:#17262F;--muted:#4F5F69;--line:#D8D1BF;\n  --owed:#1F6B4F;--owe:#A33820;--tint:#E8EEF2;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 \"Public Sans\",system-ui,sans-serif;overflow-x:hidden}\nh1,h2,.brand{font-family:Fraunces,Georgia,serif;font-weight:700;letter-spacing:-.01em}\nheader.top{background:var(--harbour);color:#fff;padding:20px 16px 22px;border-bottom:5px solid var(--signal)}\n.wrap{max-width:1080px;margin:0 auto}\n.brand{font-size:1.75rem;margin:0;line-height:1.1}\n.tag{margin:4px 0 0;color:#D5E1E9;max-width:46ch}\nmain{max-width:1080px;margin:0 auto;padding:20px 16px 48px;display:grid;gap:20px;grid-template-columns:1fr}\n@media(min-width:880px){main{grid-template-columns:1fr 1fr;align-items:start}.col{display:grid;gap:20px}}\n.col{display:grid;gap:20px;min-width:0}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}\nh2{font-size:1.3rem;margin:0 0 12px;color:var(--harbour)}\nlabel,legend{display:block;font-weight:600;font-size:.9rem;margin-bottom:4px;color:var(--ink)}\ninput[type=text],input[type=number],input:not([type]),select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #8A97A0;border-radius:6px;background:#fff;color:var(--ink);min-height:44px}\n.row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}\n.row>div{flex:1 1 160px;min-width:0}\n.field{margin-bottom:14px}\nbutton{font:inherit;font-weight:600;min-height:44px;padding:0 18px;border-radius:6px;border:2px solid var(--harbour);background:var(--harbour);color:#fff;cursor:pointer}\nbutton:hover{background:var(--harbour-2);border-color:var(--harbour-2)}\nbutton.primary{background:var(--signal-dark);border-color:var(--signal-dark)}\nbutton.primary:hover{background:#8A2E19;border-color:#8A2E19}\nbutton.ghost{background:transparent;color:var(--harbour);min-height:36px;padding:0 12px;font-size:.875rem}\nbutton.ghost:hover{background:var(--tint)}\n:focus-visible{outline:3px solid #E8A317;outline-offset:2px;box-shadow:0 0 0 5px var(--harbour)}\n.err{color:#8A2E19;background:#FBEAE4;border-left:4px solid var(--signal);padding:8px 12px;border-radius:4px;margin:10px 0 0;font-size:.92rem}\n.err[hidden]{display:none}\nul{list-style:none;margin:0;padding:0}\n.people{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}\n.people li{background:var(--tint);color:var(--harbour);padding:5px 12px;border-radius:99px;font-weight:600;font-size:.92rem;overflow-wrap:anywhere}\n.empty{color:var(--muted);margin:10px 0 0;padding:14px;border:1.5px dashed var(--line);border-radius:8px;font-size:.95rem}\nfieldset{border:0;padding:0;margin:0 0 14px;min-width:0}\n.checks{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:6px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:500;margin:0;padding:8px 10px;border:1px solid var(--line);border-radius:6px;min-height:44px;background:#fff;overflow-wrap:anywhere}\n.checks input{width:20px;height:20px;accent-color:var(--harbour);flex:none}\n.exp{padding:12px 0;border-top:1px solid var(--line);display:flex;gap:12px;justify-content:space-between;align-items:flex-start}\n.exp:first-child{border-top:0}\n.exp .t{font-weight:600;overflow-wrap:anywhere}\n.exp .m{color:var(--muted);font-size:.88rem;overflow-wrap:anywhere}\n.amt{font-variant-numeric:tabular-nums;font-weight:700;white-space:nowrap}\n.exp>div:first-child{min-width:0}\n.exp .r{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:2px;flex:none}\n.bal{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid var(--line);align-items:baseline}\n.bal:first-child{border-top:0}\n.bal .n{font-weight:600;overflow-wrap:anywhere}\n.bal .v{font-variant-numeric:tabular-nums;font-weight:700;text-align:right}\n.pos{color:var(--owed)}.neg{color:var(--owe)}.zero{color:var(--muted)}\n.bal small{display:block;font-weight:500;font-size:.8rem}\n.tr{display:flex;justify-content:space-between;gap:10px;padding:12px;margin-top:8px;background:var(--tint);border-radius:8px;border-left:5px solid var(--signal);align-items:center}\n.tr span:first-child{overflow-wrap:anywhere;min-width:0}\n.note{color:var(--muted);font-size:.9rem;margin:0 0 8px}\n</style>\n</head>\n<body>\n<header class=\"top\"><div class=\"wrap\">\n<p class=\"brand\">Even Keel</p>\n<p class=\"tag\">Log what each of you paid. We’ll work out who covers whom. Owing a friend is normal.</p>\n</div></header>\n\n<main data-testid=\"app\">\n<div class=\"col\">\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People on the trip</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\"><div><label for=\"pname\">Name</label><input id=\"pname\" type=\"text\" autocomplete=\"off\" data-testid=\"person-name\"></div>\n<button type=\"submit\" data-testid=\"add-person\">Add person</button></div>\n<p class=\"err\" id=\"perr\" role=\"alert\" hidden></p>\n</form>\n<ul class=\"people\" id=\"plist\"></ul>\n<p class=\"empty\" id=\"pempty\">Nobody’s here yet. Add everyone on the trip, including yourself.</p>\n</section>\n\n<section aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Add an expense</h2>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"desc\">What was it for?</label><input id=\"desc\" type=\"text\" autocomplete=\"off\" data-testid=\"expense-desc\"></div>\n<div class=\"row field\"><div><label for=\"amt\">Amount (CAD)</label><input id=\"amt\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"0.00\" data-testid=\"expense-amount\"></div>\n<div><label for=\"payer\">Paid by</label><select id=\"payer\" data-testid=\"expense-payer\"></select></div></div>\n<fieldset><legend>Split between</legend><div class=\"checks\" id=\"split\" data-testid=\"expense-split\"></div></fieldset>\n<button class=\"primary\" type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"eerr\" role=\"alert\" hidden></p>\n</form>\n</section>\n</div>\n\n<div class=\"col\">\n<section aria-labelledby=\"h-set\">\n<h2 id=\"h-set\">Settle up</h2>\n<div id=\"settle\"></div>\n</section>\n<section aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<div id=\"bals\"></div>\n</section>\n<section aria-labelledby=\"h-list\">\n<h2 id=\"h-list\">Expenses</h2>\n<ul id=\"elist\"></ul>\n</section>\n</div>\n</main>\n\n<script>\n(function(){\nvar fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nvar $=function(i){return document.getElementById(i)};\nvar money=function(c){return fmt.format(c/100)};\nvar KEY='evenkeel.v1';\nvar state={people:[],expenses:[]};\ntry{var s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=s}catch(e){}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}}\nfunction el(t,a,txt){var e=document.createElement(t);if(a)for(var k in a)e.setAttribute(k,a[k]);if(txt!=null)e.textContent=txt;return e}\nfunction showErr(id,msg){var e=$(id);if(msg){e.textContent=msg;e.hidden=false;e.setAttribute('data-testid','form-error')}else{e.hidden=true;e.textContent='';e.removeAttribute('data-testid')}}\n\nfunction shares(exp){\n  var order=state.people.filter(function(p){return exp.split.indexOf(p)>-1});\n  var base=Math.floor(exp.cents/order.length),rem=exp.cents-base*order.length,out={};\n  order.forEach(function(p,i){out[p]=base+(i<rem?1:0)});\n  return out;\n}\nfunction balances(){\n  var b={};state.people.forEach(function(p){b[p]=0});\n  state.expenses.forEach(function(x){\n    if(b[x.payer]!=null)b[x.payer]+=x.cents;\n    var sh=shares(x);for(var p in sh)b[p]-=sh[p];\n  });\n  return b;\n}\nfunction transfers(b){\n  var cr=[],db=[],out=[];\n  state.people.forEach(function(p){if(b[p]>0)cr.push({n:p,c:b[p]});else if(b[p]<0)db.push({n:p,c:-b[p]})});\n  while(cr.length&&db.length){\n    cr.sort(function(a,b){return b.c-a.c});db.sort(function(a,b){return b.c-a.c});\n    var c=cr[0],d=db[0],m=Math.min(c.c,d.c);\n    out.push({from:d.n,to:c.n,cents:m});\n    c.c-=m;d.c-=m;\n    if(!c.c)cr.shift();if(!d.c)db.shift();\n  }\n  return out;\n}\n\nvar checked={};\nfunction render(){\n  var P=state.people;\n  // people\n  var pl=$('plist');pl.innerHTML='';\n  P.forEach(function(p){pl.appendChild(el('li',{'data-testid':'person'},p))});\n  $('pempty').hidden=P.length>0;\n  // payer\n  var sel=$('payer'),cur=sel.value;sel.innerHTML='';\n  P.forEach(function(p){var o=el('option',{value:p},p);sel.appendChild(o)});\n  if(P.indexOf(cur)>-1)sel.value=cur;\n  sel.disabled=!P.length;\n  // split\n  var sp=$('split');\n  var prev={};[].forEach.call(sp.querySelectorAll('input'),function(i){prev[i.value]=i.checked});\n  sp.innerHTML='';\n  if(!P.length)sp.appendChild(el('p',{class:'note'},'Add people first to split with them.'));\n  P.forEach(function(p){\n    var l=el('label'),i=el('input',{type:'checkbox',value:p});\n    i.checked=(p in prev)?prev[p]:true;\n    l.appendChild(i);l.appendChild(el('span',null,p));sp.appendChild(l);\n  });\n  // expenses\n  var el_=$('elist');el_.innerHTML='';\n  if(!state.expenses.length){var li=el('li');li.appendChild(el('p',{class:'empty'},'No expenses yet. Add the first one and balances will show up here.'));el_.appendChild(li)}\n  state.expenses.slice().reverse().forEach(function(x){\n    var li=el('li',{class:'exp','data-testid':'expense'});\n    var l=el('div');\n    l.appendChild(el('div',{class:'t'},x.desc));\n    l.appendChild(el('div',{class:'m'},'Paid by '+x.payer+' · Split between '+x.split.join(', ')));\n    var r=el('div',{class:'r'});\n    r.appendChild(el('span',{class:'amt'},money(x.cents)));\n    var del=el('button',{type:'button',class:'ghost','data-testid':'delete-expense','aria-label':'Remove '+x.desc+', '+money(x.cents)},'Remove');\n    del.onclick=function(){state.expenses=state.expenses.filter(function(e){return e!==x});save();render()};\n    r.appendChild(del);li.appendChild(l);li.appendChild(r);el_.appendChild(li);\n  });\n  // balances\n  var b=balances(),bd=$('bals');bd.innerHTML='';\n  if(!P.length)bd.appendChild(el('p',{class:'empty'},'Balances appear once people join the trip.'));\n  P.forEach(function(p){\n    var v=b[p],d=el('div',{class:'bal','data-testid':'balance','data-person':p,'data-cents':String(v)});\n    d.appendChild(el('span',{class:'n'},p));\n    var s=el('span',{class:'v '+(v>0?'pos':v<0?'neg':'zero')});\n    s.appendChild(document.createTextNode(money(Math.abs(v))));\n    s.appendChild(el('small',null,v>0?'is owed':v<0?'owes':'all even'));\n    d.appendChild(s);bd.appendChild(d);\n  });\n  // settle\n  var st=$('settle');st.innerHTML='';\n  var t=transfers(b);\n  if(!state.expenses.length)st.appendChild(el('p',{class:'empty'},'Nothing to settle yet. Once you log expenses, you’ll see who pays whom here.'));\n  else if(!t.length)st.appendChild(el('p',{class:'empty'},'You’re all even. No one needs to pay anyone.'));\n  else{\n    st.appendChild(el('p',{class:'note'},'Do these '+t.length+(t.length===1?' payment':' payments')+' and everyone is square.'));\n    t.forEach(function(x){\n      var d=el('div',{class:'tr','data-testid':'transfer','data-from':x.from,'data-to':x.to,'data-cents':String(x.cents)});\n      var a=el('span');a.appendChild(el('strong',null,x.from));a.appendChild(document.createTextNode(' pays '));a.appendChild(el('strong',null,x.to));\n      d.appendChild(a);d.appendChild(el('span',{class:'amt'},money(x.cents)));st.appendChild(d);\n    });\n  }\n}\n\n$('pf').addEventListener('submit',function(e){\n  e.preventDefault();\n  var n=$('pname').value.trim().replace(/\\s+/g,' ');\n  if(!n)return showErr('perr','Enter a name to add someone.');\n  if(state.people.some(function(p){return p.toLowerCase()===n.toLowerCase()}))return showErr('perr',n+' is already on the trip. Names must be different, ignoring capitals.');\n  showErr('perr');\n  state.people.push(n);save();$('pname').value='';render();$('pname').focus();\n});\n\n$('ef').addEventListener('submit',function(e){\n  e.preventDefault();\n  var desc=$('desc').value.trim(),raw=$('amt').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  var payer=$('payer').value;\n  var split=[].filter.call($('split').querySelectorAll('input:checked'),function(){return true}).map(function(i){return i.value});\n  if(!state.people.length)return showErr('eerr','Add the people on the trip before logging an expense.');\n  if(!desc)return showErr('eerr','Add a description, like “Groceries”.');\n  if(!raw)return showErr('eerr','Enter an amount.');\n  if(!/^\\d+(\\.\\d{1,2})?$|^\\.\\d{1,2}$/.test(raw)){\n    return showErr('eerr',/^\\d*\\.\\d{3,}$/.test(raw)?'Amounts can have at most 2 decimal places.':'Enter the amount as a number, like 42.50.');\n  }\n  var parts=raw.split('.'),cents=parseInt(parts[0]||'0',10)*100+parseInt(((parts[1]||'')+'00').slice(0,2),10);\n  if(!(cents>0))return showErr('eerr','The amount must be greater than $0.');\n  if(!payer)return showErr('eerr','Choose who paid.');\n  if(!split.length)return showErr('eerr','Choose at least one person to split with.');\n  showErr('eerr');\n  state.expenses.push({id:Date.now()+Math.random(),desc:desc,cents:cents,payer:payer,split:split});\n  save();$('desc').value='';$('amt').value='';render();$('desc').focus();\n});\n\nrender();\n})();\n</script>\n</body>\n</html>"
    }

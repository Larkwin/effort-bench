  "content": [
    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel · Trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;--harbour-2:#2E5470;--signal:#C2462B;--signal-d:#A53A22;\n  --paper:#F4F1EA;--card:#FFFFFF;--ink:#17262F;--muted:#4F616D;--line:#D8D3C7;\n  --owed:#1E6B4A;--owe:#A53A22;--tint:#E7EDF1;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 \"Public Sans\",system-ui,sans-serif}\nh1,h2{font-family:Fraunces,Georgia,serif;margin:0;line-height:1.15}\n:focus-visible{outline:3px solid var(--signal);outline-offset:2px;border-radius:4px}\nheader{background:var(--harbour);color:#fff;padding:22px 16px 26px;border-bottom:6px solid var(--signal)}\n.wrap{max-width:1040px;margin:0 auto}\nheader h1{font-size:2rem;letter-spacing:-.01em}\nheader p{margin:6px 0 0;color:#D6E0E7;max-width:46ch}\nmain{max-width:1040px;margin:0 auto;padding:20px 16px 48px;display:grid;gap:20px;grid-template-columns:1fr}\n@media(min-width:860px){main{grid-template-columns:1fr 1fr;align-items:start}.wide{grid-column:1/-1}}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}\nh2{font-size:1.3rem;color:var(--harbour);margin-bottom:12px}\nlabel{display:block;font-weight:600;font-size:.9rem;margin-bottom:4px}\ninput[type=text],input[type=number],select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #7A8A94;border-radius:6px;background:#fff;color:var(--ink);min-height:44px}\n.field{margin-bottom:14px}\n.row{display:flex;gap:10px;align-items:flex-end}\n.row .field{flex:1;margin:0;min-width:0}\nbutton{font:inherit;font-weight:600;cursor:pointer;min-height:44px;padding:8px 16px;border-radius:6px;border:2px solid var(--harbour);background:var(--harbour);color:#fff}\nbutton:hover{background:var(--harbour-2)}\nbutton.sig{background:var(--signal);border-color:var(--signal)}\nbutton.sig:hover{background:var(--signal-d)}\nbutton.ghost{background:transparent;color:var(--harbour);padding:4px 12px;min-height:36px}\nbutton.ghost:hover{background:var(--tint)}\n.err{color:#9A2F18;font-weight:600;font-size:.92rem;margin:8px 0 0;min-height:0}\n.err:empty{display:none}\nul{list-style:none;margin:0;padding:0}\n.people li{display:inline-block;background:var(--tint);color:var(--harbour);padding:5px 12px;border-radius:99px;margin:0 6px 6px 0;font-weight:600}\n.empty{color:var(--muted);margin:0}\nfieldset{border:0;padding:0;margin:0 0 14px}\nlegend{font-weight:600;font-size:.9rem;padding:0;margin-bottom:6px}\n.split{display:flex;flex-wrap:wrap;gap:8px}\n.split label{display:flex;align-items:center;gap:8px;margin:0;padding:6px 12px;border:1.5px solid var(--line);border-radius:6px;min-height:44px;font-weight:500;cursor:pointer}\n.split input{width:20px;height:20px;accent-color:var(--harbour)}\n.exp{border-top:1px solid var(--line);padding:12px 0;display:flex;gap:12px;justify-content:space-between;align-items:flex-start}\n.exp:first-child{border-top:0}\n.exp b{font-size:1.05rem;overflow-wrap:anywhere}\n.exp small{display:block;color:var(--muted);overflow-wrap:anywhere}\n.amt{font-weight:700;color:var(--harbour);white-space:nowrap;text-align:right}\n.bal{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid var(--line)}\n.bal:first-child{border-top:0}\n.pos{color:var(--owed);font-weight:700}.neg{color:var(--owe);font-weight:700}.zero{color:var(--muted);font-weight:700}\n.bal span:first-child{overflow-wrap:anywhere}\n.tr{display:flex;justify-content:space-between;gap:10px;padding:12px;margin-bottom:8px;background:var(--tint);border-left:5px solid var(--signal);border-radius:6px}\n.tr strong{white-space:nowrap}\n.note{color:var(--muted);font-size:.9rem;margin:12px 0 0}\n</style>\n</head>\n<body>\n<header><div class=\"wrap\"><h1>Even Keel</h1><p>Log what everyone paid. Owing a friend is normal — this just shows how to level out.</p></div></header>\n<main data-testid=\"app\">\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\"><div class=\"field\"><label for=\"pn\">Name</label><input type=\"text\" id=\"pn\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" data-testid=\"add-person\">Add person</button></div>\n<p class=\"err\" id=\"pe\" role=\"alert\" aria-live=\"polite\"></p>\n</form>\n<div style=\"margin-top:14px\"><ul class=\"people\" id=\"plist\"></ul><p class=\"empty\" id=\"pempty\">No one is on the trip yet. Add the first name above.</p></div>\n</section>\n\n<section aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Add an expense</h2>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"ed\">Description</label><input type=\"text\" id=\"ed\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"ea\">Amount (CAD)</label><input type=\"number\" id=\"ea\" data-testid=\"expense-amount\" inputmode=\"decimal\" step=\"0.01\" min=\"0\" placeholder=\"0.00\"></div>\n<div class=\"field\"><label for=\"ep\">Paid by</label><select id=\"ep\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend>Split between</legend><div class=\"split\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" class=\"sig\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"ee\" role=\"alert\" aria-live=\"polite\"></p>\n</form>\n</section>\n\n<section class=\"wide\" aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<div id=\"bals\"></div>\n<p class=\"note\">Positive means you're owed money. Negative means you owe.</p>\n</section>\n\n<section aria-labelledby=\"h-set\">\n<h2 id=\"h-set\">Settle up</h2>\n<div id=\"sets\"></div>\n</section>\n\n<section aria-labelledby=\"h-list\">\n<h2 id=\"h-list\">Expenses</h2>\n<div id=\"elist\"></div>\n</section>\n</main>\n<script>\n(function(){\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst $=id=>document.getElementById(id);\nlet S={people:[],expenses:[]};\ntry{const d=JSON.parse(localStorage.getItem('evenkeel'));if(d&&Array.isArray(d.people)&&Array.isArray(d.expenses))S=d}catch(e){}\nconst save=()=>{try{localStorage.setItem('evenkeel',JSON.stringify(S))}catch(e){}};\nconst el=(t,p,txt)=>{const e=document.createElement(t);if(p)Object.assign(e,p);if(txt!=null)e.textContent=txt;return e};\nfunction shares(ex){\n  const ppl=S.people.filter(p=>ex.split.includes(p));\n  const n=ppl.length,base=Math.floor(ex.cents/n),rem=ex.cents-base*n,m={};\n  ppl.forEach((p,i)=>m[p]=base+(i<rem?1:0));return m;\n}\nfunction balances(){\n  const b={};S.people.forEach(p=>b[p]=0);\n  S.expenses.forEach(ex=>{\n    if(b[ex.payer]!==undefined)b[ex.payer]+=ex.cents;\n    const s=shares(ex);for(const k in s)b[k]-=s[k];\n  });return b;\n}\nfunction transfers(b){\n  const c=[],d=[];\n  S.people.forEach(p=>{if(b[p]>0)c.push([p,b[p]]);else if(b[p]<0)d.push([p,-b[p]])});\n  const out=[];\n  while(c.length&&d.length){\n    c.sort((x,y)=>y[1]-x[1]);d.sort((x,y)=>y[1]-x[1]);\n    const a=Math.min(c[0][1],d[0][1]);\n    out.push({from:d[0][0],to:c[0][0],cents:a});\n    c[0][1]-=a;d[0][1]-=a;\n    if(!c[0][1])c.shift();if(!d[0][1])d.shift();\n  }return out;\n}\nfunction render(){\n  // people\n  const pl=$('plist');pl.textContent='';\n  S.people.forEach(p=>pl.appendChild(el('li',{},p)).setAttribute('data-testid','person'));\n  $('pempty').hidden=S.people.length>0;\n  // form controls\n  const sel=$('ep'),prev=sel.value;sel.textContent='';\n  S.people.forEach(p=>sel.appendChild(el('option',{value:p},p)));\n  if(S.people.includes(prev))sel.value=prev;\n  const sp=$('es');\n  const checked=new Set([...sp.querySelectorAll('input:checked')].map(i=>i.value));\n  const had=new Set([...sp.querySelectorAll('input')].map(i=>i.value));\n  sp.textContent='';\n  if(!S.people.length)sp.appendChild(el('p',{className:'empty'},'Add people first.'));\n  S.people.forEach(p=>{\n    const l=el('label'),i=el('input',{type:'checkbox',value:p});\n    i.checked=had.has(p)?checked.has(p):true;\n    l.append(i,document.createTextNode(p));sp.appendChild(l);\n  });\n  // balances\n  const b=balances(),bd=$('bals');bd.textContent='';\n  if(!S.people.length)bd.appendChild(el('p',{className:'empty'},'Balances appear once people are added.'));\n  S.people.forEach(p=>{\n    const r=el('div',{className:'bal'});\n    r.dataset.testid='balance';r.setAttribute('data-testid','balance');\n    r.setAttribute('data-person',p);r.setAttribute('data-cents',b[p]);\n    const v=b[p],cls=v>0?'pos':v<0?'neg':'zero';\n    const txt=v>0?'is owed '+fmt.format(v/100):v<0?'owes '+fmt.format(-v/100):'is even';\n    r.append(el('span',{},p),el('span',{className:cls},txt));bd.appendChild(r);\n  });\n  // settle\n  const sd=$('sets');sd.textContent='';\n  const t=transfers(b);\n  if(!S.expenses.length)sd.appendChild(el('p',{className:'empty'},'Nothing to settle yet. Add an expense and the transfers show up here.'));\n  else if(!t.length)sd.appendChild(el('p',{className:'empty'},'Everyone is even. Nothing to pay.'));\n  t.forEach(x=>{\n    const r=el('div',{className:'tr'});\n    r.setAttribute('data-testid','transfer');r.setAttribute('data-from',x.from);r.setAttribute('data-to',x.to);r.setAttribute('data-cents',x.cents);\n    const s=el('span');s.append(el('b',{},x.from),document.createTextNode(' pays '),el('b',{},x.to));\n    r.append(s,el('strong',{},fmt.format(x.cents/100)));sd.appendChild(r);\n  });\n  // expenses\n  const ed=$('elist');ed.textContent='';\n  if(!S.expenses.length)ed.appendChild(el('p',{className:'empty'},'No expenses yet. Add the first one when someone pays for something.'));\n  S.expenses.slice().reverse().forEach(ex=>{\n    const r=el('div',{className:'exp'});r.setAttribute('data-testid','expense');\n    const L=el('div');L.append(el('b',{},ex.desc),el('small',{},'Paid by '+ex.payer),el('small',{},'Split: '+ex.split.join(', ')));\n    const R=el('div',{className:'amt'},fmt.format(ex.cents/100));\n    const d=el('button',{type:'button',className:'ghost'},'Remove');\n    d.setAttribute('data-testid','delete-expense');d.setAttribute('aria-label','Remove '+ex.desc);\n    d.onclick=()=>{S.expenses=S.expenses.filter(e=>e.id!==ex.id);save();render()};\n    R.appendChild(document.createElement('br'));R.appendChild(d);\n    r.append(L,R);ed.appendChild(r);\n  });\n}\nfunction err(id,msg){const e=$(id);e.textContent=msg;if(msg)e.setAttribute('data-testid','form-error');else e.removeAttribute('data-testid')}\n$('pf').onsubmit=e=>{\n  e.preventDefault();\n  const n=$('pn').value.trim();\n  if(!n)return err('pe','Enter a name to add someone.');\n  if(S.people.some(p=>p.toLowerCase()===n.toLowerCase()))return err('pe',n+' is already on the trip (names ignore capitals).');\n  S.people.push(n);err('pe','');$('pn').value='';save();render();$('pn').focus();\n};\n$('ef').onsubmit=e=>{\n  e.preventDefault();\n  const d=$('ed').value.trim(),a=$('ea').value.trim(),payer=$('ep').value;\n  const split=[...$('es').querySelectorAll('input:checked')].map(i=>i.value);\n  if(!d)return err('ee','Add a description, like \"Groceries\".');\n  if(!/^\\d+(\\.\\d{1,2})?$|^\\.\\d{1,2}$/.test(a)){\n    return err('ee',a&&/^\\d*\\.\\d{3,}$/.test(a)?'Use at most 2 decimal places.':'Enter an amount greater than $0.00, like 24.50.');\n  }\n  const [w,f=''] = a.split('.');\n  const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(cents<=0)return err('ee','Enter an amount greater than $0.00.');\n  if(!S.people.length||!payer)return err('ee','Add people to the trip before logging expenses.');\n  if(!split.length)return err('ee','Pick at least one person to split between.');\n  S.expenses.push({id:Date.now()+Math.random(),desc:d,cents,payer,split:S.people.filter(p=>split.includes(p))});\n  err('ee','');$('ed').value='';$('ea').value='';save();render();\n  $('es').querySelectorAll('input').forEach(i=>i.checked=true);\n  $('ed').focus();\n};\nrender();\n})();\n</script>\n</body>\n</html>"
    }

    {
      "type": "thinking",
      "thinking": "I'm planning out the full app structure: adding people with validation, expenses with split logic that distributes remainder cents fairly, balance tracking with data attributes, and a greedy settle-up algorithm to minimize transactions.\n\nFor styling, I'm going with harbour navy and signal red-orange colors, pairing Fraunces for headings with Inter for body text, keeping the CSS compact but responsive down to 360px with proper accessibility.\n\nFor amount parsing, I'm handling it as strings to avoid floating-point issues, validating two decimal places, and converting to cents before doing the equal-split math with remainder distribution based on the order people were added. I'm also making sure expense form errors preserve the user's input rather than clearing it, and that split checkboxes stay in sync when new people are added.\n\nNow I'm structuring the app itself: a header with the Even Keel name, a main grid of sections for People, Add Expense, Expenses, Balances, and Settle Up, with state tracking people and expenses, and using Intl.NumberFormat for CAD currency display with signed cent values for balances.\n\n",
      "signature": ""
    },
    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel — split trip costs fairly</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --harbour:#1F3A4D;\n    --harbour-deep:#15293A;\n    --harbour-tint:#E8EEF2;\n    --signal:#C2462B;\n    --signal-deep:#9E3520;\n    --signal-tint:#FBEDE9;\n    --paper:#F7F5F1;\n    --card:#FFFFFF;\n    --ink:#1A2229;\n    --ink-soft:#4C5A66;\n    --rule:#D6DDE2;\n    --green:#2C6E49;\n    --green-tint:#E6F1EA;\n    --radius:10px;\n    --focus:0 0 0 3px #fff, 0 0 0 6px var(--signal);\n    font-size:16px;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0}\n  body{\n    font-family:\"Inter\",system-ui,sans-serif;\n    color:var(--ink);\n    background:var(--paper);\n    line-height:1.5;\n    -webkit-font-smoothing:antialiased;\n  }\n  h1,h2,h3{font-family:\"Fraunces\",Georgia,serif;font-weight:600;margin:0;line-height:1.15;letter-spacing:-0.01em}\n  p{margin:0}\n  button,input,select{font:inherit;color:inherit}\n  :focus-visible{outline:none;box-shadow:var(--focus);border-radius:6px}\n\n  header.top{\n    background:var(--harbour);\n    color:#fff;\n    padding:1.5rem 1.25rem 1.75rem;\n  }\n  .top-inner{max-width:1080px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:baseline;gap:.5rem 1.5rem}\n  .wordmark{font-family:\"Fraunces\",serif;font-size:1.75rem;font-weight:600;display:flex;align-items:center;gap:.6rem}\n  .wordmark svg{width:28px;height:28px;flex:none}\n  .tagline{color:#C9D6DF;font-size:.95rem}\n\n  main{max-width:1080px;margin:0 auto;padding:1.25rem 1.25rem 4rem;display:grid;gap:1.25rem;grid-template-columns:1fr}\n  @media (min-width:800px){\n    main{grid-template-columns:1fr 1fr;grid-template-areas:\"people expense\" \"balances expense\" \"settle expenses\"}\n    #people{grid-area:people}#add-expense{grid-area:expense}#expenses{grid-area:expenses}#balances{grid-area:balances}#settle{grid-area:settle}\n  }\n  section.card{\n    background:var(--card);\n    border:1px solid var(--rule);\n    border-radius:var(--radius);\n    padding:1.25rem;\n    box-shadow:0 1px 2px rgba(31,58,77,.05);\n  }\n  .card-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1rem}\n  .card-head h2{font-size:1.35rem;color:var(--harbour)}\n  .count{font-size:.85rem;color:var(--ink-soft);font-weight:500}\n  .lede{color:var(--ink-soft);font-size:.95rem;margin-bottom:1rem}\n\n  label{display:block;font-weight:500;font-size:.9rem;margin-bottom:.35rem;color:var(--harbour)}\n  .hint{font-weight:400;color:var(--ink-soft)}\n  .field{margin-bottom:1rem}\n  input[type=text],select{\n    width:100%;padding:.65rem .75rem;border:1.5px solid #B9C4CC;border-radius:8px;background:#fff;\n  }\n  input[type=text]:focus-visible,select:focus-visible{border-color:var(--harbour);box-shadow:0 0 0 3px #C9D6DF}\n  .row{display:flex;gap:.5rem;align-items:flex-end;flex-wrap:wrap}\n  .row .grow{flex:1 1 180px}\n  .btn{\n    display:inline-flex;align-items:center;justify-content:center;gap:.4rem;\n    padding:.68rem 1.1rem;border-radius:8px;border:1.5px solid transparent;cursor:pointer;font-weight:600;\n    background:var(--harbour);color:#fff;white-space:nowrap;\n  }\n  .btn:hover{background:var(--harbour-deep)}\n  .btn.primary{background:var(--signal)}\n  .btn.primary:hover{background:var(--signal-deep)}\n  .btn:disabled{opacity:.5;cursor:not-allowed}\n  .btn.ghost{background:transparent;color:var(--signal-deep);border-color:transparent;padding:.35rem .6rem;font-size:.85rem}\n  .btn.ghost:hover{background:var(--signal-tint)}\n  .btn.block{width:100%}\n\n  .error{\n    margin-top:.5rem;padding:.6rem .75rem;border-radius:8px;\n    background:var(--signal-tint);color:var(--signal-deep);border-left:4px solid var(--signal);\n    font-size:.9rem;font-weight:500;\n  }\n  .empty{\n    padding:1rem;border:1.5px dashed #C3CDD4;border-radius:8px;color:var(--ink-soft);font-size:.95rem;background:var(--paper);\n  }\n  ul{list-style:none;margin:0;padding:0}\n\n  .chips{display:flex;flex-wrap:wrap;gap:.5rem}\n  .chip{\n    display:inline-flex;align-items:center;gap:.5rem;padding:.4rem .8rem .4rem .5rem;border-radius:999px;\n    background:var(--harbour-tint);color:var(--harbour);font-weight:500;font-size:.95rem;\n  }\n  .avatar{width:1.6rem;height:1.6rem;border-radius:50%;background:var(--harbour);color:#fff;display:grid;place-items:center;font-size:.75rem;font-weight:600;flex:none}\n\n  .split-grid{display:flex;flex-wrap:wrap;gap:.5rem}\n  .check{\n    display:inline-flex;align-items:center;gap:.5rem;padding:.45rem .8rem;border:1.5px solid #B9C4CC;border-radius:999px;\n    cursor:pointer;font-weight:500;font-size:.95rem;margin:0;color:var(--ink);\n  }\n  .check:has(input:checked){background:var(--harbour-tint);border-color:var(--harbour);color:var(--harbour)}\n  .check:has(input:focus-visible){box-shadow:var(--focus)}\n  .check input{width:1rem;height:1rem;margin:0;accent-color:var(--harbour)}\n  .split-actions{display:flex;gap:.75rem;margin-top:.5rem}\n  .link{background:none;border:0;padding:0;color:var(--harbour);text-decoration:underline;cursor:pointer;font-size:.85rem}\n\n  .expense{display:grid;grid-template-columns:1fr auto;gap:.25rem .75rem;padding:.9rem 0;border-top:1px solid var(--rule)}\n  .expense:first-child{border-top:0;padding-top:0}\n  .expense .desc{font-weight:600}\n  .expense .amt{font-weight:600;text-align:right;font-variant-numeric:tabular-nums;color:var(--harbour)}\n  .expense .meta{grid-column:1 / -1;color:var(--ink-soft);font-size:.9rem}\n  .expense .actions{grid-column:1 / -1;display:flex;justify-content:flex-end}\n\n  .balance{display:flex;align-items:center;gap:.75rem;padding:.7rem 0;border-top:1px solid var(--rule)}\n  .balance:first-child{border-top:0;padding-top:0}\n  .balance .name{flex:1;font-weight:500}\n  .balance .state{font-size:.85rem;color:var(--ink-soft)}\n  .balance .val{font-weight:600;font-variant-numeric:tabular-nums;padding:.2rem .6rem;border-radius:6px}\n  .val.pos{color:var(--green);background:var(--green-tint)}\n  .val.neg{color:var(--signal-deep);background:var(--signal-tint)}\n  .val.zero{color:var(--ink-soft);background:var(--harbour-tint)}\n\n  .transfer{display:flex;align-items:center;gap:.6rem;padding:.8rem 0;border-top:1px solid var(--rule);flex-wrap:wrap}\n  .transfer:first-child{border-top:0;padding-top:0}\n  .transfer .who{font-weight:600}\n  .transfer .arrow{color:var(--signal);flex:none}\n  .transfer .val{margin-left:auto;font-weight:600;font-variant-numeric:tabular-nums;color:var(--harbour)}\n  .settled{display:flex;gap:.75rem;align-items:center;padding:1rem;border-radius:8px;background:var(--green-tint);color:var(--green);font-weight:500}\n  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n  footer{max-width:1080px;margin:0 auto;padding:0 1.25rem 2rem;color:var(--ink-soft);font-size:.85rem}\n</style>\n</head>\n<body>\n<header class=\"top\">\n  <div class=\"top-inner\">\n    <div class=\"wordmark\">\n      <svg viewBox=\"0 0 28 28\" aria-hidden=\"true\"><circle cx=\"14\" cy=\"14\" r=\"12\" fill=\"none\" stroke=\"#C9D6DF\" stroke-width=\"2\"/><path d=\"M5 15.5 Q14 11 23 15.5\" fill=\"none\" stroke=\"#C2462B\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><circle cx=\"14\" cy=\"9\" r=\"2\" fill=\"#fff\"/></svg>\n      <span>Even Keel</span>\n    </div>\n    <p class=\"tagline\">Log what each of you paid. We'll work out who owes whom so you all end up even.</p>\n  </div>\n</header>\n\n<main data-testid=\"app\">\n\n  <section class=\"card\" id=\"people\" aria-labelledby=\"people-h\">\n    <div class=\"card-head\"><h2 id=\"people-h\">People</h2><span class=\"count\" id=\"people-count\"></span></div>\n    <form id=\"person-form\" novalidate>\n      <div class=\"row\">\n        <div class=\"grow\">\n          <label for=\"person-name\">Name</label>\n          <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" placeholder=\"e.g. Ana\">\n        </div>\n        <button type=\"submit\" class=\"btn\" data-testid=\"add-person\">Add person</button>\n      </div>\n      <div id=\"person-error\"></div>\n    </form>\n    <div id=\"people-list\" style=\"margin-top:1rem\"></div>\n  </section>\n\n  <section class=\"card\" id=\"add-expense\" aria-labelledby=\"expense-h\">\n    <div class=\"card-head\"><h2 id=\"expense-h\">Add an expense</h2></div>\n    <form id=\"expense-form\" novalidate>\n      <div class=\"field\">\n        <label for=\"expense-desc\">What was it for?</label>\n        <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\" placeholder=\"e.g. Groceries, Saturday\">\n      </div>\n      <div class=\"field\">\n        <label for=\"expense-amount\">Amount <span class=\"hint\">(CAD)</span></label>\n        <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"0.00\">\n      </div>\n      <div class=\"field\">\n        <label for=\"expense-payer\">Who paid?</label>\n        <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n      </div>\n      <fieldset class=\"field\" style=\"border:0;padding:0;margin:0 0 1rem\">\n        <legend><label as=\"span\" style=\"margin-bottom:.35rem\">Split between <span class=\"hint\">(everyone by default)</span></label></legend>\n        <div class=\"split-grid\" id=\"expense-split\" data-testid=\"expense-split\"></div>\n        <div class=\"split-actions\" id=\"split-actions\">\n          <button type=\"button\" class=\"link\" id=\"split-all\">Select everyone</button>\n          <button type=\"button\" class=\"link\" id=\"split-none\">Clear</button>\n        </div>\n      </fieldset>\n      <button type=\"submit\" class=\"btn primary block\" data-testid=\"add-expense\" id=\"add-expense-btn\">Add expense</button>\n      <div id=\"expense-error\"></div>\n    </form>\n  </section>\n\n  <section class=\"card\" id=\"balances\" aria-labelledby=\"balances-h\">\n    <div class=\"card-head\"><h2 id=\"balances-h\">Balances</h2></div>\n    <p class=\"lede\">What each of you paid, minus your share of everything.</p>\n    <div id=\"balances-list\"></div>\n  </section>\n\n  <section class=\"card\" id=\"settle\" aria-labelledby=\"settle-h\">\n    <div class=\"card-head\"><h2 id=\"settle-h\">Settle up</h2></div>\n    <p class=\"lede\">The fewest transfers that bring everyone back to zero.</p>\n    <div id=\"settle-list\"></div>\n  </section>\n\n  <section class=\"card\" id=\"expenses\" aria-labelledby=\"expenses-h\">\n    <div class=\"card-head\"><h2 id=\"expenses-h\">Expenses</h2><span class=\"count\" id=\"expenses-total\"></span></div>\n    <div id=\"expenses-list\"></div>\n  </section>\n\n</main>\n<footer>Everything is saved in this browser, so you can come back to the trip later.</footer>\n\n<script>\n(function(){\n  const STORAGE = 'even-keel-v1';\n  const fmt = new Intl.NumberFormat('en-CA', { style:'currency', currency:'CAD' });\n  const money = c => fmt.format(c/100);\n  const $ = id => document.getElementById(id);\n\n  let state = { people: [], expenses: [] };\n  try {\n    const raw = localStorage.getItem(STORAGE);\n    if (raw) { const s = JSON.parse(raw); if (s && Array.isArray(s.people) && Array.isArray(s.expenses)) state = s; }\n  } catch (e) {}\n  const save = () => { try { localStorage.setItem(STORAGE, JSON.stringify(state)); } catch(e){} };\n\n  const esc = s => String(s).replace(/[&<>\"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[m]));\n  const initials = n => n.trim().split(/\\s+/).slice(0,2).map(w => w[0].toUpperCase()).join('');\n  const listNames = arr => arr.length <= 1 ? arr.join('') : arr.slice(0,-1).join(', ') + ' and ' + arr[arr.length-1];\n\n  function showError(container, msg){\n    container.innerHTML = msg ? `<div class=\"error\" role=\"alert\" data-testid=\"form-error\">${esc(msg)}</div>` : '';\n  }\n\n  // ---- Shares: integer cents, remainder to earliest-added people\n  function shares(cents, split){\n    const ordered = state.people.filter(p => split.includes(p));\n    const n = ordered.length, base = Math.floor(cents/n), rem = cents - base*n;\n    const out = {};\n    ordered.forEach((p,i) => { out[p] = base + (i < rem ? 1 : 0); });\n    return out;\n  }\n\n  function balances(){\n    const b = {}; state.people.forEach(p => b[p] = 0);\n    state.expenses.forEach(e => {\n      if (p in b || true) b[e.payer] = (b[e.payer] || 0) + e.cents;\n      const sh = shares(e.cents, e.split);\n      for (const p in sh) b[p] -= sh[p];\n    });\n    return b;\n  }\n\n  function settle(b){\n    const cred = [], debt = [];\n    state.people.forEach(p => { if (b[p] > 0) cred.push({p, c:b[p]}); else if (b[p] < 0) debt.push({p, c:-b[p]}); });\n    cred.sort((x,y)=>y.c-x.c); debt.sort((x,y)=>y.c-x.c);\n    const out = []; let i=0, j=0;\n    while (i < debt.length && j < cred.length){\n      const amt = Math.min(debt[i].c, cred[j].c);\n      out.push({from:debt[i].p, to:cred[j].p, cents:amt});\n      debt[i].c -= amt; cred[j].c -= amt;\n      if (debt[i].c === 0) i++;\n      if (cred[j].c === 0) j++;\n    }\n    return out;\n  }\n\n  // ---- Render\n  function renderPeople(){\n    const list = $('people-list');\n    $('people-count').textContent = state.people.length ? `${state.people.length} on the trip` : '';\n    if (!state.people.length){\n      list.innerHTML = `<div class=\"empty\">Nobody's here yet. Add everyone who's on the trip, including yourself.</div>`;\n      return;\n    }\n    list.innerHTML = `<ul class=\"chips\">` + state.people.map(p =>\n      `<li class=\"chip\" data-testid=\"person\"><span class=\"avatar\" aria-hidden=\"true\">${esc(initials(p))}</span>${esc(p)}</li>`).join('') + `</ul>`;\n  }\n\n  function renderExpenseForm(){\n    const payer = $('expense-payer'), prevPayer = payer.value;\n    const split = $('expense-split');\n    const prevChecked = {}; split.querySelectorAll('input').forEach(i => prevChecked[i.value] = i.checked);\n    const has = state.people.length > 0;\n\n    payer.innerHTML = has ? state.people.map(p => `<option value=\"${esc(p)}\">${esc(p)}</option>`).join('')\n                          : `<option value=\"\">Add people first</option>`;\n    if (has && state.people.includes(prevPayer)) payer.value = prevPayer;\n    payer.disabled = !has;\n\n    split.innerHTML = has ? state.people.map((p,i) => {\n      const checked = (p in prevChecked) ? prevChecked[p] : true;\n      return `<label class=\"check\" for=\"split-${i}\"><input type=\"checkbox\" id=\"split-${i}\" value=\"${esc(p)}\" ${checked?'checked':''}>${esc(p)}</label>`;\n    }).join('') : `<div class=\"empty\" style=\"width:100%\">Once you've added people, you can choose who shares each cost.</div>`;\n    $('split-actions').style.display = has ? '' : 'none';\n    $('add-expense-btn').disabled = !has;\n  }\n\n  function renderExpenses(){\n    const list = $('expenses-list');\n    const total = state.expenses.reduce((s,e)=>s+e.cents,0);\n    $('expenses-total').textContent = state.expenses.length ? `${state.expenses.length} · ${money(total)} total` : '';\n    if (!state.expenses.length){\n      list.innerHTML = `<div class=\"empty\">${state.people.length ? 'No expenses yet. Add the first thing someone paid for.' : 'Expenses will show up here once you\\u2019ve added people and logged a cost.'}</div>`;\n      return;\n    }\n    list.innerHTML = `<ul>` + state.expenses.slice().reverse().map(e => {\n      const n = e.split.length;\n      const sh = shares(e.cents, e.split);\n      const vals = Object.values(sh);\n      const even = vals.every(v => v === vals[0]);\n      const splitText = n === state.people.length && n > 1\n        ? `everyone (${n})` : listNames(state.people.filter(p=>e.split.includes(p)));\n      const shareText = even ? `${money(vals[0])} each` : `about ${money(vals[0])} each`;\n      return `<li class=\"expense\" data-testid=\"expense\">\n        <span class=\"desc\">${esc(e.desc)}</span>\n        <span class=\"amt\">${money(e.cents)}</span>\n        <span class=\"meta\"><strong>${esc(e.payer)}</strong> paid · split between ${esc(splitText)}, ${shareText}</span>\n        <span class=\"actions\"><button type=\"button\" class=\"btn ghost\" data-testid=\"delete-expense\" data-id=\"${e.id}\" aria-label=\"Remove ${esc(e.desc)}\">Remove</button></span>\n      </li>`;\n    }).join('') + `</ul>`;\n  }\n\n  function renderBalances(){\n    const list = $('balances-list'), settleEl = $('settle-list');\n    if (!state.people.length){\n      list.innerHTML = `<div class=\"empty\">Add people to see where everyone stands.</div>`;\n      settleEl.innerHTML = `<div class=\"empty\">Nothing to settle yet.</div>`;\n      return;\n    }\n    const b = balances();\n    list.innerHTML = `<ul>` + state.people.map(p => {\n      const c = b[p];\n      const cls = c > 0 ? 'pos' : c < 0 ? 'neg' : 'zero';\n      const stateText = c > 0 ? 'is owed' : c < 0 ? 'owes' : 'even';\n      const sign = c > 0 ? '+' : c < 0 ? '−' : '';\n      return `<li class=\"balance\" data-testid=\"balance\" data-person=\"${esc(p)}\" data-cents=\"${c}\">\n        <span class=\"avatar\" aria-hidden=\"true\">${esc(initials(p))}</span>\n        <span class=\"name\">${esc(p)} <span class=\"state\">${stateText}</span></span>\n        <span class=\"val ${cls}\">${sign}${money(Math.abs(c))}</span>\n      </li>`;\n    }).join('') + `</ul>`;\n\n    if (!state.expenses.length){\n      settleEl.innerHTML = `<div class=\"empty\">Once you log some expenses, you\\u2019ll see exactly who should pay whom.</div>`;\n      return;\n    }\n    const t = settle(b);\n    if (!t.length){\n      settleEl.innerHTML = `<div class=\"settled\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M6.5 11.5l3 3 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>You\\u2019re all even. Nothing to pay.</div>`;\n      return;\n    }\n    settleEl.innerHTML = `<ul>` + t.map(x => `<li class=\"transfer\" data-testid=\"transfer\" data-from=\"${esc(x.from)}\" data-to=\"${esc(x.to)}\" data-cents=\"${x.cents}\">\n      <span class=\"who\">${esc(x.from)}</span>\n      <span class=\"arrow\" aria-hidden=\"true\">→</span><span class=\"sr-only\">pays</span>\n      <span class=\"who\">${esc(x.to)}</span>\n      <span class=\"val\">${money(x.cents)}</span>\n    </li>`).join('') + `</ul>` +\n    `<p class=\"lede\" style=\"margin:1rem 0 0\">${t.length} transfer${t.length===1?'':'s'} and everyone\\u2019s square.</p>`;\n  }\n\n  function renderAll(){ renderPeople(); renderExpenseForm(); renderExpenses(); renderBalances(); }\n\n  // ---- People form\n  $('person-form').addEventListener('submit', e => {\n    e.preventDefault();\n    const input = $('person-name'), name = input.value.trim();\n    if (!name){ showError($('person-error'), 'Type a name before adding someone.'); input.focus(); return; }\n    if (state.people.some(p => p.toLowerCase() === name.toLowerCase())){\n      showError($('person-error'), `${name} is already on the trip. Each name needs to be different.`); input.focus(); return;\n    }\n    state.people.push(name); save();\n    showError($('person-error'), '');\n    input.value = '';\n    renderAll();\n    input.focus();\n  });\n  $('person-name').addEventListener('input', () => showError($('person-error'), ''));\n\n  // ---- Expense form\n  function parseCents(raw){\n    const s = raw.trim().replace(/^\\$/, '').replace(/,/g, '');\n    if (!/^\\d+(\\.\\d{1,2})?$|^\\.\\d{1,2}$/.test(s)) return null;\n    const [w, d=''] = s.split('.');\n    return parseInt(w || '0', 10) * 100 + parseInt((d + '00').slice(0,2), 10);\n  }\n\n  $('expense-form').addEventListener('submit', e => {\n    e.preventDefault();\n    const err = $('expense-error');\n    if (!state.people.length){ showError(err, 'Add at least one person before logging an expense.'); return; }\n    const desc = $('expense-desc').value.trim();\n    const amountRaw = $('expense-amount').value;\n    const payer = $('expense-payer').value;\n    const split = [...$('expense-split').querySelectorAll('input:checked')].map(i => i.value);\n\n    if (!desc){ showError(err, 'Say what the expense was for.'); $('expense-desc').focus(); return; }\n    if (!amountRaw.trim()){ showError(err, 'Enter the amount paid.'); $('expense-amount').focus(); return; }\n    const cents = parseCents(amountRaw);\n    if (cents === null){ showError(err, 'Enter the amount in dollars and cents, like 42 or 42.50, with no more than two decimals.'); $('expense-amount').focus(); return; }\n    if (cents <= 0){ showError(err, 'The amount needs to be more than $0.00.'); $('expense-amount').focus(); return; }\n    if (!state.people.includes(payer)){ showError(err, 'Choose who paid.'); $('expense-payer').focus(); return; }\n    if (!split.length){ showError(err, 'Pick at least one person to split this between.'); $('expense-split').querySelector('input')?.focus(); return; }\n\n    state.expenses.push({ id: Date.now().toString(36) + Math.random().toString(36).slice(2,6), desc, cents, payer, split });\n    save();\n    showError(err, '');\n    $('expense-desc').value = ''; $('expense-amount').value = '';\n    $('expense-split').querySelectorAll('input').forEach(i => i.checked = true);\n    renderAll();\n    $('expense-desc').focus();\n  });\n  ['expense-desc','expense-amount','expense-payer','expense-split'].forEach(id => $(id).addEventListener('input', () => showError($('expense-error'), '')));\n\n  $('split-all').addEventListener('click', () => $('expense-split').querySelectorAll('input').forEach(i => i.checked = true));\n  $('split-none').addEventListener('click', () => $('expense-split').querySelectorAll('input').forEach(i => i.checked = false));\n\n  $('expenses-list').addEventListener('click', e => {\n    const btn = e.target.closest('[data-testid=\"delete-expense\"]');\n    if (!btn) return;\n    state.expenses = state.expenses.filter(x => x.id !== btn.dataset.id);\n    save(); renderAll();\n    $('expenses-h').focus?.();\n  });\n\n  renderAll();\n})();\n</script>\n</body>\n</html>"
    }

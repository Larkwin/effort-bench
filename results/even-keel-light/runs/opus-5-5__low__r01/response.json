      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel — Trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;--harbour-2:#2C5068;--signal:#C2462B;--signal-dk:#A33A22;\n  --sand:#F6F2EA;--paper:#FFFDF9;--line:#DCD4C6;--ink:#1B2730;--muted:#55636E;\n  --owed:#2F6B4F;--owes:#A33A22;--focus:#C2462B;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--sand);color:var(--ink);font:16px/1.5 \"Public Sans\",system-ui,sans-serif}\nh1,h2{font-family:Fraunces,Georgia,serif;font-weight:650;margin:0;letter-spacing:-.01em}\nheader{background:var(--harbour);color:#fff;padding:28px 20px 34px}\n.wrap{max-width:1080px;margin:0 auto}\n.brand{display:flex;align-items:center;gap:12px}\n.brand svg{flex:none}\nheader h1{font-size:1.9rem}\nheader p{margin:6px 0 0;color:#D5E0E7;max-width:42ch}\nmain{padding:0 16px 48px}\n.grid{max-width:1080px;margin:-18px auto 0;display:grid;gap:18px;grid-template-columns:1fr}\n@media(min-width:880px){.grid{grid-template-columns:minmax(0,5fr) minmax(0,6fr);align-items:start}.col{display:grid;gap:18px}}\n.col{display:grid;gap:18px;min-width:0}\n.card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:20px;min-width:0}\n.card h2{font-size:1.3rem;color:var(--harbour);margin-bottom:4px}\n.hint{color:var(--muted);margin:0 0 14px;font-size:.94rem}\nlabel,.lbl{display:block;font-weight:600;font-size:.92rem;margin:0 0 6px;color:var(--ink)}\ninput[type=text],input[type=number],input[inputmode],select{\n  width:100%;font:inherit;padding:10px 12px;border:1.5px solid #8C9AA4;border-radius:9px;background:#fff;color:var(--ink);min-height:44px}\n.row{display:flex;gap:8px;flex-wrap:wrap}\n.row input{flex:1 1 160px;min-width:0}\n.field{margin-bottom:14px}\n.two{display:grid;gap:14px;grid-template-columns:1fr}\n@media(min-width:460px){.two{grid-template-columns:1fr 1fr}}\nbutton{font:inherit;font-weight:600;cursor:pointer;border-radius:9px;min-height:44px;padding:10px 18px;border:1.5px solid transparent}\n.primary{background:var(--harbour);color:#fff}\n.primary:hover{background:var(--harbour-2)}\n.ghost{background:transparent;color:var(--signal-dk);border-color:transparent;padding:6px 10px;min-height:36px;text-decoration:underline;text-underline-offset:3px}\n.ghost:hover{background:#F7E6E1}\n:focus-visible{outline:3px solid var(--focus);outline-offset:2px}\ninput:focus-visible,select:focus-visible{border-color:var(--harbour)}\n.error{color:var(--signal-dk);background:#FBEDE9;border-left:4px solid var(--signal);padding:8px 12px;border-radius:6px;margin:10px 0 0;font-size:.93rem}\n.people{list-style:none;padding:0;margin:14px 0 0;display:flex;flex-wrap:wrap;gap:8px}\n.people li{background:#E8EEF2;color:var(--harbour);border-radius:999px;padding:5px 14px;font-weight:600;max-width:100%;overflow-wrap:anywhere}\nfieldset{border:0;padding:0;margin:0 0 14px;min-width:0}\nlegend{font-weight:600;font-size:.92rem;margin-bottom:6px;padding:0}\n.checks{display:flex;flex-wrap:wrap;gap:8px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:500;border:1.5px solid var(--line);border-radius:9px;padding:8px 12px;margin:0;cursor:pointer;background:#fff;overflow-wrap:anywhere;max-width:100%}\n.checks input{width:18px;height:18px;accent-color:var(--harbour);flex:none}\n.empty{color:var(--muted);background:var(--sand);border:1.5px dashed var(--line);border-radius:10px;padding:14px;margin:8px 0 0;font-size:.94rem}\nul.list{list-style:none;padding:0;margin:8px 0 0}\n.exp{display:flex;gap:12px;justify-content:space-between;align-items:flex-start;padding:14px 0;border-top:1px solid var(--line)}\n.exp:first-child{border-top:0}\n.exp .d{font-weight:600;overflow-wrap:anywhere}\n.exp .m{color:var(--muted);font-size:.9rem;overflow-wrap:anywhere}\n.exp .r{text-align:right;flex:none}\n.amt{font-variant-numeric:tabular-nums;font-weight:700}\n.bal{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line);align-items:baseline}\n.bal:first-child{border-top:0}\n.bal .n{font-weight:600;overflow-wrap:anywhere;min-width:0}\n.bal .s{font-size:.85rem;color:var(--muted);display:block;font-weight:400}\n.pos{color:var(--owed)}.neg{color:var(--owes)}.zero{color:var(--muted)}\n.tr{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;padding:12px 14px;background:var(--sand);border-radius:10px;margin-top:8px}\n.tr b{overflow-wrap:anywhere}\n.tr .arrow{color:var(--signal)}\n.tr .amt{margin-left:auto}\n.even{display:flex;gap:10px;align-items:center;color:var(--owed);font-weight:600;margin-top:8px}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n</style>\n</head>\n<body>\n<header>\n  <div class=\"wrap\">\n    <div class=\"brand\">\n      <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" aria-hidden=\"true\"><circle cx=\"18\" cy=\"18\" r=\"17\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"/><path d=\"M7 21h22\" stroke=\"#C2462B\" stroke-width=\"3\" stroke-linecap=\"round\"/><path d=\"M10 25c2.5 2 5 2 8 0s5.5-2 8 0\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M18 8v13\" stroke=\"#fff\" stroke-width=\"2\"/></svg>\n      <h1>Even Keel</h1>\n    </div>\n    <p>Log what you each paid. We'll work out the fewest transfers to make everyone even.</p>\n  </div>\n</header>\n<main data-testid=\"app\">\n<div class=\"grid\">\n  <div class=\"col\">\n    <section class=\"card\" aria-labelledby=\"h-people\">\n      <h2 id=\"h-people\">Who's on the trip</h2>\n      <p class=\"hint\">Add everyone who's sharing costs.</p>\n      <form id=\"personForm\" novalidate>\n        <label for=\"pname\">Name</label>\n        <div class=\"row\">\n          <input id=\"pname\" type=\"text\" autocomplete=\"off\" data-testid=\"person-name\" aria-describedby=\"perr\">\n          <button class=\"primary\" type=\"submit\" data-testid=\"add-person\">Add person</button>\n        </div>\n        <div id=\"perr\" aria-live=\"polite\"></div>\n      </form>\n      <ul class=\"people\" id=\"people\"></ul>\n      <p class=\"empty\" id=\"peopleEmpty\">No one yet. Start with yourself.</p>\n    </section>\n\n    <section class=\"card\" aria-labelledby=\"h-add\">\n      <h2 id=\"h-add\">Add an expense</h2>\n      <p class=\"hint\">Amounts are in Canadian dollars and split equally.</p>\n      <form id=\"expForm\" novalidate>\n        <div class=\"field\"><label for=\"edesc\">Description</label>\n          <input id=\"edesc\" type=\"text\" autocomplete=\"off\" placeholder=\"e.g. Groceries\" data-testid=\"expense-desc\"></div>\n        <div class=\"two\">\n          <div class=\"field\"><label for=\"eamt\">Amount (CAD)</label>\n            <input id=\"eamt\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"0.00\" data-testid=\"expense-amount\"></div>\n          <div class=\"field\"><label for=\"epayer\">Paid by</label>\n            <select id=\"epayer\" data-testid=\"expense-payer\"></select></div>\n        </div>\n        <fieldset><legend>Split between</legend>\n          <div class=\"checks\" id=\"split\" data-testid=\"expense-split\"></div>\n        </fieldset>\n        <button class=\"primary\" type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n        <div id=\"eerr\" aria-live=\"polite\"></div>\n      </form>\n    </section>\n  </div>\n\n  <div class=\"col\">\n    <section class=\"card\" aria-labelledby=\"h-settle\">\n      <h2 id=\"h-settle\">Settle up</h2>\n      <p class=\"hint\">The simplest way to get everyone back to even.</p>\n      <div id=\"transfers\"></div>\n    </section>\n    <section class=\"card\" aria-labelledby=\"h-bal\">\n      <h2 id=\"h-bal\">Balances</h2>\n      <p class=\"hint\">What each of you paid, minus your share.</p>\n      <div id=\"balances\"></div>\n    </section>\n    <section class=\"card\" aria-labelledby=\"h-exp\">\n      <h2 id=\"h-exp\">Expenses</h2>\n      <div id=\"expenses\"></div>\n    </section>\n  </div>\n</div>\n<div class=\"sr\" aria-live=\"polite\" id=\"announce\"></div>\n</main>\n<script>\n(function(){\nconst KEY='even-keel-v1';\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nlet state={people:[],expenses:[],nextId:1};\ntry{const s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=Object.assign(state,s);}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};\nconst $=id=>document.getElementById(id);\nconst el=(t,a={},...kids)=>{const e=document.createElement(t);for(const k in a){if(k==='text')e.textContent=a[k];else if(k==='cls')e.className=a[k];else e.setAttribute(k,a[k]);}kids.forEach(k=>k&&e.append(k));return e;};\nfunction showErr(box,input,msg){box.innerHTML='';if(msg){box.append(el('p',{cls:'error','data-testid':'form-error',role:'alert',text:msg}));if(input){input.setAttribute('aria-invalid','true');input.focus();}}}\nfunction announce(t){$('announce').textContent=t;}\n\nfunction shares(exp){\n  const order=state.people.filter(p=>exp.split.includes(p));\n  const n=order.length;const base=Math.floor(exp.cents/n);let rem=exp.cents-base*n;\n  const m={};order.forEach(p=>{m[p]=base+(rem>0?1:0);if(rem>0)rem--;});return m;\n}\nfunction balances(){\n  const b={};state.people.forEach(p=>b[p]=0);\n  state.expenses.forEach(e=>{if(b[e.payer]!==undefined)b[e.payer]+=e.cents;const s=shares(e);for(const p in s)b[p]-=s[p];});\n  return b;\n}\nfunction settle(b){\n  const cred=[],debt=[];\n  state.people.forEach(p=>{if(b[p]>0)cred.push({p,c:b[p]});else if(b[p]<0)debt.push({p,c:-b[p]});});\n  cred.sort((a,c)=>c.c-a.c);debt.sort((a,c)=>c.c-a.c);\n  const out=[];let i=0,j=0;\n  while(i<debt.length&&j<cred.length){const x=Math.min(debt[i].c,cred[j].c);out.push({from:debt[i].p,to:cred[j].p,c:x});debt[i].c-=x;cred[j].c-=x;if(!debt[i].c)i++;if(!cred[j].c)j++;}\n  return out;\n}\n\nfunction render(){\n  const P=state.people;\n  const ul=$('people');ul.innerHTML='';\n  P.forEach(p=>ul.append(el('li',{'data-testid':'person',text:p})));\n  $('peopleEmpty').hidden=P.length>0;\n\n  const sel=$('epayer');const prev=sel.value;sel.innerHTML='';\n  if(!P.length)sel.append(el('option',{value:'',text:'Add people first'}));\n  P.forEach(p=>sel.append(el('option',{value:p,text:p})));\n  if(P.includes(prev))sel.value=prev;\n  const split=$('split');const prevChecked={};split.querySelectorAll('input').forEach(c=>prevChecked[c.value]=c.checked);\n  split.innerHTML='';\n  if(!P.length)split.append(el('p',{cls:'empty',text:'Once you add people, choose who shares each cost here.'}));\n  P.forEach(p=>{const c=el('input',{type:'checkbox',value:p});c.checked=p in prevChecked?prevChecked[p]:true;split.append(el('label',{},c,document.createTextNode(p)));});\n\n  const ex=$('expenses');ex.innerHTML='';\n  if(!state.expenses.length)ex.append(el('p',{cls:'empty',text:P.length?'No expenses yet. Add the first one, like a tank of gas or a grocery run.':'Add people, then log what you each paid.'}));\n  else{const list=el('ul',{cls:'list'});\n    state.expenses.slice().reverse().forEach(e=>{\n      const btn=el('button',{type:'button',cls:'ghost','data-testid':'delete-expense','aria-label':'Remove '+e.desc,text:'Remove'});\n      btn.addEventListener('click',()=>{state.expenses=state.expenses.filter(x=>x.id!==e.id);save();render();announce('Removed '+e.desc);$('h-exp').setAttribute('tabindex','-1');$('h-exp').focus();});\n      const who=state.people.filter(p=>e.split.includes(p));\n      const splitTxt=who.length===P.length&&P.length>1?'everyone':who.join(', ');\n      list.append(el('li',{cls:'exp','data-testid':'expense'},\n        el('div',{},el('div',{cls:'d',text:e.desc}),el('div',{cls:'m',text:e.payer+' paid · split between '+splitTxt})),\n        el('div',{cls:'r'},el('div',{cls:'amt',text:money(e.cents)}),btn)));\n    });ex.append(list);}\n\n  const b=balances();\n  const bl=$('balances');bl.innerHTML='';\n  if(!P.length)bl.append(el('p',{cls:'empty',text:'Balances show up once people are on the trip.'}));\n  P.forEach(p=>{const c=b[p];const cls=c>0?'pos':c<0?'neg':'zero';\n    const note=c>0?'is owed':c<0?'owes':'is even';\n    bl.append(el('div',{cls:'bal','data-testid':'balance','data-person':p,'data-cents':String(c)},\n      el('span',{cls:'n',text:p},el('span',{cls:'s',text:note})),\n      el('span',{cls:'amt '+cls,text:(c>0?'+':c<0?'−':'')+money(Math.abs(c))})));});\n\n  const tr=$('transfers');tr.innerHTML='';const t=settle(b);\n  if(!state.expenses.length)tr.append(el('p',{cls:'empty',text:'Nothing to settle yet. Transfers appear here as you add expenses.'}));\n  else if(!t.length)tr.append(el('p',{cls:'even',text:'✓ You\\'re all even. Nothing to pay.'}));\n  else t.forEach(x=>tr.append(el('div',{cls:'tr','data-testid':'transfer','data-from':x.from,'data-to':x.to,'data-cents':String(x.c)},\n    el('b',{text:x.from}),el('span',{cls:'arrow','aria-hidden':'true',text:'→'}),el('span',{cls:'sr',text:'pays'}),el('b',{text:x.to}),el('span',{cls:'amt',text:money(x.c)}))));\n}\n\n$('personForm').addEventListener('submit',ev=>{ev.preventDefault();\n  const inp=$('pname');inp.removeAttribute('aria-invalid');const name=inp.value.trim();\n  if(!name)return showErr($('perr'),inp,'Enter a name to add someone.');\n  if(state.people.some(p=>p.toLowerCase()===name.toLowerCase()))return showErr($('perr'),inp,'“'+name+'” is already on the trip. Try adding a last initial.');\n  showErr($('perr'));state.people.push(name);save();inp.value='';\n  render();const cb=[...$('split').querySelectorAll('input')].find(c=>c.value===name);if(cb)cb.checked=true;\n  announce(name+' added');inp.focus();\n});\n$('pname').addEventListener('input',()=>{$('pname').removeAttribute('aria-invalid');});\n\n$('expForm').addEventListener('submit',ev=>{ev.preventDefault();\n  const d=$('edesc'),a=$('eamt'),box=$('eerr');[d,a].forEach(i=>i.removeAttribute('aria-invalid'));\n  if(!state.people.length)return showErr(box,$('pname'),'Add at least one person before logging an expense.');\n  const desc=d.value.trim();if(!desc)return showErr(box,d,'Add a short description, like “Dinner”.');\n  const raw=a.value.trim().replace(/[$,\\s]/g,'');\n  if(!raw)return showErr(box,a,'Enter an amount in dollars, like 42.50.');\n  if(!/^\\d+(\\.\\d{1,2})?$|^\\.\\d{1,2}$/.test(raw))return showErr(box,a,'Enter a valid amount with at most 2 decimal places, like 42.50.');\n  const [w,f='']=raw.split('.');const cents=Number(w||0)*100+Number((f+'00').slice(0,2));\n  if(!(cents>0))return showErr(box,a,'The amount needs to be more than $0.00.');\n  if(!Number.isSafeInteger(cents))return showErr(box,a,'That amount is too large.');\n  const payer=$('epayer').value;if(!state.people.includes(payer))return showErr(box,$('epayer'),'Choose who paid.');\n  const split=[...$('split').querySelectorAll('input:checked')].map(c=>c.value).filter(v=>state.people.includes(v));\n  if(!split.length){const f0=$('split').querySelector('input');return showErr(box,f0,'Choose at least one person to split this with.');}\n  showErr(box);state.expenses.push({id:state.nextId++,desc,cents,payer,split});save();\n  d.value='';a.value='';$('split').querySelectorAll('input').forEach(c=>c.checked=true);\n  render();announce('Added '+desc+', '+money(cents));d.focus();\n});\nrender();\n})();\n</script>\n</body>\n</html>"

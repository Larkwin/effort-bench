  "content": [
    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel — trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D; --harbour-2:#2f5873; --signal:#C2462B; --signal-dark:#a23a22;\n  --paper:#F5F1E8; --card:#FFFDF8; --ink:#17232c; --muted:#4e5f6b; --line:#d9d2c1;\n  --owed:#1d6b4b; --owe:#a23a22; --tint:#e8eef2;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 \"Public Sans\",system-ui,sans-serif}\nh1,h2{font-family:Fraunces,Georgia,serif;margin:0;color:var(--harbour);line-height:1.15}\nheader{background:var(--harbour);color:#fff;border-bottom:6px solid var(--signal)}\n.wrap{max-width:1040px;margin:0 auto;padding:0 16px}\nheader .wrap{padding-top:22px;padding-bottom:22px}\nheader h1{color:#fff;font-size:2rem;display:flex;align-items:center;gap:10px}\nheader p{margin:6px 0 0;color:#d6e2ea;max-width:46ch}\nmain{padding:20px 0 48px}\n.grid{display:grid;gap:18px;grid-template-columns:1fr}\n@media(min-width:860px){.grid{grid-template-columns:1fr 1fr;align-items:start}.span2{grid-column:1/-1}}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}\nh2{font-size:1.3rem;margin-bottom:12px}\nlabel,legend{display:block;font-weight:600;font-size:.9rem;margin-bottom:4px;color:var(--harbour)}\nfieldset{border:0;padding:0;margin:0 0 14px;min-width:0}\ninput[type=text],input[type=number],select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #7d8b94;border-radius:6px;background:#fff;color:var(--ink);min-height:44px}\n.field{margin-bottom:14px}\n.row{display:flex;gap:8px;align-items:flex-end}\n.row .field{flex:1;margin:0;min-width:0}\nbutton{font:inherit;font-weight:600;min-height:44px;padding:0 18px;border-radius:6px;border:2px solid var(--harbour);background:var(--harbour);color:#fff;cursor:pointer}\nbutton:hover{background:var(--harbour-2);border-color:var(--harbour-2)}\nbutton.sec{background:transparent;color:var(--harbour)}\nbutton.sec:hover{background:var(--tint)}\nbutton.danger{color:var(--signal-dark);border-color:var(--signal-dark);background:transparent;min-height:36px;padding:0 12px}\nbutton.danger:hover{background:#fbe9e4}\n:focus-visible{outline:3px solid var(--signal);outline-offset:2px}\n.err{margin:8px 0 0;padding:8px 12px;background:#fbe9e4;border-left:4px solid var(--signal);color:#7a2410;font-weight:500;border-radius:4px}\n.err[hidden]{display:none}\nul{list-style:none;margin:0;padding:0}\n.people{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}\n.people li{background:var(--tint);color:var(--harbour);padding:6px 14px;border-radius:99px;font-weight:600}\n.empty{color:var(--muted);margin:10px 0 0;padding:12px;border:1.5px dashed var(--line);border-radius:8px}\n.checks{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:6px}\n.checks label{display:flex;gap:8px;align-items:center;font-weight:500;color:var(--ink);margin:0;padding:8px 10px;border:1px solid var(--line);border-radius:6px;min-height:44px;cursor:pointer;overflow-wrap:anywhere}\n.checks input{width:20px;height:20px;accent-color:var(--harbour);flex:none}\n.exp{padding:12px 0;border-top:1px solid var(--line);display:flex;gap:10px;justify-content:space-between;align-items:flex-start}\n.exp:first-child{border-top:0}\n.exp .info{min-width:0;overflow-wrap:anywhere}\n.exp strong{display:block}\n.exp small{color:var(--muted);display:block}\n.amt{font-family:Fraunces,serif;font-weight:700;color:var(--harbour);font-size:1.15rem}\n.exp .side{text-align:right;display:flex;flex-direction:column;gap:6px;align-items:flex-end;flex:none}\n.bal{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid var(--line);align-items:baseline}\n.bal:first-child{border-top:0}\n.bal b{overflow-wrap:anywhere}\n.pos{color:var(--owed)}.neg{color:var(--owe)}.zero{color:var(--muted)}\n.bal span{font-weight:700;text-align:right}\n.bal em{display:block;font-style:normal;font-weight:500;font-size:.8rem}\n.tr{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:12px;margin-bottom:8px;background:var(--tint);border-radius:8px;border-left:5px solid var(--signal)}\n.tr .amt{margin-left:auto}\n.note{color:var(--muted);font-size:.9rem;margin:0 0 10px}\n</style>\n</head>\n<body>\n<header><div class=\"wrap\">\n<h1>Even Keel</h1>\n<p>Log what each of you paid. We'll work out who owes whom. Owing a friend is normal; this just makes it easy to square up.</p>\n</div></header>\n<main data-testid=\"app\" class=\"wrap\">\n<div class=\"grid\">\n\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">Who's on the trip</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\">\n<div class=\"field\"><label for=\"pname\">Name</label><input type=\"text\" id=\"pname\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" data-testid=\"add-person\">Add person</button>\n</div>\n<p class=\"err\" id=\"perr\" data-testid=\"form-error\" role=\"alert\" hidden></p>\n</form>\n<ul class=\"people\" id=\"plist\"></ul>\n<p class=\"empty\" id=\"pempty\">No one is on the trip yet. Add the first name above.</p>\n</section>\n\n<section aria-labelledby=\"h-add\">\n<h2 id=\"h-add\">Add an expense</h2>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"edesc\">What was it for?</label><input type=\"text\" id=\"edesc\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"eamt\">Amount (CAD)</label><input type=\"number\" id=\"eamt\" data-testid=\"expense-amount\" inputmode=\"decimal\" step=\"0.01\" min=\"0\" placeholder=\"0.00\"></div>\n<div class=\"field\"><label for=\"epayer\">Paid by</label><select id=\"epayer\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend>Split between</legend><div class=\"checks\" id=\"esplit\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"eerr\" data-testid=\"form-error\" role=\"alert\" hidden></p>\n</form>\n</section>\n\n<section aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<p class=\"note\">Positive means you're owed money. Negative means you owe.</p>\n<div id=\"blist\"></div>\n<p class=\"empty\" id=\"bempty\">Balances show up once people are added.</p>\n</section>\n\n<section aria-labelledby=\"h-set\">\n<h2 id=\"h-set\">Settle up</h2>\n<div id=\"tlist\"></div>\n<p class=\"empty\" id=\"tempty\"></p>\n</section>\n\n<section class=\"span2\" aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Expenses</h2>\n<ul id=\"xlist\"></ul>\n<p class=\"empty\" id=\"xempty\">No expenses yet. Add the first one when someone pays for something.</p>\n</section>\n\n</div>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst $=id=>document.getElementById(id);\nconst KEY='evenkeel.v1';\nlet state={people:[],expenses:[]};\ntry{const s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=s}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};\nconst money=c=>fmt.format(c/100);\nfunction el(t,props,...kids){const e=document.createElement(t);Object.assign(e,props||{});kids.forEach(k=>e.append(k));return e}\nfunction showErr(id,msg){const e=$(id);e.textContent=msg;e.hidden=false}\nfunction clearErr(id){$(id).hidden=true;$(id).textContent=''}\n\nfunction shares(e){\n  const order=state.people.filter(p=>e.split.includes(p));\n  const n=order.length,base=Math.floor(e.cents/n),rem=e.cents-base*n;\n  const out={};order.forEach((p,i)=>out[p]=base+(i<rem?1:0));return out;\n}\nfunction balances(){\n  const b={};state.people.forEach(p=>b[p]=0);\n  state.expenses.forEach(e=>{\n    if(b[e.payer]!==undefined)b[e.payer]+=e.cents;\n    const s=shares(e);for(const p in s)b[p]-=s[p];\n  });return b;\n}\nfunction transfers(b){\n  const cr=[],db=[];\n  state.people.forEach(p=>{if(b[p]>0)cr.push([p,b[p]]);else if(b[p]<0)db.push([p,-b[p]])});\n  const out=[];\n  while(cr.length&&db.length){\n    cr.sort((a,c)=>c[1]-a[1]);db.sort((a,c)=>c[1]-a[1]);\n    const c=cr[0],d=db[0],m=Math.min(c[1],d[1]);\n    out.push({from:d[0],to:c[0],cents:m});\n    c[1]-=m;d[1]-=m;\n    if(!c[1])cr.shift();if(!d[1])db.shift();\n  }\n  return out;\n}\n\nfunction render(){\n  // people\n  const pl=$('plist');pl.replaceChildren();\n  state.people.forEach(p=>{const li=el('li',{textContent:p});li.dataset.testid='person';pl.append(li)});\n  $('pempty').hidden=state.people.length>0;\n  // form controls preserve state\n  const checked=new Set([...$('esplit').querySelectorAll('input:checked')].map(i=>i.value));\n  const known=new Set([...$('esplit').querySelectorAll('input')].map(i=>i.value));\n  const sel=$('epayer').value;\n  $('epayer').replaceChildren(...state.people.map(p=>el('option',{value:p,textContent:p})));\n  if(state.people.includes(sel))$('epayer').value=sel;\n  const sp=$('esplit');sp.replaceChildren();\n  state.people.forEach((p,i)=>{\n    const cb=el('input',{type:'checkbox',value:p,id:'sp'+i});\n    cb.checked=known.has(p)?checked.has(p):true;\n    sp.append(el('label',{htmlFor:'sp'+i},cb,el('span',{textContent:p})));\n  });\n  if(!state.people.length)sp.append(el('span',{className:'note',textContent:'Add people to choose who shares the cost.'}));\n  // expenses\n  const xl=$('xlist');xl.replaceChildren();\n  [...state.expenses].reverse().forEach(e=>{\n    const del=el('button',{type:'button',className:'danger',textContent:'Remove'});\n    del.dataset.testid='delete-expense';\n    del.setAttribute('aria-label','Remove '+e.desc);\n    del.onclick=()=>{state.expenses=state.expenses.filter(x=>x.id!==e.id);save();render()};\n    const li=el('li',{className:'exp'},\n      el('div',{className:'info'},el('strong',{textContent:e.desc}),\n        el('small',{textContent:'Paid by '+e.payer}),\n        el('small',{textContent:'Split between '+state.people.filter(p=>e.split.includes(p)).join(', ')})),\n      el('div',{className:'side'},el('span',{className:'amt',textContent:money(e.cents)}),del));\n    li.dataset.testid='expense';xl.append(li);\n  });\n  $('xempty').hidden=state.expenses.length>0;\n  // balances\n  const b=balances(),bl=$('blist');bl.replaceChildren();\n  state.people.forEach(p=>{\n    const c=b[p],cls=c>0?'pos':c<0?'neg':'zero';\n    const txt=c>0?'is owed':c<0?'owes':'all even';\n    const row=el('div',{className:'bal'},el('b',{textContent:p}),\n      el('span',{className:cls},(c>0?'+':'')+money(c),el('em',{textContent:txt})));\n    row.dataset.testid='balance';row.dataset.person=p;row.dataset.cents=c;\n    bl.append(row);\n  });\n  $('bempty').hidden=state.people.length>0;\n  // transfers\n  const tl=$('tlist');tl.replaceChildren();\n  const ts=transfers(b);\n  ts.forEach(t=>{\n    const d=el('div',{className:'tr'},el('b',{textContent:t.from}),'pays',el('b',{textContent:t.to}),\n      el('span',{className:'amt',textContent:money(t.cents)}));\n    d.dataset.testid='transfer';d.dataset.from=t.from;d.dataset.to=t.to;d.dataset.cents=t.cents;\n    tl.append(d);\n  });\n  const te=$('tempty');\n  te.hidden=ts.length>0;\n  te.textContent=!state.people.length?'Add people and expenses to see who pays whom.':\n    !state.expenses.length?'Nothing to settle yet. Everyone is even.':'You\\'re all square. No one needs to pay anyone.';\n}\n\n$('pf').addEventListener('submit',ev=>{\n  ev.preventDefault();\n  const name=$('pname').value.trim();\n  if(!name)return showErr('perr','Enter a name to add someone.');\n  if(state.people.some(p=>p.toLowerCase()===name.toLowerCase()))return showErr('perr',`\"${name}\" is already on the trip. Names must be different, ignoring capitals.`);\n  clearErr('perr');state.people.push(name);$('pname').value='';save();render();$('pname').focus();\n});\n\n$('ef').addEventListener('submit',ev=>{\n  ev.preventDefault();\n  const desc=$('edesc').value.trim(),raw=$('eamt').value.trim();\n  const payer=$('epayer').value;\n  const split=[...$('esplit').querySelectorAll('input:checked')].map(i=>i.value);\n  let msg='';\n  if(!desc)msg='Add a description for this expense.';\n  else if(!raw)msg='Enter the amount.';\n  else if(!/^\\d+(\\.\\d{1,2})?$/.test(raw)&&!/^\\.\\d{1,2}$/.test(raw))msg=/^-/.test(raw)?'The amount must be greater than $0.00.':'Enter the amount as dollars with at most 2 decimal places, like 24.50.';\n  else if(Math.round(parseFloat(raw)*100)<=0)msg='The amount must be greater than $0.00.';\n  else if(!state.people.length)msg='Add at least one person to the trip first.';\n  else if(!payer)msg='Choose who paid.';\n  else if(!split.length)msg='Choose at least one person to split this between.';\n  if(msg)return showErr('eerr',msg);\n  const cents=Math.round(parseFloat(raw)*100);\n  clearErr('eerr');\n  state.expenses.push({id:Date.now()+Math.random(),desc,cents,payer,split});\n  $('edesc').value='';$('eamt').value='';\n  save();render();$('edesc').focus();\n});\n\nrender();\n</script>\n</body>\n</html>"
    }

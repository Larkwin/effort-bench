    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel — split trip costs fairly</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;--harbour-2:#2C5068;--signal:#C2462B;--signal-dark:#A33A23;\n  --sand:#F6F2EA;--paper:#FFFDF9;--line:#DDD5C7;--ink:#1B2730;--muted:#4F5D68;\n  --sea:#2F6B5A;--sea-bg:#E4F0EA;--owe:#8A3A22;--owe-bg:#F8E7E0;\n  --focus:#C2462B;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--sand);color:var(--ink);font:16px/1.5 \"Public Sans\",system-ui,sans-serif}\nh1,h2{font-family:Fraunces,Georgia,serif;font-weight:650;margin:0;letter-spacing:-.01em}\n.top{background:var(--harbour);color:#fff;padding:22px 20px 26px}\n.top .wrap{display:flex;align-items:center;gap:14px}\n.mark{width:40px;height:40px;flex:none}\n.top h1{font-size:1.7rem}\n.top p{margin:2px 0 0;color:#D3DEE6;font-size:.95rem}\n.wrap{max-width:1080px;margin:0 auto}\nmain{padding:20px 16px 48px}\n.grid{display:grid;gap:18px;grid-template-columns:1fr}\n@media(min-width:860px){.grid{grid-template-columns:minmax(0,5fr) minmax(0,6fr)}.span{grid-column:1/-1}}\n.card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:20px;min-width:0}\n.card h2{font-size:1.3rem;color:var(--harbour);margin-bottom:4px}\n.lede{margin:0 0 14px;color:var(--muted);font-size:.93rem}\nlabel,.legend{display:block;font-weight:600;font-size:.9rem;margin:0 0 5px;color:var(--ink)}\ninput[type=text],input[type=number],input[inputmode],select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #9AA5AD;border-radius:9px;background:#fff;color:var(--ink);min-height:44px}\ninput[aria-invalid=true]{border-color:var(--signal)}\n.field{margin-bottom:14px}\n.row{display:flex;gap:10px}\n.row>.grow{flex:1;min-width:0}\n.two{display:grid;gap:12px;grid-template-columns:1fr}\n@media(min-width:480px){.two{grid-template-columns:1fr 1fr}}\nbutton{font:inherit;font-weight:600;border-radius:9px;cursor:pointer;min-height:44px;padding:10px 16px}\n.primary{background:var(--signal);color:#fff;border:0}\n.primary:hover{background:var(--signal-dark)}\n.ghost{background:transparent;border:1.5px solid var(--line);color:var(--harbour);padding:6px 12px;min-height:36px;font-size:.88rem}\n.ghost:hover{border-color:var(--harbour)}\n.link{background:none;border:0;color:var(--harbour);text-decoration:underline;padding:4px 6px;min-height:32px;font-size:.88rem}\n:focus-visible{outline:3px solid var(--focus);outline-offset:2px}\ninput:focus-visible,select:focus-visible{outline-offset:0}\n.error{margin:8px 0 0;color:#9B2F17;font-size:.9rem;font-weight:500;display:flex;gap:6px}\n.error::before{content:\"!\";display:inline-grid;place-items:center;width:18px;height:18px;flex:none;border-radius:50%;background:var(--signal);color:#fff;font-size:.75rem;font-weight:700;margin-top:2px}\n.people{list-style:none;margin:16px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px}\n.people li{background:#E9EEF1;color:var(--harbour);border-radius:999px;padding:5px 12px 5px 6px;display:flex;align-items:center;gap:8px;font-weight:500;max-width:100%;overflow-wrap:anywhere}\n.av{width:26px;height:26px;border-radius:50%;background:var(--harbour);color:#fff;display:grid;place-items:center;font-size:.75rem;font-weight:700;flex:none}\nfieldset{border:0;padding:0;margin:0 0 16px}\n.split{display:flex;flex-wrap:wrap;gap:8px}\n.chk{display:flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:9px;padding:8px 12px;font-weight:500;font-size:.93rem;cursor:pointer;margin:0;min-height:44px;max-width:100%;overflow-wrap:anywhere}\n.chk:has(input:checked){border-color:var(--harbour);background:#EEF3F6}\n.chk input{width:18px;height:18px;accent-color:var(--harbour);margin:0}\n.splitbar{display:flex;gap:4px;margin-bottom:8px}\n.empty{border:1.5px dashed var(--line);border-radius:10px;padding:16px;color:var(--muted);font-size:.93rem;margin:12px 0 0}\n.list{list-style:none;margin:0;padding:0}\n.exp{display:flex;gap:12px;align-items:flex-start;padding:14px 0;border-top:1px solid var(--line)}\n.exp:first-child{border-top:0}\n.exp .body{flex:1;min-width:0;overflow-wrap:anywhere}\n.exp .desc{font-weight:600}\n.exp .meta{color:var(--muted);font-size:.88rem}\n.amt{font-variant-numeric:tabular-nums;font-weight:700;color:var(--harbour);white-space:nowrap}\n.bal{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 0;border-top:1px solid var(--line);overflow-wrap:anywhere}\n.bal:first-child{border-top:0}\n.pill{font-variant-numeric:tabular-nums;font-weight:700;padding:3px 10px;border-radius:999px;white-space:nowrap;font-size:.93rem}\n.pos{background:var(--sea-bg);color:#245446}.neg{background:var(--owe-bg);color:var(--owe)}.zero{background:#ECEAE4;color:var(--muted)}\n.bal small{display:block;color:var(--muted);font-size:.82rem}\n.settle h3{font-size:1rem;margin:18px 0 6px;color:var(--harbour)}\n.tr{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:12px 14px;background:#F1EEE6;border-radius:10px;margin-top:8px}\n.tr .arrow{color:var(--signal);font-weight:700}\n.tr .amt{margin-left:auto}\n.even{background:var(--sea-bg);color:#245446;border-radius:10px;padding:12px 14px;font-weight:500;margin-top:8px}\n.foot{color:var(--muted);font-size:.85rem;text-align:center;margin-top:24px}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n</style>\n</head>\n<body>\n<header class=\"top\"><div class=\"wrap\">\n  <svg class=\"mark\" viewBox=\"0 0 40 40\" aria-hidden=\"true\"><circle cx=\"20\" cy=\"20\" r=\"19\" fill=\"#fff\" opacity=\".1\"/><path d=\"M8 24h24l-4 6H12z\" fill=\"#C2462B\"/><path d=\"M20 7v15M20 9l8 11h-8\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/></svg>\n  <div><h1>Even Keel</h1><p>Log who paid for what. See who owes whom. Everyone ends up even.</p></div>\n</div></header>\n\n<main data-testid=\"app\" class=\"wrap\">\n<div class=\"grid\">\n  <section class=\"card\" aria-labelledby=\"h-people\">\n    <h2 id=\"h-people\">Who's on the trip</h2>\n    <p class=\"lede\">Add everyone who's sharing costs.</p>\n    <form id=\"personForm\" novalidate>\n      <label for=\"pname\">Name</label>\n      <div class=\"row\">\n        <input class=\"grow\" id=\"pname\" type=\"text\" autocomplete=\"off\" data-testid=\"person-name\" aria-describedby=\"perr\">\n        <button class=\"primary\" type=\"submit\" data-testid=\"add-person\">Add person</button>\n      </div>\n      <div id=\"perr\" aria-live=\"polite\"></div>\n    </form>\n    <ul class=\"people\" id=\"people\"></ul>\n    <div id=\"peopleEmpty\"></div>\n  </section>\n\n  <section class=\"card\" aria-labelledby=\"h-add\">\n    <h2 id=\"h-add\">Add an expense</h2>\n    <p class=\"lede\">Split equally between the people you choose.</p>\n    <form id=\"expForm\" novalidate>\n      <div class=\"two\">\n        <div class=\"field\"><label for=\"edesc\">What was it for?</label>\n          <input id=\"edesc\" type=\"text\" placeholder=\"Groceries, gas, cabin…\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n        <div class=\"field\"><label for=\"eamt\">Amount (CAD)</label>\n          <input id=\"eamt\" type=\"text\" inputmode=\"decimal\" placeholder=\"0.00\" data-testid=\"expense-amount\" autocomplete=\"off\"></div>\n      </div>\n      <div class=\"field\"><label for=\"epayer\">Who paid?</label>\n        <select id=\"epayer\" data-testid=\"expense-payer\"></select></div>\n      <fieldset>\n        <legend class=\"legend\">Split between</legend>\n        <div class=\"splitbar\"><button type=\"button\" class=\"link\" id=\"selAll\">Everyone</button><button type=\"button\" class=\"link\" id=\"selNone\">No one</button></div>\n        <div class=\"split\" id=\"split\" data-testid=\"expense-split\"></div>\n      </fieldset>\n      <button class=\"primary\" type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n      <div id=\"eerr\" aria-live=\"polite\"></div>\n    </form>\n  </section>\n\n  <section class=\"card\" aria-labelledby=\"h-exp\">\n    <h2 id=\"h-exp\">Expenses</h2>\n    <p class=\"lede\" id=\"expTotal\">Newest first.</p>\n    <ul class=\"list\" id=\"expenses\"></ul>\n  </section>\n\n  <section class=\"card settle\" aria-labelledby=\"h-bal\">\n    <h2 id=\"h-bal\">Balances</h2>\n    <p class=\"lede\">Paid minus share. Owing is normal — it just means someone else covered you for now.</p>\n    <ul class=\"list\" id=\"balances\"></ul>\n    <h3>Settle up</h3>\n    <ul class=\"list\" id=\"transfers\"></ul>\n  </section>\n</div>\n<p class=\"foot\">Saved on this device automatically.</p>\n</main>\n\n<script>\n(function(){\nconst KEY='even-keel-v1';\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nlet state={people:[],expenses:[],nextId:1};\ntry{const s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=Object.assign(state,s);}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};\nconst $=id=>document.getElementById(id);\nconst el=(t,a={},...kids)=>{const n=document.createElement(t);for(const k in a){if(k==='text')n.textContent=a[k];else if(k==='class')n.className=a[k];else n.setAttribute(k,a[k]);}kids.forEach(c=>c&&n.append(c));return n;};\nconst initials=n=>n.split(/\\s+/).map(w=>w[0]).join('').slice(0,2).toUpperCase();\n\nfunction showErr(box,msg,input){\n  box.innerHTML='';\n  document.querySelectorAll('[aria-invalid]').forEach(i=>i.removeAttribute('aria-invalid'));\n  if(!msg)return;\n  box.append(el('p',{class:'error','data-testid':'form-error',role:'alert',text:msg}));\n  if(input){input.setAttribute('aria-invalid','true');input.focus();}\n}\n\nfunction shares(exp){\n  const order=state.people.filter(p=>exp.split.includes(p));\n  const n=order.length,base=Math.floor(exp.cents/n),rem=exp.cents-base*n;\n  const m={};order.forEach((p,i)=>m[p]=base+(i<rem?1:0));return m;\n}\nfunction balances(){\n  const b={};state.people.forEach(p=>b[p]=0);\n  state.expenses.forEach(e=>{if(b[e.payer]!==undefined)b[e.payer]+=e.cents;const s=shares(e);for(const p in s)b[p]-=s[p];});\n  return b;\n}\nfunction settle(b){\n  const cr=[],db=[];\n  state.people.forEach(p=>{if(b[p]>0)cr.push({p,v:b[p]});else if(b[p]<0)db.push({p,v:-b[p]});});\n  const out=[];let i=0,j=0;\n  while(i<db.length&&j<cr.length){\n    const v=Math.min(db[i].v,cr[j].v);\n    out.push({from:db[i].p,to:cr[j].p,cents:v});\n    db[i].v-=v;cr[j].v-=v;if(!db[i].v)i++;if(!cr[j].v)j++;\n  }\n  return out;\n}\n\nfunction render(){\n  // people\n  const pl=$('people');pl.innerHTML='';\n  state.people.forEach(p=>pl.append(el('li',{'data-testid':'person'},el('span',{class:'av','aria-hidden':'true',text:initials(p)}),el('span',{text:p}))));\n  $('peopleEmpty').innerHTML='';\n  if(!state.people.length)$('peopleEmpty').append(el('p',{class:'empty',text:'No one yet. Start with yourself, then add your travel companions.'}));\n  else if(state.people.length===1)$('peopleEmpty').append(el('p',{class:'empty',text:'Add at least one more person to start splitting.'}));\n\n  // payer & split (preserve selections)\n  const sel=$('epayer'),prev=sel.value;sel.innerHTML='';\n  if(!state.people.length)sel.append(el('option',{value:'',text:'Add people first'}));\n  state.people.forEach(p=>sel.append(el('option',{value:p,text:p})));\n  if(state.people.includes(prev))sel.value=prev;\n  const sp=$('split');\n  const known=new Set([...sp.querySelectorAll('input')].map(i=>i.value));\n  const checked=new Set([...sp.querySelectorAll('input:checked')].map(i=>i.value));\n  sp.innerHTML='';\n  if(!state.people.length)sp.append(el('p',{class:'empty',style:'margin:0',text:'People you add will appear here.'}));\n  state.people.forEach(p=>{\n    const cb=el('input',{type:'checkbox',value:p});\n    cb.checked=known.has(p)?checked.has(p):true;\n    sp.append(el('label',{class:'chk'},cb,el('span',{text:p})));\n  });\n\n  // expenses\n  const el2=$('expenses');el2.innerHTML='';\n  const total=state.expenses.reduce((s,e)=>s+e.cents,0);\n  $('expTotal').textContent=state.expenses.length?`${state.expenses.length} ${state.expenses.length===1?'expense':'expenses'}, ${money(total)} in total. Newest first.`:'Newest first.';\n  if(!state.expenses.length)el2.append(el('li',{class:'empty',text:state.people.length?'No expenses yet. When someone pays for something, add it here.':'Add the people on your trip, then log what each of you paid.'}));\n  [...state.expenses].reverse().forEach(e=>{\n    const everyone=state.people.length>1&&state.people.every(p=>e.split.includes(p));\n    const btn=el('button',{type:'button',class:'ghost','data-testid':'delete-expense','aria-label':`Remove ${e.desc}`,text:'Remove'});\n    btn.onclick=()=>{state.expenses=state.expenses.filter(x=>x.id!==e.id);save();render();$('h-exp').focus?.();};\n    el2.append(el('li',{class:'exp','data-testid':'expense'},\n      el('div',{class:'body'},el('div',{class:'desc',text:e.desc}),\n        el('div',{class:'meta',text:`${e.payer} paid · split between ${everyone?'everyone':e.split.join(', ')}`})),\n      el('span',{class:'amt',text:money(e.cents)}),btn));\n  });\n\n  // balances\n  const b=balances(),bl=$('balances');bl.innerHTML='';\n  if(!state.people.length)bl.append(el('li',{class:'empty',text:'Balances show up once people are on the trip.'}));\n  state.people.forEach(p=>{\n    const c=b[p];\n    const cls=c>0?'pos':c<0?'neg':'zero';\n    const note=c>0?'is owed':c<0?'owes':'is even';\n    bl.append(el('li',{class:'bal','data-testid':'balance','data-person':p,'data-cents':String(c)},\n      el('span',{},el('span',{text:p}),el('small',{text:note})),\n      el('span',{class:'pill '+cls,text:(c>0?'+':c<0?'−':'')+money(Math.abs(c))})));\n  });\n  const tl=$('transfers');tl.innerHTML='';\n  const ts=settle(b);\n  if(!ts.length)tl.append(el('li',{class:state.expenses.length?'even':'empty',text:state.expenses.length?'Everyone is even. Nothing to settle.':'Nothing to settle yet.'}));\n  ts.forEach(t=>tl.append(el('li',{class:'tr','data-testid':'transfer','data-from':t.from,'data-to':t.to,'data-cents':String(t.cents)},\n    el('strong',{text:t.from}),el('span',{class:'arrow','aria-hidden':'true',text:'→'}),el('span',{class:'sr',text:'pays'}),el('strong',{text:t.to}),el('span',{class:'amt',text:money(t.cents)}))));\n}\n\n$('personForm').addEventListener('submit',ev=>{\n  ev.preventDefault();const inp=$('pname'),name=inp.value.trim().replace(/\\s+/g,' ');\n  if(!name)return showErr($('perr'),'Enter a name to add someone.',inp);\n  if(state.people.some(p=>p.toLowerCase()===name.toLowerCase()))return showErr($('perr'),`${name} is already on the trip. Try a different name, like adding a last initial.`,inp);\n  state.people.push(name);save();showErr($('perr'),'');inp.value='';render();inp.focus();\n});\n\n$('selAll').onclick=()=>$('split').querySelectorAll('input').forEach(i=>i.checked=true);\n$('selNone').onclick=()=>$('split').querySelectorAll('input').forEach(i=>i.checked=false);\n\n$('expForm').addEventListener('submit',ev=>{\n  ev.preventDefault();const box=$('eerr');\n  const d=$('edesc'),a=$('eamt'),desc=d.value.trim(),raw=a.value.trim().replace(/[$,\\s]/g,'');\n  if(!state.people.length)return showErr(box,'Add the people on your trip first.',$('pname'));\n  if(!desc)return showErr(box,'Add a short description, like \"Groceries\".',d);\n  if(!raw)return showErr(box,'Enter the amount paid.',a);\n  if(!/^(\\d+(\\.\\d{0,2})?|\\.\\d{1,2})$/.test(raw))return showErr(box,'Enter the amount as a number with up to 2 decimal places, like 42.50.',a);\n  const [w,f='']=raw.split('.');const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(!(cents>0))return showErr(box,'The amount needs to be more than $0.00.',a);\n  if(!Number.isSafeInteger(cents))return showErr(box,'That amount is too large.',a);\n  const payer=$('epayer').value;\n  if(!state.people.includes(payer))return showErr(box,'Choose who paid.',$('epayer'));\n  const split=[...$('split').querySelectorAll('input:checked')].map(i=>i.value).filter(p=>state.people.includes(p));\n  if(!split.length)return showErr(box,'Choose at least one person to split this with.',$('split').querySelector('input'));\n  state.expenses.push({id:state.nextId++,desc,cents,payer,split});save();showErr(box,'');\n  d.value='';a.value='';$('split').querySelectorAll('input').forEach(i=>i.checked=true);render();d.focus();\n});\n\n$('h-exp').tabIndex=-1;\nrender();\n})();\n</script>\n</body>\n</html>"
    }

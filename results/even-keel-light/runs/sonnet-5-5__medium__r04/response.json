  "content": [
    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel — trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;--harbour-2:#2E5570;--signal:#C2462B;--signal-d:#A53820;\n  --paper:#F5F1E8;--card:#FFFFFF;--ink:#16242E;--muted:#506270;--line:#D9D3C4;\n  --owed:#1C6B4A;--owe:#A53820;--tint:#E8EEF1;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 \"Public Sans\",system-ui,sans-serif}\nheader.top{background:var(--harbour);color:#fff;padding:20px 16px 22px;border-bottom:4px solid var(--signal)}\n.wrap{max-width:1040px;margin:0 auto}\n.brand{display:flex;align-items:center;gap:12px}\n.brand svg{flex:none}\nh1{font-family:Fraunces,Georgia,serif;font-weight:700;font-size:1.7rem;margin:0;letter-spacing:-.01em;line-height:1.1}\n.tag{margin:2px 0 0;color:#D3DEE5;font-size:.95rem}\nmain{max-width:1040px;margin:0 auto;padding:20px 16px 48px;display:grid;gap:20px;grid-template-columns:1fr}\n@media(min-width:860px){main{grid-template-columns:1fr 1fr;align-items:start}.col{display:grid;gap:20px}}\n.col{display:grid;gap:20px;min-width:0}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}\nh2{font-family:Fraunces,Georgia,serif;font-size:1.3rem;margin:0 0 12px;color:var(--harbour);line-height:1.2}\nlabel,.lbl{display:block;font-weight:600;font-size:.9rem;margin:0 0 4px;color:var(--ink)}\ninput[type=text],input[type=number],input:not([type]),select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #7B8A94;border-radius:6px;background:#fff;color:var(--ink);min-height:44px}\n.field{margin-bottom:12px}\n.row{display:flex;gap:8px;align-items:flex-end}\n.row .field{flex:1;margin:0;min-width:0}\nbutton{font:inherit;font-weight:600;min-height:44px;padding:8px 16px;border-radius:6px;border:2px solid var(--harbour);background:var(--harbour);color:#fff;cursor:pointer}\nbutton:hover{background:var(--harbour-2);border-color:var(--harbour-2)}\nbutton.primary{background:var(--signal);border-color:var(--signal)}\nbutton.primary:hover{background:var(--signal-d);border-color:var(--signal-d)}\nbutton.ghost{background:transparent;color:var(--harbour);border-color:var(--line);min-height:36px;padding:4px 12px;font-size:.9rem}\nbutton.ghost:hover{background:var(--tint);border-color:var(--harbour)}\n:focus-visible{outline:3px solid #E58A00;outline-offset:2px}\nheader :focus-visible{outline-color:#fff}\n.err{margin:8px 0 0;padding:8px 12px;background:#FBE9E4;border-left:4px solid var(--signal);color:#7A220F;font-weight:500;border-radius:4px}\n.err:empty{display:none}\nul{list-style:none;margin:0;padding:0}\n.people{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}\n.people li{background:var(--tint);color:var(--harbour);padding:6px 14px;border-radius:99px;font-weight:600;overflow-wrap:anywhere}\n.empty{color:var(--muted);margin:12px 0 0;padding:14px;border:1.5px dashed var(--line);border-radius:8px;background:#FBFAF6}\nfieldset{border:0;margin:0 0 12px;padding:0;min-width:0}\nlegend{padding:0;font-weight:600;font-size:.9rem;margin-bottom:4px}\n.split{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:6px}\n.split label{display:flex;align-items:center;gap:8px;font-weight:500;margin:0;padding:6px 10px;border:1.5px solid var(--line);border-radius:6px;min-height:44px;cursor:pointer;overflow-wrap:anywhere}\n.split input{width:20px;height:20px;accent-color:var(--harbour);flex:none}\n.exp{border-top:1px solid var(--line);padding:12px 0;display:flex;gap:12px;justify-content:space-between;align-items:flex-start}\n.exp:first-child{border-top:0}\n.exp .d{font-weight:700;overflow-wrap:anywhere}\n.exp .m{color:var(--muted);font-size:.9rem;overflow-wrap:anywhere}\n.amt{font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}\n.exp .r{display:flex;flex-direction:column;align-items:flex-end;gap:6px}\n.bal{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line);align-items:center}\n.bal:first-child{border-top:0}\n.bal .n{font-weight:600;overflow-wrap:anywhere}\n.bal .s{display:block;font-size:.85rem;font-weight:500;color:var(--muted)}\n.pos{color:var(--owed)}.neg{color:var(--owe)}.zero{color:var(--muted)}\n.bal .amt{text-align:right}\n.tr{display:flex;align-items:center;gap:10px;padding:12px;margin-bottom:8px;background:var(--tint);border-radius:8px;border-left:5px solid var(--signal);flex-wrap:wrap;justify-content:space-between}\n.tr .t{overflow-wrap:anywhere;min-width:0;flex:1 1 180px}\n.note{color:var(--muted);font-size:.9rem;margin:0 0 10px}\n</style>\n</head>\n<body>\n<header class=\"top\"><div class=\"wrap brand\">\n<svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" aria-hidden=\"true\"><circle cx=\"20\" cy=\"20\" r=\"19\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"/><path d=\"M6 22h28\" stroke=\"#C2462B\" stroke-width=\"3\"/><path d=\"M20 8v14M20 22l-7 9h14z\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>\n<div><h1>Even Keel</h1><p class=\"tag\">Share the costs. Owing a friend is normal, so let’s keep it level.</p></div>\n</div></header>\n\n<main data-testid=\"app\">\n<div class=\"col\">\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People on this trip</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\"><div class=\"field\"><label for=\"pname\">Name</label><input id=\"pname\" type=\"text\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" data-testid=\"add-person\">Add person</button></div>\n<div id=\"perr\" role=\"alert\"></div>\n</form>\n<div id=\"plist\"></div>\n</section>\n\n<section aria-labelledby=\"h-add\">\n<h2 id=\"h-add\">Log an expense</h2>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"edesc\">What was it for?</label><input id=\"edesc\" type=\"text\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"eamt\">Amount (CAD)</label><input id=\"eamt\" type=\"text\" inputmode=\"decimal\" data-testid=\"expense-amount\" autocomplete=\"off\" placeholder=\"0.00\"></div>\n<div class=\"field\"><label for=\"epayer\">Who paid?</label><select id=\"epayer\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend>Split between</legend><div class=\"split\" id=\"esplit\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n<div id=\"eerr\" role=\"alert\"></div>\n</form>\n</section>\n</div>\n\n<div class=\"col\">\n<section aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<div id=\"blist\"></div>\n</section>\n<section aria-labelledby=\"h-set\">\n<h2 id=\"h-set\">Settle up</h2>\n<div id=\"slist\"></div>\n</section>\n<section aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Expenses</h2>\n<div id=\"xlist\"></div>\n</section>\n</div>\n</main>\n\n<script>\n(function(){\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nconst KEY='evenkeel.v1';\nlet state={people:[],expenses:[],nid:1};\ntry{const s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=Object.assign(state,s)}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction showErr(id,msg){const el=$(id);el.innerHTML=msg?'<p class=\"err\" data-testid=\"form-error\">'+esc(msg)+'</p>':''}\n\nfunction shares(e){\n  const order=state.people.map(p=>p.name).filter(n=>e.split.includes(n));\n  const k=order.length,base=Math.floor(e.cents/k),rem=e.cents-base*k;\n  const out={};order.forEach((n,i)=>out[n]=base+(i<rem?1:0));return out;\n}\nfunction balances(){\n  const b={};state.people.forEach(p=>b[p.name]=0);\n  state.expenses.forEach(e=>{\n    if(b[e.payer]!==undefined)b[e.payer]+=e.cents;\n    const s=shares(e);for(const n in s)b[n]-=s[n];\n  });\n  return b;\n}\nfunction transfers(b){\n  const cr=[],db=[];\n  state.people.forEach(p=>{const v=b[p.name];if(v>0)cr.push({n:p.name,v});else if(v<0)db.push({n:p.name,v:-v})});\n  const out=[];\n  cr.sort((a,b)=>b.v-a.v);db.sort((a,b)=>b.v-a.v);\n  let i=0,j=0;\n  while(i<cr.length&&j<db.length){\n    const m=Math.min(cr[i].v,db[j].v);\n    out.push({from:db[j].n,to:cr[i].n,c:m});\n    cr[i].v-=m;db[j].v-=m;\n    if(!cr[i].v)i++;if(!db[j].v)j++;\n  }\n  return out;\n}\n\nfunction renderPeople(){\n  const el=$('plist');\n  el.innerHTML=state.people.length?'<ul class=\"people\">'+state.people.map(p=>'<li data-testid=\"person\">'+esc(p.name)+'</li>').join('')+'</ul>':'<p class=\"empty\">No one is on the trip yet. Add the first name above to get started.</p>';\n}\nfunction renderForm(){\n  const sel=$('epayer'),prevP=sel.value;\n  const checked=new Set([...document.querySelectorAll('#esplit input:checked')].map(i=>i.value));\n  const had=new Set([...document.querySelectorAll('#esplit input')].map(i=>i.value));\n  if(!state.people.length){sel.innerHTML='<option value=\"\">Add people first</option>';$('esplit').innerHTML='<p class=\"note\">Everyone you add will appear here.</p>';return}\n  sel.innerHTML=state.people.map(p=>'<option value=\"'+esc(p.name)+'\">'+esc(p.name)+'</option>').join('');\n  if(state.people.some(p=>p.name===prevP))sel.value=prevP;\n  $('esplit').innerHTML=state.people.map((p,i)=>'<label><input type=\"checkbox\" value=\"'+esc(p.name)+'\"'+((!had.has(p.name)||checked.has(p.name))?' checked':'')+'> <span>'+esc(p.name)+'</span></label>').join('');\n}\nfunction renderExpenses(){\n  const el=$('xlist');\n  if(!state.expenses.length){el.innerHTML='<p class=\"empty\">No expenses yet. When someone pays for something, log it here and Even Keel will do the sums.</p>';return}\n  el.innerHTML='<ul>'+state.expenses.slice().reverse().map(e=>{\n    const s=shares(e);\n    return '<li class=\"exp\" data-testid=\"expense\"><div><div class=\"d\">'+esc(e.desc)+'</div><div class=\"m\">Paid by '+esc(e.payer)+' · Split between '+Object.keys(s).map(esc).join(', ')+'</div></div><div class=\"r\"><span class=\"amt\">'+money(e.cents)+'</span><button type=\"button\" class=\"ghost\" data-testid=\"delete-expense\" data-id=\"'+e.id+'\" aria-label=\"Remove '+esc(e.desc)+'\">Remove</button></div></li>';\n  }).join('')+'</ul>';\n}\nfunction renderBalances(){\n  const b=balances(),bel=$('blist'),sel=$('slist');\n  if(!state.people.length){bel.innerHTML='<p class=\"empty\">Balances appear once people are on the trip.</p>';sel.innerHTML='<p class=\"empty\">Nothing to settle yet.</p>';return}\n  bel.innerHTML=state.people.map(p=>{\n    const v=b[p.name],cls=v>0?'pos':v<0?'neg':'zero';\n    const txt=v>0?'is owed':v<0?'owes':'is all square';\n    return '<div class=\"bal\" data-testid=\"balance\" data-person=\"'+esc(p.name)+'\" data-cents=\"'+v+'\"><span class=\"n\">'+esc(p.name)+'<span class=\"s\">'+txt+'</span></span><span class=\"amt '+cls+'\">'+(v>0?'+':v<0?'−':'')+money(Math.abs(v))+'</span></div>';\n  }).join('');\n  const t=transfers(b);\n  if(!t.length){sel.innerHTML='<p class=\"empty\">'+(state.expenses.length?'Everyone is even. Nothing to pay back.':'No transfers needed yet. Log an expense to see who pays whom.')+'</p>';return}\n  sel.innerHTML='<p class=\"note\">'+t.length+' payment'+(t.length>1?'s':'')+' will bring everyone level.</p>'+t.map(x=>'<div class=\"tr\" data-testid=\"transfer\" data-from=\"'+esc(x.from)+'\" data-to=\"'+esc(x.to)+'\" data-cents=\"'+x.c+'\"><span class=\"t\"><strong>'+esc(x.from)+'</strong> pays <strong>'+esc(x.to)+'</strong></span><span class=\"amt\">'+money(x.c)+'</span></div>').join('');\n}\nfunction render(){renderPeople();renderForm();renderExpenses();renderBalances()}\n\n$('pf').addEventListener('submit',e=>{\n  e.preventDefault();\n  const name=$('pname').value.trim();\n  if(!name)return showErr('perr','Enter a name to add someone.');\n  if(state.people.some(p=>p.name.toLowerCase()===name.toLowerCase()))return showErr('perr','“'+name+'” is already on the trip. Names must be different, ignoring capitals.');\n  state.people.push({name});save();showErr('perr','');$('pname').value='';render();$('pname').focus();\n});\n$('pname').addEventListener('input',()=>showErr('perr',''));\n\n$('ef').addEventListener('submit',e=>{\n  e.preventDefault();\n  const desc=$('edesc').value.trim(),raw=$('eamt').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  const payer=$('epayer').value;\n  const split=[...document.querySelectorAll('#esplit input:checked')].map(i=>i.value);\n  let m;\n  if(!state.people.length)return showErr('eerr','Add at least one person before logging an expense.');\n  if(!desc)return showErr('eerr','Add a description so everyone knows what this was for.');\n  if(!raw)return showErr('eerr','Enter the amount in Canadian dollars.');\n  if(!/^(\\d+(\\.\\d{0,2})?|\\.\\d{1,2})$/.test(raw)){\n    return showErr('eerr',/^\\d*\\.\\d{3,}$/.test(raw)?'The amount can have at most 2 decimal places.':'Enter the amount as a number, like 42.50.');\n  }\n  const cents=Math.round(parseFloat(raw)*100);\n  if(!(cents>0))return showErr('eerr','The amount must be greater than $0.00.');\n  if(!payer)return showErr('eerr','Choose who paid.');\n  if(!split.length)return showErr('eerr','Choose at least one person to split this between.');\n  state.expenses.push({id:state.nid++,desc,cents,payer,split});save();\n  showErr('eerr','');$('edesc').value='';$('eamt').value='';\n  document.querySelectorAll('#esplit input').forEach(i=>i.checked=true);\n  render();$('edesc').focus();\n});\n$('xlist').addEventListener('click',e=>{\n  const b=e.target.closest('[data-testid=delete-expense]');if(!b)return;\n  state.expenses=state.expenses.filter(x=>String(x.id)!==b.dataset.id);save();render();\n  $('edesc').focus();\n});\nrender();\n})();\n</script>\n</body>\n</html>"
    }

      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel — split trip costs fairly</title>\n<meta name=\"description\" content=\"Add the people on your trip, log who paid for what, and see who owes whom so everyone ends up even.\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --harbour:#1F3A4D;\n    --harbour-deep:#15293A;\n    --harbour-tint:#E6EDF2;\n    --signal:#C2462B;\n    --signal-deep:#A8381F;\n    --signal-tint:#F8E7E1;\n    --paper:#F6F3EE;\n    --card:#FFFFFF;\n    --line:#D9D3C9;\n    --line-soft:#EAE6DF;\n    --ink:#1A2430;\n    --ink-soft:#56616B;\n    --owed:#2C6B5A;\n    --owed-tint:#E4F0EB;\n    --radius:10px;\n    --shadow:0 1px 2px rgba(31,58,77,.06), 0 6px 20px -12px rgba(31,58,77,.25);\n    --sans:\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    --serif:\"Fraunces\", Georgia, \"Times New Roman\", serif;\n  }\n  *{box-sizing:border-box}\n  html{-webkit-text-size-adjust:100%}\n  body{\n    margin:0;\n    font-family:var(--sans);\n    font-size:16px;\n    line-height:1.5;\n    color:var(--ink);\n    background:var(--paper);\n    background-image:linear-gradient(180deg, #EEF2F4 0, var(--paper) 260px);\n  }\n  :focus-visible{outline:3px solid var(--signal);outline-offset:3px;border-radius:4px}\n  .skip{position:absolute;left:-999px;top:8px;background:var(--harbour);color:#fff;padding:.5rem .75rem;border-radius:6px;z-index:10}\n  .skip:focus{left:8px}\n\n  .wrap{width:min(1120px, 100% - 2rem);margin:0 auto}\n\n  header.site{\n    padding:1.75rem 0 1.25rem;\n    display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:.75rem 1.5rem;\n  }\n  .brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;color:var(--harbour)}\n  .brand svg{flex:none}\n  .brand h1{font-family:var(--serif);font-weight:600;font-size:1.75rem;line-height:1;margin:0;letter-spacing:-.01em}\n  .tag{margin:0;color:var(--ink-soft);font-size:.95rem;max-width:34ch}\n\n  main{display:grid;gap:1.25rem;padding-bottom:1rem}\n  @media (min-width: 900px){\n    main{grid-template-columns:5fr 7fr;align-items:start;gap:1.5rem}\n    .col{display:grid;gap:1.5rem}\n  }\n  .col{display:grid;gap:1.25rem}\n\n  section.card{\n    background:var(--card);\n    border:1px solid var(--line);\n    border-radius:var(--radius);\n    box-shadow:var(--shadow);\n    padding:1.25rem;\n  }\n  @media (min-width:600px){section.card{padding:1.5rem}}\n  .card-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1rem}\n  .card-head h2{font-family:var(--serif);font-weight:600;font-size:1.35rem;margin:0;color:var(--harbour);letter-spacing:-.005em}\n  .step{font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--signal);display:block;margin-bottom:.15rem}\n  .count{color:var(--ink-soft);font-size:.9rem;white-space:nowrap}\n  .lead{margin:0 0 1rem;color:var(--ink-soft);font-size:.95rem}\n\n  label{display:block;font-weight:500;font-size:.925rem;margin-bottom:.35rem;color:var(--ink)}\n  .hint{font-weight:400;color:var(--ink-soft)}\n  input[type=text], select{\n    width:100%;\n    font:inherit;\n    padding:.65rem .8rem;\n    border:1px solid #B9B2A6;\n    border-radius:8px;\n    background:#fff;\n    color:var(--ink);\n    min-height:46px;\n  }\n  input[type=text]:hover, select:hover{border-color:#8E9AA4}\n  input[aria-invalid=\"true\"]{border-color:var(--signal);box-shadow:inset 0 0 0 1px var(--signal)}\n  .field{margin-bottom:1rem}\n  .row{display:flex;gap:.6rem;align-items:flex-end;flex-wrap:wrap}\n  .row .grow{flex:1 1 180px}\n  .amount-wrap{position:relative}\n  .amount-wrap input{padding-left:1.6rem;font-variant-numeric:tabular-nums}\n  .amount-wrap .cur{position:absolute;left:.8rem;top:50%;transform:translateY(-50%);color:var(--ink-soft);pointer-events:none}\n  @media (min-width:480px){.two{display:grid;grid-template-columns:1fr 1fr;gap:1rem}}\n\n  .btn{\n    font:inherit;font-weight:600;font-size:.95rem;\n    padding:.7rem 1.1rem;min-height:46px;\n    border-radius:8px;border:1px solid transparent;\n    cursor:pointer;white-space:nowrap;\n    transition:background .15s, transform .05s;\n  }\n  .btn:active{transform:translateY(1px)}\n  .btn-primary{background:var(--harbour);color:#fff}\n  .btn-primary:hover{background:var(--harbour-deep)}\n  .btn-wide{width:100%}\n  .btn-quiet{background:transparent;color:var(--harbour);border-color:#B9B2A6;min-height:34px;padding:.3rem .7rem;font-size:.85rem;font-weight:500}\n  .btn-quiet:hover{background:var(--harbour-tint)}\n  .btn-remove{background:transparent;color:var(--ink-soft);border:1px solid transparent;padding:.35rem .6rem;min-height:36px;font-size:.85rem;font-weight:500;border-radius:6px}\n  .btn-remove:hover{color:var(--signal-deep);background:var(--signal-tint);border-color:#E9C9BF}\n\n  .error{\n    display:flex;gap:.5rem;align-items:flex-start;\n    margin:.6rem 0 0;padding:.6rem .8rem;\n    background:var(--signal-tint);border-left:3px solid var(--signal);border-radius:6px;\n    color:var(--signal-deep);font-size:.925rem;\n  }\n  .error svg{flex:none;margin-top:.2rem}\n\n  ul.plain{list-style:none;margin:0;padding:0}\n  .people li{display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-top:1px solid var(--line-soft)}\n  .people li:first-child{border-top:0}\n  .avatar{\n    flex:none;width:36px;height:36px;border-radius:50%;\n    display:grid;place-items:center;\n    background:var(--harbour-tint);color:var(--harbour);\n    font-weight:600;font-size:.85rem;letter-spacing:.02em;\n  }\n  .people .name{font-weight:500;flex:1;min-width:0;overflow-wrap:anywhere}\n  .people .meta{color:var(--ink-soft);font-size:.85rem;white-space:nowrap}\n\n  .split{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.35rem}\n  .chip{\n    display:inline-flex;align-items:center;gap:.45rem;\n    margin:0;padding:.45rem .8rem .45rem .6rem;\n    border:1px solid #B9B2A6;border-radius:999px;background:#fff;\n    font-weight:500;font-size:.9rem;cursor:pointer;user-select:none;\n  }\n  .chip:hover{border-color:var(--harbour)}\n  .chip:has(input:checked){background:var(--harbour);color:#fff;border-color:var(--harbour)}\n  .chip input{width:18px;height:18px;margin:0;accent-color:var(--signal);cursor:pointer}\n  .chip:has(input:focus-visible){outline:3px solid var(--signal);outline-offset:2px}\n  .chip input:focus-visible{outline:none}\n  .split-tools{display:flex;gap:.4rem;margin-top:.6rem}\n\n  .empty{\n    margin:0;padding:1.1rem 1rem;\n    border:1px dashed #C4BDB1;border-radius:8px;\n    color:var(--ink-soft);font-size:.95rem;text-align:center;\n    background:#FBFAF7;\n  }\n  .empty strong{color:var(--harbour);font-weight:600}\n\n  .expenses li{display:grid;grid-template-columns:1fr auto;gap:.2rem .75rem;padding:.9rem 0;border-top:1px solid var(--line-soft)}\n  .expenses li:first-child{border-top:0;padding-top:0}\n  .expenses .desc{font-weight:600;overflow-wrap:anywhere}\n  .expenses .amt{font-family:var(--serif);font-weight:600;font-size:1.15rem;color:var(--harbour);font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}\n  .expenses .who{grid-column:1;color:var(--ink-soft);font-size:.9rem}\n  .expenses .who b{color:var(--ink);font-weight:500}\n  .expenses .act{grid-column:2;grid-row:2;justify-self:end;align-self:start}\n\n  .balances li{display:flex;align-items:center;gap:.75rem;padding:.65rem 0;border-top:1px solid var(--line-soft)}\n  .balances li:first-child{border-top:0}\n  .balances .name{flex:1;min-width:0;font-weight:500;overflow-wrap:anywhere}\n  .balances .status{font-size:.85rem;color:var(--ink-soft)}\n  .balances .val{font-family:var(--serif);font-weight:600;font-size:1.15rem;font-variant-numeric:tabular-nums;white-space:nowrap;padding:.1rem .55rem;border-radius:6px}\n  .val.pos{color:var(--owed);background:var(--owed-tint)}\n  .val.neg{color:var(--harbour);background:var(--harbour-tint)}\n  .val.zero{color:var(--ink-soft);background:#F1EEE8}\n  .bar{height:4px;border-radius:2px;background:var(--line-soft);flex:0 0 72px;position:relative;overflow:hidden}\n  .bar i{position:absolute;top:0;bottom:0;background:var(--owed)}\n  .bar i.n{background:var(--harbour)}\n\n  .transfers li{\n    display:grid;grid-template-columns:1fr auto 1fr auto;align-items:center;gap:.5rem .6rem;\n    padding:.75rem .85rem;margin-top:.5rem;\n    background:var(--paper);border:1px solid var(--line-soft);border-radius:8px;\n  }\n  .transfers li:first-child{margin-top:0}\n  .transfers .from,.transfers .to{font-weight:500;min-width:0;overflow-wrap:anywhere}\n  .transfers .to{text-align:left}\n  .transfers .arrow{color:var(--signal);display:flex}\n  .transfers .amt{font-family:var(--serif);font-weight:600;font-size:1.1rem;color:var(--harbour);font-variant-numeric:tabular-nums;white-space:nowrap}\n  @media (max-width:420px){\n    .transfers li{grid-template-columns:1fr auto 1fr}\n    .transfers .amt{grid-column:1 / -1;border-top:1px solid var(--line-soft);padding-top:.4rem;margin-top:.1rem}\n  }\n  .settle-note{margin:.9rem 0 0;color:var(--ink-soft);font-size:.875rem}\n  .even{\n    display:flex;gap:.75rem;align-items:center;padding:1rem;\n    background:var(--owed-tint);border-radius:8px;color:var(--owed);font-weight:500;\n  }\n  .even svg{flex:none}\n\n  footer.site{padding:1.5rem 0 2.5rem;display:flex;flex-wrap:wrap;justify-content:space-between;gap:.75rem;align-items:center;color:var(--ink-soft);font-size:.875rem}\n  footer p{margin:0}\n  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#app\">Skip to the app</a>\n<div class=\"wrap\">\n  <header class=\"site\">\n    <a class=\"brand\" href=\"#app\" aria-label=\"Even Keel, home\">\n      <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" aria-hidden=\"true\">\n        <circle cx=\"17\" cy=\"17\" r=\"16\" fill=\"#1F3A4D\"/>\n        <path d=\"M6 20 Q17 14 28 20\" stroke=\"#F6F3EE\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M17 7 V20\" stroke=\"#F6F3EE\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>\n        <circle cx=\"17\" cy=\"25\" r=\"2.4\" fill=\"#C2462B\"/>\n      </svg>\n      <h1>Even Keel</h1>\n    </a>\n    <p class=\"tag\">Log what each of you paid. See who owes whom. End the trip even.</p>\n  </header>\n\n  <main id=\"app\" data-testid=\"app\">\n    <div class=\"col\">\n      <section class=\"card\" aria-labelledby=\"people-h\">\n        <div class=\"card-head\">\n          <h2 id=\"people-h\"><span class=\"step\">Step 1</span>Who’s on the trip</h2>\n          <span class=\"count\" id=\"people-count\"></span>\n        </div>\n        <form id=\"person-form\" novalidate>\n          <div class=\"row\">\n            <div class=\"grow\">\n              <label for=\"person-name\">Name</label>\n              <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" maxlength=\"40\" placeholder=\"e.g. Ana\">\n            </div>\n            <button type=\"submit\" class=\"btn btn-primary\" data-testid=\"add-person\">Add person</button>\n          </div>\n          <div id=\"person-error\" aria-live=\"polite\"></div>\n        </form>\n        <ul class=\"plain people\" id=\"people-list\" style=\"margin-top:1rem\"></ul>\n      </section>\n\n      <section class=\"card\" aria-labelledby=\"expense-h\">\n        <div class=\"card-head\">\n          <h2 id=\"expense-h\"><span class=\"step\">Step 2</span>Log an expense</h2>\n        </div>\n        <form id=\"expense-form\" novalidate>\n          <div class=\"two\">\n            <div class=\"field\">\n              <label for=\"expense-desc\">What was it for?</label>\n              <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\" maxlength=\"80\" placeholder=\"e.g. Ferry tickets\">\n            </div>\n            <div class=\"field\">\n              <label for=\"expense-amount\">Amount <span class=\"hint\">(CAD)</span></label>\n              <div class=\"amount-wrap\">\n                <span class=\"cur\" aria-hidden=\"true\">$</span>\n                <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"0.00\">\n              </div>\n            </div>\n          </div>\n          <div class=\"field\">\n            <label for=\"expense-payer\">Who paid?</label>\n            <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n          </div>\n          <fieldset class=\"field\" style=\"border:0;padding:0;margin:0 0 1rem;min-width:0\">\n            <legend style=\"padding:0\"><label as=\"span\" style=\"margin-bottom:.35rem\" id=\"split-label\">Split between <span class=\"hint\">(everyone by default)</span></label></legend>\n            <div class=\"split\" id=\"expense-split\" data-testid=\"expense-split\" role=\"group\" aria-labelledby=\"split-label\"></div>\n            <div class=\"split-tools\" id=\"split-tools\" hidden>\n              <button type=\"button\" class=\"btn btn-quiet\" id=\"split-all\">Everyone</button>\n              <button type=\"button\" class=\"btn btn-quiet\" id=\"split-none\">No one</button>\n            </div>\n          </fieldset>\n          <button type=\"submit\" class=\"btn btn-primary btn-wide\" data-testid=\"add-expense\">Add expense</button>\n          <div id=\"expense-error\" aria-live=\"polite\"></div>\n        </form>\n      </section>\n    </div>\n\n    <div class=\"col\">\n      <section class=\"card\" aria-labelledby=\"expenses-h\">\n        <div class=\"card-head\">\n          <h2 id=\"expenses-h\">Expenses</h2>\n          <span class=\"count\" id=\"expenses-total\"></span>\n        </div>\n        <ul class=\"plain expenses\" id=\"expenses-list\"></ul>\n      </section>\n\n      <section class=\"card\" aria-labelledby=\"balances-h\">\n        <div class=\"card-head\">\n          <h2 id=\"balances-h\"><span class=\"step\">Step 3</span>Where everyone stands</h2>\n        </div>\n        <p class=\"lead\">Each balance is what you paid minus your share of the costs. Being owed or owing a bit is just how trips go.</p>\n        <ul class=\"plain balances\" id=\"balances-list\"></ul>\n      </section>\n\n      <section class=\"card\" aria-labelledby=\"settle-h\">\n        <div class=\"card-head\">\n          <h2 id=\"settle-h\">Settle up</h2>\n          <span class=\"count\" id=\"settle-count\"></span>\n        </div>\n        <ul class=\"plain transfers\" id=\"transfers-list\"></ul>\n        <p class=\"settle-note\" id=\"settle-note\" hidden>These are the fewest transfers we could find to get everyone to zero. Pay by e-transfer, cash, or a round of drinks — your call.</p>\n      </section>\n    </div>\n  </main>\n\n  <footer class=\"site\">\n    <p>Everything is saved on this device only.</p>\n    <button type=\"button\" class=\"btn btn-quiet\" id=\"reset-trip\">Start a new trip</button>\n  </footer>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  var STORAGE_KEY = 'evenkeel.trip.v1';\n  var fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  var money = function (cents) { return fmt.format(cents / 100); };\n\n  var state = load();\n\n  function load() {\n    try {\n      var raw = localStorage.getItem(STORAGE_KEY);\n      if (raw) {\n        var s = JSON.parse(raw);\n        if (s && Array.isArray(s.people) && Array.isArray(s.expenses)) {\n          s.nextId = s.nextId || (s.expenses.length + 1);\n          return s;\n        }\n      }\n    } catch (e) { /* fall through to a fresh trip */ }\n    return { people: [], expenses: [], nextId: 1 };\n  }\n  function save() {\n    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) { /* storage unavailable; keep going in memory */ }\n  }\n\n  // ---------- helpers ----------\n  var $ = function (id) { return document.getElementById(id); };\n  function esc(s) {\n    return String(s).replace(/[&<>\"']/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c];\n    });\n  }\n  function initials(name) {\n    var parts = name.split(/\\s+/).filter(Boolean);\n    var s = parts.length > 1 ? parts[0][0] + parts[parts.length - 1][0] : name.slice(0, 2);\n    return s.toUpperCase();\n  }\n  function errorHTML(msg) {\n    return '<p class=\"error\" data-testid=\"form-error\" id=\"err-msg-' + (++errSeq) + '\">' +\n      '<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M8 4.5v4.2M8 11.2v.4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>' +\n      '<span>' + esc(msg) + '</span></p>';\n  }\n  var errSeq = 0;\n  function showError(container, input, msg) {\n    container.innerHTML = errorHTML(msg);\n    var p = container.firstElementChild;\n    if (input) {\n      input.setAttribute('aria-invalid', 'true');\n      input.setAttribute('aria-describedby', p.id);\n      input.focus();\n    }\n  }\n  function clearError(container, inputs) {\n    container.innerHTML = '';\n    inputs.forEach(function (i) { i.removeAttribute('aria-invalid'); i.removeAttribute('aria-describedby'); });\n  }\n\n  // Parse a dollar string into integer cents. Returns {cents} or {error}.\n  function parseAmount(str) {\n    var s = String(str).trim().replace(/^\\$/, '').replace(/,/g, '').trim();\n    if (s === '') return { error: 'Enter an amount.' };\n    if (!/^(\\d+(\\.\\d*)?|\\.\\d+)$/.test(s)) return { error: 'Enter the amount as a number, like 42.50.' };\n    var parts = s.split('.');\n    var frac = parts[1] || '';\n    if (frac.length > 2) return { error: 'Amounts can have at most 2 decimal places (cents).' };\n    var cents = parseInt(parts[0] || '0', 10) * 100 + parseInt((frac + '00').slice(0, 2), 10);\n    if (!isFinite(cents) || cents > 1e13) return { error: 'That amount is too large.' };\n    if (cents <= 0) return { error: 'The amount has to be more than $0.00.' };\n    return { cents: cents };\n  }\n\n  // Shares in integer cents. Leftover cents go one each, in trip order.\n  function sharesFor(exp) {\n    var order = state.people.map(function (p) { return p.name; })\n      .filter(function (n) { return exp.split.indexOf(n) !== -1; });\n    var n = order.length, out = {};\n    if (!n) return out;\n    var base = Math.floor(exp.cents / n), rem = exp.cents - base * n;\n    order.forEach(function (name, i) { out[name] = base + (i < rem ? 1 : 0); });\n    return out;\n  }\n\n  function balances() {\n    var bal = {};\n    state.people.forEach(function (p) { bal[p.name] = 0; });\n    state.expenses.forEach(function (e) {\n      if (bal.hasOwnProperty(e.payer)) bal[e.payer] += e.cents;\n      var sh = sharesFor(e);\n      Object.keys(sh).forEach(function (n) { bal[n] -= sh[n]; });\n    });\n    return bal;\n  }\n\n  function settle(bal) {\n    var cred = [], debt = [];\n    Object.keys(bal).forEach(function (n) {\n      if (bal[n] > 0) cred.push({ name: n, amt: bal[n] });\n      else if (bal[n] < 0) debt.push({ name: n, amt: -bal[n] });\n    });\n    cred.sort(function (a, b) { return b.amt - a.amt; });\n    debt.sort(function (a, b) { return b.amt - a.amt; });\n    var out = [], i = 0, j = 0;\n    while (i < debt.length && j < cred.length) {\n      var x = Math.min(debt[i].amt, cred[j].amt);\n      out.push({ from: debt[i].name, to: cred[j].name, cents: x });\n      debt[i].amt -= x; cred[j].amt -= x;\n      if (debt[i].amt === 0) i++;\n      if (cred[j].amt === 0) j++;\n    }\n    return out;\n  }\n\n  // ---------- rendering ----------\n  function renderPeople() {\n    var list = $('people-list');\n    var count = $('people-count');\n    if (!state.people.length) {\n      count.textContent = '';\n      list.innerHTML = '<li><p class=\"empty\" style=\"width:100%\"><strong>No one’s here yet.</strong><br>Add the first person — probably you.</p></li>';\n      list.firstElementChild.style.cssText = 'display:block;border:0;padding:0';\n      return;\n    }\n    count.textContent = state.people.length + (state.people.length === 1 ? ' person' : ' people');\n    list.innerHTML = state.people.map(function (p) {\n      var paid = state.expenses.filter(function (e) { return e.payer === p.name; }).length;\n      var meta = paid ? 'paid for ' + paid + (paid === 1 ? ' thing' : ' things') : 'nothing paid yet';\n      return '<li data-testid=\"person\"><span class=\"avatar\" aria-hidden=\"true\">' + esc(initials(p.name)) + '</span>' +\n        '<span class=\"name\">' + esc(p.name) + '</span><span class=\"meta\">' + meta + '</span></li>';\n    }).join('');\n  }\n\n  function renderExpenseForm() {\n    var payer = $('expense-payer');\n    var split = $('expense-split');\n    var prevPayer = payer.value;\n    var prevChecks = {};\n    var hadBoxes = false;\n    Array.prototype.forEach.call(split.querySelectorAll('input[type=checkbox]'), function (cb) {\n      hadBoxes = true; prevChecks[cb.value] = cb.checked;\n    });\n\n    if (!state.people.length) {\n      payer.innerHTML = '<option value=\"\">Add someone to the trip first</option>';\n      split.innerHTML = '<p class=\"empty\" style=\"width:100%;margin:0\">The people you add in step 1 will show up here.</p>';\n      $('split-tools').hidden = true;\n      return;\n    }\n    payer.innerHTML = state.people.map(function (p) {\n      return '<option value=\"' + esc(p.name) + '\">' + esc(p.name) + '</option>';\n    }).join('');\n    if (prevPayer && state.people.some(function (p) { return p.name === prevPayer; })) payer.value = prevPayer;\n\n    split.innerHTML = state.people.map(function (p, i) {\n      var checked = hadBoxes && prevChecks.hasOwnProperty(p.name) ? prevChecks[p.name] : true;\n      return '<label class=\"chip\"><input type=\"checkbox\" value=\"' + esc(p.name) + '\"' + (checked ? ' checked' : '') + '>' + esc(p.name) + '</label>';\n    }).join('');\n    $('split-tools').hidden = state.people.length < 2;\n  }\n\n  function resetSplitToEveryone() {\n    Array.prototype.forEach.call($('expense-split').querySelectorAll('input[type=checkbox]'), function (cb) { cb.checked = true; });\n  }\n\n  function renderExpenses() {\n    var list = $('expenses-list');\n    var total = $('expenses-total');\n    if (!state.expenses.length) {\n      total.textContent = '';\n      list.innerHTML = '<li style=\"display:block;border:0;padding:0\"><p class=\"empty\"><strong>Nothing logged yet.</strong><br>' +\n        (state.people.length ? 'Add the first expense — ferry tickets, groceries, the big dinner.' : 'Add the people on your trip, then log who paid for what.') + '</p></li>';\n      return;\n    }\n    var sum = state.expenses.reduce(function (a, e) { return a + e.cents; }, 0);\n    total.textContent = money(sum) + ' total';\n    var items = state.expenses.slice().reverse().map(function (e) {\n      var order = state.people.map(function (p) { return p.name; }).filter(function (n) { return e.split.indexOf(n) !== -1; });\n      var splitText = order.length === state.people.length && state.people.length > 1\n        ? 'everyone (' + order.map(esc).join(', ') + ')'\n        : order.map(esc).join(', ');\n      var ways = order.length === 1 ? 'just ' + splitText : 'split ' + order.length + ' ways: ' + splitText;\n      return '<li data-testid=\"expense\" data-id=\"' + e.id + '\">' +\n        '<span class=\"desc\">' + esc(e.desc) + '</span>' +\n        '<span class=\"amt\">' + money(e.cents) + '</span>' +\n        '<span class=\"who\">Paid by <b>' + esc(e.payer) + '</b> · ' + ways + '</span>' +\n        '<span class=\"act\"><button type=\"button\" class=\"btn-remove btn\" data-testid=\"delete-expense\" data-id=\"' + e.id + '\" aria-label=\"Remove ' + esc(e.desc) + '\">Remove</button></span>' +\n        '</li>';\n    });\n    list.innerHTML = items.join('');\n  }\n\n  function renderBalances() {\n    var list = $('balances-list');\n    var tlist = $('transfers-list');\n    var scount = $('settle-count');\n    var note = $('settle-note');\n    if (!state.people.length) {\n      list.innerHTML = '<li style=\"display:block;border:0;padding:0\"><p class=\"empty\">Balances show up once you’ve added people and an expense.</p></li>';\n      tlist.innerHTML = '<li style=\"display:block;border:0;padding:0;background:none;margin:0\"><p class=\"empty\">Nothing to settle yet.</p></li>';\n      scount.textContent = ''; note.hidden = true;\n      return;\n    }\n    var bal = balances();\n    var maxAbs = Math.max(1, Math.max.apply(null, state.people.map(function (p) { return Math.abs(bal[p.name]); })));\n    list.innerHTML = state.people.map(function (p) {\n      var c = bal[p.name];\n      var cls = c > 0 ? 'pos' : c < 0 ? 'neg' : 'zero';\n      var status = c > 0 ? 'is owed' : c < 0 ? 'owes' : 'is even';\n      var pct = Math.round(Math.abs(c) / maxAbs * 100);\n      var bar = c >= 0\n        ? '<i style=\"left:50%;width:' + (pct / 2) + '%\"></i>'\n        : '<i class=\"n\" style=\"right:50%;width:' + (pct / 2) + '%\"></i>';\n      return '<li data-testid=\"balance\" data-person=\"' + esc(p.name) + '\" data-cents=\"' + c + '\">' +\n        '<span class=\"avatar\" aria-hidden=\"true\">' + esc(initials(p.name)) + '</span>' +\n        '<span class=\"name\">' + esc(p.name) + '<br><span class=\"status\">' + status + '</span></span>' +\n        '<span class=\"bar\" aria-hidden=\"true\">' + bar + '</span>' +\n        '<span class=\"val ' + cls + '\">' + (c < 0 ? '−' : '') + money(Math.abs(c)) + '</span>' +\n        '</li>';\n    }).join('');\n\n    if (!state.expenses.length) {\n      tlist.innerHTML = '<li style=\"display:block;border:0;padding:0;background:none;margin:0\"><p class=\"empty\">Nothing to settle yet. Once there are expenses, you’ll see who pays whom.</p></li>';\n      scount.textContent = ''; note.hidden = true;\n      return;\n    }\n    var tr = settle(bal);\n    if (!tr.length) {\n      tlist.innerHTML = '<li style=\"display:block;border:0;padding:0;background:none;margin:0\"><div class=\"even\">' +\n        '<svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M6.5 11.5l3 3 6-6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>' +\n        '<span>Everyone’s even. Nothing to pay back.</span></div></li>';\n      scount.textContent = ''; note.hidden = true;\n      return;\n    }\n    scount.textContent = tr.length + (tr.length === 1 ? ' transfer' : ' transfers');\n    tlist.innerHTML = tr.map(function (t) {\n      return '<li data-testid=\"transfer\" data-from=\"' + esc(t.from) + '\" data-to=\"' + esc(t.to) + '\" data-cents=\"' + t.cents + '\">' +\n        '<span class=\"from\">' + esc(t.from) + '</span>' +\n        '<span class=\"arrow\" aria-hidden=\"true\"><svg width=\"22\" height=\"14\" viewBox=\"0 0 22 14\"><path d=\"M1 7h18M14 1.5L20 7l-6 5.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>' +\n        '<span class=\"sr-only\">pays</span>' +\n        '<span class=\"to\">' + esc(t.to) + '</span>' +\n        '<span class=\"amt\">' + money(t.cents) + '</span>' +\n        '</li>';\n    }).join('');\n    note.hidden = false;\n  }\n\n  function render() {\n    renderPeople();\n    renderExpenseForm();\n    renderExpenses();\n    renderBalances();\n  }\n\n  // ---------- events ----------\n  $('person-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var input = $('person-name');\n    var box = $('person-error');\n    var name = input.value.trim();\n    if (!name) { showError(box, input, 'Enter a name before adding someone.'); return; }\n    var lower = name.toLowerCase();\n    var dup = state.people.find(function (p) { return p.name.toLowerCase() === lower; });\n    if (dup) { showError(box, input, '“' + dup.name + '” is already on the trip. Try a nickname or add a last initial.'); return; }\n    clearError(box, [input]);\n    state.people.push({ name: name });\n    save();\n    render();\n    input.value = '';\n    input.focus();\n  });\n  $('person-name').addEventListener('input', function () {\n    if ($('person-error').firstChild) clearError($('person-error'), [this]);\n  });\n\n  $('expense-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var desc = $('expense-desc'), amount = $('expense-amount'), payer = $('expense-payer');\n    var box = $('expense-error');\n    var all = [desc, amount, payer];\n    clearError(box, all);\n\n    if (!state.people.length) { showError(box, $('person-name'), 'Add at least one person to the trip before logging an expense.'); return; }\n    var d = desc.value.trim();\n    if (!d) { showError(box, desc, 'Say what the expense was for.'); return; }\n    var a = parseAmount(amount.value);\n    if (a.error) { showError(box, amount, a.error); return; }\n    var who = payer.value;\n    if (!who || !state.people.some(function (p) { return p.name === who; })) { showError(box, payer, 'Choose who paid.'); return; }\n    var split = Array.prototype.filter.call($('expense-split').querySelectorAll('input[type=checkbox]'), function (cb) { return cb.checked; })\n      .map(function (cb) { return cb.value; });\n    if (!split.length) {\n      showError(box, null, 'Pick at least one person to split this between.');\n      var first = $('expense-split').querySelector('input[type=checkbox]');\n      if (first) first.focus();\n      return;\n    }\n\n    state.expenses.push({ id: state.nextId++, desc: d, cents: a.cents, payer: who, split: split });\n    save();\n    desc.value = ''; amount.value = '';\n    render();\n    resetSplitToEveryone();\n    desc.focus();\n  });\n  ['expense-desc', 'expense-amount'].forEach(function (id) {\n    $(id).addEventListener('input', function () {\n      if ($('expense-error').firstChild) clearError($('expense-error'), [$('expense-desc'), $('expense-amount'), $('expense-payer')]);\n    });\n  });\n\n  $('split-all').addEventListener('click', resetSplitToEveryone);\n  $('split-none').addEventListener('click', function () {\n    Array.prototype.forEach.call($('expense-split').querySelectorAll('input[type=checkbox]'), function (cb) { cb.checked = false; });\n  });\n\n  $('expenses-list').addEventListener('click', function (ev) {\n    var btn = ev.target.closest('[data-testid=\"delete-expense\"]');\n    if (!btn) return;\n    var id = Number(btn.getAttribute('data-id'));\n    state.expenses = state.expenses.filter(function (e) { return e.id !== id; });\n    save();\n    render();\n    var h = $('expenses-h');\n    h.setAttribute('tabindex', '-1');\n    h.focus();\n  });\n\n  $('reset-trip').addEventListener('click', function () {\n    if (!state.people.length && !state.expenses.length) return;\n    if (!window.confirm('Start a new trip? This clears everyone and every expense on this device.')) return;\n    state = { people: [], expenses: [], nextId: 1 };\n    save();\n    render();\n    $('person-name').focus();\n  });\n\n  render();\n})();\n</script>\n</body>\n</html>"

      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Even Keel — trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Public+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--harbour:#1F3A4D;--signal:#C2462B;--signal-d:#A53820;--paper:#F5F2EB;--card:#FFFDF8;--ink:#1B2A35;--muted:#52606B;--line:#D9D3C5;--pos:#1D6B4A;--neg:#A53820}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 'Public Sans',system-ui,sans-serif}\nh1,h2{font-family:Fraunces,Georgia,serif;margin:0;letter-spacing:-.01em}\nheader{background:var(--harbour);color:#fff;padding:22px 16px 20px;border-bottom:5px solid var(--signal)}\n.wrap{max-width:1040px;margin:0 auto}\nheader h1{font-size:1.8rem}\nheader p{margin:4px 0 0;color:#D5E0E8}\nmain{max-width:1040px;margin:0 auto;padding:20px 16px 48px;display:grid;gap:20px;grid-template-columns:1fr}\n@media(min-width:800px){main{grid-template-columns:1fr 1fr;align-items:start}.full{grid-column:1/-1}}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}\nh2{font-size:1.3rem;color:var(--harbour);margin-bottom:12px}\nlabel,legend{display:block;font-weight:600;font-size:.9rem;margin-bottom:4px;padding:0}\ninput[type=text],input[type=number],select{width:100%;font:inherit;padding:10px;border:1.5px solid #8A939A;border-radius:6px;background:#fff;color:var(--ink);min-height:44px}\n.row{display:flex;gap:8px;align-items:flex-end}.row>div{flex:1;min-width:0}\n.field{margin-bottom:12px}\nbutton{font:inherit;font-weight:600;border:0;border-radius:6px;padding:10px 16px;min-height:44px;cursor:pointer;background:var(--signal);color:#fff}\nbutton:hover{background:var(--signal-d)}\nbutton.ghost{background:none;color:var(--harbour);border:1.5px solid var(--harbour);padding:6px 12px;min-height:36px}\nbutton.ghost:hover{background:#E8EEF2}\n:focus-visible{outline:3px solid #0B6FD6;outline-offset:2px}\nfieldset{border:0;padding:0;margin:0 0 12px}\n.checks{display:flex;flex-wrap:wrap;gap:6px}\n.checks label{display:flex;align-items:center;gap:6px;font-weight:500;border:1.5px solid var(--line);border-radius:20px;padding:6px 12px;margin:0;min-height:40px;cursor:pointer;background:#fff}\n.checks input{width:18px;height:18px;accent-color:var(--harbour)}\n.err{color:#9B2C14;font-weight:500;margin:8px 0 0;font-size:.92rem}\n.err:empty{display:none}\nul{list-style:none;margin:0;padding:0}\nli{padding:10px 0;border-top:1px solid var(--line)}\nli:first-child{border-top:0}\n.chips{display:flex;flex-wrap:wrap;gap:6px}\n.chip{background:#E8EEF2;color:var(--harbour);border-radius:20px;padding:2px 12px;font-weight:500}\n.empty{color:var(--muted);margin:0}\n.exp{display:flex;justify-content:space-between;gap:10px}\n.exp .amt{font-weight:600;font-variant-numeric:tabular-nums}\n.meta{color:var(--muted);font-size:.9rem;overflow-wrap:anywhere}\n.bal{display:flex;justify-content:space-between;gap:10px;font-variant-numeric:tabular-nums}\n.pos{color:var(--pos);font-weight:600}.neg{color:var(--neg);font-weight:600}.zero{color:var(--muted)}\n.tr{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}\n.tr b{font-variant-numeric:tabular-nums;color:var(--harbour)}\n.note{color:var(--muted);font-size:.9rem;margin:0 0 8px}\n</style>\n</head>\n<body>\n<header><div class=\"wrap\"><h1>Even Keel</h1><p>Log what everyone paid. See who owes whom. Owing a friend is normal.</p></div></header>\n<main data-testid=\"app\">\n<section aria-labelledby=\"hp\">\n<h2 id=\"hp\">People</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\"><div><label for=\"pn\">Name</label><input type=\"text\" id=\"pn\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" data-testid=\"add-person\">Add person</button></div>\n<p class=\"err\" id=\"pe\" role=\"alert\" aria-live=\"polite\"></p>\n</form>\n<ul id=\"pl\" style=\"margin-top:10px\"></ul>\n</section>\n\n<section aria-labelledby=\"he\">\n<h2 id=\"he\">Add an expense</h2>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"ed\">Description</label><input type=\"text\" id=\"ed\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"ea\">Amount (CAD)</label><input type=\"text\" inputmode=\"decimal\" id=\"ea\" data-testid=\"expense-amount\" placeholder=\"0.00\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"ep\">Paid by</label><select id=\"ep\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend>Split between</legend><div class=\"checks\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"ee\" role=\"alert\" aria-live=\"polite\"></p>\n</form>\n</section>\n\n<section class=\"full\" aria-labelledby=\"hb\">\n<h2 id=\"hb\">Balances</h2>\n<p class=\"note\">Positive means you're owed money. Negative means you owe.</p>\n<ul id=\"bl\"></ul>\n</section>\n\n<section aria-labelledby=\"hs\">\n<h2 id=\"hs\">Settle up</h2>\n<ul id=\"tl\"></ul>\n</section>\n\n<section aria-labelledby=\"hx\">\n<h2 id=\"hx\">Expenses</h2>\n<ul id=\"xl\"></ul>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst $=id=>document.getElementById(id);\nconst K='evenkeel.v1';\nlet S={people:[],expenses:[]};\ntry{const d=JSON.parse(localStorage.getItem(K));if(d&&Array.isArray(d.people)&&Array.isArray(d.expenses))S=d}catch(e){}\nconst save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};\nconst money=c=>fmt.format(c/100);\nfunction el(t,p,txt){const e=document.createElement(t);if(p)for(const k in p)e.setAttribute(k,p[k]);if(txt!=null)e.textContent=txt;return e}\nfunction err(id,msg){const e=$(id);e.textContent=msg||'';if(msg)e.setAttribute('data-testid','form-error');else e.removeAttribute('data-testid')}\n\nfunction shares(x){\n const order=S.people.filter(p=>x.split.includes(p));\n const n=order.length,base=Math.floor(x.cents/n),r=x.cents-base*n,m={};\n order.forEach((p,i)=>m[p]=base+(i<r?1:0));return m}\nfunction balances(){\n const b={};S.people.forEach(p=>b[p]=0);\n S.expenses.forEach(x=>{if(x.payer in b)b[x.payer]+=x.cents;const s=shares(x);for(const p in s)b[p]-=s[p]});\n return b}\nfunction transfers(b){\n const cr=[],db=[];\n S.people.forEach(p=>{if(b[p]>0)cr.push([p,b[p]]);else if(b[p]<0)db.push([p,-b[p]])});\n const out=[];\n cr.sort((a,c)=>c[1]-a[1]);db.sort((a,c)=>c[1]-a[1]);\n let i=0,j=0;\n while(i<cr.length&&j<db.length){\n  const a=Math.min(cr[i][1],db[j][1]);\n  out.push({from:db[j][0],to:cr[i][0],c:a});\n  cr[i][1]-=a;db[j][1]-=a;\n  if(!cr[i][1])i++;if(!db[j][1])j++}\n return out}\n\nfunction render(){\n const pl=$('pl');pl.textContent='';\n if(!S.people.length)pl.appendChild(el('li',0)).appendChild(el('p',{class:'empty'},'No one is on this trip yet. Add the first name above.'));\n S.people.forEach(p=>{const li=el('li',{'data-testid':'person'});li.appendChild(el('span',{class:'chip'},p));pl.appendChild(li)});\n\n const ep=$('ep'),pv=ep.value;ep.textContent='';\n S.people.forEach(p=>{const o=el('option',{value:p},p);ep.appendChild(o)});\n if(S.people.includes(pv))ep.value=pv;\n const es=$('es'),chk=new Set([...es.querySelectorAll('input:checked')].map(i=>i.value)),had=new Set([...es.querySelectorAll('input')].map(i=>i.value));\n es.textContent='';\n if(!S.people.length)es.appendChild(el('p',{class:'empty'},'Add people first, then choose who shares the cost.'));\n S.people.forEach(p=>{\n  const l=el('label'),i=el('input',{type:'checkbox',value:p});\n  i.checked=had.has(p)?chk.has(p):true;\n  l.appendChild(i);l.appendChild(document.createTextNode(p));es.appendChild(l)});\n\n const xl=$('xl');xl.textContent='';\n if(!S.expenses.length)xl.appendChild(el('li')).appendChild(el('p',{class:'empty'},'No expenses yet. Add the first one when someone pays for something.'));\n [...S.expenses].reverse().forEach(x=>{\n  const li=el('li',{'data-testid':'expense'});\n  const r=el('div',{class:'exp'}),L=el('div');\n  L.appendChild(el('strong',0,x.desc));\n  L.appendChild(el('div',{class:'meta'},'Paid by '+x.payer+' · Split between '+x.split.join(', ')));\n  r.appendChild(L);r.appendChild(el('span',{class:'amt'},money(x.cents)));\n  li.appendChild(r);\n  const d=el('button',{type:'button',class:'ghost','data-testid':'delete-expense','aria-label':'Remove '+x.desc,style:'margin-top:8px'},'Remove');\n  d.onclick=()=>{S.expenses=S.expenses.filter(e=>e.id!==x.id);save();render()};\n  li.appendChild(d);xl.appendChild(li)});\n\n const b=balances(),bl=$('bl');bl.textContent='';\n if(!S.people.length)bl.appendChild(el('li')).appendChild(el('p',{class:'empty'},'Balances show up once people are on the trip.'));\n S.people.forEach(p=>{\n  const c=b[p],li=el('li',{'data-testid':'balance','data-person':p,'data-cents':c});\n  const row=el('div',{class:'bal'});row.appendChild(el('span',0,p));\n  const t=c>0?money(c)+' owed to '+p:c<0?p+' owes '+money(-c):'All even';\n  row.appendChild(el('span',{class:c>0?'pos':c<0?'neg':'zero'},(c>0?'+':c<0?'−':'')+(c?money(Math.abs(c)):'')+(c?'':'Even')));\n  row.lastChild.setAttribute('title',t);\n  li.appendChild(row);bl.appendChild(li)});\n\n const tl=$('tl');tl.textContent='';\n const T=transfers(b);\n if(!T.length)tl.appendChild(el('li')).appendChild(el('p',{class:'empty'},S.expenses.length?'You\\'re all even. Nobody needs to pay anyone.':'Nothing to settle yet. Transfers appear once expenses are logged.'));\n T.forEach(t=>{\n  const li=el('li',{'data-testid':'transfer','data-from':t.from,'data-to':t.to,'data-cents':t.c});\n  const r=el('div',{class:'tr'});\n  const s=el('span');s.appendChild(el('strong',0,t.from));s.appendChild(document.createTextNode(' pays '));s.appendChild(el('strong',0,t.to));\n  r.appendChild(s);r.appendChild(el('b',0,money(t.c)));li.appendChild(r);tl.appendChild(li)});\n}\n\n$('pf').onsubmit=e=>{\n e.preventDefault();\n const n=$('pn').value.trim();\n if(!n)return err('pe','Enter a name to add someone.');\n if(S.people.some(p=>p.toLowerCase()===n.toLowerCase()))return err('pe','\"'+n+'\" is already on the trip. Names must be different, ignoring capitals.');\n S.people.push(n);save();err('pe');$('pn').value='';render();$('pn').focus()};\n\n$('ef').onsubmit=e=>{\n e.preventDefault();\n const d=$('ed').value.trim(),a=$('ea').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n const payer=$('ep').value,split=[...$('es').querySelectorAll('input:checked')].map(i=>i.value);\n if(!S.people.length)return err('ee','Add at least one person before logging an expense.');\n if(!d)return err('ee','Add a description, like \"Groceries\".');\n if(!a)return err('ee','Enter the amount.');\n if(!/^\\d*\\.?\\d*$/.test(a)||isNaN(+a))return err('ee','The amount must be a number, like 42.50.');\n if(!/^\\d*\\.?\\d{0,2}$/.test(a))return err('ee','Use at most 2 decimal places for the amount.');\n const [w,f='']=a.split('.');\n const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n if(!(cents>0))return err('ee','The amount must be greater than $0.');\n if(!Number.isSafeInteger(cents))return err('ee','That amount is too large.');\n if(!payer)return err('ee','Choose who paid.');\n if(!split.length)return err('ee','Choose at least one person to split between.');\n S.expenses.push({id:Date.now()+Math.random(),desc:d,cents,payer,split});\n save();err('ee');$('ed').value='';$('ea').value='';\n $('es').querySelectorAll('input').forEach(i=>i.checked=true);\n render();$('ed').focus()};\n\nrender();\n</script>\n</body>\n</html>"
    }

  "content": [
    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Even Keel · Trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;--harbour-2:#2d5068;--signal:#C2462B;--signal-d:#a53a22;\n  --paper:#F5F1E8;--card:#FFFFFF;--ink:#1b2830;--muted:#55656f;--line:#d8d2c3;\n  --owed:#1d6b4a;--owe:#a53a22;--tint:#E8EEF1;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 \"Public Sans\",system-ui,sans-serif}\nh1,h2{font-family:Fraunces,Georgia,serif;margin:0;letter-spacing:-.01em}\nheader{background:var(--harbour);color:#fff;padding:22px 16px 26px;border-bottom:6px solid var(--signal)}\n.wrap{max-width:1040px;margin:0 auto}\nheader h1{font-size:2rem;line-height:1.1}\nheader p{margin:6px 0 0;color:#cfdbe3;max-width:52ch}\nmain{max-width:1040px;margin:0 auto;padding:20px 16px 56px;display:grid;gap:20px;grid-template-columns:1fr}\n@media(min-width:860px){main{grid-template-columns:1fr 1fr;align-items:start}.full{grid-column:1/-1}}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}\nsection h2{font-size:1.3rem;color:var(--harbour);margin-bottom:12px}\nlabel,legend{display:block;font-weight:600;font-size:.9rem;margin-bottom:4px;color:var(--harbour)}\nfieldset{border:0;padding:0;margin:0 0 12px}\ninput[type=text],input[type=number],input:not([type]),select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #8a979f;border-radius:8px;background:#fff;color:var(--ink);min-height:44px}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row>div{flex:1 1 180px}\n.field{margin-bottom:12px}\nbutton{font:inherit;font-weight:600;min-height:44px;padding:8px 16px;border-radius:8px;border:2px solid var(--harbour);background:var(--harbour);color:#fff;cursor:pointer}\nbutton:hover{background:var(--harbour-2)}\nbutton.sec{background:#fff;color:var(--harbour)}\nbutton.sec:hover{background:var(--tint)}\nbutton.danger{background:#fff;color:var(--signal-d);border-color:var(--signal-d);min-height:40px;padding:4px 12px}\nbutton.danger:hover{background:#fbeae6}\n:focus-visible{outline:3px solid var(--signal);outline-offset:2px}\n.err{background:#fbeae6;color:#7d2412;border-left:4px solid var(--signal);padding:8px 12px;border-radius:4px;margin:0 0 12px;font-weight:500}\n.err[hidden]{display:none}\nul{list-style:none;margin:0;padding:0}\n.chips{display:flex;flex-wrap:wrap;gap:8px}\n.chips li{background:var(--tint);color:var(--harbour);padding:6px 14px;border-radius:99px;font-weight:600}\n.empty{color:var(--muted);margin:0;padding:12px;border:1.5px dashed var(--line);border-radius:8px}\n.split{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:6px}\n.split label{display:flex;gap:8px;align-items:center;font-weight:500;color:var(--ink);margin:0;padding:6px 8px;border:1px solid var(--line);border-radius:8px;min-height:44px;overflow-wrap:anywhere}\n.split input{width:20px;height:20px;accent-color:var(--harbour);flex:none}\n.exp{display:flex;gap:12px;justify-content:space-between;align-items:flex-start;padding:12px 0;border-top:1px solid var(--line)}\n.exp:first-child{border-top:0}\n.exp b{display:block;overflow-wrap:anywhere}\n.exp small{color:var(--muted);display:block;overflow-wrap:anywhere}\n.amt{font-weight:700;font-variant-numeric:tabular-nums;color:var(--harbour)}\n.bal{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line);font-variant-numeric:tabular-nums}\n.bal:first-child{border-top:0}\n.pos{color:var(--owed);font-weight:700}.neg{color:var(--owe);font-weight:700}.zero{color:var(--muted);font-weight:600}\n.tr{padding:12px;background:var(--tint);border-radius:8px;margin-bottom:8px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center}\n.tr strong:last-child{font-family:Fraunces,serif;font-size:1.2rem;color:var(--harbour)}\n.note{color:var(--muted);font-size:.9rem;margin:0 0 10px}\n</style>\n</head>\n<body>\n<header><div class=\"wrap\"><h1>Even Keel</h1><p>Log what everyone paid. You'll see who owes whom, so the trip ends level. Owing a friend is normal.</p></div></header>\n<main data-testid=\"app\">\n<section aria-labelledby=\"hp\">\n  <h2 id=\"hp\">People</h2>\n  <form id=\"pf\" novalidate>\n    <div class=\"field\"><label for=\"pn\">Name</label>\n    <div class=\"row\"><div><input id=\"pn\" type=\"text\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n    <button type=\"submit\" data-testid=\"add-person\">Add person</button></div></div>\n    <p class=\"err\" id=\"pe\" role=\"alert\" hidden data-testid=\"form-error\"></p>\n  </form>\n  <div id=\"plist\"></div>\n</section>\n\n<section aria-labelledby=\"he\">\n  <h2 id=\"he\">Add an expense</h2>\n  <form id=\"ef\" novalidate>\n    <div class=\"field\"><label for=\"ed\">Description</label><input id=\"ed\" type=\"text\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n    <div class=\"row\">\n      <div class=\"field\"><label for=\"ea\">Amount (CAD)</label><input id=\"ea\" type=\"text\" inputmode=\"decimal\" data-testid=\"expense-amount\" placeholder=\"0.00\" autocomplete=\"off\"></div>\n      <div class=\"field\"><label for=\"ep\">Paid by</label><select id=\"ep\" data-testid=\"expense-payer\"></select></div>\n    </div>\n    <fieldset><legend>Split between</legend><div class=\"split\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n    <p class=\"err\" id=\"ee\" role=\"alert\" hidden data-testid=\"form-error\"></p>\n    <button type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n  </form>\n</section>\n\n<section aria-labelledby=\"hb\">\n  <h2 id=\"hb\">Balances</h2>\n  <p class=\"note\">Positive means you're owed. Negative means you owe.</p>\n  <div id=\"bals\"></div>\n</section>\n\n<section aria-labelledby=\"hs\">\n  <h2 id=\"hs\">Settle up</h2>\n  <div id=\"trs\"></div>\n</section>\n\n<section class=\"full\" aria-labelledby=\"hx\">\n  <h2 id=\"hx\">Expenses</h2>\n  <div id=\"xs\"></div>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst $=id=>document.getElementById(id);\nconst KEY='evenkeel.v1';\nlet S={people:[],expenses:[]};\ntry{const d=JSON.parse(localStorage.getItem(KEY));if(d&&Array.isArray(d.people)&&Array.isArray(d.expenses))S=d}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}};\nconst money=c=>fmt.format(c/100);\nfunction el(t,p,txt){const e=document.createElement(t);if(p)Object.assign(e,p);if(txt!=null)e.textContent=txt;return e}\nfunction showErr(id,m){const e=$(id);e.textContent=m;e.hidden=false}\nfunction clrErr(id){$(id).hidden=true;$(id).textContent=''}\n\nfunction shares(ex){\n  const order=S.people.filter(p=>ex.split.includes(p));\n  const n=order.length,base=Math.floor(ex.cents/n),extra=ex.cents-base*n,m={};\n  order.forEach((p,i)=>m[p]=base+(i<extra?1:0));\n  return m;\n}\nfunction balances(){\n  const b={};S.people.forEach(p=>b[p]=0);\n  S.expenses.forEach(ex=>{\n    if(ex.payer in b)b[ex.payer]+=ex.cents;\n    const sh=shares(ex);for(const p in sh)b[p]-=sh[p];\n  });\n  return b;\n}\nfunction settle(b){\n  const cr=[],db=[];\n  S.people.forEach(p=>{if(b[p]>0)cr.push({p,c:b[p]});else if(b[p]<0)db.push({p,c:-b[p]})});\n  const out=[];\n  while(cr.length&&db.length){\n    cr.sort((a,b)=>b.c-a.c);db.sort((a,b)=>b.c-a.c);\n    const c=cr[0],d=db[0],x=Math.min(c.c,d.c);\n    out.push({from:d.p,to:c.p,cents:x});\n    c.c-=x;d.c-=x;\n    if(!c.c)cr.shift();if(!d.c)db.shift();\n  }\n  return out;\n}\nfunction render(){\n  // people\n  const pl=$('plist');pl.textContent='';\n  if(!S.people.length)pl.append(el('p',{className:'empty'},'No one is on the trip yet. Add the first name above.'));\n  else{const u=el('ul',{className:'chips'});S.people.forEach(p=>{const li=el('li',null,p);li.dataset.testid='person';li.setAttribute('data-testid','person');u.append(li)});pl.append(u)}\n  // payer + split (preserve state)\n  const prev=$('ep').value;\n  const checked=new Set([...document.querySelectorAll('#es input:checked')].map(i=>i.value));\n  const known=new Set([...document.querySelectorAll('#es input')].map(i=>i.value));\n  $('ep').textContent='';\n  S.people.forEach(p=>$('ep').append(el('option',{value:p},p)));\n  if(S.people.includes(prev))$('ep').value=prev;\n  const es=$('es');es.textContent='';\n  if(!S.people.length)es.append(el('p',{className:'empty'},'Add people first to split an expense.'));\n  S.people.forEach((p,i)=>{\n    const l=el('label');const c=el('input',{type:'checkbox',value:p});\n    c.checked=known.has(p)?checked.has(p):true;\n    l.append(c,el('span',null,p));es.append(l);\n  });\n  // expenses\n  const xs=$('xs');xs.textContent='';\n  if(!S.expenses.length)xs.append(el('p',{className:'empty'},'No expenses yet. Add the first one when someone pays for something.'));\n  else{\n    const u=el('ul');\n    [...S.expenses].reverse().forEach(ex=>{\n      const li=el('li',{className:'exp'});li.setAttribute('data-testid','expense');\n      const d=el('div');\n      d.append(el('b',null,ex.desc),el('small',null,'Paid by '+ex.payer),el('small',null,'Split between '+ex.split.join(', ')));\n      const r=el('div');r.style.textAlign='right';\n      const a=el('span',{className:'amt'},money(ex.cents));\n      const bt=el('button',{type:'button',className:'danger'},'Remove');\n      bt.setAttribute('data-testid','delete-expense');\n      bt.setAttribute('aria-label','Remove '+ex.desc);\n      bt.onclick=()=>{S.expenses=S.expenses.filter(e=>e!==ex&&e.id!==ex.id);save();render()};\n      r.append(a,el('br'),bt);li.append(d,r);u.append(li);\n    });\n    xs.append(u);\n  }\n  // balances\n  const bs=$('bals');bs.textContent='';\n  const b=balances();\n  if(!S.people.length)bs.append(el('p',{className:'empty'},'Balances appear once people are added.'));\n  S.people.forEach(p=>{\n    const row=el('div',{className:'bal'});\n    row.setAttribute('data-testid','balance');row.dataset.person=p;row.dataset.cents=b[p];\n    const v=b[p];\n    row.append(el('span',null,p),el('span',{className:v>0?'pos':v<0?'neg':'zero'},v>0?'is owed '+money(v):v<0?'owes '+money(-v):'all even'));\n    bs.append(row);\n  });\n  // transfers\n  const ts=$('trs');ts.textContent='';\n  const t=settle(b);\n  if(!S.expenses.length)ts.append(el('p',{className:'empty'},'Nothing to settle yet. Log an expense and your transfers show up here.'));\n  else if(!t.length)ts.append(el('p',{className:'empty'},'Everyone is even. Nothing to pay.'));\n  t.forEach(x=>{\n    const d=el('div',{className:'tr'});\n    d.setAttribute('data-testid','transfer');d.dataset.from=x.from;d.dataset.to=x.to;d.dataset.cents=x.cents;\n    const s=el('span');s.append(el('strong',null,x.from),' pays ',el('strong',null,x.to));\n    d.append(s,el('strong',null,money(x.cents)));ts.append(d);\n  });\n}\n$('pf').onsubmit=e=>{\n  e.preventDefault();\n  const n=$('pn').value.trim();\n  if(!n)return showErr('pe','Enter a name to add someone.');\n  if(S.people.some(p=>p.toLowerCase()===n.toLowerCase()))return showErr('pe',`\"${n}\" is already on the trip. Names must be different.`);\n  S.people.push(n);save();clrErr('pe');$('pn').value='';render();$('pn').focus();\n};\n$('pn').oninput=()=>clrErr('pe');\n$('ef').onsubmit=e=>{\n  e.preventDefault();\n  const desc=$('ed').value.trim(),raw=$('ea').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  const payer=$('ep').value;\n  const split=[...document.querySelectorAll('#es input:checked')].map(i=>i.value);\n  if(!S.people.length)return showErr('ee','Add at least one person before logging an expense.');\n  if(!desc)return showErr('ee','Add a description, like \"Groceries\".');\n  if(!raw)return showErr('ee','Enter an amount.');\n  if(!/^\\d*\\.?\\d*$/.test(raw)||raw==='.')return showErr('ee','Amount must be a number, like 42.50.');\n  if(!/^\\d*(\\.\\d{1,2})?$/.test(raw))return showErr('ee','Amount can have at most 2 decimal places.');\n  const [w,f='']=raw.split('.');\n  const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(!(cents>0))return showErr('ee','Amount must be greater than $0.00.');\n  if(!payer)return showErr('ee','Choose who paid.');\n  if(!split.length)return showErr('ee','Choose at least one person to split between.');\n  S.expenses.push({id:Date.now()+Math.random(),desc,cents,payer,split});\n  save();clrErr('ee');$('ed').value='';$('ea').value='';render();$('ed').focus();\n};\n['ed','ea','ep'].forEach(i=>$(i).addEventListener('input',()=>clrErr('ee')));\n$('es').addEventListener('change',()=>clrErr('ee'));\nrender();\n</script>\n</body>\n</html>"
    }

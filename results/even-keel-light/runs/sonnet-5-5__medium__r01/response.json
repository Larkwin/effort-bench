  "content": [
    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel — trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;--harbour-2:#2D5069;--signal:#C2462B;--signal-dark:#A33820;\n  --paper:#F6F3EC;--card:#FFFFFF;--ink:#17242D;--muted:#52616B;--line:#D9D4C7;\n  --owed:#1E6B4A;--owe:#A33820;--tint:#E8EEF1;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font:400 16px/1.5 \"Public Sans\",system-ui,sans-serif}\nh1,h2,h3{font-family:Fraunces,Georgia,serif;margin:0;line-height:1.2}\n:focus-visible{outline:3px solid var(--signal);outline-offset:2px}\nheader.top{background:var(--harbour);color:#fff;padding:20px 16px 22px;border-bottom:4px solid var(--signal)}\n.wrap{max-width:1040px;margin:0 auto}\nheader.top h1{font-size:1.9rem;letter-spacing:-.01em}\nheader.top p{margin:4px 0 0;color:#D5E1E8;max-width:46ch}\nmain{max-width:1040px;margin:0 auto;padding:20px 16px 48px;display:grid;gap:20px;grid-template-columns:1fr}\n@media(min-width:860px){main{grid-template-columns:1fr 1fr;align-items:start;gap:24px}.col{display:grid;gap:20px}}\n.col{display:grid;gap:20px;min-width:0}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}\nsection h2{font-size:1.25rem;margin-bottom:12px;color:var(--harbour)}\nlabel,legend{display:block;font-weight:600;font-size:.9rem;margin-bottom:4px;color:var(--harbour)}\ninput[type=text],input[type=number],input:not([type]),select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #8A97A0;border-radius:6px;background:#fff;color:var(--ink);min-height:44px}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row .grow{flex:1 1 180px;min-width:0}\nbutton{font:inherit;font-weight:600;min-height:44px;padding:8px 16px;border-radius:6px;border:1.5px solid var(--harbour);background:var(--harbour);color:#fff;cursor:pointer}\nbutton:hover{background:var(--harbour-2)}\nbutton.ghost{background:transparent;color:var(--owe);border-color:transparent;text-decoration:underline;padding:8px}\nbutton.ghost:hover{background:#FBEDE9}\n.err{margin:10px 0 0;padding:8px 12px;border-left:4px solid var(--signal);background:#FBEDE9;color:#7A2411;font-weight:500;border-radius:4px}\n.empty{color:var(--muted);margin:0;padding:12px;background:var(--tint);border-radius:6px}\nul{list-style:none;margin:0;padding:0}\n.people{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}\n.people li{background:var(--tint);color:var(--harbour);padding:6px 14px;border-radius:999px;font-weight:600}\n.field{margin-top:14px}\nfieldset{border:0;padding:0;margin:14px 0 0;min-width:0}\n.split{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:6px}\n.split label{display:flex;align-items:center;gap:8px;font-weight:500;color:var(--ink);margin:0;padding:8px 10px;border:1px solid var(--line);border-radius:6px;min-height:44px;overflow-wrap:anywhere}\n.split input{width:20px;height:20px;accent-color:var(--harbour);flex:none}\nform .actions{margin-top:16px}\n.exp{padding:12px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:4px 12px}\n.exp:first-child{border-top:0}\n.exp strong{overflow-wrap:anywhere}\n.exp .amt{font-family:Fraunces,serif;font-weight:700;font-size:1.15rem;color:var(--harbour);text-align:right}\n.exp .meta{color:var(--muted);font-size:.9rem;grid-column:1;overflow-wrap:anywhere}\n.exp button{grid-column:2;justify-self:end}\n.bal{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line);align-items:baseline}\n.bal:first-child{border-top:0}\n.bal .n{font-weight:600;overflow-wrap:anywhere}\n.bal .v{font-variant-numeric:tabular-nums;font-weight:700;text-align:right}\n.bal small{display:block;font-weight:500;color:var(--muted)}\n.pos{color:var(--owed)}.neg{color:var(--owe)}.zero{color:var(--muted)}\n.tr{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px;margin-top:8px;background:var(--tint);border-radius:8px;border-left:4px solid var(--signal)}\n.tr .t{overflow-wrap:anywhere}\n.tr b.m{font-family:Fraunces,serif;font-size:1.15rem;color:var(--harbour);white-space:nowrap}\n.note{color:var(--muted);font-size:.9rem;margin:0 0 10px}\n</style>\n</head>\n<body>\n<header class=\"top\"><div class=\"wrap\">\n<h1>Even Keel</h1>\n<p>Log what each person paid. You'll see who owes whom, so the trip ends level.</p>\n</div></header>\n\n<main data-testid=\"app\">\n<div class=\"col\">\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People</h2>\n<form id=\"pform\" novalidate>\n<div class=\"row\">\n<div class=\"grow\"><label for=\"pname\">Name</label><input id=\"pname\" type=\"text\" autocomplete=\"off\" data-testid=\"person-name\"></div>\n<button type=\"submit\" data-testid=\"add-person\">Add person</button>\n</div>\n<div id=\"perr\" aria-live=\"polite\"></div>\n</form>\n<div id=\"plist\"></div>\n</section>\n\n<section aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Add an expense</h2>\n<form id=\"eform\" novalidate>\n<div><label for=\"edesc\">What was it for?</label><input id=\"edesc\" type=\"text\" autocomplete=\"off\" data-testid=\"expense-desc\"></div>\n<div class=\"field\"><label for=\"eamt\">Amount (CAD)</label><input id=\"eamt\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"0.00\" data-testid=\"expense-amount\"></div>\n<div class=\"field\"><label for=\"epayer\">Paid by</label><select id=\"epayer\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend>Split between</legend><div class=\"split\" id=\"esplit\" data-testid=\"expense-split\"></div></fieldset>\n<div id=\"eerr\" aria-live=\"polite\"></div>\n<div class=\"actions\"><button type=\"submit\" data-testid=\"add-expense\">Add expense</button></div>\n</form>\n</section>\n</div>\n\n<div class=\"col\">\n<section aria-labelledby=\"h-set\">\n<h2 id=\"h-set\">Settle up</h2>\n<div id=\"settle\"></div>\n</section>\n<section aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<div id=\"bals\"></div>\n</section>\n<section aria-labelledby=\"h-list\">\n<h2 id=\"h-list\">Expenses</h2>\n<div id=\"elist\"></div>\n</section>\n</div>\n</main>\n\n<script>\n(function(){\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nconst KEY='evenkeel.v1';\nlet state={people:[],expenses:[]};\ntry{const s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=s}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};\nconst $=id=>document.getElementById(id);\nfunction el(t,props,...kids){const e=document.createElement(t);for(const k in props||{}){if(k==='text')e.textContent=props[k];else if(k.startsWith('data-')||k==='for'||k==='role')e.setAttribute(k,props[k]);else e[k]=props[k]}kids.forEach(x=>e.append(x));return e}\nfunction showErr(box,msg){box.innerHTML='';if(msg)box.append(el('p',{className:'err',text:msg,role:'alert'}),0)||0;const p=box.firstChild;if(p)p.setAttribute('data-testid','form-error')}\n\nfunction shares(e){\n  const order=state.people.filter(p=>e.split.includes(p));\n  const n=order.length,base=Math.floor(e.cents/n),rem=e.cents-base*n;\n  const r={};order.forEach((p,i)=>r[p]=base+(i<rem?1:0));return r;\n}\nfunction balances(){\n  const b={};state.people.forEach(p=>b[p]=0);\n  state.expenses.forEach(e=>{\n    if(b[e.payer]!==undefined)b[e.payer]+=e.cents;\n    const s=shares(e);for(const p in s)b[p]-=s[p];\n  });return b;\n}\nfunction transfers(b){\n  const cr=[],db=[];\n  state.people.forEach(p=>{if(b[p]>0)cr.push([p,b[p]]);else if(b[p]<0)db.push([p,-b[p]])});\n  const out=[];\n  cr.sort((a,c)=>c[1]-a[1]);db.sort((a,c)=>c[1]-a[1]);\n  let i=0,j=0;\n  while(i<cr.length&&j<db.length){\n    const m=Math.min(cr[i][1],db[j][1]);\n    out.push({from:db[j][0],to:cr[i][0],cents:m});\n    cr[i][1]-=m;db[j][1]-=m;\n    if(cr[i][1]===0)i++;if(db[j][1]===0)j++;\n  }\n  return out;\n}\n\nfunction render(){\n  // people\n  const pl=$('plist');pl.innerHTML='';\n  if(!state.people.length)pl.append(el('p',{className:'empty',text:'No one is on the trip yet. Add the first name above.'}));\n  else{const ul=el('ul',{className:'people'});state.people.forEach(p=>ul.append(el('li',{text:p,'data-testid':'person'})));pl.append(ul)}\n  // payer + split (preserve selections)\n  const sel=$('epayer'),prevPayer=sel.value;\n  const split=$('esplit');\n  const prevChecked=new Set([...split.querySelectorAll('input:checked')].map(i=>i.value));\n  const prevKnown=new Set([...split.querySelectorAll('input')].map(i=>i.value));\n  sel.innerHTML='';\n  state.people.forEach(p=>{const o=el('option',{text:p});o.value=p;sel.append(o)});\n  if(state.people.includes(prevPayer))sel.value=prevPayer;\n  split.innerHTML='';\n  if(!state.people.length)split.append(el('p',{className:'empty',text:'Add people first.'}));\n  state.people.forEach((p,i)=>{\n    const id='sp'+i;\n    const cb=el('input',{type:'checkbox',id});cb.value=p;\n    cb.checked=prevKnown.has(p)?prevChecked.has(p):true;\n    split.append(el('label',{for:id},cb,el('span',{text:p})));\n  });\n  // expenses\n  const el_=$('elist');el_.innerHTML='';\n  if(!state.expenses.length)el_.append(el('p',{className:'empty',text:'No expenses yet. Add the first one when someone pays for something.'}));\n  else{\n    const ul=el('ul');\n    state.expenses.slice().reverse().forEach(e=>{\n      const li=el('li',{className:'exp','data-testid':'expense'});\n      li.append(el('strong',{text:e.desc}),el('span',{className:'amt',text:money(e.cents)}),\n        el('span',{className:'meta',text:'Paid by '+e.payer+' · Split between '+e.split.join(', ')}));\n      const d=el('button',{type:'button',className:'ghost',text:'Remove','data-testid':'delete-expense'});\n      d.setAttribute('aria-label','Remove '+e.desc);\n      d.onclick=()=>{state.expenses=state.expenses.filter(x=>x.id!==e.id);save();render()};\n      li.append(d);ul.append(li);\n    });el_.append(ul);\n  }\n  // balances\n  const b=balances(),bx=$('bals');bx.innerHTML='';\n  if(!state.people.length)bx.append(el('p',{className:'empty',text:'Balances show up once people join the trip.'}));\n  state.people.forEach(p=>{\n    const c=b[p];\n    const row=el('div',{className:'bal','data-testid':'balance','data-person':p,'data-cents':String(c)});\n    const cls=c>0?'pos':c<0?'neg':'zero';\n    const note=c>0?'is owed':c<0?'owes':'is square';\n    row.append(el('span',{className:'n',text:p}),\n      el('span',{className:'v '+cls},document.createTextNode(money(Math.abs(c))),el('small',{text:note})));\n    bx.append(row);\n  });\n  // settle\n  const sb=$('settle');sb.innerHTML='';\n  const ts=transfers(b);\n  if(!state.expenses.length)sb.append(el('p',{className:'empty',text:'Nothing to settle yet. Once expenses are logged, the simplest payments appear here.'}));\n  else if(!ts.length)sb.append(el('p',{className:'empty',text:'Everyone is even. Nobody owes anything.'}));\n  else{\n    sb.append(el('p',{className:'note',text:'These '+ts.length+(ts.length===1?' payment brings':' payments bring')+' everyone level.'}));\n    ts.forEach(t=>{\n      const d=el('div',{className:'tr','data-testid':'transfer','data-from':t.from,'data-to':t.to,'data-cents':String(t.cents)});\n      const s=el('span',{className:'t'},el('strong',{text:t.from}),document.createTextNode(' pays '),el('strong',{text:t.to}));\n      d.append(s,el('b',{className:'m',text:money(t.cents)}));sb.append(d);\n    });\n  }\n}\n\n$('pform').addEventListener('submit',ev=>{\n  ev.preventDefault();\n  const inp=$('pname'),name=inp.value.trim().replace(/\\s+/g,' ');\n  if(!name){showErr($('perr'),'Enter a name to add someone.');inp.focus();return}\n  if(state.people.some(p=>p.toLowerCase()===name.toLowerCase())){showErr($('perr'),'\"'+name+'\" is already on the trip. Try a different name.');inp.focus();return}\n  state.people.push(name);save();inp.value='';showErr($('perr'),'');render();inp.focus();\n});\n\n$('eform').addEventListener('submit',ev=>{\n  ev.preventDefault();\n  const desc=$('edesc').value.trim(),raw=$('eamt').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  const payer=$('epayer').value;\n  const chosen=[...$('esplit').querySelectorAll('input:checked')].map(i=>i.value);\n  const box=$('eerr');let msg='';\n  if(!state.people.length)msg='Add at least one person before logging an expense.';\n  else if(!desc)msg='Add a description, like \"Groceries\".';\n  else if(!raw)msg='Enter an amount.';\n  else if(!/^\\d*\\.?\\d+$|^\\d+\\.$/.test(raw)||isNaN(Number(raw)))msg='Amount must be a number, like 42.50.';\n  else if(!/^\\d*(\\.\\d{0,2})?$/.test(raw))msg='Amount can have at most 2 decimal places.';\n  else if(Number(raw)<=0)msg='Amount must be greater than $0.';\n  else if(!payer)msg='Choose who paid.';\n  else if(!chosen.length)msg='Choose at least one person to split between.';\n  if(msg){showErr(box,msg);return}\n  const [w,f='']=raw.split('.');\n  const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(cents<=0){showErr(box,'Amount must be greater than $0.');return}\n  const split=state.people.filter(p=>chosen.includes(p));\n  state.expenses.push({id:Date.now()+Math.random(),desc,cents,payer,split});\n  save();showErr(box,'');\n  $('edesc').value='';$('eamt').value='';\n  render();$('edesc').focus();\n});\n\nrender();\n})();\n</script>\n</body>\n</html>"
    }

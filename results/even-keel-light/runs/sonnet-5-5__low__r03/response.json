      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Even Keel · Trip expenses</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Public+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--harbour:#1F3A4D;--signal:#C2462B;--paper:#F5F2EC;--card:#fff;--ink:#1B2A35;--muted:#52606b;--line:#D9D4C9;--pos:#1D6B4F;--tint:#E8EEF2}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 'Public Sans',system-ui,sans-serif}\nh1,h2{font-family:Fraunces,Georgia,serif;margin:0;line-height:1.15}\nheader{background:var(--harbour);color:#fff;padding:24px 16px 28px;border-bottom:6px solid var(--signal)}\n.wrap{max-width:1040px;margin:0 auto}\nheader h1{font-size:2rem}\nheader p{margin:6px 0 0;color:#d5e0e8;max-width:46ch}\nmain{max-width:1040px;margin:0 auto;padding:20px 16px 48px;display:grid;gap:20px;grid-template-columns:1fr}\n@media(min-width:820px){main{grid-template-columns:1fr 1fr;align-items:start}.wide{grid-column:1/-1}}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}\nh2{font-size:1.3rem;color:var(--harbour);margin-bottom:12px}\nlabel,legend{display:block;font-weight:600;font-size:.9rem;margin:12px 0 4px;color:var(--harbour);padding:0}\ninput[type=text],input[type=number],select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #8895a0;border-radius:6px;background:#fff;color:var(--ink);min-height:44px}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row>div{flex:1 1 180px}\nbutton{font:inherit;font-weight:600;min-height:44px;padding:8px 16px;border-radius:6px;border:2px solid var(--harbour);background:var(--harbour);color:#fff;cursor:pointer}\nbutton:hover{background:#162c3b}\nbutton.ghost{background:#fff;color:var(--harbour);min-height:36px;padding:4px 10px}\nbutton.ghost:hover{background:var(--tint)}\nbutton.go{background:var(--signal);border-color:var(--signal);margin-top:14px}\nbutton.go:hover{background:#a53a22}\n:focus-visible{outline:3px solid #E59A00;outline-offset:2px}\n.err{color:#9B2C16;font-weight:600;margin:8px 0 0;font-size:.92rem}\n.err:empty{display:none}\nul{list-style:none;margin:0;padding:0}\n.empty{color:var(--muted);margin:4px 0}\n.chips li{display:inline-block;background:var(--tint);color:var(--harbour);border-radius:99px;padding:4px 14px;margin:0 6px 6px 0;font-weight:500}\nfieldset{border:0;padding:0;margin:0;min-width:0}\n.checks{display:flex;flex-wrap:wrap;gap:6px 14px}\n.checks label{display:flex;align-items:center;gap:6px;font-weight:500;margin:0;min-height:36px;color:var(--ink)}\n.checks input{width:20px;height:20px;accent-color:var(--harbour)}\n.exp{border-top:1px solid var(--line);padding:12px 0;display:flex;gap:10px;justify-content:space-between;align-items:flex-start}\n.exp:first-child{border-top:0}\n.exp div{min-width:0;overflow-wrap:anywhere}\n.amt{font-weight:600;font-variant-numeric:tabular-nums}\n.sub{color:var(--muted);font-size:.88rem}\n.bal,.tr{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid var(--line);font-variant-numeric:tabular-nums;flex-wrap:wrap}\n.bal:first-child,.tr:first-child{border-top:0}\n.pos{color:var(--pos);font-weight:600}.neg{color:#A73A22;font-weight:600}\n.tr strong{color:var(--harbour)}\n.note{color:var(--muted);font-size:.9rem;margin:0 0 8px}\n</style>\n</head>\n<body>\n<header><div class=\"wrap\"><h1>Even Keel</h1><p>Log what everyone paid. You'll see who owes whom, so the trip ends level.</p></div></header>\n<main data-testid=\"app\">\n<section>\n<h2>People</h2>\n<form id=\"pf\" novalidate>\n<label for=\"pn\">Name</label>\n<div class=\"row\"><div><input type=\"text\" id=\"pn\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" data-testid=\"add-person\">Add person</button></div>\n<p class=\"err\" id=\"pe\" role=\"alert\"></p>\n</form>\n<ul id=\"people\" class=\"chips\" style=\"margin-top:12px\"></ul>\n<p class=\"empty\" id=\"pempty\">No one is on the trip yet. Add the first name above.</p>\n</section>\n\n<section>\n<h2>Add an expense</h2>\n<form id=\"ef\" novalidate>\n<label for=\"ed\" style=\"margin-top:0\">Description</label>\n<input type=\"text\" id=\"ed\" data-testid=\"expense-desc\" autocomplete=\"off\">\n<label for=\"ea\">Amount (CAD)</label>\n<input type=\"text\" inputmode=\"decimal\" id=\"ea\" data-testid=\"expense-amount\" placeholder=\"0.00\" autocomplete=\"off\">\n<label for=\"ep\">Paid by</label>\n<select id=\"ep\" data-testid=\"expense-payer\"></select>\n<fieldset><legend>Split between</legend>\n<div class=\"checks\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n<p class=\"err\" id=\"ee\" role=\"alert\"></p>\n<button type=\"submit\" class=\"go\" data-testid=\"add-expense\">Add expense</button>\n</form>\n</section>\n\n<section>\n<h2>Balances</h2>\n<p class=\"note\">Positive means you're owed. Negative means you owe.</p>\n<div id=\"bals\"></div>\n</section>\n\n<section>\n<h2>Settle up</h2>\n<div id=\"settle\"></div>\n</section>\n\n<section class=\"wide\">\n<h2>Expenses</h2>\n<div id=\"exps\"></div>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nlet S;try{S=JSON.parse(localStorage.getItem('evenkeel'))}catch(e){}\nif(!S||!Array.isArray(S.people)||!Array.isArray(S.expenses))S={people:[],expenses:[]};\nconst save=()=>{try{localStorage.setItem('evenkeel',JSON.stringify(S))}catch(e){}};\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction setErr(id,msg,inp){const e=$(id);e.textContent=msg;if(msg)e.setAttribute('data-testid','form-error');else e.removeAttribute('data-testid');}\nfunction shares(e){const n=e.split.length,b=Math.floor(e.cents/n),r=e.cents-b*n;\nconst order=S.people.filter(p=>e.split.includes(p));const m={};\norder.forEach((p,i)=>m[p]=b+(i<r?1:0));return m}\nfunction balances(){const b={};S.people.forEach(p=>b[p]=0);\nS.expenses.forEach(e=>{if(b[e.payer]!==undefined)b[e.payer]+=e.cents;const m=shares(e);for(const p in m)b[p]-=m[p]});return b}\nfunction transfers(b){const d=[],c=[];\nfor(const p of S.people){if(b[p]<0)d.push([p,-b[p]]);else if(b[p]>0)c.push([p,b[p]])}\nconst out=[];d.sort((a,b)=>b[1]-a[1]);c.sort((a,b)=>b[1]-a[1]);\nlet i=0,j=0;while(i<d.length&&j<c.length){const x=Math.min(d[i][1],c[j][1]);\nout.push({from:d[i][0],to:c[j][0],cents:x});d[i][1]-=x;c[j][1]-=x;if(!d[i][1])i++;if(!c[j][1])j++}\nreturn out}\nfunction render(){\n$('pempty').style.display=S.people.length?'none':'';\n$('people').innerHTML=S.people.map(p=>`<li data-testid=\"person\">${esc(p)}</li>`).join('');\nconst sel=$('ep'),cur=sel.value;\nsel.innerHTML=S.people.map(p=>`<option value=\"${esc(p)}\">${esc(p)}</option>`).join('');\nif(S.people.includes(cur))sel.value=cur;\nconst checked=new Set([...$('es').querySelectorAll('input:checked')].map(i=>i.value));\nconst known=new Set([...$('es').querySelectorAll('input')].map(i=>i.value));\n$('es').innerHTML=S.people.length?S.people.map((p,i)=>`<label><input type=\"checkbox\" value=\"${esc(p)}\" ${(!known.has(p)||checked.has(p))?'checked':''}>${esc(p)}</label>`).join(''):'<span class=\"empty\">Add people to split with.</span>';\nconst b=balances();\n$('bals').innerHTML=S.people.length?S.people.map(p=>{const c=b[p];\nreturn `<div class=\"bal\" data-testid=\"balance\" data-person=\"${esc(p)}\" data-cents=\"${c}\"><span>${esc(p)}</span><span class=\"${c>0?'pos':c<0?'neg':''}\">${c>0?'is owed ':c<0?'owes ':'is even · '}${c?money(Math.abs(c)):money(0)}</span></div>`}).join(''):'<p class=\"empty\">Balances show up once people join the trip.</p>';\nconst t=transfers(b);\n$('settle').innerHTML=!S.expenses.length?'<p class=\"empty\">Nothing to settle yet. Log an expense and the transfers appear here.</p>':t.length?'<p class=\"note\">These transfers bring everyone level.</p>'+t.map(x=>`<div class=\"tr\" data-testid=\"transfer\" data-from=\"${esc(x.from)}\" data-to=\"${esc(x.to)}\" data-cents=\"${x.cents}\"><span><strong>${esc(x.from)}</strong> pays <strong>${esc(x.to)}</strong></span><span class=\"amt\">${money(x.cents)}</span></div>`).join(''):'<p class=\"empty\">Everyone is even. Nothing to pay.</p>';\n$('exps').innerHTML=S.expenses.length?[...S.expenses].reverse().map(e=>`<div class=\"exp\" data-testid=\"expense\"><div><strong>${esc(e.desc)}</strong> · <span class=\"amt\">${money(e.cents)}</span><div class=\"sub\">Paid by ${esc(e.payer)} · Split between ${e.split.map(esc).join(', ')}</div></div><button type=\"button\" class=\"ghost\" data-testid=\"delete-expense\" data-id=\"${e.id}\" aria-label=\"Remove ${esc(e.desc)}\">Remove</button></div>`).join(''):'<p class=\"empty\">No expenses yet. Add the first one when someone pays for something.</p>';\n}\n$('pf').addEventListener('submit',e=>{e.preventDefault();\nconst n=$('pn').value.trim();\nif(!n)return setErr('pe','Enter a name to add someone.');\nif(S.people.some(p=>p.toLowerCase()===n.toLowerCase()))return setErr('pe',`\"${n}\" is already on the trip. Names must be different.`);\nS.people.push(n);save();setErr('pe','');$('pn').value='';render();$('pn').focus()});\n$('ef').addEventListener('submit',e=>{e.preventDefault();\nconst d=$('ed').value.trim(),a=$('ea').value.trim().replace(/^\\$/,'').replace(/,/g,'');\nconst split=[...$('es').querySelectorAll('input:checked')].map(i=>i.value);\nconst payer=$('ep').value;\nif(!d)return setErr('ee','Add a description, like \"Groceries\".');\nif(!a||!/^\\d*\\.?\\d*$/.test(a)||isNaN(+a))return setErr('ee','Enter the amount as a number, like 42.50.');\nif(!/^\\d+(\\.\\d{1,2})?$|^\\.\\d{1,2}$/.test(a))return setErr('ee','The amount can have at most 2 decimal places.');\nconst cents=Math.round(parseFloat(a)*100);\nif(cents<=0)return setErr('ee','The amount must be greater than $0.');\nif(!S.people.length||!payer)return setErr('ee','Add people to the trip first, then choose who paid.');\nif(!split.length)return setErr('ee','Choose at least one person to split between.');\nS.expenses.push({id:Date.now()+Math.random(),desc:d,cents,payer,split});\nsave();setErr('ee','');$('ed').value='';$('ea').value='';render();$('ed').focus()});\n$('exps').addEventListener('click',e=>{const b=e.target.closest('[data-id]');if(!b)return;\nS.expenses=S.expenses.filter(x=>String(x.id)!==b.dataset.id);save();render();$('ed').focus()});\nrender();\n</script>\n</body>\n</html>"
    }

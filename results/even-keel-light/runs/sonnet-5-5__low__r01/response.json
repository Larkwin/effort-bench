    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Even Keel — trip expenses, kept level</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--harbour:#1F3A4D;--signal:#C2462B;--paper:#F5F2EC;--card:#fff;--ink:#1c2a35;--muted:#5a6b78;--line:#d9d4c9;--pos:#1d6b4a;--neg:#A63A22}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 Inter,system-ui,sans-serif}\nheader{background:var(--harbour);color:#fff;padding:20px 16px;border-bottom:4px solid var(--signal)}\n.wrap{max-width:1000px;margin:0 auto}\nh1{font:600 28px Fraunces,Georgia,serif;margin:0}\nheader p{margin:2px 0 0;color:#d5e0e7}\nmain{max-width:1000px;margin:0 auto;padding:16px;display:grid;gap:16px;grid-template-columns:1fr 1fr}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;min-width:0}\n.full{grid-column:1/-1}\n@media(max-width:760px){main{grid-template-columns:1fr}}\nh2{font:600 20px Fraunces,Georgia,serif;color:var(--harbour);margin:0 0 12px}\nlabel,legend{display:block;font-weight:600;font-size:14px;margin:10px 0 4px;color:var(--harbour);padding:0}\ninput[type=text],input[type=number],select{width:100%;padding:10px;border:1px solid #7b8b96;border-radius:6px;font:inherit;background:#fff;color:var(--ink)}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row>div{flex:1;min-width:160px}\nbutton{font:inherit;font-weight:600;padding:10px 16px;border-radius:6px;border:2px solid var(--harbour);background:var(--harbour);color:#fff;cursor:pointer;min-height:44px}\nbutton.ghost{background:#fff;color:var(--harbour);padding:6px 12px;min-height:36px}\nbutton.add{margin-top:12px}\n:focus-visible{outline:3px solid var(--signal);outline-offset:2px}\n.err{color:#9b2c15;font-weight:500;margin:8px 0 0;font-size:14px}\n.err:empty{display:none}\nul{list-style:none;margin:0;padding:0}\nli{padding:10px 0;border-top:1px solid var(--line)}\nli:first-child{border-top:0}\n.empty{color:var(--muted);margin:0}\n.chips{display:flex;flex-wrap:wrap;gap:8px}\n.chips li{border:1px solid var(--line);border-radius:99px;padding:4px 12px;background:var(--paper)}\n#split{border:0;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:6px 16px}\n#split label{display:flex;align-items:center;gap:6px;font-weight:400;color:var(--ink);margin:0;min-height:32px;font-size:16px}\n#split input{width:20px;height:20px;accent-color:var(--harbour)}\n.exp{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}\n.exp div{min-width:0;overflow-wrap:anywhere}\n.amt{font-weight:600;font-variant-numeric:tabular-nums}\n.sub{color:var(--muted);font-size:14px}\n.bal{display:flex;justify-content:space-between;gap:8px}\n.pos{color:var(--pos);font-weight:600}.neg{color:var(--neg);font-weight:600}\n.tr{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}\n.tr b{color:var(--signal)}\n.tr .amt{color:var(--harbour)}\n</style>\n</head>\n<body>\n<header><div class=\"wrap\"><h1>Even Keel</h1><p>Owing between friends is normal. Let’s keep it level.</p></div></header>\n<main data-testid=\"app\">\n<section>\n<h2>People</h2>\n<form id=\"pf\" novalidate>\n<label for=\"pn\">Name</label>\n<input type=\"text\" id=\"pn\" data-testid=\"person-name\" autocomplete=\"off\">\n<button class=\"add\" type=\"submit\" data-testid=\"add-person\">Add person</button>\n<p class=\"err\" id=\"pe\" role=\"alert\"></p>\n</form>\n<ul class=\"chips\" id=\"people\" style=\"margin-top:12px\"></ul>\n<p class=\"empty\" id=\"pempty\">Nobody’s on the trip yet. Add the first name above.</p>\n</section>\n\n<section>\n<h2>Add an expense</h2>\n<form id=\"ef\" novalidate>\n<label for=\"ed\">Description</label>\n<input type=\"text\" id=\"ed\" data-testid=\"expense-desc\" autocomplete=\"off\">\n<div class=\"row\"><div><label for=\"ea\">Amount (CAD)</label>\n<input type=\"text\" inputmode=\"decimal\" id=\"ea\" data-testid=\"expense-amount\" placeholder=\"0.00\" autocomplete=\"off\"></div>\n<div><label for=\"ep\">Paid by</label>\n<select id=\"ep\" data-testid=\"expense-payer\"></select></div></div>\n<fieldset id=\"splitset\" style=\"border:0;padding:0;margin:0\"><legend>Split between</legend>\n<div id=\"split\" data-testid=\"expense-split\"></div></fieldset>\n<button class=\"add\" type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"ee\" role=\"alert\"></p>\n</form>\n</section>\n\n<section>\n<h2>Balances</h2>\n<ul id=\"bals\"></ul>\n<p class=\"empty\" id=\"bempty\">Balances show up once people are added.</p>\n</section>\n\n<section>\n<h2>Settle up</h2>\n<ul id=\"trs\"></ul>\n<p class=\"empty\" id=\"tempty\"></p>\n</section>\n\n<section class=\"full\">\n<h2>Expenses</h2>\n<ul id=\"exps\"></ul>\n<p class=\"empty\" id=\"xempty\">No expenses yet. When someone pays for something, log it here.</p>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nlet S;\ntry{S=JSON.parse(localStorage.getItem('evenkeel'))}catch(e){}\nif(!S||!Array.isArray(S.people)||!Array.isArray(S.expenses))S={people:[],expenses:[]};\nconst $=id=>document.getElementById(id);\nconst save=()=>{try{localStorage.setItem('evenkeel',JSON.stringify(S))}catch(e){}};\nconst el=(t,p={},txt)=>{const e=document.createElement(t);Object.assign(e,p);if(txt!=null)e.textContent=txt;return e};\nfunction shares(x){\n const order=S.people.filter(p=>x.split.includes(p));\n const n=order.length,base=Math.floor(x.cents/n);let r=x.cents-base*n;\n const m={};order.forEach(p=>{m[p]=base+(r>0?1:0);if(r>0)r--});return m}\nfunction balances(){\n const b={};S.people.forEach(p=>b[p]=0);\n S.expenses.forEach(x=>{if(x.payer in b)b[x.payer]+=x.cents;const s=shares(x);for(const p in s)b[p]-=s[p]});\n return b}\nfunction transfers(b){\n const cr=[],de=[];\n S.people.forEach(p=>{if(b[p]>0)cr.push({p,c:b[p]});else if(b[p]<0)de.push({p,c:-b[p]})});\n const out=[];\n while(cr.length&&de.length){\n  cr.sort((a,b)=>b.c-a.c);de.sort((a,b)=>b.c-a.c);\n  const c=cr[0],d=de[0],m=Math.min(c.c,d.c);\n  out.push({from:d.p,to:c.p,c:m});c.c-=m;d.c-=m;\n  if(!c.c)cr.shift();if(!d.c)de.shift()}\n return out}\nfunction render(){\n const ppl=$('people');ppl.innerHTML='';\n S.people.forEach(p=>ppl.appendChild(el('li',{},p)).setAttribute('data-testid','person'));\n $('pempty').hidden=S.people.length>0;\n // form controls, preserving state\n const sel=$('ep'),cur=sel.value;sel.innerHTML='';\n S.people.forEach(p=>sel.appendChild(el('option',{value:p},p)));\n if(S.people.includes(cur))sel.value=cur;\n const sp=$('split'),checked=new Set([...sp.querySelectorAll('input:checked')].map(i=>i.value)),known=new Set([...sp.querySelectorAll('input')].map(i=>i.value));\n sp.innerHTML='';\n if(!S.people.length)sp.appendChild(el('span',{className:'sub'},'Add people first.'));\n S.people.forEach((p,i)=>{\n  const l=el('label'),c=el('input',{type:'checkbox',value:p,id:'sp'+i});\n  c.checked=known.has(p)?checked.has(p):true;\n  l.append(c,document.createTextNode(p));sp.appendChild(l)});\n // expenses\n const ex=$('exps');ex.innerHTML='';\n [...S.expenses].reverse().forEach(x=>{\n  const li=el('li');li.setAttribute('data-testid','expense');\n  const d=el('div');\n  d.append(el('div',{className:'amt'},x.desc+' · '+money(x.cents)),\n   el('div',{className:'sub'},x.payer+' paid, split between '+x.split.join(', ')));\n  const b=el('button',{className:'ghost',type:'button'},'Remove');\n  b.setAttribute('data-testid','delete-expense');\n  b.setAttribute('aria-label','Remove '+x.desc);\n  b.onclick=()=>{S.expenses=S.expenses.filter(e=>e.id!==x.id);save();render()};\n  li.className='exp';li.append(d,b);ex.appendChild(li)});\n $('xempty').hidden=S.expenses.length>0;\n // balances\n const bal=balances(),bl=$('bals');bl.innerHTML='';\n S.people.forEach(p=>{\n  const li=el('li',{className:'bal'});\n  li.setAttribute('data-testid','balance');li.setAttribute('data-person',p);li.setAttribute('data-cents',bal[p]);\n  const v=bal[p],t=v>0?money(v)+' owed to them':v<0?'owes '+money(-v):'all even';\n  li.append(el('span',{},p),el('span',{className:v>0?'pos':v<0?'neg':'sub'},t));bl.appendChild(li)});\n $('bempty').hidden=S.people.length>0;\n // transfers\n const tl=$('trs');tl.innerHTML='';\n const ts=transfers(bal);\n ts.forEach(t=>{\n  const li=el('li',{className:'tr'});\n  li.setAttribute('data-testid','transfer');li.setAttribute('data-from',t.from);li.setAttribute('data-to',t.to);li.setAttribute('data-cents',t.c);\n  const s=el('span');s.append(el('b',{},t.from),' pays ',el('b',{},t.to));\n  li.append(s,el('span',{className:'amt'},money(t.c)));tl.appendChild(li)});\n $('tempty').hidden=ts.length>0;\n $('tempty').textContent=S.expenses.length?'You’re all square. Nobody needs to pay anyone.':'Nothing to settle yet. Log an expense and your transfers appear here.';\n}\nfunction showErr(id,inp,msg){\n const e=$(id);e.textContent=msg||'';\n if(msg)e.setAttribute('data-testid','form-error');else e.removeAttribute('data-testid')}\n$('pf').onsubmit=ev=>{\n ev.preventDefault();\n const n=$('pn').value.trim().replace(/\\s+/g,' ');\n if(!n)return showErr('pe',0,'Enter a name to add someone.');\n if(S.people.some(p=>p.toLowerCase()===n.toLowerCase()))return showErr('pe',0,'“'+n+'” is already on the trip. Names must be different.');\n S.people.push(n);save();showErr('pe',0,'');$('pn').value='';render();$('pn').focus()};\n$('ef').onsubmit=ev=>{\n ev.preventDefault();\n const desc=$('ed').value.trim(),a=$('ea').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n const split=[...$('split').querySelectorAll('input:checked')].map(i=>i.value);\n let m=null;\n if(!S.people.length)m='Add the people on the trip before logging expenses.';\n else if(!desc)m='Add a description, like “Groceries”.';\n else if(!a)m='Enter an amount.';\n else if(!/^\\d*\\.?\\d+$|^\\d+\\.$/.test(a)||isNaN(+a))m='Amount must be a number, like 24.50.';\n else if(/\\.\\d{3,}/.test(a))m='Amount can have at most 2 decimal places.';\n else if(!(+a>0))m='Amount must be greater than $0.';\n else if(!$('ep').value)m='Choose who paid.';\n else if(!split.length)m='Pick at least one person to split between.';\n if(m)return showErr('ee',0,m);\n const [w,f='']=a.split('.');\n const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n if(cents<1)return showErr('ee',0,'Amount must be greater than $0.');\n S.expenses.push({id:Date.now()+Math.random(),desc,cents,payer:$('ep').value,split});\n save();showErr('ee',0,'');$('ed').value='';$('ea').value='';render();$('ed').focus()};\nrender();\n</script>\n</body>\n</html>"
    }

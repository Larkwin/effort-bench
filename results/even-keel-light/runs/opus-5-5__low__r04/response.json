    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel — trip expenses</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;--harbour-2:#2C5068;--signal:#C2462B;--signal-dark:#A33A23;\n  --paper:#F6F3EE;--card:#FFFFFF;--line:#DCD6CC;--ink:#1B2730;--muted:#55636E;\n  --owed:#2F6B4F;--owes:#9A3A22;--tint:#EAF0F3;\n  --r:10px;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0}\nbody{background:var(--paper);color:var(--ink);font:16px/1.5 \"Public Sans\",system-ui,sans-serif;overflow-x:hidden}\nh1,h2{font-family:Fraunces,Georgia,serif;font-weight:600;margin:0;color:var(--harbour)}\nheader{background:var(--harbour);color:#fff;padding:20px 16px 26px}\nheader .wrap{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap}\nheader h1{color:#fff;font-size:1.9rem;letter-spacing:-.01em}\nheader p{margin:0;color:#D5E0E7;font-size:.95rem}\n.keel{width:34px;height:34px;flex:none}\n.wrap{max-width:1080px;margin:0 auto}\nmain{padding:20px 16px 48px}\n.grid{display:grid;gap:18px;grid-template-columns:1fr}\n@media(min-width:860px){.grid{grid-template-columns:340px 1fr}.right{display:grid;gap:18px;align-content:start}}\n.left{display:grid;gap:18px;align-content:start}\nsection.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:18px;min-width:0}\nh2{font-size:1.25rem;margin-bottom:4px}\n.sub{color:var(--muted);font-size:.9rem;margin:0 0 14px}\nlabel,.lab{display:block;font-weight:600;font-size:.9rem;margin:0 0 4px;color:var(--ink)}\ninput[type=text],input[type=number],input[inputmode],select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #8C969E;border-radius:8px;background:#fff;color:var(--ink);min-height:44px}\n.row{display:flex;gap:8px}\n.row input{flex:1;min-width:0}\n.field{margin-bottom:12px}\nbutton{font:inherit;font-weight:600;border-radius:8px;border:0;padding:10px 16px;min-height:44px;cursor:pointer}\n.primary{background:var(--signal);color:#fff}\n.primary:hover{background:var(--signal-dark)}\n.secondary{background:var(--harbour);color:#fff}\n.secondary:hover{background:var(--harbour-2)}\n.ghost{background:transparent;color:var(--signal-dark);padding:6px 10px;min-height:36px;border:1px solid transparent}\n.ghost:hover{border-color:var(--line)}\n:focus-visible{outline:3px solid #E39A2C;outline-offset:2px}\ninput:focus-visible,select:focus-visible{border-color:var(--harbour)}\n.err{color:var(--owes);background:#FBECE7;border-left:3px solid var(--signal);padding:8px 10px;border-radius:4px;font-size:.9rem;margin-top:8px}\nul{list-style:none;margin:0;padding:0}\n.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}\n.chips li{background:var(--tint);color:var(--harbour);border-radius:999px;padding:4px 12px;font-weight:500;font-size:.92rem;overflow-wrap:anywhere}\nfieldset{border:0;padding:0;margin:0 0 12px}\nlegend{font-weight:600;font-size:.9rem;padding:0;margin-bottom:4px}\n.split{display:flex;flex-wrap:wrap;gap:6px}\n.split label{display:flex;align-items:center;gap:6px;font-weight:500;border:1.5px solid var(--line);border-radius:8px;padding:6px 10px;margin:0;cursor:pointer}\n.split input{width:18px;height:18px;accent-color:var(--harbour)}\n.empty{color:var(--muted);background:var(--paper);border:1px dashed var(--line);border-radius:8px;padding:14px;font-size:.93rem;margin:0}\n.exp li{display:flex;gap:10px;justify-content:space-between;align-items:flex-start;padding:12px 0;border-top:1px solid var(--line)}\n.exp li:first-child{border-top:0}\n.exp .d{font-weight:600;overflow-wrap:anywhere}\n.exp .m{color:var(--muted);font-size:.88rem;overflow-wrap:anywhere}\n.exp .amt{font-variant-numeric:tabular-nums;font-weight:700;color:var(--harbour);white-space:nowrap}\n.exp .end{display:flex;flex-direction:column;align-items:flex-end;gap:2px}\n.bal li{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid var(--line)}\n.bal li:first-child{border-top:0}\n.bal .n{font-weight:600;overflow-wrap:anywhere}\n.bal .v{font-variant-numeric:tabular-nums;font-weight:700;text-align:right}\n.bal .v small{display:block;font-weight:500;color:var(--muted);font-size:.8rem}\n.pos{color:var(--owed)}.neg{color:var(--owes)}.zero{color:var(--muted)}\n.tr li{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:10px 12px;background:var(--tint);border-radius:8px;margin-bottom:6px}\n.tr .arrow{color:var(--signal)}\n.tr .amt{margin-left:auto;font-weight:700;font-variant-numeric:tabular-nums;color:var(--harbour)}\n.even{color:var(--owed);font-weight:600;margin:0}\n.two{display:grid;gap:18px}\n@media(min-width:620px){.two{grid-template-columns:1fr 1fr}}\n</style>\n</head>\n<body>\n<header><div class=\"wrap\">\n<svg class=\"keel\" viewBox=\"0 0 34 34\" aria-hidden=\"true\"><path d=\"M3 18h28\" stroke=\"#fff\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><path d=\"M8 18c2 8 16 8 18 0\" fill=\"none\" stroke=\"#C2462B\" stroke-width=\"2.5\"/><path d=\"M17 4v14\" stroke=\"#fff\" stroke-width=\"2.5\" stroke-linecap=\"round\"/></svg>\n<div><h1>Even Keel</h1><p>Log who paid. See who owes whom. Everyone ends up even.</p></div>\n</div></header>\n<main data-testid=\"app\"><div class=\"wrap grid\">\n<div class=\"left\">\n<section class=\"card\" aria-labelledby=\"hp\">\n<h2 id=\"hp\">Who's on the trip</h2>\n<p class=\"sub\">Add everyone who's sharing costs.</p>\n<form id=\"pf\" novalidate>\n<label for=\"pn\">Name</label>\n<div class=\"row\"><input id=\"pn\" type=\"text\" data-testid=\"person-name\" autocomplete=\"off\" aria-describedby=\"perr\"><button class=\"secondary\" data-testid=\"add-person\" type=\"submit\">Add</button></div>\n<div id=\"perr\" aria-live=\"polite\"></div>\n</form>\n<ul class=\"chips\" id=\"people\"></ul>\n</section>\n<section class=\"card\" aria-labelledby=\"he\">\n<h2 id=\"he\">Add an expense</h2>\n<p class=\"sub\">Amounts are split equally, to the cent.</p>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"ed\">What was it for?</label><input id=\"ed\" type=\"text\" data-testid=\"expense-desc\" placeholder=\"Groceries, gas, cabin…\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"ea\">Amount (CAD)</label><input id=\"ea\" type=\"text\" inputmode=\"decimal\" data-testid=\"expense-amount\" placeholder=\"0.00\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"ep\">Who paid</label><select id=\"ep\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend>Split between</legend><div class=\"split\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n<button class=\"primary\" data-testid=\"add-expense\" type=\"submit\" style=\"width:100%\">Add expense</button>\n<div id=\"eerr\" aria-live=\"polite\"></div>\n</form>\n</section>\n</div>\n<div class=\"right\">\n<div class=\"two\">\n<section class=\"card\" aria-labelledby=\"hb\"><h2 id=\"hb\">Balances</h2><p class=\"sub\">Paid minus your share.</p><ul class=\"bal\" id=\"bal\"></ul></section>\n<section class=\"card\" aria-labelledby=\"hs\"><h2 id=\"hs\">Settle up</h2><p class=\"sub\">The fewest transfers to get even.</p><ul class=\"tr\" id=\"tr\"></ul></section>\n</div>\n<section class=\"card\" aria-labelledby=\"hx\"><h2 id=\"hx\">Expenses</h2><p class=\"sub\">Newest first.</p><ul class=\"exp\" id=\"exps\"></ul></section>\n</div>\n</div></main>\n<script>\n(function(){\nconst KEY='evenkeel.v1';\nlet S={people:[],expenses:[],nid:1};\ntry{const d=JSON.parse(localStorage.getItem(KEY));if(d&&Array.isArray(d.people)&&Array.isArray(d.expenses))S=Object.assign(S,d);}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}};\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nconst $=id=>document.getElementById(id);\nconst el=(t,a={},txt)=>{const e=document.createElement(t);for(const k in a)e.setAttribute(k,a[k]);if(txt!=null)e.textContent=txt;return e};\nfunction showErr(box,msg,input){box.innerHTML='';if(msg){const e=el('p',{class:'err','data-testid':'form-error',role:'alert'},msg);box.appendChild(e);if(input){input.setAttribute('aria-invalid','true');input.focus();}}}\nfunction shares(exp){\n  const sel=S.people.filter(p=>exp.split.includes(p));\n  const n=sel.length,base=Math.floor(exp.cents/n),rem=exp.cents-base*n,out={};\n  sel.forEach((p,i)=>out[p]=base+(i<rem?1:0));return out;\n}\nfunction balances(){\n  const b={};S.people.forEach(p=>b[p]=0);\n  S.expenses.forEach(x=>{if(b[x.payer]!=null)b[x.payer]+=x.cents;const s=shares(x);for(const p in s)b[p]-=s[p];});\n  return b;\n}\nfunction settle(b){\n  const cr=[],db=[];S.people.forEach(p=>{if(b[p]>0)cr.push([p,b[p]]);else if(b[p]<0)db.push([p,-b[p]]);});\n  const t=[];let i=0,j=0;\n  while(i<db.length&&j<cr.length){const a=Math.min(db[i][1],cr[j][1]);t.push({from:db[i][0],to:cr[j][0],cents:a});db[i][1]-=a;cr[j][1]-=a;if(!db[i][1])i++;if(!cr[j][1])j++;}\n  return t;\n}\nfunction render(){\n  const pl=$('people');pl.innerHTML='';\n  if(!S.people.length){const li=el('li',{class:'empty',style:'background:var(--paper);color:var(--muted);border-radius:8px'},'No one yet. Start with your own name.');pl.appendChild(li);}\n  S.people.forEach(p=>pl.appendChild(el('li',{'data-testid':'person'},p)));\n  const ep=$('ep'),prev=ep.value;ep.innerHTML='';\n  if(!S.people.length)ep.appendChild(el('option',{value:''},'Add people first'));\n  S.people.forEach(p=>{const o=el('option',{value:p},p);ep.appendChild(o)});\n  if(S.people.includes(prev))ep.value=prev;\n  const es=$('es'),checked={};es.querySelectorAll('input').forEach(c=>checked[c.value]=c.checked);es.innerHTML='';\n  if(!S.people.length)es.appendChild(el('p',{class:'empty'},'People you add will appear here.'));\n  S.people.forEach((p,i)=>{const l=el('label');const c=el('input',{type:'checkbox',value:p});c.checked=p in checked?checked[p]:true;l.appendChild(c);l.appendChild(document.createTextNode(p));es.appendChild(l)});\n  const xl=$('exps');xl.innerHTML='';\n  if(!S.expenses.length)xl.appendChild(el('li',{class:'empty',style:'display:block'},'No expenses yet. When someone pays for something, add it here.'));\n  [...S.expenses].reverse().forEach(x=>{\n    const li=el('li',{'data-testid':'expense'});const l=el('div');l.style.minWidth='0';\n    l.appendChild(el('div',{class:'d'},x.desc));\n    const sp=S.people.filter(p=>x.split.includes(p));\n    l.appendChild(el('div',{class:'m'},x.payer+' paid · split between '+(sp.length===S.people.length&&sp.length>1?'everyone ('+sp.join(', ')+')':sp.join(', '))));\n    const r=el('div',{class:'end'});r.appendChild(el('span',{class:'amt'},money(x.cents)));\n    const b=el('button',{type:'button',class:'ghost','data-testid':'delete-expense','aria-label':'Remove '+x.desc},'Remove');\n    b.onclick=()=>{S.expenses=S.expenses.filter(e=>e.id!==x.id);save();render();$('ed').focus();};\n    r.appendChild(b);li.appendChild(l);li.appendChild(r);xl.appendChild(li);\n  });\n  const b=balances(),bl=$('bal');bl.innerHTML='';\n  if(!S.people.length)bl.appendChild(el('li',{class:'empty',style:'display:block'},'Balances show up once people are on the trip.'));\n  S.people.forEach(p=>{const c=b[p];const li=el('li',{'data-testid':'balance','data-person':p,'data-cents':String(c)});\n    li.appendChild(el('span',{class:'n'},p));const v=el('span',{class:'v '+(c>0?'pos':c<0?'neg':'zero')},(c>0?'+':c<0?'−':'')+money(Math.abs(c)));\n    v.appendChild(el('small',{},c>0?'is owed':c<0?'owes':'even'));li.appendChild(v);bl.appendChild(li);});\n  const t=settle(b),tl=$('tr');tl.innerHTML='';\n  if(!S.expenses.length)tl.appendChild(el('li',{class:'empty',style:'display:block;background:var(--paper)'},'Nothing to settle yet.'));\n  else if(!t.length)tl.appendChild(el('li',{class:'even',style:'background:#E7F1EB'},'Everyone is even. Nothing to pay.'));\n  t.forEach(x=>{const li=el('li',{'data-testid':'transfer','data-from':x.from,'data-to':x.to,'data-cents':String(x.cents)});\n    li.appendChild(el('strong',{},x.from));li.appendChild(el('span',{class:'arrow','aria-hidden':'true'},'→'));li.appendChild(el('span',{class:'sr',style:'position:absolute;left:-9999px'},' pays '));\n    li.appendChild(el('strong',{},x.to));li.appendChild(el('span',{class:'amt'},money(x.cents)));tl.appendChild(li);});\n}\n$('pf').addEventListener('submit',e=>{e.preventDefault();const i=$('pn'),n=i.value.trim(),box=$('perr');\n  if(!n)return showErr(box,'Type a name to add someone.',i);\n  if(S.people.some(p=>p.toLowerCase()===n.toLowerCase()))return showErr(box,'“'+n+'” is already on the trip. Try a different name, like adding an initial.',i);\n  S.people.push(n);save();i.value='';i.removeAttribute('aria-invalid');showErr(box,'');render();i.focus();});\n$('ef').addEventListener('submit',e=>{e.preventDefault();const box=$('eerr'),d=$('ed'),a=$('ea');\n  [d,a].forEach(x=>x.removeAttribute('aria-invalid'));\n  if(!S.people.length)return showErr(box,'Add at least one person before logging an expense.',$('pn'));\n  const desc=d.value.trim();if(!desc)return showErr(box,'Add a short description, like “Groceries”.',d);\n  const raw=a.value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  if(!/^\\d+(\\.\\d{1,2})?$|^\\.\\d{1,2}$/.test(raw))return showErr(box,'Enter the amount as a number with up to 2 decimal places, like 42.50.',a);\n  const [w,f='']=raw.split('.');const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(!(cents>0))return showErr(box,'The amount needs to be more than $0.00.',a);\n  if(cents>Number.MAX_SAFE_INTEGER/10)return showErr(box,'That amount is too large.',a);\n  const payer=$('ep').value;if(!S.people.includes(payer))return showErr(box,'Choose who paid.',$('ep'));\n  const split=[...$('es').querySelectorAll('input:checked')].map(c=>c.value).filter(v=>S.people.includes(v));\n  if(!split.length)return showErr(box,'Pick at least one person to split this between.',$('es').querySelector('input'));\n  S.expenses.push({id:S.nid++,desc,cents,payer,split});save();d.value='';a.value='';showErr(box,'');\n  $('es').querySelectorAll('input').forEach(c=>c.checked=true);render();d.focus();});\nrender();\n})();\n</script>\n</body>\n</html>"
    }

  "content": [
    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel · Trip expenses, settled fairly</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D; --harbour-2:#2F5570; --signal:#C2462B; --signal-dark:#9E3520;\n  --sand:#F6F2EA; --paper:#FFFFFF; --ink:#1B2630; --muted:#55636F; --line:#D9D3C7;\n  --owed:#1E6B4A; --owe:#9E3520; --tint:#E8EEF2;\n}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;background:var(--sand);color:var(--ink);font:16px/1.5 \"Public Sans\",system-ui,sans-serif}\nh1,h2,h3{font-family:Fraunces,Georgia,serif;margin:0;color:var(--harbour);line-height:1.2}\nheader.top{background:var(--harbour);color:#fff;padding:20px 16px 22px;border-bottom:6px solid var(--signal)}\n.top-in{max-width:1080px;margin:0 auto}\n.brand{font-family:Fraunces,serif;font-weight:700;font-size:1.6rem;letter-spacing:.01em;margin:0;color:#fff}\n.tag{margin:2px 0 0;color:#D6E2EA}\nmain{max-width:1080px;margin:0 auto;padding:20px 16px 48px;display:grid;gap:20px;grid-template-columns:1fr}\n@media(min-width:860px){main{grid-template-columns:1fr 1fr;align-items:start;gap:24px}\n .col-wide{grid-column:1/-1}}\n.col{display:grid;gap:20px;min-width:0}\nsection.card{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:18px;min-width:0}\nsection.card h2{font-size:1.25rem;margin-bottom:4px}\n.hint{color:var(--muted);margin:0 0 14px;font-size:.95rem}\nlabel,legend{display:block;font-weight:600;font-size:.9rem;margin-bottom:4px;color:var(--harbour);padding:0}\ninput[type=text],input[type=number],input:not([type]),select{width:100%;min-height:44px;padding:9px 12px;border:1.5px solid #8A97A1;border-radius:8px;font:inherit;background:#fff;color:var(--ink)}\n.row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}\n.row .grow{flex:1 1 180px;min-width:0}\n.field{margin-bottom:14px}\n.two{display:grid;gap:14px;grid-template-columns:1fr}\n@media(min-width:480px){.two{grid-template-columns:1fr 1fr}}\nbutton{font:inherit;font-weight:600;min-height:44px;padding:9px 18px;border-radius:8px;border:2px solid transparent;cursor:pointer}\n.primary{background:var(--harbour);color:#fff}\n.primary:hover{background:var(--harbour-2)}\n.ghost{background:transparent;color:var(--signal-dark);border-color:var(--line);min-height:40px;padding:6px 12px}\n.ghost:hover{border-color:var(--signal);background:#FBEDE9}\n:focus-visible{outline:3px solid var(--signal);outline-offset:2px}\nheader.top :focus-visible{outline-color:#fff}\n.err{color:#8F2C16;background:#FBEDE9;border-left:4px solid var(--signal);padding:8px 12px;border-radius:4px;margin:10px 0 0;font-weight:500}\n.err[hidden]{display:none}\nul{list-style:none;margin:0;padding:0}\n.people{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}\n.people li{background:var(--tint);color:var(--harbour);padding:6px 14px;border-radius:999px;font-weight:600}\n.empty{color:var(--muted);background:var(--sand);border:1.5px dashed var(--line);border-radius:8px;padding:14px;margin:0}\nfieldset{border:0;padding:0;margin:0 0 14px;min-width:0}\n.split{display:grid;gap:6px;grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}\n.split label{display:flex;align-items:center;gap:8px;font-weight:500;color:var(--ink);margin:0;min-height:40px;padding:4px 10px;border:1.5px solid var(--line);border-radius:8px;cursor:pointer;overflow-wrap:anywhere}\n.split input{width:20px;height:20px;accent-color:var(--harbour);flex:none}\n.exp{border-top:1px solid var(--line);padding:14px 0;display:flex;gap:12px;justify-content:space-between;align-items:flex-start}\n.exp:first-child{border-top:0}\n.exp .info{min-width:0}\n.exp .d{font-weight:700;overflow-wrap:anywhere}\n.exp .m{color:var(--muted);font-size:.92rem;overflow-wrap:anywhere}\n.amt{font-family:Fraunces,serif;font-weight:700;font-size:1.15rem;color:var(--harbour);white-space:nowrap}\n.exp .side{display:flex;flex-direction:column;align-items:flex-end;gap:6px}\n.bal{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--line)}\n.bal:first-child{border-top:0}\n.bal .n{font-weight:600;overflow-wrap:anywhere}\n.bal .v{font-weight:700;text-align:right}\n.bal small{display:block;font-weight:500;color:var(--muted)}\n.pos{color:var(--owed)} .neg{color:var(--owe)} .zero{color:var(--muted)}\n.tr{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--tint);border-left:5px solid var(--signal);border-radius:6px;padding:12px 14px;margin-bottom:8px}\n.tr .t{flex:1 1 180px;overflow-wrap:anywhere}\n.tr .a{font-family:Fraunces,serif;font-weight:700;font-size:1.15rem;color:var(--harbour)}\n.calm{color:var(--owed);font-weight:600;margin:0}\n</style>\n</head>\n<body>\n<header class=\"top\"><div class=\"top-in\">\n<h1 class=\"brand\">Even Keel</h1>\n<p class=\"tag\">Split trip costs fairly. Owing a friend is normal; this just shows you how to square up.</p>\n</div></header>\n\n<main data-testid=\"app\">\n<div class=\"col\">\n<section class=\"card\" aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People on the trip</h2>\n<p class=\"hint\">Add everyone who is sharing costs. Order matters only for leftover cents.</p>\n<form id=\"pform\" novalidate>\n<div class=\"row\">\n<div class=\"grow\"><label for=\"pname\">Name</label>\n<input type=\"text\" id=\"pname\" data-testid=\"person-name\" autocomplete=\"off\" aria-describedby=\"perr\"></div>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n</div>\n<p class=\"err\" id=\"perr\" role=\"alert\" data-testid=\"form-error\" hidden></p>\n</form>\n<div id=\"plist\"></div>\n</section>\n\n<section class=\"card\" aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Add an expense</h2>\n<p class=\"hint\">Log what was paid and who shares it.</p>\n<form id=\"eform\" novalidate>\n<div class=\"field\"><label for=\"edesc\">What was it for?</label>\n<input type=\"text\" id=\"edesc\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"two\">\n<div class=\"field\"><label for=\"eamt\">Amount (CAD)</label>\n<input type=\"text\" inputmode=\"decimal\" id=\"eamt\" data-testid=\"expense-amount\" placeholder=\"0.00\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"epayer\">Paid by</label>\n<select id=\"epayer\" data-testid=\"expense-payer\"></select></div>\n</div>\n<fieldset><legend>Split between</legend>\n<div class=\"split\" id=\"esplit\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"eerr\" role=\"alert\" data-testid=\"form-error\" hidden></p>\n</form>\n</section>\n</div>\n\n<div class=\"col\">\n<section class=\"card\" aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<p class=\"hint\">Positive means you're owed. Negative means you owe.</p>\n<div id=\"blist\"></div>\n</section>\n\n<section class=\"card\" aria-labelledby=\"h-set\">\n<h2 id=\"h-set\">Settle up</h2>\n<p class=\"hint\">The fewest payments that put everyone even.</p>\n<div id=\"slist\"></div>\n</section>\n</div>\n\n<section class=\"card col-wide\" aria-labelledby=\"h-list\">\n<h2 id=\"h-list\">Expenses</h2>\n<p class=\"hint\">Newest first.</p>\n<div id=\"xlist\"></div>\n</section>\n</main>\n\n<script>\n(function(){\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nconst KEY='evenkeel.v1';\nlet state={people:[],expenses:[]};\ntry{const s=JSON.parse(localStorage.getItem(KEY));\n if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=s}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};\nconst $=id=>document.getElementById(id);\nconst el=(t,c,txt)=>{const e=document.createElement(t);if(c)e.className=c;if(txt!=null)e.textContent=txt;return e};\n\nfunction showErr(id,msg){const e=$(id);if(msg){e.textContent=msg;e.hidden=false}else{e.textContent='';e.hidden=true}}\n\nfunction shares(exp){\n const order=state.people.filter(p=>exp.split.includes(p));\n const n=order.length,base=Math.floor(exp.cents/n);let rem=exp.cents-base*n;\n const out={};\n order.forEach(p=>{out[p]=base+(rem>0?1:0);if(rem>0)rem--});\n return out;\n}\nfunction balances(){\n const b={};state.people.forEach(p=>b[p]=0);\n state.expenses.forEach(x=>{\n  if(x.payer in b)b[x.payer]+=x.cents;\n  const s=shares(x);for(const p in s)b[p]-=s[p];\n });\n return b;\n}\nfunction settle(b){\n const cr=[],de=[];\n state.people.forEach(p=>{if(b[p]>0)cr.push({p,c:b[p]});else if(b[p]<0)de.push({p,c:-b[p]})});\n const out=[];\n while(cr.length&&de.length){\n  cr.sort((a,b)=>b.c-a.c);de.sort((a,b)=>b.c-a.c);\n  const c=cr[0],d=de[0],m=Math.min(c.c,d.c);\n  out.push({from:d.p,to:c.p,c:m});\n  c.c-=m;d.c-=m;\n  if(c.c===0)cr.shift();if(d.c===0)de.shift();\n }\n return out;\n}\n\nfunction renderPeople(){\n const box=$('plist');box.textContent='';\n if(!state.people.length){box.appendChild(el('p','empty','No one is on the trip yet. Add the first name above to get started.'));box.firstChild.style.marginTop='14px';return}\n const ul=el('ul','people');\n state.people.forEach(p=>{const li=el('li',null,p);li.setAttribute('data-testid','person');ul.appendChild(li)});\n box.appendChild(ul);\n}\nfunction renderForm(){\n const sel=$('epayer');const prev=sel.value;\n const checked=new Set([...document.querySelectorAll('#esplit input:checked')].map(i=>i.value));\n const had=new Set([...document.querySelectorAll('#esplit input')].map(i=>i.value));\n sel.textContent='';\n state.people.forEach(p=>{const o=el('option',null,p);o.value=p;sel.appendChild(o)});\n if(state.people.includes(prev))sel.value=prev;\n const sp=$('esplit');sp.textContent='';\n if(!state.people.length){sp.appendChild(el('p','empty','Add people first, then choose who shares the cost.'));sp.style.display='block';return}\n sp.style.display='';\n state.people.forEach((p,i)=>{\n  const l=el('label');const cb=document.createElement('input');\n  cb.type='checkbox';cb.value=p;cb.checked=had.has(p)?checked.has(p):true;\n  l.appendChild(cb);l.appendChild(el('span',null,p));sp.appendChild(l);\n });\n}\nfunction renderBalances(){\n const box=$('blist');box.textContent='';\n if(!state.people.length){box.appendChild(el('p','empty','Balances appear once people are added.'));return}\n const b=balances();\n state.people.forEach(p=>{\n  const r=el('div','bal');r.setAttribute('data-testid','balance');\n  r.setAttribute('data-person',p);r.setAttribute('data-cents',String(b[p]));\n  r.appendChild(el('span','n',p));\n  const v=el('span','v '+(b[p]>0?'pos':b[p]<0?'neg':'zero'),money(Math.abs(b[p])*(b[p]<0?-1:1)));\n  v.appendChild(el('small',null,b[p]>0?'is owed':b[p]<0?'owes':'all even'));\n  r.appendChild(v);box.appendChild(r);\n });\n}\nfunction renderSettle(){\n const box=$('slist');box.textContent='';\n if(!state.expenses.length){box.appendChild(el('p','empty','Nothing to settle yet. Log an expense and your transfers will show here.'));return}\n const t=settle(balances());\n if(!t.length){box.appendChild(el('p','calm','Everyone is even. Nothing to pay.'));return}\n t.forEach(x=>{\n  const d=el('div','tr');d.setAttribute('data-testid','transfer');\n  d.setAttribute('data-from',x.from);d.setAttribute('data-to',x.to);d.setAttribute('data-cents',String(x.c));\n  const s=el('span','t');\n  s.appendChild(el('strong',null,x.from));s.appendChild(document.createTextNode(' pays '));s.appendChild(el('strong',null,x.to));\n  d.appendChild(s);d.appendChild(el('span','a',money(x.c)));box.appendChild(d);\n });\n}\nfunction renderExpenses(){\n const box=$('xlist');box.textContent='';\n if(!state.expenses.length){box.appendChild(el('p','empty','No expenses yet. When someone pays for something, add it above.'));return}\n [...state.expenses].reverse().forEach(x=>{\n  const r=el('div','exp');r.setAttribute('data-testid','expense');\n  const i=el('div','info');\n  i.appendChild(el('div','d',x.desc));\n  i.appendChild(el('div','m','Paid by '+x.payer));\n  i.appendChild(el('div','m','Split between '+state.people.filter(p=>x.split.includes(p)).join(', ')));\n  const s=el('div','side');\n  s.appendChild(el('span','amt',money(x.cents)));\n  const bt=el('button','ghost','Remove');bt.type='button';\n  bt.setAttribute('data-testid','delete-expense');\n  bt.setAttribute('aria-label','Remove expense '+x.desc);\n  bt.addEventListener('click',()=>{state.expenses=state.expenses.filter(e=>e.id!==x.id);save();renderAll()});\n  s.appendChild(bt);r.appendChild(i);r.appendChild(s);box.appendChild(r);\n });\n}\nfunction renderAll(){renderPeople();renderForm();renderBalances();renderSettle();renderExpenses()}\n\n$('pform').addEventListener('submit',e=>{\n e.preventDefault();\n const inp=$('pname'),name=inp.value.trim();\n if(!name)return showErr('perr','Enter a name to add someone.');\n if(state.people.some(p=>p.toLowerCase()===name.toLowerCase()))return showErr('perr',name+' is already on the trip. Names must be different, ignoring capitals.');\n state.people.push(name);save();showErr('perr','');inp.value='';renderAll();inp.focus();\n});\n$('eform').addEventListener('submit',e=>{\n e.preventDefault();\n const desc=$('edesc').value.trim(),raw=$('eamt').value.trim().replace(/^\\$/,'');\n const payer=$('epayer').value;\n const split=[...document.querySelectorAll('#esplit input:checked')].map(i=>i.value);\n if(!state.people.length)return showErr('eerr','Add at least one person before logging an expense.');\n if(!desc)return showErr('eerr','Add a description so everyone knows what this was for.');\n if(!raw)return showErr('eerr','Enter the amount in Canadian dollars.');\n if(!/^\\d*\\.?\\d+$|^\\d+\\.$/.test(raw)||/\\.\\d{3,}/.test(raw))\n  return showErr('eerr',/\\.\\d{3,}/.test(raw)?'Use at most 2 decimal places for the amount.':'Enter the amount as a number, like 42.50.');\n const cents=Math.round(parseFloat(raw)*100);\n if(!(cents>0))return showErr('eerr','The amount must be greater than $0.');\n if(!payer)return showErr('eerr','Choose who paid.');\n if(!split.length)return showErr('eerr','Choose at least one person to split this between.');\n state.expenses.push({id:Date.now()+Math.random(),desc,cents,payer,split});\n save();showErr('eerr','');$('edesc').value='';$('eamt').value='';\n renderAll();$('edesc').focus();\n});\nrenderAll();\n})();\n</script>\n</body>\n</html>"
    }

  "content": [
    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel: trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Public+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;--harbour-2:#2C5068;--signal:#C2462B;--signal-dk:#A33A22;\n  --sand:#F6F2EA;--paper:#FFFDF9;--line:#DCD4C6;--ink:#1B2730;--muted:#55636D;\n  --owed:#1E6B4F;--owes:#A33A22;--focus:#C2462B;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0}\nbody{background:var(--sand);color:var(--ink);font:400 16px/1.5 \"Public Sans\",system-ui,sans-serif;-webkit-font-smoothing:antialiased}\nh1,h2{font-family:Fraunces,Georgia,serif;font-weight:650;letter-spacing:-.01em;margin:0}\nheader{background:var(--harbour);color:#fff;padding:28px 20px 72px}\n.wrap{max-width:1080px;margin:0 auto}\n.brand{display:flex;align-items:center;gap:12px}\n.brand svg{flex:none}\nh1{font-size:1.75rem}\nheader p{margin:8px 0 0;color:#D5E0E8;max-width:36rem}\nmain{max-width:1080px;margin:-48px auto 48px;padding:0 16px;display:grid;gap:20px;grid-template-columns:1fr}\n@media(min-width:880px){main{grid-template-columns:minmax(0,5fr) minmax(0,7fr)}.col{display:grid;gap:20px;align-content:start}}\n.col{display:grid;gap:20px;align-content:start;min-width:0}\nsection{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:20px;min-width:0}\nsection h2{font-size:1.25rem;color:var(--harbour);margin-bottom:4px}\n.sub{color:var(--muted);margin:0 0 16px;font-size:.94rem}\nlabel,.lbl{display:block;font-weight:600;font-size:.9rem;margin-bottom:6px;color:var(--ink)}\ninput[type=text],select{width:100%;font:inherit;padding:10px 12px;border:1.5px solid #8A969E;border-radius:8px;background:#fff;color:var(--ink);min-height:44px}\ninput:focus-visible,select:focus-visible,button:focus-visible,.chk input:focus-visible{outline:3px solid var(--focus);outline-offset:2px}\n.row{display:flex;gap:8px}\n.row input{flex:1;min-width:0}\n.field{margin-bottom:14px}\n.grid2{display:grid;gap:14px;grid-template-columns:1fr}\n@media(min-width:520px){.grid2{grid-template-columns:1fr 1fr}}\nbutton{font:600 .95rem \"Public Sans\",sans-serif;border-radius:8px;border:0;padding:10px 16px;min-height:44px;cursor:pointer}\n.primary{background:var(--harbour);color:#fff}\n.primary:hover{background:var(--harbour-2)}\n.accent{background:var(--signal);color:#fff}\n.accent:hover{background:var(--signal-dk)}\n.ghost{background:transparent;color:var(--signal-dk);border:1.5px solid transparent;padding:6px 10px;min-height:36px}\n.ghost:hover{border-color:var(--line)}\n.err{color:var(--owes);font-weight:600;font-size:.9rem;margin:8px 0 0;display:flex;gap:6px}\n.err::before{content:\"!\";display:inline-grid;place-items:center;width:18px;height:18px;border-radius:50%;background:var(--owes);color:#fff;font-size:.75rem;flex:none;margin-top:2px}\nul{list-style:none;margin:0;padding:0}\n.people{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}\n.people li{background:#EAF0F4;color:var(--harbour);border-radius:999px;padding:5px 12px;font-weight:600;font-size:.92rem;overflow-wrap:anywhere}\nfieldset{border:0;padding:0;margin:0 0 14px;min-width:0}\nlegend{font-weight:600;font-size:.9rem;margin-bottom:6px;padding:0}\n.chips{display:flex;flex-wrap:wrap;gap:8px}\n.chk{display:flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:8px;padding:8px 12px;font-weight:500;margin:0;cursor:pointer;overflow-wrap:anywhere}\n.chk input{width:18px;height:18px;accent-color:var(--harbour);margin:0}\n.splitbtns{display:flex;gap:4px;margin-top:6px}\n.empty{color:var(--muted);background:var(--sand);border:1.5px dashed var(--line);border-radius:10px;padding:16px;margin:0;font-size:.94rem}\n.exp li{display:flex;gap:12px;align-items:flex-start;padding:14px 0;border-top:1px solid var(--line)}\n.exp li:first-child{border-top:0;padding-top:0}\n.exp .body{flex:1;min-width:0}\n.exp .t{font-weight:600;overflow-wrap:anywhere}\n.exp .m{color:var(--muted);font-size:.9rem;overflow-wrap:anywhere}\n.amt{font-variant-numeric:tabular-nums;font-weight:700;white-space:nowrap}\n.bal li{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line);align-items:baseline}\n.bal li:first-child{border-top:0}\n.bal .n{font-weight:600;overflow-wrap:anywhere;min-width:0}\n.bal .s{font-size:.85rem;color:var(--muted);display:block;font-weight:400}\n.pos{color:var(--owed)}.neg{color:var(--owes)}.zero{color:var(--muted)}\n.tr li{display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;padding:12px 14px;background:#EAF0F4;border-radius:10px;margin-bottom:8px;border-left:4px solid var(--signal)}\n.tr .who{flex:1;min-width:0;overflow-wrap:anywhere}\n.tr b{color:var(--harbour)}\n.total{display:flex;justify-content:space-between;color:var(--muted);font-size:.9rem;margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\nfooter{text-align:center;color:var(--muted);font-size:.85rem;padding:0 16px 32px}\n</style>\n</head>\n<body>\n<header><div class=\"wrap\">\n  <div class=\"brand\">\n    <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" aria-hidden=\"true\"><circle cx=\"17\" cy=\"17\" r=\"16\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"/><path d=\"M6 19h22\" stroke=\"#C2462B\" stroke-width=\"3\" stroke-linecap=\"round\"/><path d=\"M9 23c3 2 13 2 16 0\" stroke=\"#fff\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n    <h1>Even Keel</h1>\n  </div>\n  <p>Add who's on the trip, log what each of you paid, and see the few transfers that leave everyone even.</p>\n</div></header>\n\n<main data-testid=\"app\">\n  <div class=\"col\">\n    <section aria-labelledby=\"h-people\">\n      <h2 id=\"h-people\">People</h2>\n      <p class=\"sub\">Everyone sharing costs on this trip.</p>\n      <form id=\"pform\" novalidate>\n        <label for=\"pname\">Name</label>\n        <div class=\"row\">\n          <input type=\"text\" id=\"pname\" data-testid=\"person-name\" autocomplete=\"off\" aria-describedby=\"perr\">\n          <button class=\"primary\" type=\"submit\" data-testid=\"add-person\">Add person</button>\n        </div>\n        <div id=\"perr\" aria-live=\"polite\"></div>\n      </form>\n      <div id=\"plist\"></div>\n    </section>\n\n    <section aria-labelledby=\"h-add\">\n      <h2 id=\"h-add\">Add an expense</h2>\n      <p class=\"sub\">Split equally, to the cent.</p>\n      <form id=\"eform\" novalidate>\n        <div class=\"field\"><label for=\"edesc\">What was it for?</label>\n          <input type=\"text\" id=\"edesc\" data-testid=\"expense-desc\" placeholder=\"Groceries, gas, cabin…\" autocomplete=\"off\"></div>\n        <div class=\"grid2\">\n          <div class=\"field\"><label for=\"eamt\">Amount (CAD)</label>\n            <input type=\"text\" id=\"eamt\" data-testid=\"expense-amount\" inputmode=\"decimal\" placeholder=\"0.00\" autocomplete=\"off\"></div>\n          <div class=\"field\"><label for=\"epayer\">Paid by</label>\n            <select id=\"epayer\" data-testid=\"expense-payer\"></select></div>\n        </div>\n        <fieldset>\n          <legend>Split between</legend>\n          <div class=\"chips\" id=\"esplit\" data-testid=\"expense-split\"></div>\n          <div class=\"splitbtns\" id=\"splitbtns\"></div>\n        </fieldset>\n        <button class=\"accent\" type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n        <div id=\"eerr\" aria-live=\"polite\"></div>\n      </form>\n    </section>\n  </div>\n\n  <div class=\"col\">\n    <section aria-labelledby=\"h-settle\">\n      <h2 id=\"h-settle\">Settle up</h2>\n      <p class=\"sub\">The shortest way for everyone to end up even.</p>\n      <div id=\"tlist\" aria-live=\"polite\"></div>\n    </section>\n    <section aria-labelledby=\"h-bal\">\n      <h2 id=\"h-bal\">Balances</h2>\n      <p class=\"sub\">What you paid minus your share.</p>\n      <div id=\"blist\"></div>\n    </section>\n    <section aria-labelledby=\"h-exp\">\n      <h2 id=\"h-exp\">Expenses</h2>\n      <p class=\"sub\">Newest first.</p>\n      <div id=\"elist\"></div>\n    </section>\n  </div>\n</main>\n<footer>Saved on this device. Owing a friend is normal. This just keeps it clear.</footer>\n\n<script>\n(function(){\nconst KEY='evenkeel.v1';\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nlet S={people:[],expenses:[],nextId:1};\ntry{const d=JSON.parse(localStorage.getItem(KEY));if(d&&Array.isArray(d.people)&&Array.isArray(d.expenses))S=Object.assign(S,d);}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}};\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nlet splitSel=null; // set of names; null = everyone\n\nfunction showErr(el,msg){el.innerHTML=msg?'<p class=\"err\" data-testid=\"form-error\" role=\"alert\">'+esc(msg)+'</p>':'';}\n\nfunction shares(e){\n  const order=S.people.filter(p=>e.split.includes(p));\n  const n=order.length,base=Math.floor(e.cents/n),rem=e.cents-base*n,out={};\n  order.forEach((p,i)=>out[p]=base+(i<rem?1:0));\n  return out;\n}\nfunction balances(){\n  const b={};S.people.forEach(p=>b[p]=0);\n  S.expenses.forEach(e=>{\n    b[e.payer]=(b[e.payer]||0)+e.cents;\n    const sh=shares(e);for(const p in sh)b[p]-=sh[p];\n  });\n  return b;\n}\nfunction transfers(b){\n  const cr=[],db=[];\n  S.people.forEach(p=>{if(b[p]>0)cr.push({p,v:b[p]});else if(b[p]<0)db.push({p,v:-b[p]});});\n  cr.sort((a,c)=>c.v-a.v);db.sort((a,c)=>c.v-a.v);\n  const out=[];let i=0,j=0;\n  while(i<db.length&&j<cr.length){\n    const m=Math.min(db[i].v,cr[j].v);\n    out.push({from:db[i].p,to:cr[j].p,c:m});\n    db[i].v-=m;cr[j].v-=m;\n    if(!db[i].v)i++;if(!cr[j].v)j++;\n  }\n  return out;\n}\n\nfunction render(){\n  const P=S.people;\n  $('plist').innerHTML=P.length?'<ul class=\"people\">'+P.map(p=>'<li data-testid=\"person\">'+esc(p)+'</li>').join('')+'</ul>'\n    :'<p class=\"empty\" style=\"margin-top:14px\">No one yet. Start by adding yourself, then your friends.</p>';\n\n  const prevPayer=$('epayer').value;\n  $('epayer').innerHTML=P.length?P.map(p=>'<option value=\"'+esc(p)+'\">'+esc(p)+'</option>').join(''):'<option value=\"\">Add people first</option>';\n  if(P.includes(prevPayer))$('epayer').value=prevPayer;\n  $('epayer').disabled=!P.length;\n\n  const sel=splitSel?splitSel:new Set(P);\n  $('esplit').innerHTML=P.length?P.map((p,i)=>'<label class=\"chk\"><input type=\"checkbox\" value=\"'+esc(p)+'\"'+(sel.has(p)?' checked':'')+'> '+esc(p)+'</label>').join('')\n    :'<p class=\"empty\" style=\"width:100%\">People you add will appear here.</p>';\n  $('splitbtns').innerHTML=P.length>1?'<button type=\"button\" class=\"ghost\" data-all=\"1\">Everyone</button><button type=\"button\" class=\"ghost\" data-all=\"0\">No one</button>':'';\n\n  const ex=S.expenses.slice().reverse();\n  $('elist').innerHTML=ex.length?'<ul class=\"exp\">'+ex.map(e=>{\n    const all=e.split.length===P.length&&P.length>1;\n    return '<li data-testid=\"expense\"><div class=\"body\"><div class=\"t\">'+esc(e.desc)+'</div><div class=\"m\">'+esc(e.payer)+' paid · split '+(all?'between everyone':'between '+esc(S.people.filter(p=>e.split.includes(p)).join(', ')))+'</div></div><span class=\"amt\">'+money(e.cents)+'</span><button class=\"ghost\" data-testid=\"delete-expense\" data-id=\"'+e.id+'\" aria-label=\"Remove '+esc(e.desc)+'\">Remove</button></li>';\n  }).join('')+'</ul><div class=\"total\"><span>Trip total</span><span class=\"amt\">'+money(S.expenses.reduce((a,e)=>a+e.cents,0))+'</span></div>'\n    :'<p class=\"empty\">No expenses yet. When someone pays for something, add it here.</p>';\n\n  const b=balances();\n  $('blist').innerHTML=P.length?'<ul class=\"bal\">'+P.map(p=>{\n    const c=b[p],cls=c>0?'pos':c<0?'neg':'zero',lab=c>0?'is owed':c<0?'owes':'even';\n    return '<li data-testid=\"balance\" data-person=\"'+esc(p)+'\" data-cents=\"'+c+'\"><span class=\"n\">'+esc(p)+'<span class=\"s\">'+lab+'</span></span><span class=\"amt '+cls+'\">'+(c>0?'+':c<0?'−':'')+money(Math.abs(c))+'</span></li>';\n  }).join('')+'</ul>':'<p class=\"empty\">Balances show up once people are on the trip.</p>';\n\n  const T=transfers(b);\n  $('tlist').innerHTML=T.length?'<ul class=\"tr\">'+T.map(t=>'<li data-testid=\"transfer\" data-from=\"'+esc(t.from)+'\" data-to=\"'+esc(t.to)+'\" data-cents=\"'+t.c+'\"><span class=\"who\"><b>'+esc(t.from)+'</b> pays <b>'+esc(t.to)+'</b></span><span class=\"amt\">'+money(t.c)+'</span></li>').join('')+'</ul>'\n    :'<p class=\"empty\">'+(S.expenses.length?'Everyone is even. Nothing to settle.':'Nothing to settle yet. Transfers appear here as expenses are added.')+'</p>';\n}\n\n$('pform').addEventListener('submit',ev=>{\n  ev.preventDefault();\n  const inp=$('pname'),name=inp.value.trim();\n  if(!name){showErr($('perr'),'Enter a name to add someone.');inp.focus();return;}\n  if(S.people.some(p=>p.toLowerCase()===name.toLowerCase())){showErr($('perr'),'\"'+name+'\" is already on the trip. Try adding a last initial.');inp.focus();return;}\n  if(splitSel)splitSel.add(name);\n  S.people.push(name);save();showErr($('perr'),'');inp.value='';render();inp.focus();\n});\n$('pname').addEventListener('input',()=>showErr($('perr'),''));\n\n$('esplit').addEventListener('change',()=>{\n  splitSel=new Set([...$('esplit').querySelectorAll('input:checked')].map(c=>c.value));\n});\n$('splitbtns').addEventListener('click',ev=>{\n  const b=ev.target.closest('button');if(!b)return;\n  splitSel=b.dataset.all==='1'?null:new Set();render();\n});\n\n$('eform').addEventListener('submit',ev=>{\n  ev.preventDefault();\n  const err=$('eerr'),desc=$('edesc').value.trim(),raw=$('eamt').value.trim().replace(/[$,\\s]/g,'');\n  const payer=$('epayer').value;\n  const split=[...$('esplit').querySelectorAll('input:checked')].map(c=>c.value);\n  if(!S.people.length){showErr(err,'Add at least one person before logging an expense.');$('pname').focus();return;}\n  if(!desc){showErr(err,'Add a short description, like \"Groceries\".');$('edesc').focus();return;}\n  if(!raw){showErr(err,'Enter an amount, like 42.50.');$('eamt').focus();return;}\n  if(!/^\\d+(\\.\\d{1,2})?$|^\\.\\d{1,2}$/.test(raw)){showErr(err,'Enter the amount as a number with at most 2 decimal places, like 42.50.');$('eamt').focus();return;}\n  const [w,f='']=raw.split('.');const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(!(cents>0)){showErr(err,'The amount needs to be more than $0.00.');$('eamt').focus();return;}\n  if(cents>99999999999){showErr(err,'That amount is too large.');$('eamt').focus();return;}\n  if(!S.people.includes(payer)){showErr(err,'Choose who paid.');$('epayer').focus();return;}\n  if(!split.length){showErr(err,'Choose at least one person to split this between.');const c=$('esplit').querySelector('input');c&&c.focus();return;}\n  S.expenses.push({id:S.nextId++,desc,cents,payer,split});save();\n  showErr(err,'');$('edesc').value='';$('eamt').value='';splitSel=null;render();$('edesc').focus();\n});\n\n$('elist').addEventListener('click',ev=>{\n  const b=ev.target.closest('[data-testid=\"delete-expense\"]');if(!b)return;\n  S.expenses=S.expenses.filter(e=>e.id!==+b.dataset.id);save();render();\n  const next=$('elist').querySelector('[data-testid=\"delete-expense\"]');(next||$('edesc')).focus();\n});\n\nrender();\n})();\n</script>\n</body>\n</html>"
    }
  ],

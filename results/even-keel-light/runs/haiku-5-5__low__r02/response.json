      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Figtree:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --harbour: #1F3A4D;\n    --harbour-deep: #172C3B;\n    --signal: #C2462B;\n    --signal-ink: #9E3320;\n    --paper: #F4F1EB;\n    --card: #FFFFFF;\n    --line: #DED7CA;\n    --ink: #1C2630;\n    --muted: #55606B;\n    --tide: #2E6B57;\n    --focus: #C2462B;\n    --display: \"Fraunces\", Georgia, serif;\n    --text: \"Figtree\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    background: var(--paper);\n    color: var(--ink);\n    font-family: var(--text);\n    font-size: 16px;\n    line-height: 1.5;\n    -webkit-font-smoothing: antialiased;\n  }\n  header.site {\n    background: var(--harbour);\n    color: #fff;\n    padding: 28px 20px 24px;\n    border-bottom: 4px solid var(--signal);\n  }\n  .wrap { max-width: 1040px; margin: 0 auto; }\n  .brand {\n    font-family: var(--display);\n    font-weight: 700;\n    font-size: 2rem;\n    letter-spacing: -0.01em;\n    margin: 0;\n    line-height: 1.1;\n  }\n  .tagline { margin: 6px 0 0; color: #D9E2E8; font-size: 0.98rem; }\n  main {\n    max-width: 1040px;\n    margin: 0 auto;\n    padding: 24px 16px 56px;\n    display: grid;\n    gap: 20px;\n    grid-template-columns: 1fr;\n  }\n  @media (min-width: 900px) {\n    main { grid-template-columns: 1fr 1.25fr; align-items: start; }\n  }\n  .card {\n    background: var(--card);\n    border: 1px solid var(--line);\n    border-radius: 14px;\n    padding: 20px;\n    min-width: 0;\n  }\n  h2 {\n    font-family: var(--display);\n    font-weight: 600;\n    font-size: 1.3rem;\n    margin: 0 0 4px;\n    color: var(--harbour);\n  }\n  .hint { margin: 0 0 16px; color: var(--muted); font-size: 0.93rem; }\n  label, legend {\n    display: block;\n    font-weight: 600;\n    font-size: 0.93rem;\n    margin-bottom: 6px;\n  }\n  input[type=\"text\"], input[type=\"number\"], select {\n    width: 100%;\n    font: inherit;\n    color: var(--ink);\n    background: #fff;\n    border: 1.5px solid #B9B1A2;\n    border-radius: 10px;\n    padding: 10px 12px;\n    min-height: 44px;\n  }\n  input::placeholder { color: #7A8390; }\n  input:focus-visible, select:focus-visible, button:focus-visible, input[type=\"checkbox\"]:focus-visible {\n    outline: 3px solid var(--focus);\n    outline-offset: 2px;\n  }\n  input[aria-invalid=\"true\"] { border-color: var(--signal-ink); }\n  .field { margin-bottom: 14px; }\n  .row { display: flex; gap: 10px; align-items: stretch; }\n  .row > * { flex: 1 1 auto; }\n  .btn {\n    font: inherit;\n    font-weight: 600;\n    min-height: 44px;\n    padding: 10px 18px;\n    border-radius: 10px;\n    border: 0;\n    background: var(--harbour);\n    color: #fff;\n    cursor: pointer;\n    white-space: nowrap;\n  }\n  .btn:hover { background: var(--harbour-deep); }\n  .btn.primary-signal { background: var(--signal); }\n  .btn.primary-signal:hover { background: var(--signal-ink); }\n  .btn.quiet {\n    background: transparent;\n    color: var(--signal-ink);\n    border: 1.5px solid var(--line);\n    padding: 6px 12px;\n    min-height: 36px;\n    font-size: 0.9rem;\n  }\n  .btn.quiet:hover { border-color: var(--signal-ink); background: #FBF3F0; }\n  .btn.full { width: 100%; margin-top: 4px; }\n  .error {\n    color: var(--signal-ink);\n    background: #FBEDE9;\n    border: 1px solid #E9B9AC;\n    border-radius: 10px;\n    padding: 10px 12px;\n    margin: 0 0 14px;\n    font-size: 0.93rem;\n    font-weight: 500;\n  }\n  fieldset {\n    border: 0;\n    padding: 0;\n    margin: 0 0 16px;\n  }\n  .checks {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n  .check {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 8px 12px;\n    border: 1.5px solid var(--line);\n    border-radius: 999px;\n    cursor: pointer;\n    font-weight: 500;\n    min-height: 44px;\n    background: #fff;\n  }\n  .check input { width: 18px; height: 18px; margin: 0; accent-color: var(--harbour); }\n  .check:has(input:checked) { border-color: var(--harbour); background: #EEF3F6; }\n  .empty {\n    color: var(--muted);\n    background: #FAF8F4;\n    border: 1px dashed #CFC6B5;\n    border-radius: 10px;\n    padding: 16px;\n    margin: 0;\n    font-size: 0.95rem;\n  }\n  ul.list { list-style: none; margin: 0; padding: 0; }\n  .person {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 10px 0;\n    border-bottom: 1px solid var(--line);\n    font-weight: 500;\n  }\n  .person:last-child { border-bottom: 0; }\n  .avatar {\n    width: 36px; height: 36px; border-radius: 50%;\n    display: grid; place-items: center;\n    color: #fff; font-weight: 700; font-size: 0.95rem;\n    flex: 0 0 auto;\n  }\n  .expense {\n    display: flex;\n    justify-content: space-between;\n    gap: 14px;\n    padding: 14px 0;\n    border-bottom: 1px solid var(--line);\n  }\n  .expense:last-child { border-bottom: 0; }\n  .expense-main { min-width: 0; }\n  .expense-desc { font-weight: 600; margin: 0; overflow-wrap: anywhere; }\n  .expense-meta { margin: 2px 0 0; color: var(--muted); font-size: 0.9rem; overflow-wrap: anywhere; }\n  .expense-side { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; flex: 0 0 auto; }\n  .amount { font-family: var(--display); font-weight: 700; font-variant-numeric: tabular-nums; font-size: 1.1rem; }\n  .balance {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    gap: 12px;\n    padding: 12px 0;\n    border-bottom: 1px solid var(--line);\n  }\n  .balance:last-child { border-bottom: 0; }\n  .balance-name { font-weight: 600; }\n  .balance-status { color: var(--muted); font-size: 0.9rem; }\n  .figure { font-variant-numeric: tabular-nums; font-weight: 700; white-space: nowrap; }\n  .figure.owed { color: var(--tide); }\n  .figure.owes { color: var(--signal-ink); }\n  .figure.even { color: var(--muted); font-weight: 600; }\n  .transfer {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    flex-wrap: wrap;\n    padding: 12px 14px;\n    border: 1px solid var(--line);\n    border-left: 4px solid var(--signal);\n    border-radius: 10px;\n    margin-bottom: 10px;\n    background: #FCFBF8;\n  }\n  .transfer .arrow { color: var(--muted); }\n  .transfer .sum { margin-left: auto; font-family: var(--display); font-weight: 700; font-variant-numeric: tabular-nums; font-size: 1.1rem; }\n  .settled {\n    color: var(--tide);\n    font-weight: 600;\n    background: #EDF5F1;\n    border: 1px solid #BFDCCF;\n    border-radius: 10px;\n    padding: 12px 14px;\n    margin: 0;\n  }\n  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }\n  .count { color: var(--muted); font-size: 0.9rem; font-variant-numeric: tabular-nums; }\n  .stack { display: grid; gap: 20px; min-width: 0; }\n  .sr-only {\n    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;\n  }\n  .note { color: var(--muted); font-size: 0.85rem; margin: 10px 0 0; }\n  @media (max-width: 380px) {\n    .row { flex-direction: column; }\n    .btn { width: 100%; }\n    .brand { font-size: 1.7rem; }\n  }\n</style>\n</head>\n<body>\n<header class=\"site\">\n  <div class=\"wrap\">\n    <h1 class=\"brand\">Even Keel</h1>\n    <p class=\"tagline\">Split the trip costs. Keep everyone level.</p>\n  </div>\n</header>\n\n<main data-testid=\"app\">\n  <div class=\"stack\">\n    <section class=\"card\" aria-labelledby=\"people-title\">\n      <div class=\"section-head\">\n        <h2 id=\"people-title\">People</h2>\n        <span class=\"count\" id=\"people-count\"></span>\n      </div>\n      <p class=\"hint\">Add everyone on the trip. Names must be unique, and capitals don't count.</p>\n      <form id=\"person-form\" novalidate>\n        <div class=\"field\">\n          <label for=\"person-name\">Name</label>\n          <div class=\"row\">\n            <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" maxlength=\"40\" placeholder=\"e.g. Priya\">\n            <button type=\"submit\" class=\"btn\" data-testid=\"add-person\">Add person</button>\n          </div>\n        </div>\n        <div id=\"person-error-slot\" aria-live=\"polite\"></div>\n      </form>\n      <div id=\"people-list-wrap\"></div>\n    </section>\n\n    <section class=\"card\" aria-labelledby=\"expense-title\">\n      <h2 id=\"expense-title\">Add an expense</h2>\n      <p class=\"hint\">Amounts are in Canadian dollars. The cost is split equally between the people you tick.</p>\n      <form id=\"expense-form\" novalidate>\n        <div class=\"field\">\n          <label for=\"expense-desc\">Description</label>\n          <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\" maxlength=\"80\" placeholder=\"e.g. Ferry tickets\">\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-amount\">Amount (CAD)</label>\n          <input type=\"text\" inputmode=\"decimal\" id=\"expense-amount\" data-testid=\"expense-amount\" autocomplete=\"off\" placeholder=\"e.g. 42.50\">\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-payer\">Paid by</label>\n          <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n        </div>\n        <fieldset data-testid=\"expense-split\" id=\"expense-split\">\n          <legend>Split between</legend>\n          <div class=\"checks\" id=\"split-checks\"></div>\n        </fieldset>\n        <div id=\"expense-error-slot\" aria-live=\"polite\"></div>\n        <button type=\"submit\" class=\"btn primary-signal full\" data-testid=\"add-expense\">Add expense</button>\n      </form>\n    </section>\n  </div>\n\n  <div class=\"stack\">\n    <section class=\"card\" aria-labelledby=\"expenses-title\">\n      <div class=\"section-head\">\n        <h2 id=\"expenses-title\">Expenses</h2>\n        <span class=\"count\" id=\"expenses-count\"></span>\n      </div>\n      <p class=\"hint\">Newest first.</p>\n      <div id=\"expenses-wrap\"></div>\n    </section>\n\n    <section class=\"card\" aria-labelledby=\"balances-title\">\n      <h2 id=\"balances-title\">Balances</h2>\n      <p class=\"hint\">What each person paid, minus their share. Positive means they are owed; negative means they owe.</p>\n      <div id=\"balances-wrap\"></div>\n    </section>\n\n    <section class=\"card\" aria-labelledby=\"settle-title\">\n      <h2 id=\"settle-title\">Settle up</h2>\n      <p class=\"hint\">The fewest payments that bring everyone back to even.</p>\n      <div id=\"settle-wrap\"></div>\n    </section>\n  </div>\n</main>\n\n<script>\n(function () {\n  const KEY = 'even-keel:v1';\n  const fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  const money = cents => fmt.format(cents / 100);\n  const $ = id => document.getElementById(id);\n\n  let state = loadState();\n  let personError = '';\n  let expenseError = '';\n  let uncheckedDraft = new Set();\n\n  function loadState() {\n    try {\n      const s = JSON.parse(localStorage.getItem(KEY));\n      if (s && Array.isArray(s.people) && Array.isArray(s.expenses)) return s;\n    } catch (e) { /* ignore corrupt data */ }\n    return { people: [], expenses: [] };\n  }\n\n  function save() {\n    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) { /* storage full or blocked */ }\n  }\n\n  function esc(s) {\n    return String(s).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n  }\n\n  function hue(name) {\n    let h = 0;\n    for (const ch of name) h = (h * 31 + ch.charCodeAt(0)) % 360;\n    return h;\n  }\n\n  function parseCents(str) {\n    const s = str.trim();\n    if (!/^\\d{1,9}(\\.\\d{1,2})?$/.test(s)) return null;\n    const [d, c = ''] = s.split('.');\n    return parseInt(d, 10) * 100 + parseInt((c + '00').slice(0, 2), 10);\n  }\n\n  // Equal split in integer cents; leftover cents go one each to selected people in trip order.\n  function shares(expense) {\n    const ordered = state.people.filter(p => expense.split.includes(p));\n    const n = ordered.length;\n    const map = new Map();\n    if (n === 0) return map;\n    const base = Math.floor(expense.cents / n);\n    const rem = expense.cents % n;\n    ordered.forEach((p, i) => map.set(p, base + (i < rem ? 1 : 0)));\n    return map;\n  }\n\n  function balances() {\n    const bal = new Map(state.people.map(p => [p, 0]));\n    for (const e of state.expenses) {\n      bal.set(e.payer, (bal.get(e.payer) || 0) + e.cents);\n      for (const [p, s] of shares(e)) bal.set(p, (bal.get(p) || 0) - s);\n    }\n    return bal;\n  }\n\n  // Greedy matching: each transfer clears at least one balance, so count <= nonzero - 1.\n  function settle(bal) {\n    const creditors = [], debtors = [];\n    for (const [p, v] of bal) {\n      if (v > 0) creditors.push([p, v]);\n      else if (v < 0) debtors.push([p, -v]);\n    }\n    creditors.sort((a, b) => b[1] - a[1]);\n    debtors.sort((a, b) => b[1] - a[1]);\n    const out = [];\n    let i = 0, j = 0;\n    while (i < debtors.length && j < creditors.length) {\n      const t = Math.min(debtors[i][1], creditors[j][1]);\n      out.push({ from: debtors[i][0], to: creditors[j][0], cents: t });\n      debtors[i][1] -= t;\n      creditors[j][1] -= t;\n      if (debtors[i][1] === 0) i++;\n      if (creditors[j][1] === 0) j++;\n    }\n    return out;\n  }\n\n  function setError(slotId, msg) {\n    $(slotId).innerHTML = msg\n      ? `<p class=\"error\" data-testid=\"form-error\" role=\"alert\">${esc(msg)}</p>`\n      : '';\n  }\n\n  function renderControls() {\n    const payer = $('expense-payer');\n    const prev = payer.value;\n    payer.innerHTML = state.people.map(p =>\n      `<option value=\"${esc(p)}\">${esc(p)}</option>`).join('');\n    if (state.people.includes(prev)) payer.value = prev;\n\n    const checks = $('split-checks');\n    if (state.people.length === 0) {\n      checks.innerHTML = '<p class=\"empty\" style=\"width:100%\">Add people above to choose who shares each cost.</p>';\n    } else {\n      checks.innerHTML = state.people.map((p, i) => {\n        const checked = !uncheckedDraft.has(p) ? 'checked' : '';\n        return `<label class=\"check\"><input type=\"checkbox\" name=\"split\" value=\"${esc(p)}\" ${checked}> ${esc(p)}</label>`;\n      }).join('');\n    }\n    $('expense-split').disabled = state.people.length === 0;\n  }\n\n  function renderPeople() {\n    const n = state.people.length;\n    $('people-count').textContent = n ? `${n} ${n === 1 ? 'person' : 'people'}` : '';\n    if (n === 0) {\n      $('people-list-wrap').innerHTML = '<p class=\"empty\">No one is on the trip yet. Add yourself first, then everyone else.</p>';\n      return;\n    }\n    $('people-list-wrap').innerHTML = `<ul class=\"list\">${state.people.map(p =>\n      `<li class=\"person\" data-testid=\"person\"><span class=\"avatar\" style=\"background:hsl(${hue(p)} 38% 38%)\" aria-hidden=\"true\">${esc(p.charAt(0).toUpperCase())}</span><span>${esc(p)}</span></li>`\n    ).join('')}</ul>`;\n  }\n\n  function renderExpenses() {\n    const n = state.expenses.length;\n    $('expenses-count').textContent = n ? `${n} ${n === 1 ? 'expense' : 'expenses'}` : '';\n    if (n === 0) {\n      $('expenses-wrap').innerHTML = '<p class=\"empty\">No expenses yet. Once someone pays for something, log it here and it will be split for you.</p>';\n      return;\n    }\n    const items = state.expenses.slice().reverse().map(e => {\n      const names = state.people.filter(p => e.split.includes(p));\n      return `<li class=\"expense\" data-testid=\"expense\">\n        <div class=\"expense-main\">\n          <p class=\"expense-desc\">${esc(e.desc)}</p>\n          <p class=\"expense-meta\">Paid by ${esc(e.payer)} · split between ${names.map(esc).join(', ')}</p>\n        </div>\n        <div class=\"expense-side\">\n          <span class=\"amount\">${money(e.cents)}</span>\n          <button type=\"button\" class=\"btn quiet\" data-testid=\"delete-expense\" data-id=\"${esc(e.id)}\" aria-label=\"Remove expense: ${esc(e.desc)}\">Remove</button>\n        </div>\n      </li>`;\n    });\n    $('expenses-wrap').innerHTML = `<ul class=\"list\">${items.join('')}</ul>`;\n  }\n\n  function renderBalances() {\n    if (state.people.length === 0) {\n      $('balances-wrap').innerHTML = '<p class=\"empty\">Balances appear once there are people on the trip.</p>';\n      return;\n    }\n    const bal = balances();\n    $('balances-wrap').innerHTML = `<ul class=\"list\">${state.people.map(p => {\n      const v = bal.get(p) || 0;\n      let status, cls;\n      if (v > 0) { status = 'is owed'; cls = 'owed'; }\n      else if (v < 0) { status = 'owes'; cls = 'owes'; }\n      else { status = 'is even'; cls = 'even'; }\n      const figure = v === 0 ? money(0) : money(Math.abs(v));\n      return `<li class=\"balance\" data-testid=\"balance\" data-person=\"${esc(p)}\" data-cents=\"${v}\">\n        <span><span class=\"balance-name\">${esc(p)}</span> <span class=\"balance-status\">${status}</span></span>\n        <span class=\"figure ${cls}\">${figure}</span>\n      </li>`;\n    }).join('')}</ul>`;\n  }\n\n  function renderSettle() {\n    if (state.people.length === 0 || state.expenses.length === 0) {\n      $('settle-wrap').innerHTML = '<p class=\"empty\">Nothing to settle yet. Add an expense and the payments needed will show up here.</p>';\n      return;\n    }\n    const transfers = settle(balances());\n    if (transfers.length === 0) {\n      $('settle-wrap').innerHTML = '<p class=\"settled\">Everyone is even. No payments needed.</p>';\n      return;\n    }\n    $('settle-wrap').innerHTML = transfers.map(t =>\n      `<div class=\"transfer\" data-testid=\"transfer\" data-from=\"${esc(t.from)}\" data-to=\"${esc(t.to)}\" data-cents=\"${t.cents}\">\n        <strong>${esc(t.from)}</strong><span class=\"arrow\" aria-hidden=\"true\">→</span><span>pays <strong>${esc(t.to)}</strong></span>\n        <span class=\"sum\">${money(t.cents)}</span>\n      </div>`\n    ).join('') + '<p class=\"note\">Each payment is a direct transfer. Nobody needs to pay more than this.</p>';\n  }\n\n  function render() {\n    renderPeople();\n    renderControls();\n    renderExpenses();\n    renderBalances();\n    renderSettle();\n    setError('person-error-slot', personError);\n    setError('expense-error-slot', expenseError);\n  }\n\n  $('person-form').addEventListener('submit', e => {\n    e.preventDefault();\n    const input = $('person-name');\n    const name = input.value.trim();\n    if (!name) {\n      personError = 'Enter a name before adding someone.';\n    } else if (name.length > 40) {\n      personError = 'Names can be up to 40 characters.';\n    } else if (state.people.some(p => p.toLowerCase() === name.toLowerCase())) {\n      personError = `\"${name}\" is already on the trip. Names must be unique.`;\n    } else {\n      state.people.push(name);\n      save();\n      personError = '';\n      input.value = '';\n      render();\n      input.focus();\n      return;\n    }\n    input.setAttribute('aria-invalid', 'true');\n    input.setAttribute('aria-describedby', 'person-error-slot');\n    render();\n    input.focus();\n  });\n\n  $('person-name').addEventListener('input', e => {\n    if (personError) { personError = ''; e.target.removeAttribute('aria-invalid'); setError('person-error-slot', ''); }\n  });\n\n  $('split-checks').addEventListener('change', e => {\n    if (e.target.matches('input[type=\"checkbox\"]')) {\n      const v = e.target.value;\n      if (e.target.checked) uncheckedDraft.delete(v); else uncheckedDraft.add(v);\n    }\n  });\n\n  ['expense-desc', 'expense-amount'].forEach(id => {\n    $(id).addEventListener('input', () => {\n      if (expenseError) { expenseError = ''; setError('expense-error-slot', ''); }\n    });\n  });\n\n  $('expense-form').addEventListener('submit', e => {\n    e.preventDefault();\n    const descEl = $('expense-desc');\n    const amtEl = $('expense-amount');\n    const payerEl = $('expense-payer');\n    const desc = descEl.value.trim();\n    const cents = parseCents(amtEl.value);\n    const payer = payerEl.value;\n    const split = state.people.filter(p =>\n      [...document.querySelectorAll('#split-checks input[type=\"checkbox\"]')]\n        .some(cb => cb.value === p && cb.checked));\n\n    let msg = '';\n    if (state.people.length === 0) msg = 'Add people to the trip before logging an expense.';\n    else if (!desc) msg = 'Describe the expense, for example \"Groceries\".';\n    else if (desc.length > 80) msg = 'Descriptions can be up to 80 characters.';\n    else if (amtEl.value.trim() === '') msg = 'Enter an amount in dollars.';\n    else if (cents === null) msg = 'Enter the amount as a number with at most 2 decimal places, like 42.50.';\n    else if (cents <= 0) msg = 'The amount must be greater than $0.00.';\n    else if (!state.people.includes(payer)) msg = 'Choose who paid.';\n    else if (split.length === 0) msg = 'Choose at least one person to split this between.';\n\n    if (msg) {\n      expenseError = msg;\n      if (!desc) descEl.setAttribute('aria-invalid', 'true');\n      amtEl.setAttribute('aria-invalid', cents === null || cents <= 0 ? 'true' : 'false');\n      render();\n      (!desc ? descEl : amtEl).focus();\n      return;\n    }\n\n    state.expenses.push({\n      id: (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2),\n      desc, cents, payer, split\n    });\n    save();\n    expenseError = '';\n    descEl.value = '';\n    amtEl.value = '';\n    descEl.removeAttribute('aria-invalid');\n    amtEl.removeAttribute('aria-invalid');\n    uncheckedDraft = new Set();\n    render();\n    descEl.focus();\n  });\n\n  $('expenses-wrap').addEventListener('click', e => {\n    const btn = e.target.closest('[data-testid=\"delete-expense\"]');\n    if (!btn) return;\n    const id = btn.getAttribute('data-id');\n    const idx = state.expenses.findIndex(x => x.id === id);\n    if (idx === -1) return;\n    const items = [...document.querySelectorAll('[data-testid=\"expense\"]')];\n    const pos = items.indexOf(btn.closest('[data-testid=\"expense\"]'));\n    state.expenses.splice(idx, 1);\n    save();\n    render();\n    const next = document.querySelectorAll('[data-testid=\"delete-expense\"]');\n    if (next.length) next[Math.min(pos, next.length - 1)].focus();\n    else $('expense-desc').focus();\n  });\n\n  render();\n})();\n</script>\n</body>\n</html>"
    }

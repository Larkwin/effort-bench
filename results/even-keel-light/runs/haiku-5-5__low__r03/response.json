      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Figtree:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --harbour: #1F3A4D;\n    --harbour-deep: #172C3B;\n    --signal: #C2462B;\n    --signal-deep: #A93A22;\n    --paper: #F4F0E8;\n    --card: #FFFDF8;\n    --sand: #EAE3D6;\n    --ink: #1C2A33;\n    --muted: #55626B;\n    --line: #D9D0C0;\n    --owe: #A93A22;\n    --owed: #1F5C4A;\n    --focus: #1F3A4D;\n    --radius: 14px;\n    --display: \"Fraunces\", Georgia, \"Times New Roman\", serif;\n    --body: \"Figtree\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  }\n  *, *::before, *::after { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    background: var(--paper);\n    color: var(--ink);\n    font-family: var(--body);\n    font-size: 16px;\n    line-height: 1.5;\n    overflow-x: hidden;\n    -webkit-font-smoothing: antialiased;\n  }\n  h1, h2, h3, p { margin: 0; }\n  .wrap { width: 100%; max-width: 1040px; margin: 0 auto; padding: 0 16px; }\n\n  header.top {\n    background: var(--harbour);\n    color: #FFFDF8;\n    padding: 28px 0 24px;\n    border-bottom: 4px solid var(--signal);\n  }\n  .brand {\n    font-family: var(--display);\n    font-weight: 700;\n    font-size: 2rem;\n    letter-spacing: -0.01em;\n    line-height: 1.1;\n  }\n  .tagline { color: #DCE4EA; margin-top: 4px; font-size: 1rem; }\n\n  .grid {\n    display: grid;\n    gap: 20px;\n    padding-top: 24px;\n    padding-bottom: 48px;\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .col { display: grid; gap: 20px; min-width: 0; align-content: start; }\n  @media (min-width: 900px) {\n    .grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }\n  }\n\n  .card {\n    background: var(--card);\n    border: 1px solid var(--line);\n    border-radius: var(--radius);\n    padding: 20px;\n    min-width: 0;\n    box-shadow: 0 1px 0 rgba(28,42,51,0.04);\n  }\n  .card h2 {\n    font-family: var(--display);\n    font-size: 1.35rem;\n    font-weight: 700;\n    color: var(--harbour);\n    margin-bottom: 4px;\n  }\n  .hint { color: var(--muted); font-size: 0.95rem; margin-bottom: 16px; }\n\n  label, legend {\n    display: block;\n    font-weight: 600;\n    font-size: 0.95rem;\n    margin-bottom: 6px;\n  }\n  input[type=\"text\"], input[type=\"search\"], input:not([type]), select {\n    width: 100%;\n    min-width: 0;\n    font: inherit;\n    color: var(--ink);\n    background: #fff;\n    border: 1.5px solid #B9AF9E;\n    border-radius: 10px;\n    padding: 10px 12px;\n    min-height: 44px;\n  }\n  input:focus-visible, select:focus-visible, button:focus-visible, input[type=\"checkbox\"]:focus-visible {\n    outline: 3px solid var(--focus);\n    outline-offset: 2px;\n  }\n  input[type=\"checkbox\"] {\n    width: 20px; height: 20px; margin: 0;\n    accent-color: var(--harbour);\n    flex: 0 0 auto;\n  }\n  input[aria-invalid=\"true\"] { border-color: var(--signal-deep); }\n\n  .field { margin-bottom: 14px; min-width: 0; }\n  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: stretch; }\n  .row > * { min-width: 0; }\n  .row > input { flex: 1 1 180px; }\n\n  button {\n    font: inherit;\n    font-weight: 600;\n    min-height: 44px;\n    padding: 10px 18px;\n    border-radius: 10px;\n    border: 0;\n    cursor: pointer;\n    background: var(--harbour);\n    color: #FFFDF8;\n    transition: background 0.15s ease;\n  }\n  button:hover { background: var(--harbour-deep); }\n  button.primary-signal { background: var(--signal); }\n  button.primary-signal:hover { background: var(--signal-deep); }\n  button.ghost {\n    background: transparent;\n    color: var(--signal-deep);\n    border: 1.5px solid currentColor;\n    padding: 6px 12px;\n    min-height: 36px;\n    font-size: 0.9rem;\n  }\n  button.ghost:hover { background: rgba(194,70,43,0.08); }\n\n  .checks {\n    display: grid;\n    gap: 8px;\n    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\n    margin-top: 4px;\n  }\n  .check {\n    display: flex; align-items: center; gap: 10px;\n    background: var(--paper);\n    border: 1.5px solid var(--line);\n    border-radius: 10px;\n    padding: 8px 10px;\n    min-height: 44px;\n    cursor: pointer;\n    font-weight: 500;\n    min-width: 0;\n    overflow-wrap: anywhere;\n  }\n  .check:has(input:checked) { border-color: var(--harbour); background: #EEF2F4; }\n  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }\n  fieldset legend { padding: 0; }\n\n  .form-error {\n    background: #FBE9E4;\n    color: #7E2A18;\n    border: 1px solid #E7B3A4;\n    border-left: 4px solid var(--signal-deep);\n    border-radius: 8px;\n    padding: 10px 12px;\n    margin-bottom: 14px;\n    font-weight: 500;\n    font-size: 0.95rem;\n  }\n\n  .empty {\n    color: var(--muted);\n    background: var(--sand);\n    border-radius: 10px;\n    padding: 14px;\n    font-size: 0.95rem;\n  }\n  ul.list, ol.list { list-style: none; margin: 0; padding: 0; }\n\n  .people { display: flex; flex-wrap: wrap; gap: 8px; }\n  .person {\n    background: var(--sand);\n    border-radius: 999px;\n    padding: 6px 14px;\n    font-weight: 600;\n    max-width: 100%;\n    overflow-wrap: anywhere;\n  }\n\n  .expense {\n    border-top: 1px solid var(--line);\n    padding: 14px 0;\n    display: grid;\n    gap: 6px;\n    grid-template-columns: minmax(0, 1fr) auto;\n    align-items: start;\n  }\n  .expense:first-child { border-top: 0; padding-top: 0; }\n  .expense-desc { font-weight: 600; overflow-wrap: anywhere; }\n  .expense-meta { color: var(--muted); font-size: 0.9rem; overflow-wrap: anywhere; grid-column: 1 / -1; }\n  .amount {\n    font-family: var(--display);\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n    white-space: nowrap;\n    font-size: 1.1rem;\n  }\n  .expense .amount { grid-column: 2; grid-row: 1; }\n  .expense .remove { grid-column: 2; grid-row: 2; justify-self: end; }\n  .expense .expense-desc { grid-column: 1; grid-row: 1; }\n\n  .balance {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    gap: 12px;\n    padding: 12px 0;\n    border-top: 1px solid var(--line);\n    flex-wrap: wrap;\n  }\n  .balance:first-child { border-top: 0; padding-top: 0; }\n  .balance .name { font-weight: 600; overflow-wrap: anywhere; min-width: 0; }\n  .balance .state { color: var(--muted); font-size: 0.92rem; }\n  .owed { color: var(--owed); }\n  .owe { color: var(--owe); }\n  .even { color: var(--muted); }\n\n  .transfer {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 12px;\n    padding: 12px 14px;\n    border: 1.5px solid var(--line);\n    border-radius: 10px;\n    background: #fff;\n    margin-bottom: 10px;\n    flex-wrap: wrap;\n  }\n  .transfer .who { font-weight: 600; overflow-wrap: anywhere; min-width: 0; }\n  .transfer .who em { font-style: normal; color: var(--muted); font-weight: 500; }\n  .transfer .amount { color: var(--ink); }\n  .summary-note { color: var(--muted); font-size: 0.92rem; margin-top: 12px; }\n  .sub-h { font-size: 0.95rem; font-weight: 700; color: var(--harbour); margin: 18px 0 10px; }\n  .sr-only {\n    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;\n  }\n  .split-tools { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }\n  .split-tools button { min-height: 36px; padding: 6px 12px; font-size: 0.9rem; background: var(--sand); color: var(--harbour); }\n  .split-tools button:hover { background: #DDD4C3; }\n  .money-note { color: var(--muted); font-size: 0.85rem; margin-top: 6px; }\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header class=\"top\">\n    <div class=\"wrap\">\n      <p class=\"brand\">Even Keel</p>\n      <p class=\"tagline\">Log who paid, and see who owes whom. Owing a friend is normal.</p>\n    </div>\n  </header>\n\n  <div class=\"wrap grid\">\n    <div class=\"col\">\n      <section class=\"card\" aria-labelledby=\"people-h\">\n        <h2 id=\"people-h\">People on the trip</h2>\n        <p class=\"hint\">Add everyone who is sharing costs. Names must be unique.</p>\n        <form id=\"person-form\" novalidate>\n          <div class=\"field\">\n            <label for=\"person-name\">Name</label>\n            <div class=\"row\">\n              <input id=\"person-name\" data-testid=\"person-name\" type=\"text\" autocomplete=\"off\" maxlength=\"40\">\n              <button type=\"submit\" data-testid=\"add-person\">Add person</button>\n            </div>\n          </div>\n          <div id=\"person-msg\"></div>\n        </form>\n        <div id=\"people-empty\" class=\"empty\">No one yet. Add the people on this trip to get started.</div>\n        <div id=\"people-list\" class=\"people\" role=\"list\"></div>\n      </section>\n\n      <section class=\"card\" aria-labelledby=\"expense-h\">\n        <h2 id=\"expense-h\">Log an expense</h2>\n        <p class=\"hint\">Split equally between the people you tick. Odd cents go to the first people on the list.</p>\n        <form id=\"expense-form\" novalidate>\n          <div id=\"expense-msg\"></div>\n          <div class=\"field\">\n            <label for=\"expense-desc\">Description</label>\n            <input id=\"expense-desc\" data-testid=\"expense-desc\" type=\"text\" maxlength=\"80\" autocomplete=\"off\" placeholder=\"Groceries, ferry, dinner\">\n          </div>\n          <div class=\"field\">\n            <label for=\"expense-amount\">Amount (CAD)</label>\n            <input id=\"expense-amount\" data-testid=\"expense-amount\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"0.00\">\n          </div>\n          <div class=\"field\">\n            <label for=\"expense-payer\">Paid by</label>\n            <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n          </div>\n          <fieldset class=\"field\">\n            <legend>Split between</legend>\n            <div class=\"split-tools\">\n              <button type=\"button\" id=\"select-all\">Select everyone</button>\n              <button type=\"button\" id=\"select-none\">Clear</button>\n            </div>\n            <div class=\"checks\" data-testid=\"expense-split\" id=\"expense-split\"></div>\n          </fieldset>\n          <button type=\"submit\" class=\"primary-signal\" data-testid=\"add-expense\">Add expense</button>\n        </form>\n      </section>\n    </div>\n\n    <div class=\"col\">\n      <section class=\"card\" aria-labelledby=\"expenses-h\">\n        <h2 id=\"expenses-h\">Expenses</h2>\n        <p class=\"hint\">Newest first.</p>\n        <div id=\"expenses-empty\" class=\"empty\">No expenses yet. Once someone pays for something, it will show up here.</div>\n        <ol id=\"expense-list\" class=\"list\"></ol>\n      </section>\n\n      <section class=\"card\" aria-labelledby=\"balances-h\">\n        <h2 id=\"balances-h\">Balances</h2>\n        <p class=\"hint\">Paid minus your share. Positive means you are owed; negative means you owe.</p>\n        <div id=\"balances-empty\" class=\"empty\">Balances appear once there are people on the trip.</div>\n        <ul id=\"balance-list\" class=\"list\"></ul>\n      </section>\n\n      <section class=\"card\" aria-labelledby=\"settle-h\">\n        <h2 id=\"settle-h\">Settle up</h2>\n        <p class=\"hint\">The fewest payments that bring everyone back to even.</p>\n        <div id=\"settle-empty\" class=\"empty\">Nothing to settle yet.</div>\n        <ul id=\"transfer-list\" class=\"list\"></ul>\n      </section>\n    </div>\n  </div>\n</main>\n\n<script>\n(function () {\n  \"use strict\";\n\n  var STORAGE_KEY = \"even-keel-v1\";\n  var money = new Intl.NumberFormat(\"en-CA\", { style: \"currency\", currency: \"CAD\" });\n  function fmt(cents) { return money.format(cents / 100); }\n\n  var state = load();\n  var renderedNames = {}; // names already present in the split/payer controls\n\n  // ---------- storage ----------\n  function load() {\n    try {\n      var raw = localStorage.getItem(STORAGE_KEY);\n      if (!raw) return { people: [], expenses: [] };\n      var data = JSON.parse(raw);\n      var people = Array.isArray(data.people) ? data.people.filter(function (p) { return typeof p === \"string\"; }) : [];\n      var expenses = Array.isArray(data.expenses) ? data.expenses.filter(function (e) {\n        return e && typeof e.desc === \"string\" && Number.isInteger(e.cents) && e.cents > 0 &&\n          typeof e.payer === \"string\" && Array.isArray(e.split) && e.split.length > 0;\n      }) : [];\n      return { people: people, expenses: expenses };\n    } catch (err) {\n      return { people: [], expenses: [] };\n    }\n  }\n  function save() {\n    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (err) { /* storage full or blocked */ }\n  }\n\n  // ---------- helpers ----------\n  function esc(s) {\n    return String(s).replace(/[&<>\"']/g, function (c) {\n      return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n    });\n  }\n  function parseAmount(raw) {\n    var t = raw.trim().replace(/^\\$/, \"\").replace(/,/g, \"\");\n    if (!/^\\d+(\\.\\d{1,2})?$/.test(t)) return null;\n    var parts = t.split(\".\");\n    var whole = parseInt(parts[0], 10);\n    var frac = parseInt(((parts[1] || \"\") + \"00\").slice(0, 2), 10);\n    var cents = whole * 100 + frac;\n    return cents > 0 ? cents : null;\n  }\n  // members must be in trip order; leftover cents go to the first members\n  function shares(cents, members) {\n    var n = members.length;\n    var base = Math.floor(cents / n);\n    var rem = cents - base * n;\n    return members.map(function (name, i) {\n      return { name: name, cents: base + (i < rem ? 1 : 0) };\n    });\n  }\n  function balances() {\n    var bal = {};\n    state.people.forEach(function (p) { bal[p] = 0; });\n    state.expenses.forEach(function (e) {\n      bal[e.payer] = (bal[e.payer] || 0) + e.cents;\n      var members = state.people.filter(function (p) { return e.split.indexOf(p) !== -1; });\n      shares(e.cents, members).forEach(function (s) {\n        bal[s.name] = (bal[s.name] || 0) - s.cents;\n      });\n    });\n    return bal;\n  }\n  function settle(bal) {\n    var creditors = [], debtors = [];\n    state.people.forEach(function (p) {\n      var c = bal[p] || 0;\n      if (c > 0) creditors.push({ name: p, cents: c });\n      else if (c < 0) debtors.push({ name: p, cents: -c });\n    });\n    creditors.sort(function (a, b) { return b.cents - a.cents; });\n    debtors.sort(function (a, b) { return b.cents - a.cents; });\n    var out = [];\n    var i = 0, j = 0;\n    while (i < creditors.length && j < debtors.length) {\n      var amt = Math.min(creditors[i].cents, debtors[j].cents);\n      out.push({ from: debtors[j].name, to: creditors[i].name, cents: amt });\n      creditors[i].cents -= amt;\n      debtors[j].cents -= amt;\n      if (creditors[i].cents === 0) i++;\n      if (debtors[j].cents === 0) j++;\n    }\n    return out;\n  }\n  function showError(slotId, inputId, msg) {\n    var slot = document.getElementById(slotId);\n    slot.innerHTML = '<p class=\"form-error\" data-testid=\"form-error\" role=\"alert\">' + esc(msg) + \"</p>\";\n    if (inputId) {\n      var input = document.getElementById(inputId);\n      input.setAttribute(\"aria-invalid\", \"true\");\n      input.focus();\n    }\n  }\n  function clearError(slotId, inputId) {\n    document.getElementById(slotId).innerHTML = \"\";\n    if (inputId) document.getElementById(inputId).removeAttribute(\"aria-invalid\");\n  }\n\n  // ---------- rendering ----------\n  function renderPeople() {\n    var list = document.getElementById(\"people-list\");\n    document.getElementById(\"people-empty\").hidden = state.people.length > 0;\n    list.innerHTML = state.people.map(function (p) {\n      return '<span class=\"person\" role=\"listitem\" data-testid=\"person\">' + esc(p) + \"</span>\";\n    }).join(\"\");\n  }\n\n  function syncFormOptions() {\n    var payer = document.getElementById(\"expense-payer\");\n    var split = document.getElementById(\"expense-split\");\n    var prevPayer = payer.value;\n    var prevChecked = {};\n    split.querySelectorAll(\"input[type=checkbox]\").forEach(function (cb) {\n      prevChecked[cb.value] = cb.checked;\n    });\n\n    payer.innerHTML = state.people.length\n      ? state.people.map(function (p) {\n          return '<option value=\"' + esc(p) + '\">' + esc(p) + \"</option>\";\n        }).join(\"\")\n      : '<option value=\"\">Add people first</option>';\n    if (state.people.indexOf(prevPayer) !== -1) payer.value = prevPayer;\n\n    split.innerHTML = state.people.map(function (p, i) {\n      var isNew = !renderedNames[p];\n      var checked = isNew || prevChecked[p] ? \" checked\" : \"\";\n      return '<label class=\"check\"><input type=\"checkbox\" value=\"' + esc(p) + '\"' + checked + \">\" +\n        \"<span>\" + esc(p) + \"</span></label>\";\n    }).join(\"\");\n\n    renderedNames = {};\n    state.people.forEach(function (p) { renderedNames[p] = true; });\n  }\n\n  function renderExpenses() {\n    document.getElementById(\"expenses-empty\").hidden = state.expenses.length > 0;\n    document.getElementById(\"expense-list\").innerHTML = state.expenses.map(function (e) {\n      var members = state.people.filter(function (p) { return e.split.indexOf(p) !== -1; });\n      var names = members.join(\", \");\n      var each = shares(e.cents, members);\n      var note = each.length > 1 && each.some(function (s) { return s.cents !== each[0].cents; })\n        ? \" (some pay a cent more)\" : \"\";\n      var eachAmt = fmt(Math.floor(e.cents / members.length));\n      return '<li class=\"expense\" data-testid=\"expense\">' +\n        '<span class=\"expense-desc\">' + esc(e.desc) + \"</span>\" +\n        '<span class=\"amount\">' + fmt(e.cents) + \"</span>\" +\n        '<span class=\"expense-meta\">Paid by ' + esc(e.payer) + \". Split between \" + esc(names) +\n        \" (about \" + eachAmt + \" each\" + note + \").</span>\" +\n        '<button type=\"button\" class=\"ghost remove\" data-testid=\"delete-expense\" data-id=\"' + esc(e.id) +\n        '\" aria-label=\"Remove ' + esc(e.desc) + '\">Remove</button>' +\n        \"</li>\";\n    }).join(\"\");\n  }\n\n  function renderBalances(bal) {\n    var hasPeople = state.people.length > 0;\n    document.getElementById(\"balances-empty\").hidden = hasPeople;\n    document.getElementById(\"balance-list\").innerHTML = state.people.map(function (p) {\n      var c = bal[p] || 0;\n      var cls, text;\n      if (c > 0) { cls = \"owed\"; text = \"is owed \" + fmt(c); }\n      else if (c < 0) { cls = \"owe\"; text = \"owes \" + fmt(-c); }\n      else { cls = \"even\"; text = \"is all square\"; }\n      return '<li class=\"balance\" data-testid=\"balance\" data-person=\"' + esc(p) + '\" data-cents=\"' + c + '\">' +\n        '<span class=\"name\">' + esc(p) + \"</span>\" +\n        '<span class=\"' + cls + '\">' + text + \"</span>\" +\n        \"</li>\";\n    }).join(\"\");\n  }\n\n  function renderSettle(bal) {\n    var transfers = settle(bal);\n    document.getElementById(\"settle-empty\").hidden = transfers.length > 0;\n    var emptyText = document.querySelector(\"#settle-empty\");\n    emptyText.textContent = state.people.length === 0\n      ? \"Nothing to settle yet. Add people and expenses first.\"\n      : \"Everyone is already even. Nothing to settle.\";\n    document.getElementById(\"transfer-list\").innerHTML = transfers.map(function (t) {\n      return '<li class=\"transfer\" data-testid=\"transfer\" data-from=\"' + esc(t.from) +\n        '\" data-to=\"' + esc(t.to) + '\" data-cents=\"' + t.cents + '\">' +\n        '<span class=\"who\">' + esc(t.from) + \" <em>pays</em> \" + esc(t.to) + \"</span>\" +\n        '<span class=\"amount\">' + fmt(t.cents) + \"</span>\" +\n        \"</li>\";\n    }).join(\"\");\n  }\n\n  function render() {\n    var bal = balances();\n    renderPeople();\n    syncFormOptions();\n    renderExpenses();\n    renderBalances(bal);\n    renderSettle(bal);\n  }\n\n  // ---------- handlers ----------\n  var personForm = document.getElementById(\"person-form\");\n  var personInput = document.getElementById(\"person-name\");\n  personInput.addEventListener(\"input\", function () { clearError(\"person-msg\", \"person-name\"); });\n\n  personForm.addEventListener(\"submit\", function (ev) {\n    ev.preventDefault();\n    var name = personInput.value.trim();\n    if (!name) {\n      showError(\"person-msg\", \"person-name\", \"Please enter a name for the person.\");\n      return;\n    }\n    var lower = name.toLowerCase();\n    var dup = state.people.some(function (p) { return p.toLowerCase() === lower; });\n    if (dup) {\n      showError(\"person-msg\", \"person-name\", '\"' + name + '\" is already on the trip. Names must be unique.');\n      return;\n    }\n    state.people.push(name);\n    save();\n    personInput.value = \"\";\n    clearError(\"person-msg\", \"person-name\");\n    render();\n    personInput.focus();\n  });\n\n  document.getElementById(\"select-all\").addEventListener(\"click\", function () {\n    document.querySelectorAll(\"#expense-split input[type=checkbox]\").forEach(function (cb) { cb.checked = true; });\n  });\n  document.getElementById(\"select-none\").addEventListener(\"click\", function () {\n    document.querySelectorAll(\"#expense-split input[type=checkbox]\").forEach(function (cb) { cb.checked = false; });\n  });\n\n  var expenseForm = document.getElementById(\"expense-form\");\n  var descInput = document.getElementById(\"expense-desc\");\n  var amountInput = document.getElementById(\"expense-amount\");\n  var payerSelect = document.getElementById(\"expense-payer\");\n\n  [\"expense-desc\", \"expense-amount\"].forEach(function (id) {\n    document.getElementById(id).addEventListener(\"input\", function () { clearError(\"expense-msg\", id); });\n  });\n\n  expenseForm.addEventListener(\"submit\", function (ev) {\n    ev.preventDefault();\n    clearError(\"expense-msg\", null);\n    [\"expense-desc\", \"expense-amount\", \"expense-payer\"].forEach(function (id) {\n      document.getElementById(id).removeAttribute(\"aria-invalid\");\n    });\n\n    if (state.people.length === 0) {\n      showError(\"expense-msg\", null, \"Add at least one person to the trip before logging an expense.\");\n      personInput.focus();\n      return;\n    }\n    var desc = descInput.value.trim();\n    if (!desc) {\n      showError(\"expense-msg\", \"expense-desc\", \"Describe what this expense was for.\");\n      return;\n    }\n    var cents = parseAmount(amountInput.value);\n    if (cents === null) {\n      showError(\"expense-msg\", \"expense-amount\",\n        \"Enter an amount greater than $0 with at most 2 decimal places, such as 42.50.\");\n      return;\n    }\n    var payer = payerSelect.value;\n    if (state.people.indexOf(payer) === -1) {\n      showError(\"expense-msg\", \"expense-payer\", \"Choose who paid.\");\n      return;\n    }\n    var checked = [];\n    document.querySelectorAll(\"#expense-split input[type=checkbox]\").forEach(function (cb) {\n      if (cb.checked) checked.push(cb.value);\n    });\n    if (checked.length === 0) {\n      showError(\"expense-msg\", null, \"Tick at least one person to split this expense between.\");\n      return;\n    }\n    var split = state.people.filter(function (p) { return checked.indexOf(p) !== -1; });\n\n    state.expenses.unshift({\n      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7),\n      desc: desc,\n      cents: cents,\n      payer: payer,\n      split: split\n    });\n    save();\n\n    descInput.value = \"\";\n    amountInput.value = \"\";\n    document.querySelectorAll(\"#expense-split input[type=checkbox]\").forEach(function (cb) { cb.checked = true; });\n    clearError(\"expense-msg\", null);\n    render();\n    descInput.focus();\n  });\n\n  document.getElementById(\"expense-list\").addEventListener(\"click\", function (ev) {\n    var btn = ev.target.closest(\"[data-testid=delete-expense]\");\n    if (!btn) return;\n    var id = btn.getAttribute(\"data-id\");\n    state.expenses = state.expenses.filter(function (e) { return e.id !== id; });\n    save();\n    render();\n    var remaining = document.querySelectorAll(\"[data-testid=delete-expense]\");\n    if (remaining.length) remaining[0].focus();\n    else descInput.focus();\n  });\n\n  render();\n})();\n</script>\n</body>\n</html>"

    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --harbour:#1F3A4D;\n  --fog:#5B6B75;\n  --sailcloth:#F6F3EC;\n  --paper:#FFFFFF;\n  --rope:#D9D2C3;\n  --signal:#C2462B;\n  --kelp:#2F6B4F;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0}\nbody{\n  background:var(--sailcloth);\n  color:var(--harbour);\n  font-family:\"IBM Plex Sans\",system-ui,sans-serif;\n  font-weight:400;\n  font-size:16px;\n  line-height:1.5;\n  overflow-x:hidden;\n}\nmain{\n  max-width:720px;\n  margin:0 auto;\n  padding:24px;\n}\n@media (max-width:599px){\n  main{padding:16px}\n}\nh1,h2{font-family:\"Fraunces\",Georgia,serif;font-weight:600;margin:0}\nheader{margin-bottom:32px}\n.wordmark{\n  font-size:40px;\n  line-height:1.2;\n  display:flex;\n  align-items:center;\n  gap:8px;\n  flex-wrap:wrap;\n}\n.wordmark::before{\n  content:\"\";\n  display:inline-block;\n  width:24px;\n  height:3px;\n  background:var(--signal);\n}\n.tagline{margin:8px 0 0;color:var(--fog);font-size:16px}\nsection{\n  background:var(--paper);\n  border:1px solid var(--rope);\n  border-radius:6px;\n  padding:24px;\n  margin-bottom:24px;\n  min-width:0;\n}\nsection h2{font-size:20px;margin-bottom:16px}\n.hint{color:var(--fog);font-size:14px;margin:4px 0 0}\n.empty{color:var(--fog);font-size:14px;margin:8px 0 0}\nlabel,legend{font-size:14px;font-weight:500;display:block;margin-bottom:4px}\ninput[type=text],select{\n  width:100%;\n  min-height:40px;\n  padding:8px 12px;\n  font:inherit;\n  color:var(--harbour);\n  background:var(--paper);\n  border:1px solid var(--rope);\n  border-radius:6px;\n}\ninput[type=text]:hover,select:hover{border-color:var(--fog)}\n.field{margin-bottom:16px;min-width:0}\n.row{display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end}\n.row .grow{flex:1 1 200px;min-width:0}\nfieldset{border:1px solid var(--rope);border-radius:6px;padding:8px 16px 16px;margin:0 0 16px;min-width:0}\nlegend{padding:0 4px}\n.checks{display:flex;flex-wrap:wrap;gap:8px 16px}\n.checks label{\n  display:flex;align-items:center;gap:8px;\n  font-weight:400;margin:0;min-height:40px;cursor:pointer;\n}\n.checks input{width:20px;height:20px;accent-color:var(--harbour);margin:0}\nbutton{\n  font:inherit;\n  font-size:16px;\n  font-weight:500;\n  min-height:40px;\n  padding:8px 16px;\n  border-radius:6px;\n  cursor:pointer;\n  transition:border-color 150ms,text-decoration-color 150ms;\n}\n.primary{\n  background:var(--signal);\n  color:var(--paper);\n  border:1px solid var(--signal);\n}\n.primary:hover{text-decoration:underline}\n.secondary{\n  background:var(--paper);\n  color:var(--harbour);\n  border:1px solid var(--rope);\n}\n.secondary:hover{border-color:var(--harbour)}\nbutton:focus-visible,input:focus-visible,select:focus-visible,.checks input:focus-visible{\n  outline:2px solid var(--harbour);\n  outline-offset:2px;\n}\ninput:focus-visible,select:focus-visible{border-color:var(--harbour)}\n.error{\n  border:1px solid var(--harbour);\n  border-radius:6px;\n  padding:8px 12px;\n  margin:0 0 16px;\n  font-size:14px;\n  font-weight:500;\n}\nul{list-style:none;margin:0;padding:0}\nli{\n  border-top:1px solid var(--rope);\n  padding:16px 0;\n  display:flex;\n  justify-content:space-between;\n  align-items:flex-start;\n  gap:16px;\n  flex-wrap:wrap;\n  min-width:0;\n}\nli:first-child{border-top:none;padding-top:0}\nli:last-child{padding-bottom:0}\n.item-main{min-width:0;flex:1 1 200px;overflow-wrap:anywhere}\n.item-title{font-weight:500}\n.meta{color:var(--fog);font-size:14px}\n.money{font-variant-numeric:tabular-nums;font-weight:500;white-space:nowrap}\n.pos{color:var(--kelp)}\n.neg{color:var(--harbour)}\n.zero{color:var(--harbour)}\n.bal-name{font-weight:500}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header>\n    <h1 class=\"wordmark\">Even Keel</h1>\n    <p class=\"tagline\">Log shared trip costs and see who pays whom.</p>\n  </header>\n\n  <section aria-labelledby=\"people-heading\">\n    <h2 id=\"people-heading\">People</h2>\n    <form id=\"person-form\" novalidate>\n      <div class=\"row\">\n        <div class=\"grow\">\n          <label for=\"person-name\">Name</label>\n          <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" maxlength=\"60\">\n        </div>\n        <button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n      </div>\n      <div id=\"person-error\" aria-live=\"polite\"></div>\n    </form>\n    <ul id=\"people-list\" aria-label=\"People on this trip\" style=\"margin-top:16px\"></ul>\n    <p class=\"empty\" id=\"people-empty\">Add the people on this trip to start tracking costs.</p>\n  </section>\n\n  <section aria-labelledby=\"expenses-heading\">\n    <h2 id=\"expenses-heading\">Expenses</h2>\n    <form id=\"expense-form\" novalidate>\n      <div class=\"field\">\n        <label for=\"expense-desc\">Description</label>\n        <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" maxlength=\"120\">\n      </div>\n      <div class=\"field\">\n        <label for=\"expense-amount\">Amount (CAD)</label>\n        <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\">\n        <p class=\"hint\">Up to 2 decimal places, for example 42.50.</p>\n      </div>\n      <div class=\"field\">\n        <label for=\"expense-payer\">Paid by</label>\n        <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n      </div>\n      <fieldset>\n        <legend>Split between</legend>\n        <div class=\"checks\" data-testid=\"expense-split\" id=\"expense-split\"></div>\n      </fieldset>\n      <button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n      <div id=\"expense-error\" aria-live=\"polite\" style=\"margin-top:16px\"></div>\n    </form>\n    <ul id=\"expense-list\" aria-label=\"Expenses\" style=\"margin-top:16px\"></ul>\n    <p class=\"empty\" id=\"expenses-empty\">No expenses yet. Add one after you have people on the trip.</p>\n  </section>\n\n  <section aria-labelledby=\"balances-heading\">\n    <h2 id=\"balances-heading\">Balances</h2>\n    <ul id=\"balances\" aria-label=\"Balances\"></ul>\n    <p class=\"empty\" id=\"balances-empty\">Balances appear once you have people and at least one expense.</p>\n  </section>\n\n  <section aria-labelledby=\"settle-heading\">\n    <h2 id=\"settle-heading\">Settle up</h2>\n    <ul id=\"transfers\" aria-label=\"Transfers to settle up\"></ul>\n    <p class=\"empty\" id=\"settle-empty\">Add expenses to see who pays whom.</p>\n  </section>\n</main>\n\n<script>\n(function () {\n  var KEY = 'even-keel-v1';\n  var fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n\n  var state = load();\n\n  var el = {\n    personForm: document.getElementById('person-form'),\n    personName: document.getElementById('person-name'),\n    personError: document.getElementById('person-error'),\n    peopleList: document.getElementById('people-list'),\n    peopleEmpty: document.getElementById('people-empty'),\n    expenseForm: document.getElementById('expense-form'),\n    expDesc: document.getElementById('expense-desc'),\n    expAmount: document.getElementById('expense-amount'),\n    expPayer: document.getElementById('expense-payer'),\n    expSplit: document.getElementById('expense-split'),\n    expenseError: document.getElementById('expense-error'),\n    expenseList: document.getElementById('expense-list'),\n    expensesEmpty: document.getElementById('expenses-empty'),\n    balances: document.getElementById('balances'),\n    balancesEmpty: document.getElementById('balances-empty'),\n    transfers: document.getElementById('transfers'),\n    settleEmpty: document.getElementById('settle-empty')\n  };\n\n  function load() {\n    try {\n      var raw = localStorage.getItem(KEY);\n      if (raw) {\n        var s = JSON.parse(raw);\n        return {\n          people: Array.isArray(s.people) ? s.people.filter(function (x) { return typeof x === 'string'; }) : [],\n          expenses: Array.isArray(s.expenses) ? s.expenses : []\n        };\n      }\n    } catch (e) { /* ignore corrupt data */ }\n    return { people: [], expenses: [] };\n  }\n\n  function save() {\n    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) { /* storage unavailable */ }\n  }\n\n  function money(cents) { return fmt.format(cents / 100); }\n\n  function setError(container, msg) {\n    container.textContent = '';\n    if (msg) {\n      var p = document.createElement('p');\n      p.className = 'error';\n      p.setAttribute('data-testid', 'form-error');\n      p.textContent = msg;\n      container.appendChild(p);\n    }\n  }\n\n  function parseCents(s) {\n    var t = s.trim().replace(/^\\$/, '').replace(/,/g, '');\n    if (!/^\\d+(\\.\\d{1,2})?$/.test(t)) return null;\n    var parts = t.split('.');\n    var whole = parseInt(parts[0], 10);\n    var frac = parseInt(((parts[1] || '') + '00').slice(0, 2), 10);\n    var cents = whole * 100 + frac;\n    return cents > 0 ? cents : null;\n  }\n\n  function shares(cents, names) {\n    var n = names.length;\n    var base = Math.floor(cents / n);\n    var rem = cents - base * n;\n    var out = {};\n    names.forEach(function (nm) { out[nm] = base; });\n    for (var i = 0; i < n && rem > 0; i++, rem--) out[names[i]] += 1;\n    return out;\n  }\n\n  function orderedSplit(expense) {\n    return state.people.filter(function (p) { return expense.split.indexOf(p) !== -1; });\n  }\n\n  function computeBalances() {\n    var bal = {};\n    state.people.forEach(function (p) { bal[p] = 0; });\n    state.expenses.forEach(function (e) {\n      if (bal[e.payer] === undefined) return;\n      bal[e.payer] += e.cents;\n      var ord = orderedSplit(e);\n      if (!ord.length) return;\n      var sh = shares(e.cents, ord);\n      ord.forEach(function (nm) { bal[nm] -= sh[nm]; });\n    });\n    return bal;\n  }\n\n  function computeTransfers(bal) {\n    var creds = [], debs = [], out = [];\n    state.people.forEach(function (p) {\n      if (bal[p] > 0) creds.push({ name: p, c: bal[p] });\n      else if (bal[p] < 0) debs.push({ name: p, c: -bal[p] });\n    });\n    var i = 0, j = 0;\n    while (i < debs.length && j < creds.length) {\n      var x = Math.min(debs[i].c, creds[j].c);\n      out.push({ from: debs[i].name, to: creds[j].name, cents: x });\n      debs[i].c -= x;\n      creds[j].c -= x;\n      if (debs[i].c === 0) i++;\n      if (creds[j].c === 0) j++;\n    }\n    return out;\n  }\n\n  function el_(tag, attrs, text) {\n    var n = document.createElement(tag);\n    if (attrs) Object.keys(attrs).forEach(function (k) { n.setAttribute(k, attrs[k]); });\n    if (text !== undefined) n.textContent = text;\n    return n;\n  }\n\n  function renderSplit() {\n    var prev = {};\n    el.expSplit.querySelectorAll('input[type=checkbox]').forEach(function (cb) {\n      prev[cb.value] = cb.checked;\n    });\n    el.expSplit.textContent = '';\n    state.people.forEach(function (p) {\n      var label = document.createElement('label');\n      var cb = el_('input', { type: 'checkbox', value: p, name: 'split' });\n      cb.checked = prev.hasOwnProperty(p) ? prev[p] : true;\n      label.appendChild(cb);\n      label.appendChild(document.createTextNode(p));\n      el.expSplit.appendChild(label);\n    });\n\n    var currentPayer = el.expPayer.value;\n    el.expPayer.textContent = '';\n    state.people.forEach(function (p) {\n      var o = el_('option', { value: p }, p);\n      el.expPayer.appendChild(o);\n    });\n    if (state.people.indexOf(currentPayer) !== -1) el.expPayer.value = currentPayer;\n    el.expPayer.disabled = state.people.length === 0;\n  }\n\n  function renderPeople() {\n    el.peopleList.textContent = '';\n    state.people.forEach(function (p) {\n      var li = el_('li', { 'data-testid': 'person' });\n      li.appendChild(el_('span', { class: 'item-title' }, p));\n      el.peopleList.appendChild(li);\n    });\n    el.peopleEmpty.hidden = state.people.length > 0;\n    el.peopleList.hidden = state.people.length === 0;\n  }\n\n  function renderExpenses() {\n    el.expenseList.textContent = '';\n    var list = state.expenses.slice().reverse();\n    list.forEach(function (e) {\n      var li = el_('li', { 'data-testid': 'expense' });\n      var main = el_('div', { class: 'item-main' });\n      main.appendChild(el_('div', { class: 'item-title' }, e.desc));\n      var ord = orderedSplit(e);\n      main.appendChild(el_('div', { class: 'meta' },\n        'Paid by ' + e.payer + ' · Split between ' + ord.join(', ')));\n      li.appendChild(main);\n\n      var right = el_('div', { style: 'display:flex;align-items:center;gap:16px;flex-wrap:wrap' });\n      right.appendChild(el_('span', { class: 'money' }, money(e.cents)));\n      var btn = el_('button', { type: 'button', class: 'secondary', 'data-testid': 'delete-expense' }, 'Remove');\n      btn.setAttribute('aria-label', 'Remove expense ' + e.desc);\n      btn.addEventListener('click', function () {\n        state.expenses = state.expenses.filter(function (x) { return x.id !== e.id; });\n        save();\n        render();\n      });\n      right.appendChild(btn);\n      li.appendChild(right);\n      el.expenseList.appendChild(li);\n    });\n    el.expensesEmpty.hidden = state.expenses.length > 0;\n    el.expenseList.hidden = state.expenses.length === 0;\n  }\n\n  function renderBalances() {\n    el.balances.textContent = '';\n    var bal = computeBalances();\n    state.people.forEach(function (p) {\n      var c = bal[p];\n      var li = el_('li', { 'data-testid': 'balance', 'data-person': p, 'data-cents': String(c) });\n      li.appendChild(el_('span', { class: 'bal-name' }, p));\n      var cls, text, note;\n      if (c > 0) { cls = 'pos'; text = money(c); note = 'is owed'; }\n      else if (c < 0) { cls = 'neg'; text = '\\u2212' + money(-c); note = 'owes'; }\n      else { cls = 'zero'; text = money(0); note = 'even'; }\n      var right = el_('span', { class: 'money ' + cls }, text);\n      right.insertAdjacentText('afterend', '');\n      var wrap = el_('span', { style: 'display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;justify-content:flex-end' });\n      wrap.appendChild(el_('span', { class: 'meta' }, note));\n      wrap.appendChild(right);\n      li.appendChild(wrap);\n      el.balances.appendChild(li);\n    });\n    el.balancesEmpty.hidden = state.people.length > 0 && state.expenses.length > 0;\n    el.balances.hidden = state.people.length === 0 || state.expenses.length === 0;\n  }\n\n  function renderTransfers() {\n    el.transfers.textContent = '';\n    var bal = computeBalances();\n    var list = computeTransfers(bal);\n    list.forEach(function (t) {\n      var li = el_('li', {\n        'data-testid': 'transfer',\n        'data-from': t.from,\n        'data-to': t.to,\n        'data-cents': String(t.cents)\n      });\n      li.appendChild(el_('span', null, t.from + ' pays ' + t.to));\n      li.appendChild(el_('span', { class: 'money' }, money(t.cents)));\n      el.transfers.appendChild(li);\n    });\n    var hasExpenses = state.expenses.length > 0 && state.people.length > 0;\n    if (!hasExpenses) {\n      el.settleEmpty.textContent = 'Add expenses to see who pays whom.';\n      el.settleEmpty.hidden = false;\n    } else if (list.length === 0) {\n      el.settleEmpty.textContent = 'Everyone is even. No payments are needed.';\n      el.settleEmpty.hidden = false;\n    } else {\n      el.settleEmpty.hidden = true;\n    }\n    el.transfers.hidden = list.length === 0;\n  }\n\n  function render() {\n    renderPeople();\n    renderSplit();\n    renderExpenses();\n    renderBalances();\n    renderTransfers();\n  }\n\n  el.personForm.addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var name = el.personName.value.trim();\n    if (!name) {\n      setError(el.personError, 'Enter a name for the person.');\n      el.personName.focus();\n      return;\n    }\n    var lower = name.toLowerCase();\n    var dup = state.people.some(function (p) { return p.toLowerCase() === lower; });\n    if (dup) {\n      setError(el.personError, '\"' + name + '\" is already on the trip. Enter a different name.');\n      el.personName.focus();\n      return;\n    }\n    state.people.push(name);\n    save();\n    setError(el.personError, '');\n    el.personName.value = '';\n    render();\n    el.personName.focus();\n  });\n\n  el.expenseForm.addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var desc = el.expDesc.value.trim();\n    var cents = parseCents(el.expAmount.value);\n    var payer = el.expPayer.value;\n    var checked = Array.prototype.slice.call(el.expSplit.querySelectorAll('input[type=checkbox]:checked'))\n      .map(function (cb) { return cb.value; });\n\n    var msg = '';\n    var focusTarget = null;\n    if (state.people.length === 0) {\n      msg = 'Add at least one person before adding an expense.';\n      focusTarget = el.personName;\n    } else if (!desc) {\n      msg = 'Enter a description for the expense.';\n      focusTarget = el.expDesc;\n    } else if (cents === null) {\n      msg = 'Enter an amount greater than $0 with at most 2 decimal places.';\n      focusTarget = el.expAmount;\n    } else if (state.people.indexOf(payer) === -1) {\n      msg = 'Choose who paid for this expense.';\n      focusTarget = el.expPayer;\n    } else if (checked.length === 0) {\n      msg = 'Choose at least one person to split this expense between.';\n      focusTarget = el.expSplit.querySelector('input');\n    }\n\n    if (msg) {\n      setError(el.expenseError, msg);\n      if (focusTarget) focusTarget.focus();\n      return;\n    }\n\n    state.expenses.push({\n      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7),\n      desc: desc,\n      cents: cents,\n      payer: payer,\n      split: state.people.filter(function (p) { return checked.indexOf(p) !== -1; })\n    });\n    save();\n    setError(el.expenseError, '');\n    el.expDesc.value = '';\n    el.expAmount.value = '';\n    el.expSplit.querySelectorAll('input[type=checkbox]').forEach(function (cb) { cb.checked = true; });\n    render();\n    el.expDesc.focus();\n  });\n\n  render();\n})();\n</script>\n</body>\n</html>"

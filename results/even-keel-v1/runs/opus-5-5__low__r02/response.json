      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0;background:#F6F3EC;color:#1F3A4D;font-family:\"IBM Plex Sans\",system-ui,sans-serif;font-size:16px;line-height:1.5}\nmain{max-width:720px;margin:0 auto;padding:40px 24px}\n@media(max-width:480px){main{padding:24px 16px}}\nheader{margin-bottom:32px}\n.wordmark{display:flex;align-items:center;gap:8px;margin:0;font-family:Fraunces,serif;font-weight:600;font-size:40px;line-height:1.2;color:#1F3A4D}\n.wordmark::before{content:\"\";width:24px;height:3px;background:#C2462B;flex:none}\n.tagline{margin:4px 0 0;color:#5B6B75;font-size:16px}\nsection{background:#FFFFFF;border:1px solid #D9D2C3;border-radius:6px;padding:24px;margin-bottom:24px}\n@media(max-width:480px){section{padding:16px}}\nh2{font-family:Fraunces,serif;font-weight:600;font-size:28px;line-height:1.2;margin:0 0 16px}\nlabel,.legend{display:block;font-weight:500;font-size:14px;margin-bottom:4px}\ninput[type=text],select{width:100%;font:inherit;color:#1F3A4D;background:#FFFFFF;border:1px solid #D9D2C3;border-radius:6px;padding:8px 12px;min-height:40px}\ninput[type=text]:hover,select:hover{border-color:#5B6B75}\ninput,select,button{transition:border-color 150ms,background-color 150ms}\n:focus-visible{outline:2px solid #1F3A4D;outline-offset:2px}\n.row{display:flex;gap:8px;flex-wrap:wrap}\n.row>.grow{flex:1 1 200px;min-width:0}\n.field{margin-bottom:16px}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n@media(max-width:560px){.grid{grid-template-columns:1fr}}\nbutton{font:inherit;font-weight:500;border-radius:6px;padding:8px 16px;min-height:40px;cursor:pointer}\n.primary{background:#C2462B;color:#FFFFFF;border:1px solid #C2462B}\n.secondary{background:#FFFFFF;color:#1F3A4D;border:1px solid #D9D2C3}\n.secondary:hover{border-color:#1F3A4D}\n.error{color:#1F3A4D;font-size:14px;margin:8px 0 0;border-left:3px solid #1F3A4D;padding-left:8px}\n.hint,.empty{color:#5B6B75;font-size:14px;margin:0}\nul{list-style:none;margin:0;padding:0}\n.list li{border-top:1px solid #D9D2C3;padding:12px 0;display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap}\n.list li:first-child{border-top:0;padding-top:0}\n.people{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}\n.people li{border:1px solid #D9D2C3;border-radius:6px;padding:4px 12px}\nfieldset{border:0;margin:0 0 16px;padding:0}\n.checks{display:flex;flex-wrap:wrap;gap:8px 16px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:400;font-size:16px;margin:0}\n.checks input{width:18px;height:18px;accent-color:#1F3A4D}\n.money{font-variant-numeric:tabular-nums;font-weight:500;white-space:nowrap}\n.pos{color:#2F6B4F}\n.meta{color:#5B6B75;font-size:14px;overflow-wrap:anywhere}\n.desc{overflow-wrap:anywhere}\n.info{min-width:0;flex:1 1 220px}\nh3{font-size:20px;font-family:Fraunces,serif;font-weight:600;margin:24px 0 8px}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n<header>\n<h1 class=\"wordmark\">Even Keel</h1>\n<p class=\"tagline\">Split trip costs fairly and settle up.</p>\n</header>\n\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People</h2>\n<form id=\"person-form\" novalidate>\n<label for=\"person-name\">Name</label>\n<div class=\"row\">\n<input class=\"grow\" type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" aria-describedby=\"person-error\">\n<button class=\"primary\" type=\"submit\" data-testid=\"add-person\">Add person</button>\n</div>\n<div id=\"person-error\" aria-live=\"polite\"></div>\n</form>\n<ul class=\"people\" id=\"people\"></ul>\n<p class=\"empty\" id=\"people-empty\">Add the people on your trip to get started.</p>\n</section>\n\n<section aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Expenses</h2>\n<form id=\"expense-form\" novalidate>\n<div class=\"grid\">\n<div class=\"field\"><label for=\"expense-desc\">Description</label><input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"expense-amount\">Amount (CAD)</label><input type=\"text\" inputmode=\"decimal\" id=\"expense-amount\" data-testid=\"expense-amount\" autocomplete=\"off\"></div>\n</div>\n<div class=\"field\"><label for=\"expense-payer\">Paid by</label><select id=\"expense-payer\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend class=\"legend\">Split between</legend>\n<div class=\"checks\" id=\"expense-split\" data-testid=\"expense-split\"></div>\n<p class=\"hint\" id=\"split-empty\">Add people first.</p>\n</fieldset>\n<button class=\"primary\" type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n<div id=\"expense-error\" aria-live=\"polite\"></div>\n</form>\n<h3>Logged expenses</h3>\n<ul class=\"list\" id=\"expenses\"></ul>\n<p class=\"empty\" id=\"expenses-empty\">Add an expense above to see it here.</p>\n</section>\n\n<section aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<ul class=\"list\" id=\"balances\"></ul>\n<p class=\"empty\" id=\"balances-empty\">Balances appear once you add people.</p>\n<h3>Settle up</h3>\n<ul class=\"list\" id=\"transfers\"></ul>\n<p class=\"empty\" id=\"transfers-empty\"></p>\n</section>\n</main>\n<script>\n(function(){\nconst KEY='even-keel-v1';\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nlet state={people:[],expenses:[],nextId:1};\ntry{const s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=Object.assign({nextId:1},s);}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};\nconst $=id=>document.getElementById(id);\nconst el=(t,props,txt)=>{const e=document.createElement(t);if(props)for(const k in props){if(k==='class')e.className=props[k];else e.setAttribute(k,props[k]);}if(txt!=null)e.textContent=txt;return e;};\n\nfunction showError(boxId,msg,input){\n  const box=$(boxId);box.innerHTML='';\n  if(msg){const p=el('p',{class:'error','data-testid':'form-error',role:'alert'},msg);box.appendChild(p);if(input){input.setAttribute('aria-invalid','true');input.focus();}}\n}\n\nfunction shares(exp){\n  const order=state.people.filter(p=>exp.split.includes(p));\n  const n=order.length,base=Math.floor(exp.cents/n),rem=exp.cents-base*n;\n  const m={};order.forEach((p,i)=>m[p]=base+(i<rem?1:0));return m;\n}\nfunction balances(){\n  const b={};state.people.forEach(p=>b[p]=0);\n  state.expenses.forEach(e=>{\n    if(b[e.payer]!==undefined)b[e.payer]+=e.cents;\n    const s=shares(e);for(const p in s)b[p]-=s[p];\n  });return b;\n}\nfunction settle(b){\n  const cred=[],debt=[];\n  state.people.forEach(p=>{if(b[p]>0)cred.push({p,a:b[p]});else if(b[p]<0)debt.push({p,a:-b[p]});});\n  cred.sort((x,y)=>y.a-x.a);debt.sort((x,y)=>y.a-x.a);\n  const out=[];let i=0,j=0;\n  while(i<debt.length&&j<cred.length){\n    const a=Math.min(debt[i].a,cred[j].a);\n    out.push({from:debt[i].p,to:cred[j].p,cents:a});\n    debt[i].a-=a;cred[j].a-=a;\n    if(!debt[i].a)i++;if(!cred[j].a)j++;\n  }return out;\n}\n\nfunction render(){\n  const pl=$('people');pl.innerHTML='';\n  state.people.forEach(p=>pl.appendChild(el('li',{'data-testid':'person'},p)));\n  $('people-empty').hidden=state.people.length>0;pl.hidden=!state.people.length;\n\n  const sel=$('expense-payer'),prev=sel.value;sel.innerHTML='';\n  state.people.forEach(p=>{const o=el('option',{value:p},p);sel.appendChild(o);});\n  if(state.people.includes(prev))sel.value=prev;\n  sel.disabled=!state.people.length;\n\n  const sp=$('expense-split');\n  const checked={};sp.querySelectorAll('input').forEach(c=>checked[c.value]=c.checked);\n  sp.innerHTML='';\n  state.people.forEach((p,i)=>{\n    const id='split-'+i;const l=el('label',{for:id});\n    const c=el('input',{type:'checkbox',id,value:p});c.checked=p in checked?checked[p]:true;\n    l.appendChild(c);l.appendChild(document.createTextNode(p));sp.appendChild(l);\n  });\n  $('split-empty').hidden=state.people.length>0;\n\n  const el2=$('expenses');el2.innerHTML='';\n  state.expenses.slice().reverse().forEach(e=>{\n    const li=el('li',{'data-testid':'expense'});\n    const info=el('div',{class:'info'});\n    info.appendChild(el('div',{class:'desc'},e.desc));\n    const order=state.people.filter(p=>e.split.includes(p));\n    info.appendChild(el('div',{class:'meta'},'Paid by '+e.payer+' · Split between '+order.join(', ')));\n    li.appendChild(info);\n    const r=el('div',{class:'row'});r.style.alignItems='center';r.style.gap='16px';\n    r.appendChild(el('span',{class:'money'},money(e.cents)));\n    const btn=el('button',{type:'button',class:'secondary','data-testid':'delete-expense','aria-label':'Remove '+e.desc},'Remove');\n    btn.addEventListener('click',()=>{state.expenses=state.expenses.filter(x=>x.id!==e.id);save();render();$('expense-desc').focus();});\n    r.appendChild(btn);li.appendChild(r);el2.appendChild(li);\n  });\n  $('expenses-empty').hidden=state.expenses.length>0;\n  $('expenses-empty').textContent=state.people.length?'Add an expense above to see it here.':'Add people, then log the first expense.';\n\n  const b=balances(),bl=$('balances');bl.innerHTML='';\n  state.people.forEach(p=>{\n    const c=b[p];\n    const li=el('li',{'data-testid':'balance','data-person':p,'data-cents':String(c)});\n    const info=el('div',{class:'info'});info.appendChild(el('div',{class:'desc'},p));\n    info.appendChild(el('div',{class:'meta'},c>0?'Is owed':c<0?'Owes':'Even'));\n    li.appendChild(info);\n    li.appendChild(el('span',{class:'money'+(c>0?' pos':'')},c<0?'−'+money(-c):money(c)));\n    bl.appendChild(li);\n  });\n  $('balances-empty').hidden=state.people.length>0;\n\n  const t=settle(b),tl=$('transfers');tl.innerHTML='';\n  t.forEach(x=>{\n    const li=el('li',{'data-testid':'transfer','data-from':x.from,'data-to':x.to,'data-cents':String(x.cents)});\n    li.appendChild(el('span',{class:'desc info'},x.from+' pays '+x.to));\n    li.appendChild(el('span',{class:'money'},money(x.cents)));tl.appendChild(li);\n  });\n  const te=$('transfers-empty');te.hidden=t.length>0;\n  te.textContent=state.expenses.length?'Everyone is even. No transfers needed.':'Log an expense to see who pays whom.';\n}\n\n$('person-form').addEventListener('submit',ev=>{\n  ev.preventDefault();const inp=$('person-name');inp.removeAttribute('aria-invalid');\n  const name=inp.value.trim();\n  if(!name)return showError('person-error','Enter a name.',inp);\n  if(state.people.some(p=>p.toLowerCase()===name.toLowerCase()))return showError('person-error',name+' is already on the trip. Enter a different name.',inp);\n  state.people.push(name);save();showError('person-error','');inp.value='';render();inp.focus();\n});\n\n$('expense-form').addEventListener('submit',ev=>{\n  ev.preventDefault();\n  const d=$('expense-desc'),a=$('expense-amount');\n  [d,a].forEach(x=>x.removeAttribute('aria-invalid'));\n  if(!state.people.length)return showError('expense-error','Add at least one person before adding an expense.',$('person-name'));\n  const desc=d.value.trim();\n  if(!desc)return showError('expense-error','Enter a description.',d);\n  const raw=a.value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  if(!raw)return showError('expense-error','Enter an amount.',a);\n  if(!/^\\d*(\\.\\d{0,2})?$/.test(raw)||raw==='.'){\n    return showError('expense-error',/^\\d*\\.\\d{3,}$/.test(raw)?'Enter an amount with at most 2 decimal places.':'Enter the amount as a number, for example 24.50.',a);\n  }\n  const [w,f='']=raw.split('.');const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(!(cents>0))return showError('expense-error','Enter an amount greater than $0.',a);\n  if(cents>Number.MAX_SAFE_INTEGER/1000)return showError('expense-error','Enter a smaller amount.',a);\n  const payer=$('expense-payer').value;\n  if(!state.people.includes(payer))return showError('expense-error','Choose who paid.',$('expense-payer'));\n  const split=[...$('expense-split').querySelectorAll('input:checked')].map(c=>c.value);\n  if(!split.length){const first=$('expense-split').querySelector('input');return showError('expense-error','Select at least one person to split between.',first);}\n  state.expenses.push({id:state.nextId++,desc,cents,payer,split});save();\n  showError('expense-error','');d.value='';a.value='';\n  $('expense-split').querySelectorAll('input').forEach(c=>c.checked=true);\n  render();d.focus();\n});\n\nrender();\n})();\n</script>\n</body>\n</html>"
    }

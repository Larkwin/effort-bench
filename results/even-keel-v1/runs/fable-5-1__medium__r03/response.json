      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel – trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --harbour: #1F3A4D;\n    --fog: #5B6B75;\n    --sailcloth: #F6F3EC;\n    --paper: #FFFFFF;\n    --rope: #D9D2C3;\n    --signal: #C2462B;\n    --kelp: #2F6B4F;\n  }\n  *, *::before, *::after { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; }\n  body {\n    margin: 0;\n    background: var(--sailcloth);\n    color: var(--harbour);\n    font-family: \"IBM Plex Sans\", system-ui, sans-serif;\n    font-size: 16px;\n    line-height: 1.5;\n    min-width: 320px;\n  }\n  main {\n    max-width: 720px;\n    margin: 0 auto;\n    padding: 32px 16px 48px;\n  }\n  @media (min-width: 600px) {\n    main { padding: 48px 24px 64px; }\n  }\n  header { margin-bottom: 32px; }\n  .wordmark {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin: 0;\n    font-family: \"Fraunces\", Georgia, serif;\n    font-weight: 600;\n    font-size: 28px;\n    line-height: 1.2;\n    color: var(--harbour);\n  }\n  .wordmark::before {\n    content: \"\";\n    display: block;\n    width: 24px;\n    height: 3px;\n    background: var(--signal);\n    flex: 0 0 24px;\n  }\n  .tagline {\n    margin: 4px 0 0 32px;\n    color: var(--fog);\n    font-size: 16px;\n  }\n  h2 {\n    font-family: \"Fraunces\", Georgia, serif;\n    font-weight: 600;\n    font-size: 20px;\n    line-height: 1.3;\n    margin: 0 0 16px;\n  }\n  section { margin-bottom: 32px; }\n  .panel {\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 16px;\n  }\n  .field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\n  label, legend {\n    font-weight: 500;\n    font-size: 14px;\n    color: var(--harbour);\n  }\n  .hint { font-size: 14px; color: var(--fog); margin: 0; }\n  input[type=\"text\"], select {\n    font: inherit;\n    color: var(--harbour);\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 8px 12px;\n    width: 100%;\n    min-width: 0;\n    height: 40px;\n  }\n  input[type=\"text\"]:hover, select:hover { border-color: var(--harbour); transition: border-color 150ms; }\n  input[aria-invalid=\"true\"], select[aria-invalid=\"true\"] { border-color: var(--harbour); }\n  .amount { font-variant-numeric: tabular-nums; }\n  button {\n    font: inherit;\n    font-weight: 500;\n    border-radius: 6px;\n    padding: 8px 16px;\n    height: 40px;\n    cursor: pointer;\n    border: 1px solid transparent;\n    transition: background-color 150ms, color 150ms, border-color 150ms;\n  }\n  .primary {\n    background: var(--signal);\n    color: var(--paper);\n    border-color: var(--signal);\n  }\n  .primary:hover { background: var(--harbour); border-color: var(--harbour); }\n  .secondary {\n    background: var(--paper);\n    color: var(--harbour);\n    border-color: var(--rope);\n    height: 32px;\n    padding: 4px 12px;\n    font-size: 14px;\n  }\n  .secondary:hover { border-color: var(--harbour); }\n  :focus-visible {\n    outline: 2px solid var(--harbour);\n    outline-offset: 2px;\n  }\n  .row {\n    display: grid;\n    gap: 16px;\n    grid-template-columns: 1fr;\n  }\n  @media (min-width: 520px) {\n    .row { grid-template-columns: 1fr 1fr; }\n    .row.inline { grid-template-columns: 1fr auto; align-items: end; }\n  }\n  .error {\n    margin: 0;\n    font-size: 14px;\n    font-weight: 500;\n    color: var(--harbour);\n    padding: 8px 12px;\n    border: 1px solid var(--harbour);\n    border-radius: 6px;\n    background: var(--sailcloth);\n  }\n  .error[hidden] { display: none; }\n  .actions { display: flex; justify-content: flex-start; }\n  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }\n  legend { padding: 0; margin-bottom: 4px; }\n  .checks {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n  .check {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 4px 12px 4px 8px;\n    font-weight: 400;\n    font-size: 16px;\n    background: var(--paper);\n    max-width: 100%;\n  }\n  .check span { overflow-wrap: anywhere; }\n  .check input {\n    width: 20px; height: 20px; margin: 0;\n    accent-color: var(--harbour);\n    flex: 0 0 20px;\n  }\n  ul { list-style: none; margin: 0; padding: 0; }\n  .list li {\n    padding: 12px 0;\n    border-top: 1px solid var(--rope);\n    display: flex;\n    gap: 16px;\n    align-items: flex-start;\n    justify-content: space-between;\n    min-width: 0;\n  }\n  .list li:first-child { border-top: 0; padding-top: 0; }\n  .list li:last-child { padding-bottom: 0; }\n  .people li { padding: 8px 0; }\n  .people li:first-child { padding-top: 0; }\n  .grow { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }\n  .meta { font-size: 14px; color: var(--fog); margin: 4px 0 0; }\n  .money {\n    font-variant-numeric: tabular-nums;\n    font-weight: 500;\n    white-space: nowrap;\n  }\n  .owed { color: var(--kelp); }\n  .balance-line { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }\n  .empty { margin: 0; color: var(--fog); }\n  .form { display: flex; flex-direction: column; gap: 16px; }\n  .person-form { align-items: end; }\n  .person-form .field { flex: 1 1 200px; }\n  .sr-only {\n    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n  }\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header>\n    <h1 class=\"wordmark\">Even Keel</h1>\n    <p class=\"tagline\">Split trip costs so everyone ends up even.</p>\n  </header>\n\n  <section aria-labelledby=\"people-heading\">\n    <h2 id=\"people-heading\">People</h2>\n    <div class=\"panel\">\n      <form id=\"person-form\" class=\"form\" novalidate>\n        <div class=\"row inline person-form\">\n          <div class=\"field\">\n            <label for=\"person-name\">Name</label>\n            <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" aria-describedby=\"person-error\">\n          </div>\n          <button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n        </div>\n        <p id=\"person-error\" class=\"error\" role=\"alert\" hidden></p>\n      </form>\n      <ul id=\"people-list\" class=\"list people\" aria-label=\"People on the trip\" style=\"margin-top:16px\"></ul>\n      <p id=\"people-empty\" class=\"empty\" style=\"margin-top:16px\">Add the people on your trip to get started.</p>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"expense-heading\">\n    <h2 id=\"expense-heading\">Add an expense</h2>\n    <div class=\"panel\">\n      <form id=\"expense-form\" class=\"form\" novalidate>\n        <div class=\"row\">\n          <div class=\"field\">\n            <label for=\"expense-desc\">Description</label>\n            <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\" aria-describedby=\"expense-error\">\n          </div>\n          <div class=\"field\">\n            <label for=\"expense-amount\">Amount (CAD)</label>\n            <input type=\"text\" id=\"expense-amount\" class=\"amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\" aria-describedby=\"expense-amount-hint expense-error\">\n            <p id=\"expense-amount-hint\" class=\"hint\">Dollars and cents, for example 42.50</p>\n          </div>\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-payer\">Paid by</label>\n          <select id=\"expense-payer\" data-testid=\"expense-payer\" aria-describedby=\"expense-error\"></select>\n        </div>\n        <fieldset>\n          <legend>Split between</legend>\n          <div id=\"expense-split\" class=\"checks\" data-testid=\"expense-split\"></div>\n          <p id=\"split-empty\" class=\"hint\" style=\"margin-top:4px\">Add a person above and they will appear here.</p>\n        </fieldset>\n        <p id=\"expense-error\" class=\"error\" role=\"alert\" hidden></p>\n        <div class=\"actions\">\n          <button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n        </div>\n      </form>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"expenses-heading\">\n    <h2 id=\"expenses-heading\">Expenses</h2>\n    <div class=\"panel\">\n      <ul id=\"expenses-list\" class=\"list\" aria-label=\"Expenses, newest first\"></ul>\n      <p id=\"expenses-empty\" class=\"empty\"></p>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"balances-heading\">\n    <h2 id=\"balances-heading\">Balances</h2>\n    <div class=\"panel\">\n      <ul id=\"balances-list\" class=\"list\" aria-label=\"Balances\"></ul>\n      <p id=\"balances-empty\" class=\"empty\"></p>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"settle-heading\">\n    <h2 id=\"settle-heading\">Settle up</h2>\n    <div class=\"panel\">\n      <ul id=\"transfers-list\" class=\"list\" aria-label=\"Transfers to settle up\"></ul>\n      <p id=\"transfers-empty\" class=\"empty\"></p>\n    </div>\n  </section>\n</main>\n\n<script>\n(function () {\n  'use strict';\n\n  var STORAGE_KEY = 'even-keel-v1';\n  var state = { people: [], expenses: [] };\n\n  var fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  function money(cents) { return fmt.format(cents / 100); }\n\n  function load() {\n    try {\n      var saved = JSON.parse(localStorage.getItem(STORAGE_KEY));\n      if (saved && Array.isArray(saved.people) && Array.isArray(saved.expenses)) {\n        state = saved;\n      }\n    } catch (e) { /* start fresh */ }\n  }\n  function save() {\n    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) { /* ignore */ }\n  }\n\n  function $(id) { return document.getElementById(id); }\n  function el(tag, attrs, children) {\n    var node = document.createElement(tag);\n    if (attrs) {\n      Object.keys(attrs).forEach(function (k) {\n        if (k === 'text') node.textContent = attrs[k];\n        else if (k === 'className') node.className = attrs[k];\n        else node.setAttribute(k, attrs[k]);\n      });\n    }\n    (children || []).forEach(function (c) { if (c) node.appendChild(c); });\n    return node;\n  }\n\n  /* Errors */\n  function showError(box, msg, field) {\n    box.textContent = msg;\n    box.setAttribute('data-testid', 'form-error');\n    box.hidden = false;\n    if (field) {\n      field.setAttribute('aria-invalid', 'true');\n      field.focus();\n    }\n  }\n  function clearError(box, fields) {\n    box.textContent = '';\n    box.removeAttribute('data-testid');\n    box.hidden = true;\n    fields.forEach(function (f) { f.removeAttribute('aria-invalid'); });\n  }\n\n  /* Money parsing: works in integer cents */\n  function parseAmount(raw) {\n    var s = String(raw).trim().replace(/^\\$/, '').replace(/,/g, '');\n    if (s === '' || s === '.' || !/^\\d*(\\.\\d*)?$/.test(s)) {\n      return { error: 'Enter an amount greater than $0.' };\n    }\n    var parts = s.split('.');\n    var whole = parts[0] || '0';\n    var frac = parts[1] || '';\n    if (frac.length > 2) {\n      return { error: 'Enter an amount with at most 2 decimal places.' };\n    }\n    var cents = parseInt(whole, 10) * 100 + parseInt((frac + '00').slice(0, 2), 10);\n    if (!(cents > 0)) {\n      return { error: 'Enter an amount greater than $0.' };\n    }\n    return { cents: cents };\n  }\n\n  /* Shares: equal split, leftover cents to earliest-added people */\n  function shares(expense) {\n    var order = state.people.filter(function (p) { return expense.split.indexOf(p) !== -1; });\n    var n = order.length;\n    var result = {};\n    if (n === 0) return result;\n    var base = Math.floor(expense.cents / n);\n    var rem = expense.cents % n;\n    order.forEach(function (p, i) { result[p] = base + (i < rem ? 1 : 0); });\n    return result;\n  }\n\n  function balances() {\n    var bal = {};\n    state.people.forEach(function (p) { bal[p] = 0; });\n    state.expenses.forEach(function (e) {\n      if (bal.hasOwnProperty(e.payer)) bal[e.payer] += e.cents;\n      var sh = shares(e);\n      Object.keys(sh).forEach(function (p) { bal[p] -= sh[p]; });\n    });\n    return bal;\n  }\n\n  function settle(bal) {\n    var creditors = [], debtors = [];\n    state.people.forEach(function (p) {\n      if (bal[p] > 0) creditors.push({ name: p, cents: bal[p] });\n      else if (bal[p] < 0) debtors.push({ name: p, cents: -bal[p] });\n    });\n    creditors.sort(function (a, b) { return b.cents - a.cents; });\n    debtors.sort(function (a, b) { return b.cents - a.cents; });\n    var transfers = [];\n    var i = 0, j = 0;\n    while (i < debtors.length && j < creditors.length) {\n      var amt = Math.min(debtors[i].cents, creditors[j].cents);\n      if (amt > 0) transfers.push({ from: debtors[i].name, to: creditors[j].name, cents: amt });\n      debtors[i].cents -= amt;\n      creditors[j].cents -= amt;\n      if (debtors[i].cents === 0) i++;\n      if (creditors[j].cents === 0) j++;\n    }\n    return transfers;\n  }\n\n  /* Rendering */\n  function renderPeople() {\n    var list = $('people-list');\n    list.textContent = '';\n    state.people.forEach(function (p) {\n      list.appendChild(el('li', { 'data-testid': 'person' }, [el('span', { className: 'grow', text: p })]));\n    });\n    $('people-empty').hidden = state.people.length > 0;\n    list.hidden = state.people.length === 0;\n  }\n\n  function renderExpenseControls() {\n    var payer = $('expense-payer');\n    var prev = payer.value;\n    payer.textContent = '';\n    if (state.people.length === 0) {\n      payer.appendChild(el('option', { value: '', text: 'Add a person first' }));\n      payer.disabled = true;\n    } else {\n      payer.disabled = false;\n      state.people.forEach(function (p) {\n        payer.appendChild(el('option', { value: p, text: p }));\n      });\n      if (state.people.indexOf(prev) !== -1) payer.value = prev;\n    }\n\n    var split = $('expense-split');\n    var unchecked = {};\n    Array.prototype.forEach.call(split.querySelectorAll('input'), function (cb) {\n      if (!cb.checked) unchecked[cb.value] = true;\n    });\n    split.textContent = '';\n    state.people.forEach(function (p, i) {\n      var id = 'split-' + i;\n      var cb = el('input', { type: 'checkbox', id: id, value: p, name: 'split' });\n      cb.checked = !unchecked[p];\n      split.appendChild(el('label', { className: 'check', 'for': id }, [cb, el('span', { text: p })]));\n    });\n    $('split-empty').hidden = state.people.length > 0;\n  }\n\n  function renderExpenses() {\n    var list = $('expenses-list');\n    var empty = $('expenses-empty');\n    list.textContent = '';\n    var items = state.expenses.slice().reverse();\n    items.forEach(function (e) {\n      var splitNames = state.people.filter(function (p) { return e.split.indexOf(p) !== -1; });\n      var remove = el('button', { type: 'button', className: 'secondary', 'data-testid': 'delete-expense', 'aria-label': 'Remove ' + e.desc, text: 'Remove' });\n      remove.addEventListener('click', function () {\n        state.expenses = state.expenses.filter(function (x) { return x.id !== e.id; });\n        save();\n        render();\n        $('expense-desc').focus();\n      });\n      var body = el('div', { className: 'grow' }, [\n        el('div', { className: 'balance-line' }, [\n          el('span', { text: e.desc, style: 'font-weight:500' }),\n          el('span', { className: 'money', text: money(e.cents) })\n        ]),\n        el('p', { className: 'meta', text: 'Paid by ' + e.payer }),\n        el('p', { className: 'meta', text: 'Split between ' + splitNames.join(', ') })\n      ]);\n      list.appendChild(el('li', { 'data-testid': 'expense' }, [body, remove]));\n    });\n    list.hidden = items.length === 0;\n    empty.hidden = items.length > 0;\n    if (items.length === 0) {\n      empty.textContent = state.people.length === 0\n        ? 'Add a person, then log the first thing someone paid for.'\n        : 'Log the first thing someone paid for to see who owes whom.';\n    }\n  }\n\n  function renderBalances() {\n    var list = $('balances-list');\n    var empty = $('balances-empty');\n    list.textContent = '';\n    var bal = balances();\n    var show = state.people.length > 0 && state.expenses.length > 0;\n    if (show) {\n      state.people.forEach(function (p) {\n        var c = bal[p];\n        var label = c > 0 ? 'is owed' : (c < 0 ? 'owes' : 'is even');\n        var amount = el('span', { className: 'money' + (c > 0 ? ' owed' : ''), text: money(c) });\n        list.appendChild(el('li', { 'data-testid': 'balance', 'data-person': p, 'data-cents': String(c) }, [\n          el('div', { className: 'grow' }, [\n            el('span', { text: p, style: 'font-weight:500' }),\n            el('span', { className: 'meta', text: ' ' + label, style: 'display:inline' })\n          ]),\n          amount\n        ]));\n      });\n    }\n    list.hidden = !show;\n    empty.hidden = show;\n    if (!show) empty.textContent = 'Balances appear here once you add an expense.';\n  }\n\n  function renderTransfers() {\n    var list = $('transfers-list');\n    var empty = $('transfers-empty');\n    list.textContent = '';\n    var show = state.people.length > 0 && state.expenses.length > 0;\n    var transfers = show ? settle(balances()) : [];\n    transfers.forEach(function (t) {\n      list.appendChild(el('li', { 'data-testid': 'transfer', 'data-from': t.from, 'data-to': t.to, 'data-cents': String(t.cents) }, [\n        el('div', { className: 'grow' }, [\n          el('span', { text: t.from, style: 'font-weight:500' }),\n          el('span', { className: 'meta', text: ' pays ', style: 'display:inline' }),\n          el('span', { text: t.to, style: 'font-weight:500' })\n        ]),\n        el('span', { className: 'money', text: money(t.cents) })\n      ]));\n    });\n    list.hidden = transfers.length === 0;\n    empty.hidden = transfers.length > 0;\n    if (transfers.length === 0) {\n      empty.textContent = show ? 'Everyone is even. Nothing to settle.' : 'Transfers appear here once someone owes money.';\n    }\n  }\n\n  function render() {\n    renderPeople();\n    renderExpenseControls();\n    renderExpenses();\n    renderBalances();\n    renderTransfers();\n  }\n\n  /* Forms */\n  $('person-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var input = $('person-name');\n    var box = $('person-error');\n    clearError(box, [input]);\n    var name = input.value.trim();\n    if (name === '') {\n      showError(box, 'Enter a name.', input);\n      return;\n    }\n    var lower = name.toLowerCase();\n    var dup = state.people.some(function (p) { return p.toLowerCase() === lower; });\n    if (dup) {\n      showError(box, 'Someone named ' + name + ' is already on the trip. Use a different name.', input);\n      return;\n    }\n    state.people.push(name);\n    save();\n    input.value = '';\n    render();\n    input.focus();\n  });\n\n  $('person-name').addEventListener('input', function () {\n    clearError($('person-error'), [this]);\n  });\n\n  $('expense-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var desc = $('expense-desc');\n    var amount = $('expense-amount');\n    var payer = $('expense-payer');\n    var box = $('expense-error');\n    clearError(box, [desc, amount, payer]);\n\n    if (state.people.length === 0) {\n      showError(box, 'Add at least one person before adding an expense.', $('person-name'));\n      return;\n    }\n    var d = desc.value.trim();\n    if (d === '') {\n      showError(box, 'Enter a description of what was paid for.', desc);\n      return;\n    }\n    var parsed = parseAmount(amount.value);\n    if (parsed.error) {\n      showError(box, parsed.error, amount);\n      return;\n    }\n    if (!payer.value || state.people.indexOf(payer.value) === -1) {\n      showError(box, 'Choose who paid.', payer);\n      return;\n    }\n    var checked = Array.prototype.filter.call(\n      $('expense-split').querySelectorAll('input[type=\"checkbox\"]'),\n      function (cb) { return cb.checked; }\n    ).map(function (cb) { return cb.value; });\n    if (checked.length === 0) {\n      var first = $('expense-split').querySelector('input');\n      showError(box, 'Select at least one person to split between.', first);\n      return;\n    }\n\n    state.expenses.push({\n      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7),\n      desc: d,\n      cents: parsed.cents,\n      payer: payer.value,\n      split: checked\n    });\n    save();\n    desc.value = '';\n    amount.value = '';\n    Array.prototype.forEach.call($('expense-split').querySelectorAll('input'), function (cb) { cb.checked = true; });\n    render();\n    desc.focus();\n  });\n\n  ['expense-desc', 'expense-amount', 'expense-payer'].forEach(function (id) {\n    $(id).addEventListener('input', function () {\n      clearError($('expense-error'), [$('expense-desc'), $('expense-amount'), $('expense-payer')]);\n    });\n  });\n  $('expense-split').addEventListener('change', function () {\n    clearError($('expense-error'), [$('expense-desc'), $('expense-amount'), $('expense-payer')]);\n  });\n\n  load();\n  render();\n})();\n</script>\n</body>\n</html>"

      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --harbour: #1F3A4D;\n    --fog: #5B6B75;\n    --sailcloth: #F6F3EC;\n    --paper: #FFFFFF;\n    --rope: #D9D2C3;\n    --signal: #C2462B;\n    --kelp: #2F6B4F;\n  }\n  * { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; }\n  body {\n    margin: 0;\n    background: var(--sailcloth);\n    color: var(--harbour);\n    font-family: \"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    font-size: 16px;\n    line-height: 1.5;\n    font-weight: 400;\n  }\n  main {\n    max-width: 720px;\n    margin: 0 auto;\n    padding: 32px 24px 48px;\n  }\n  @media (max-width: 600px) {\n    main { padding: 24px 16px 40px; }\n  }\n  header { margin-bottom: 32px; }\n  h1, h2 {\n    font-family: \"Fraunces\", Georgia, serif;\n    font-weight: 600;\n    color: var(--harbour);\n    margin: 0;\n    line-height: 1.2;\n  }\n  h1 {\n    font-size: 28px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .rule { display: inline-block; width: 24px; height: 3px; background: var(--signal); flex: none; }\n  h2 { font-size: 20px; margin-bottom: 16px; }\n  .tagline { margin: 8px 0 0; color: var(--fog); font-size: 16px; }\n\n  section.panel {\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 24px;\n    margin-bottom: 24px;\n  }\n  @media (max-width: 600px) {\n    section.panel { padding: 16px; }\n  }\n\n  label, legend { display: block; font-size: 14px; font-weight: 500; color: var(--harbour); margin-bottom: 4px; padding: 0; }\n  .hint { font-size: 14px; color: var(--fog); margin: 4px 0 0; }\n  .field { margin-bottom: 16px; }\n  input[type=\"text\"], select {\n    width: 100%;\n    height: 40px;\n    padding: 0 12px;\n    font: inherit;\n    font-size: 16px;\n    color: var(--harbour);\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    transition: border-color 150ms;\n  }\n  input[type=\"text\"]:hover, select:hover { border-color: var(--fog); }\n  input[aria-invalid=\"true\"], select[aria-invalid=\"true\"] { border-color: var(--harbour); border-width: 2px; padding: 0 11px; }\n  :focus-visible { outline: 2px solid var(--harbour); outline-offset: 2px; }\n\n  button {\n    font: inherit;\n    font-size: 16px;\n    font-weight: 500;\n    height: 40px;\n    padding: 0 16px;\n    border-radius: 6px;\n    border: 1px solid var(--rope);\n    background: var(--paper);\n    color: var(--harbour);\n    cursor: pointer;\n    transition: background-color 150ms, border-color 150ms, color 150ms;\n  }\n  button:hover { background: var(--sailcloth); border-color: var(--fog); }\n  button.primary { background: var(--signal); border-color: var(--signal); color: var(--paper); }\n  button.primary:hover { background: var(--harbour); border-color: var(--harbour); color: var(--paper); }\n\n  .inline-form { display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap; }\n  .inline-form .grow { flex: 1 1 200px; min-width: 0; }\n\n  .error-slot:empty { display: none; }\n  .error {\n    margin: 0 0 16px;\n    padding: 8px 12px;\n    border: 1px solid var(--harbour);\n    border-radius: 6px;\n    background: var(--paper);\n    color: var(--harbour);\n    font-size: 14px;\n    font-weight: 500;\n  }\n  .inline-form + .error-slot .error { margin: 16px 0 0; }\n\n  ul.list { list-style: none; margin: 0; padding: 0; }\n  ul.list > li { border-top: 1px solid var(--rope); padding: 16px 0; }\n  ul.list > li:first-child { border-top: 0; padding-top: 0; }\n  ul.list > li:last-child { padding-bottom: 0; }\n  .people-list { margin-top: 24px; }\n  .people-list li { overflow-wrap: anywhere; }\n  .empty { margin: 0; color: var(--fog); }\n\n  .row { display: flex; gap: 16px; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }\n  .row > .info { flex: 1 1 200px; min-width: 0; overflow-wrap: anywhere; }\n  .row > .side { display: flex; gap: 16px; align-items: center; flex: none; }\n  .title { font-weight: 500; }\n  .meta { font-size: 14px; color: var(--fog); margin: 0; }\n  .money { font-variant-numeric: tabular-nums; font-weight: 500; white-space: nowrap; }\n\n  .balance-amount { text-align: right; }\n  .balance-amount .label { display: block; font-size: 14px; color: var(--fog); font-weight: 400; }\n  .pos { color: var(--kelp); }\n  .neg, .zero { color: var(--harbour); }\n\n  .transfer .row { align-items: center; }\n  .arrow { color: var(--fog); }\n\n  fieldset { border: 0; padding: 0; margin: 0 0 16px; min-width: 0; }\n  .split-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 8px; }\n  .check {\n    display: flex; align-items: center; gap: 8px;\n    margin: 0; padding: 8px 12px;\n    border: 1px solid var(--rope); border-radius: 6px;\n    font-size: 16px; font-weight: 400; color: var(--harbour);\n    background: var(--paper);\n    cursor: pointer;\n    min-width: 0; overflow-wrap: anywhere;\n  }\n  .check:hover { border-color: var(--fog); }\n  .check input { width: 20px; height: 20px; margin: 0; flex: none; accent-color: var(--harbour); }\n  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }\n  @media (max-width: 600px) { .form-grid { grid-template-columns: 1fr; } }\n  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header>\n    <h1><span class=\"rule\" aria-hidden=\"true\"></span>Even Keel</h1>\n    <p class=\"tagline\">Split trip costs and see who owes whom.</p>\n  </header>\n\n  <section class=\"panel\" aria-labelledby=\"people-h\">\n    <h2 id=\"people-h\">People</h2>\n    <form id=\"person-form\" class=\"inline-form\" novalidate>\n      <div class=\"grow\">\n        <label for=\"person-name\">Name</label>\n        <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" maxlength=\"40\" autocomplete=\"off\" aria-describedby=\"person-error\">\n      </div>\n      <button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n    </form>\n    <div class=\"error-slot\" id=\"person-error\" aria-live=\"polite\"></div>\n    <div class=\"people-list\" id=\"people-list\"></div>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"expense-h\">\n    <h2 id=\"expense-h\">Add an expense</h2>\n    <form id=\"expense-form\" novalidate>\n      <div class=\"field\">\n        <label for=\"expense-desc\">Description</label>\n        <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" maxlength=\"80\" autocomplete=\"off\">\n      </div>\n      <div class=\"form-grid\">\n        <div class=\"field\">\n          <label for=\"expense-amount\">Amount (CAD)</label>\n          <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\" aria-describedby=\"amount-hint\">\n          <p class=\"hint\" id=\"amount-hint\">Up to 2 decimal places.</p>\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-payer\">Paid by</label>\n          <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n        </div>\n      </div>\n      <fieldset>\n        <legend>Split between</legend>\n        <div id=\"expense-split\" data-testid=\"expense-split\" class=\"split-grid\"></div>\n      </fieldset>\n      <div class=\"error-slot\" id=\"expense-error\" aria-live=\"polite\"></div>\n      <button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n    </form>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"balances-h\">\n    <h2 id=\"balances-h\">Balances</h2>\n    <div id=\"balances\"></div>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"settle-h\">\n    <h2 id=\"settle-h\">Settle up</h2>\n    <div id=\"settle\"></div>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"expenses-h\">\n    <h2 id=\"expenses-h\">Expenses</h2>\n    <div id=\"expenses\"></div>\n  </section>\n</main>\n\n<script>\n(function () {\n  var KEY = 'evenkeel.v1';\n  var fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  function money(c) { return fmt.format(c / 100); }\n  function signed(c) { return c < 0 ? '\\u2212' + money(-c) : money(c); }\n\n  var state = load();\n  var unchecked = {}; // names unchecked in the split list\n\n  function load() {\n    try {\n      var raw = JSON.parse(localStorage.getItem(KEY));\n      if (raw && Array.isArray(raw.people) && Array.isArray(raw.expenses)) {\n        var people = raw.people.filter(function (p) { return typeof p === 'string'; });\n        var expenses = raw.expenses.filter(function (e) {\n          return e && typeof e.desc === 'string' && Number.isInteger(e.cents) && people.indexOf(e.payer) > -1 &&\n            Array.isArray(e.split) && e.split.length && e.split.every(function (n) { return people.indexOf(n) > -1; });\n        });\n        return { people: people, expenses: expenses };\n      }\n    } catch (e) {}\n    return { people: [], expenses: [] };\n  }\n  function save() {\n    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}\n  }\n\n  function h(tag, attrs) {\n    var el = document.createElement(tag);\n    for (var k in (attrs || {})) {\n      if (k === 'class') el.className = attrs[k];\n      else el.setAttribute(k, attrs[k]);\n    }\n    for (var i = 2; i < arguments.length; i++) {\n      var c = arguments[i];\n      if (c == null) continue;\n      el.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);\n    }\n    return el;\n  }\n  function $(id) { return document.getElementById(id); }\n  function clear(el) { while (el.firstChild) el.removeChild(el.firstChild); }\n\n  /* ---------- calculations ---------- */\n  function sharesFor(exp) {\n    var sel = state.people.filter(function (p) { return exp.split.indexOf(p) > -1; });\n    var n = sel.length, base = Math.floor(exp.cents / n), rem = exp.cents % n, out = {};\n    sel.forEach(function (p, i) { out[p] = base + (i < rem ? 1 : 0); });\n    return out;\n  }\n  function balances() {\n    var b = {};\n    state.people.forEach(function (p) { b[p] = 0; });\n    state.expenses.forEach(function (e) {\n      b[e.payer] += e.cents;\n      var s = sharesFor(e);\n      for (var p in s) b[p] -= s[p];\n    });\n    return b;\n  }\n  function transfers(b) {\n    var cred = [], debt = [];\n    state.people.forEach(function (p, i) {\n      if (b[p] > 0) cred.push({ n: p, c: b[p], i: i });\n      else if (b[p] < 0) debt.push({ n: p, c: -b[p], i: i });\n    });\n    function cmp(a, z) { return z.c - a.c || a.i - z.i; }\n    var out = [];\n    while (cred.length && debt.length) {\n      cred.sort(cmp); debt.sort(cmp);\n      var c = cred[0], d = debt[0], amt = Math.min(c.c, d.c);\n      out.push({ from: d.n, to: c.n, cents: amt });\n      c.c -= amt; d.c -= amt;\n      if (c.c === 0) cred.shift();\n      if (d.c === 0) debt.shift();\n    }\n    return out;\n  }\n\n  /* ---------- rendering ---------- */\n  function renderPeople() {\n    var box = $('people-list');\n    clear(box);\n    if (!state.people.length) {\n      box.appendChild(h('p', { class: 'empty' }, 'Add the first person on your trip to get started.'));\n      return;\n    }\n    var ul = h('ul', { class: 'list', 'aria-label': 'People on the trip' });\n    state.people.forEach(function (p) {\n      ul.appendChild(h('li', { 'data-testid': 'person' }, p));\n    });\n    box.appendChild(ul);\n  }\n\n  function renderFormControls() {\n    var sel = $('expense-payer');\n    var prev = sel.value;\n    clear(sel);\n    if (!state.people.length) {\n      sel.appendChild(h('option', { value: '' }, 'Add people first'));\n    } else {\n      state.people.forEach(function (p) { sel.appendChild(h('option', { value: p }, p)); });\n      sel.value = state.people.indexOf(prev) > -1 ? prev : state.people[0];\n    }\n    var box = $('expense-split');\n    clear(box);\n    if (!state.people.length) {\n      box.appendChild(h('p', { class: 'empty' }, 'Add at least one person to start splitting expenses.'));\n      return;\n    }\n    state.people.forEach(function (p) {\n      var cb = h('input', { type: 'checkbox', value: p });\n      cb.checked = !unchecked[p];\n      cb.addEventListener('change', function () {\n        if (cb.checked) delete unchecked[p]; else unchecked[p] = true;\n      });\n      box.appendChild(h('label', { class: 'check' }, cb, h('span', {}, p)));\n    });\n  }\n\n  function renderBalances() {\n    var box = $('balances');\n    clear(box);\n    if (!state.people.length) {\n      box.appendChild(h('p', { class: 'empty' }, 'Add people to the trip and their balances will show here.'));\n      return;\n    }\n    var b = balances();\n    var ul = h('ul', { class: 'list' });\n    state.people.forEach(function (p) {\n      var c = b[p];\n      var cls = c > 0 ? 'pos' : (c < 0 ? 'neg' : 'zero');\n      var label = c > 0 ? 'is owed' : (c < 0 ? 'owes' : 'is even');\n      var amount = h('div', { class: 'balance-amount money ' + cls },\n        c > 0 ? '+' + money(c) : signed(c),\n        h('span', { class: 'label' }, label));\n      ul.appendChild(h('li', { 'data-testid': 'balance', 'data-person': p, 'data-cents': String(c) },\n        h('div', { class: 'row' },\n          h('div', { class: 'info title' }, p),\n          amount)));\n    });\n    box.appendChild(ul);\n  }\n\n  function renderSettle() {\n    var box = $('settle');\n    clear(box);\n    if (!state.expenses.length) {\n      box.appendChild(h('p', { class: 'empty' }, 'Add an expense and the payments needed to even things out will show here.'));\n      return;\n    }\n    var t = transfers(balances());\n    if (!t.length) {\n      box.appendChild(h('p', { class: 'empty' }, 'Everyone is even. Nobody needs to pay anyone.'));\n      return;\n    }\n    var ul = h('ul', { class: 'list' });\n    t.forEach(function (x) {\n      ul.appendChild(h('li', { class: 'transfer', 'data-testid': 'transfer', 'data-from': x.from, 'data-to': x.to, 'data-cents': String(x.cents) },\n        h('div', { class: 'row' },\n          h('div', { class: 'info' }, h('span', { class: 'title' }, x.from), ' pays ', h('span', { class: 'title' }, x.to)),\n          h('div', { class: 'money' }, money(x.cents)))));\n    });\n    box.appendChild(ul);\n  }\n\n  function renderExpenses() {\n    var box = $('expenses');\n    clear(box);\n    if (!state.expenses.length) {\n      box.appendChild(h('p', { class: 'empty' }, state.people.length\n        ? 'Log the first thing someone paid for using the form above.'\n        : 'Add the people on your trip, then log what each person paid for.'));\n      return;\n    }\n    var ul = h('ul', { class: 'list' });\n    state.expenses.slice().reverse().forEach(function (e) {\n      var btn = h('button', { type: 'button', 'data-testid': 'delete-expense' }, 'Remove', h('span', { class: 'sr' }, ' ' + e.desc));\n      btn.addEventListener('click', function () {\n        state.expenses = state.expenses.filter(function (x) { return x.id !== e.id; });\n        save(); renderAll();\n      });\n      var names = state.people.filter(function (p) { return e.split.indexOf(p) > -1; });\n      ul.appendChild(h('li', { 'data-testid': 'expense' },\n        h('div', { class: 'row' },\n          h('div', { class: 'info' },\n            h('div', { class: 'title' }, e.desc),\n            h('p', { class: 'meta' }, 'Paid by ' + e.payer),\n            h('p', { class: 'meta' }, 'Split between ' + names.join(', '))),\n          h('div', { class: 'side' }, h('span', { class: 'money' }, money(e.cents)), btn))));\n    });\n    box.appendChild(ul);\n  }\n\n  function renderAll() {\n    renderPeople(); renderFormControls(); renderBalances(); renderSettle(); renderExpenses();\n  }\n\n  /* ---------- errors ---------- */\n  function showError(slotId, msg) {\n    var slot = $(slotId);\n    clear(slot);\n    if (msg) slot.appendChild(h('p', { class: 'error', 'data-testid': 'form-error' }, msg));\n  }\n  function setInvalid(el, on) {\n    if (on) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');\n  }\n\n  /* ---------- people ---------- */\n  var nameInput = $('person-name');\n  nameInput.addEventListener('input', function () { showError('person-error', ''); setInvalid(nameInput, false); });\n  $('person-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var name = nameInput.value.trim().replace(/\\s+/g, ' ');\n    if (!name) {\n      showError('person-error', 'Enter a name.'); setInvalid(nameInput, true); nameInput.focus(); return;\n    }\n    var dup = state.people.some(function (p) { return p.toLowerCase() === name.toLowerCase(); });\n    if (dup) {\n      showError('person-error', name + ' is already on the trip. Use a different name.');\n      setInvalid(nameInput, true); nameInput.focus(); return;\n    }\n    state.people.push(name);\n    save();\n    nameInput.value = '';\n    showError('person-error', ''); setInvalid(nameInput, false);\n    renderAll();\n    nameInput.focus();\n  });\n\n  /* ---------- expenses ---------- */\n  var descInput = $('expense-desc'), amountInput = $('expense-amount'), payerSel = $('expense-payer');\n  [descInput, amountInput, payerSel].forEach(function (el) {\n    el.addEventListener('input', function () {\n      showError('expense-error', '');\n      setInvalid(descInput, false); setInvalid(amountInput, false); setInvalid(payerSel, false);\n    });\n  });\n  $('expense-split').addEventListener('change', function () { showError('expense-error', ''); });\n\n  function parseAmount(s) {\n    s = s.trim().replace(/^\\$\\s*/, '').replace(/,/g, '');\n    var m = /^(\\d*)(?:\\.(\\d*))?$/.exec(s);\n    if (!s || !m || (!m[1] && !m[2])) return { err: 'Enter an amount greater than $0.' };\n    var frac = m[2] || '';\n    if (frac.length > 2) return { err: 'Use at most 2 decimal places, for example $12.50.' };\n    if ((m[1] || '').replace(/^0+/, '').length > 9) return { err: 'Enter an amount under $1,000,000,000.' };\n    var cents = parseInt(m[1] || '0', 10) * 100 + parseInt((frac + '00').slice(0, 2), 10);\n    if (cents <= 0) return { err: 'Enter an amount greater than $0.' };\n    return { cents: cents };\n  }\n\n  $('expense-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var desc = descInput.value.trim();\n    var err = null, focusEl = null, bad = null;\n    var amt = parseAmount(amountInput.value);\n    var payer = payerSel.value;\n    var split = Array.prototype.slice.call($('expense-split').querySelectorAll('input[type=\"checkbox\"]'))\n      .filter(function (c) { return c.checked; }).map(function (c) { return c.value; });\n\n    if (!state.people.length) { err = 'Add at least one person before you add an expense.'; focusEl = nameInput; }\n    else if (!desc) { err = 'Enter a description.'; focusEl = bad = descInput; }\n    else if (amt.err) { err = amt.err; focusEl = bad = amountInput; }\n    else if (state.people.indexOf(payer) < 0) { err = 'Choose who paid.'; focusEl = bad = payerSel; }\n    else if (!split.length) { err = 'Choose at least one person to split between.'; focusEl = $('expense-split').querySelector('input'); }\n\n    setInvalid(descInput, false); setInvalid(amountInput, false); setInvalid(payerSel, false);\n    if (err) {\n      showError('expense-error', err);\n      if (bad) setInvalid(bad, true);\n      if (focusEl) focusEl.focus();\n      return;\n    }\n    state.expenses.push({ id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7), desc: desc, cents: amt.cents, payer: payer, split: split });\n    save();\n    showError('expense-error', '');\n    descInput.value = ''; amountInput.value = '';\n    unchecked = {};\n    renderAll();\n    descInput.focus();\n  });\n\n  renderAll();\n})();\n</script>\n</body>\n</html>"

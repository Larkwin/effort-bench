      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --harbour: #1F3A4D;\n    --fog: #5B6B75;\n    --sailcloth: #F6F3EC;\n    --paper: #FFFFFF;\n    --rope: #D9D2C3;\n    --signal: #C2462B;\n    --kelp: #2F6B4F;\n  }\n  * { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; }\n  body {\n    margin: 0;\n    background: var(--sailcloth);\n    color: var(--harbour);\n    font-family: \"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n    font-weight: 400;\n    font-size: 16px;\n    line-height: 1.5;\n  }\n  main {\n    max-width: 720px;\n    margin: 0 auto;\n    padding: 40px 24px 48px;\n  }\n  h1, h2 {\n    font-family: \"Fraunces\", Georgia, \"Times New Roman\", serif;\n    font-weight: 600;\n    color: var(--harbour);\n    margin: 0;\n    line-height: 1.2;\n  }\n  h1 {\n    font-size: 28px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .rule { display: block; width: 24px; height: 3px; background: var(--signal); flex: none; }\n  h2 { font-size: 20px; }\n  h2:focus { outline: none; }\n  header { margin-bottom: 32px; }\n  header p { margin: 4px 0 0; color: var(--fog); }\n\n  section.panel {\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 24px;\n    margin-bottom: 24px;\n  }\n  .panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px 16px; flex-wrap: wrap; margin-bottom: 16px; }\n  .meta { color: var(--fog); font-size: 14px; margin: 0; }\n  .num { font-variant-numeric: tabular-nums; }\n\n  label, legend { display: block; font-size: 14px; font-weight: 500; color: var(--harbour); margin: 0 0 4px; padding: 0; }\n  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }\n  input[type=\"text\"], select {\n    width: 100%;\n    min-height: 44px;\n    padding: 8px 12px;\n    font: inherit;\n    color: var(--harbour);\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    transition: border-color 150ms;\n  }\n  input[type=\"text\"]:hover, select:hover { border-color: var(--fog); }\n  input[aria-invalid=\"true\"], select[aria-invalid=\"true\"] { border-color: var(--harbour); }\n  :focus-visible { outline: 2px solid var(--harbour); outline-offset: 2px; }\n\n  .row { display: flex; gap: 8px; align-items: flex-end; }\n  .row .grow { flex: 1; min-width: 0; }\n  .field { margin-bottom: 16px; }\n  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n  .grid2 .field { min-width: 0; }\n\n  button {\n    font: inherit;\n    font-weight: 500;\n    min-height: 44px;\n    padding: 8px 16px;\n    border-radius: 6px;\n    cursor: pointer;\n    transition: background-color 150ms, border-color 150ms;\n  }\n  .primary { background: var(--signal); color: var(--paper); border: 1px solid var(--signal); }\n  .primary:hover { background: var(--harbour); border-color: var(--harbour); }\n  .secondary { background: var(--paper); color: var(--harbour); border: 1px solid var(--rope); }\n  .secondary:hover { border-color: var(--harbour); }\n\n  .error-slot { min-height: 0; }\n  .error {\n    display: flex; align-items: flex-start; gap: 8px;\n    margin: 0 0 16px;\n    font-size: 14px; font-weight: 500; color: var(--harbour);\n  }\n  .row + .error-slot .error { margin-top: 8px; margin-bottom: 0; }\n  .error svg { flex: none; margin-top: 2px; }\n\n  .empty { margin: 0; color: var(--fog); }\n\n  ul.plain { list-style: none; margin: 0; padding: 0; }\n  .people { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }\n  .people li {\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 4px 12px;\n    overflow-wrap: anywhere;\n    min-width: 0;\n  }\n  .people:empty { display: none; }\n\n  .split { display: flex; flex-wrap: wrap; gap: 8px; }\n  .split label.check {\n    display: flex; align-items: center; gap: 8px;\n    min-height: 44px; padding: 8px 12px; margin: 0;\n    border: 1px solid var(--rope); border-radius: 6px;\n    font-size: 16px; font-weight: 400; cursor: pointer;\n    overflow-wrap: anywhere;\n  }\n  .split label.check:hover { border-color: var(--fog); }\n  .split input[type=\"checkbox\"] { width: 20px; height: 20px; margin: 0; accent-color: var(--harbour); flex: none; }\n\n  .list > li { border-top: 1px solid var(--rope); padding: 16px 0; }\n  .list > li:first-child { border-top: 0; padding-top: 0; }\n  .list > li:last-child { padding-bottom: 0; }\n\n  .expense { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: start; }\n  .expense .desc { font-weight: 500; overflow-wrap: anywhere; }\n  .expense .amt { font-weight: 500; text-align: right; }\n  .expense .meta { grid-column: 1; overflow-wrap: anywhere; }\n  .expense button { grid-column: 2; grid-row: 2 / span 2; align-self: end; }\n  .divider { border-top: 1px solid var(--rope); margin: 24px 0 16px; }\n  .list-title { font-size: 16px; font-weight: 500; margin: 0 0 16px; }\n\n  .balance, .transfer { display: flex; justify-content: space-between; align-items: baseline; gap: 8px 16px; flex-wrap: wrap; }\n  .balance .name, .transfer .what { overflow-wrap: anywhere; min-width: 0; }\n  .balance .name { font-weight: 500; }\n  .balance .figure { text-align: right; }\n  .balance .state { color: var(--fog); font-size: 14px; margin-right: 8px; }\n  .balance.pos .state, .balance.pos .figure { color: var(--kelp); }\n  .balance .figure { font-weight: 500; }\n  .transfer .amt { font-weight: 500; }\n  .transfer b { font-weight: 500; }\n\n  @media (max-width: 480px) {\n    main { padding: 24px 16px 40px; }\n    section.panel { padding: 16px; }\n    .grid2 { grid-template-columns: 1fr; gap: 0; }\n    .row { flex-direction: column; align-items: stretch; }\n    .row button { width: 100%; }\n    .primary.full { width: 100%; }\n  }\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header>\n    <h1><span class=\"rule\" aria-hidden=\"true\"></span>Even Keel</h1>\n    <p>Log what everyone paid and see who owes whom.</p>\n  </header>\n\n  <section class=\"panel\" aria-labelledby=\"people-h\">\n    <div class=\"panel-head\"><h2 id=\"people-h\">People</h2></div>\n    <form id=\"person-form\" novalidate>\n      <div class=\"row\">\n        <div class=\"grow\">\n          <label for=\"person-name\">Name</label>\n          <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" maxlength=\"40\">\n        </div>\n        <button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n      </div>\n      <div class=\"error-slot\" id=\"person-error-slot\" aria-live=\"polite\"></div>\n    </form>\n    <p class=\"empty\" id=\"people-empty\" style=\"margin-top:16px\">Add the first person on the trip.</p>\n    <ul class=\"plain people\" id=\"people-list\" aria-label=\"People on the trip\"></ul>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"exp-h\">\n    <div class=\"panel-head\"><h2 id=\"exp-h\">Expenses</h2></div>\n    <p class=\"empty\" id=\"expense-hint\" style=\"margin-bottom:16px\">Add people first, then log what each person paid.</p>\n    <form id=\"expense-form\" novalidate>\n      <div class=\"field\">\n        <label for=\"expense-desc\">Description</label>\n        <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\" maxlength=\"80\">\n      </div>\n      <div class=\"grid2\">\n        <div class=\"field\">\n          <label for=\"expense-amount\">Amount (CAD)</label>\n          <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\">\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-payer\">Paid by</label>\n          <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n        </div>\n      </div>\n      <fieldset class=\"field\">\n        <legend>Split between</legend>\n        <div class=\"split\" id=\"expense-split\" data-testid=\"expense-split\"></div>\n      </fieldset>\n      <div class=\"error-slot\" id=\"expense-error-slot\" aria-live=\"polite\"></div>\n      <button type=\"submit\" class=\"primary full\" data-testid=\"add-expense\">Add expense</button>\n    </form>\n\n    <div class=\"divider\"></div>\n    <div class=\"panel-head\" style=\"margin-bottom:16px\">\n      <h3 class=\"list-title\" id=\"expenses-list-h\" tabindex=\"-1\" style=\"margin:0\">Logged expenses</h3>\n      <p class=\"meta num\" id=\"expense-total\"></p>\n    </div>\n    <p class=\"empty\" id=\"expenses-empty\">No expenses yet. Add the first one above.</p>\n    <ul class=\"plain list\" id=\"expense-list\"></ul>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"bal-h\">\n    <div class=\"panel-head\">\n      <h2 id=\"bal-h\">Balances</h2>\n      <p class=\"meta\">Paid minus share</p>\n    </div>\n    <p class=\"empty\" id=\"balances-empty\">Add people to see their balances.</p>\n    <ul class=\"plain list\" id=\"balance-list\"></ul>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"settle-h\">\n    <div class=\"panel-head\"><h2 id=\"settle-h\">Settle up</h2></div>\n    <p class=\"empty\" id=\"settle-empty\"></p>\n    <ul class=\"plain list\" id=\"transfer-list\"></ul>\n  </section>\n</main>\n\n<script>\n(function () {\n  'use strict';\n  var STORE_KEY = 'evenkeel.trip.v1';\n  var fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  function money(cents) { return fmt.format(cents / 100); }\n\n  var state = load();\n\n  function load() {\n    try {\n      var raw = localStorage.getItem(STORE_KEY);\n      if (!raw) return { people: [], expenses: [] };\n      var d = JSON.parse(raw);\n      var people = Array.isArray(d.people) ? d.people.filter(function (p) { return typeof p === 'string'; }) : [];\n      var expenses = (Array.isArray(d.expenses) ? d.expenses : []).filter(function (e) {\n        return e && typeof e.desc === 'string' && Number.isSafeInteger(e.cents) && e.cents > 0 &&\n          people.indexOf(e.payer) !== -1 && Array.isArray(e.split) &&\n          e.split.some(function (n) { return people.indexOf(n) !== -1; });\n      }).map(function (e) {\n        return { id: String(e.id), desc: e.desc, cents: e.cents, payer: e.payer,\n          split: e.split.filter(function (n) { return people.indexOf(n) !== -1; }) };\n      });\n      return { people: people, expenses: expenses };\n    } catch (err) {\n      return { people: [], expenses: [] };\n    }\n  }\n  function save() {\n    try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (err) { /* storage unavailable */ }\n  }\n\n  /* ---------- helpers ---------- */\n  function $(id) { return document.getElementById(id); }\n  function el(tag, attrs, children) {\n    var n = document.createElement(tag);\n    if (attrs) Object.keys(attrs).forEach(function (k) {\n      if (k === 'text') n.textContent = attrs[k];\n      else if (k === 'class') n.className = attrs[k];\n      else n.setAttribute(k, attrs[k]);\n    });\n    (children || []).forEach(function (c) { n.appendChild(typeof c === 'string' ? document.createTextNode(c) : c); });\n    return n;\n  }\n\n  /* ---------- calculations ---------- */\n  function sharesFor(exp) {\n    var selected = state.people.filter(function (p) { return exp.split.indexOf(p) !== -1; });\n    var n = selected.length;\n    var out = {};\n    if (!n) return out;\n    var base = Math.floor(exp.cents / n);\n    var rem = exp.cents - base * n;\n    selected.forEach(function (p, i) { out[p] = base + (i < rem ? 1 : 0); });\n    return out;\n  }\n  function balances() {\n    var b = {};\n    state.people.forEach(function (p) { b[p] = 0; });\n    state.expenses.forEach(function (e) {\n      b[e.payer] += e.cents;\n      var s = sharesFor(e);\n      Object.keys(s).forEach(function (p) { b[p] -= s[p]; });\n    });\n    return b;\n  }\n  function settle(b) {\n    var debtors = [], creditors = [];\n    state.people.forEach(function (p, i) {\n      if (b[p] < 0) debtors.push({ name: p, amt: -b[p], i: i });\n      else if (b[p] > 0) creditors.push({ name: p, amt: b[p], i: i });\n    });\n    function cmp(a, c) { return c.amt - a.amt || a.i - c.i; }\n    var out = [];\n    while (debtors.length && creditors.length) {\n      debtors.sort(cmp); creditors.sort(cmp);\n      var d = debtors[0], c = creditors[0];\n      var t = Math.min(d.amt, c.amt);\n      out.push({ from: d.name, to: c.name, cents: t });\n      d.amt -= t; c.amt -= t;\n      if (d.amt === 0) debtors.shift();\n      if (c.amt === 0) creditors.shift();\n    }\n    return out;\n  }\n\n  /* ---------- errors ---------- */\n  var iconSvg = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"#1F3A4D\" stroke-width=\"1.5\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"6.25\"/><path d=\"M8 7.25v3.5M8 5v.01\"/></svg>';\n  function showError(slotId, message) {\n    var slot = $(slotId);\n    slot.replaceChildren();\n    var p = el('p', { 'class': 'error', 'data-testid': 'form-error', id: slotId + '-msg' });\n    p.innerHTML = iconSvg;\n    p.appendChild(el('span', { text: message }));\n    slot.appendChild(p);\n  }\n  function clearError(slotId, inputs) {\n    $(slotId).replaceChildren();\n    inputs.forEach(function (i) { i.removeAttribute('aria-invalid'); i.removeAttribute('aria-describedby'); });\n  }\n  function flag(input, slotId) {\n    input.setAttribute('aria-invalid', 'true');\n    input.setAttribute('aria-describedby', slotId + '-msg');\n  }\n\n  /* ---------- people ---------- */\n  var nameInput = $('person-name');\n  $('person-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    clearError('person-error-slot', [nameInput]);\n    var name = nameInput.value.trim();\n    if (!name) {\n      showError('person-error-slot', 'Enter a name.');\n      flag(nameInput, 'person-error-slot'); nameInput.focus(); return;\n    }\n    var dup = state.people.some(function (p) { return p.toLowerCase() === name.toLowerCase(); });\n    if (dup) {\n      showError('person-error-slot', name + ' is already on the trip. Enter a different name.');\n      flag(nameInput, 'person-error-slot'); nameInput.focus(); return;\n    }\n    state.people.push(name);\n    save();\n    nameInput.value = '';\n    renderAll();\n    nameInput.focus();\n  });\n  nameInput.addEventListener('input', function () { clearError('person-error-slot', [nameInput]); });\n\n  function renderPeople() {\n    var list = $('people-list');\n    list.replaceChildren.apply(list, state.people.map(function (p) {\n      return el('li', { 'data-testid': 'person', text: p });\n    }));\n    $('people-empty').hidden = state.people.length > 0;\n  }\n\n  /* ---------- expense form ---------- */\n  var descInput = $('expense-desc'), amountInput = $('expense-amount');\n  var payerSel = $('expense-payer'), splitBox = $('expense-split');\n  var expenseInputs = [descInput, amountInput, payerSel];\n\n  function renderExpenseForm() {\n    var prevPayer = payerSel.value;\n    var prev = {};\n    splitBox.querySelectorAll('input[type=\"checkbox\"]').forEach(function (i) { prev[i.value] = i.checked; });\n\n    payerSel.replaceChildren();\n    if (!state.people.length) {\n      payerSel.appendChild(el('option', { value: '', text: 'Add a person first' }));\n    } else {\n      state.people.forEach(function (p) { payerSel.appendChild(el('option', { value: p, text: p })); });\n      payerSel.value = state.people.indexOf(prevPayer) !== -1 ? prevPayer : state.people[0];\n    }\n\n    splitBox.replaceChildren();\n    if (!state.people.length) {\n      splitBox.appendChild(el('p', { 'class': 'empty', text: 'The people you add will appear here.' }));\n    }\n    state.people.forEach(function (p, i) {\n      var id = 'split-' + i;\n      var cb = el('input', { type: 'checkbox', id: id, value: p });\n      cb.checked = Object.prototype.hasOwnProperty.call(prev, p) ? prev[p] : true;\n      splitBox.appendChild(el('label', { 'class': 'check', 'for': id }, [cb, el('span', { text: p })]));\n    });\n    $('expense-hint').hidden = state.people.length > 0;\n  }\n\n  function parseAmount(raw) {\n    var s = raw.trim().replace(/^\\$\\s*/, '');\n    var m = /^(\\d*)(?:\\.(\\d*))?$/.exec(s);\n    var frac = m ? (m[2] || '') : '';\n    if (!m || (m[1] === '' && frac === '')) return { error: 'Enter an amount greater than $0.' };\n    if (frac.length > 2) return { error: 'Use at most 2 decimal places, like $12.50.' };\n    if (m[1].length > 9) return { error: 'Enter an amount under $1,000,000,000.' };\n    var cents = parseInt(m[1] || '0', 10) * 100 + parseInt((frac + '00').slice(0, 2), 10);\n    if (cents <= 0) return { error: 'Enter an amount greater than $0.' };\n    return { cents: cents };\n  }\n\n  $('expense-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    clearError('expense-error-slot', expenseInputs);\n    var slot = 'expense-error-slot';\n    function fail(msg, input) {\n      showError(slot, msg);\n      if (input) { flag(input, slot); input.focus(); }\n    }\n    var desc = descInput.value.trim();\n    if (!desc) return fail('Enter a description.', descInput);\n    var amt = parseAmount(amountInput.value);\n    if (amt.error) return fail(amt.error, amountInput);\n    if (!state.people.length) return fail('Add at least one person before logging an expense.', null);\n    var payer = payerSel.value;\n    if (state.people.indexOf(payer) === -1) return fail('Choose who paid.', payerSel);\n    var split = [];\n    splitBox.querySelectorAll('input[type=\"checkbox\"]').forEach(function (cb) { if (cb.checked) split.push(cb.value); });\n    if (!split.length) {\n      showError(slot, 'Select at least one person to split between.');\n      var first = splitBox.querySelector('input[type=\"checkbox\"]');\n      if (first) first.focus();\n      return;\n    }\n    state.expenses.push({\n      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7),\n      desc: desc, cents: amt.cents, payer: payer, split: split\n    });\n    save();\n    descInput.value = '';\n    amountInput.value = '';\n    splitBox.querySelectorAll('input[type=\"checkbox\"]').forEach(function (cb) { cb.checked = true; });\n    renderAll();\n    descInput.focus();\n  });\n  [descInput, amountInput, payerSel].forEach(function (i) {\n    i.addEventListener('input', function () { clearError('expense-error-slot', expenseInputs); });\n  });\n\n  /* ---------- expense list ---------- */\n  function renderExpenses() {\n    var list = $('expense-list');\n    var items = state.expenses.slice().reverse().map(function (e) {\n      var descId = 'exp-desc-' + e.id;\n      var names = state.people.filter(function (p) { return e.split.indexOf(p) !== -1; });\n      var btn = el('button', { type: 'button', 'class': 'secondary', 'data-testid': 'delete-expense', 'aria-describedby': descId, text: 'Remove' });\n      btn.addEventListener('click', function () {\n        state.expenses = state.expenses.filter(function (x) { return x.id !== e.id; });\n        save();\n        renderAll();\n        $('expenses-list-h').focus();\n      });\n      return el('li', { 'data-testid': 'expense', 'data-id': e.id }, [\n        el('div', { 'class': 'expense' }, [\n          el('span', { 'class': 'desc', id: descId, text: e.desc }),\n          el('span', { 'class': 'amt num', text: money(e.cents) }),\n          el('p', { 'class': 'meta', text: 'Paid by ' + e.payer }),\n          el('p', { 'class': 'meta', text: 'Split between ' + names.join(', ') }),\n          btn\n        ])\n      ]);\n    });\n    list.replaceChildren.apply(list, items);\n    $('expenses-empty').hidden = state.expenses.length > 0;\n    var total = state.expenses.reduce(function (s, e) { return s + e.cents; }, 0);\n    $('expense-total').textContent = state.expenses.length ? 'Total ' + money(total) : '';\n  }\n\n  /* ---------- balances & settle ---------- */\n  function renderBalances() {\n    var b = balances();\n    var list = $('balance-list');\n    list.replaceChildren.apply(list, state.people.map(function (p) {\n      var c = b[p];\n      var cls = c > 0 ? 'pos' : 'neg';\n      var label = c > 0 ? 'is owed' : (c < 0 ? 'owes' : 'is even');\n      var amountText = c === 0 ? money(0) : money(c);\n      var li = el('li', { 'data-testid': 'balance', 'data-person': p, 'data-cents': String(c) }, [\n        el('div', { 'class': 'balance ' + cls }, [\n          el('span', { 'class': 'name', text: p }),\n          el('span', { 'class': 'figure' }, [\n            el('span', { 'class': 'state', text: label }),\n            el('span', { 'class': 'num', text: amountText })\n          ])\n        ])\n      ]);\n      return li;\n    }));\n    $('balances-empty').hidden = state.people.length > 0;\n\n    var transfers = settle(b);\n    var tl = $('transfer-list');\n    tl.replaceChildren.apply(tl, transfers.map(function (t) {\n      return el('li', { 'data-testid': 'transfer', 'data-from': t.from, 'data-to': t.to, 'data-cents': String(t.cents) }, [\n        el('div', { 'class': 'transfer' }, [\n          el('span', { 'class': 'what' }, [el('b', { text: t.from }), ' pays ', el('b', { text: t.to })]),\n          el('span', { 'class': 'amt num', text: money(t.cents) })\n        ])\n      ]);\n    }));\n    var msg = $('settle-empty');\n    if (!state.people.length) { msg.textContent = 'Add people and expenses to see who pays whom.'; msg.hidden = false; }\n    else if (!state.expenses.length) { msg.textContent = 'Log an expense to see how to settle up.'; msg.hidden = false; }\n    else if (!transfers.length) { msg.textContent = 'Everyone is even. No transfers are needed.'; msg.hidden = false; }\n    else msg.hidden = true;\n  }\n\n  function renderAll() {\n    renderPeople();\n    renderExpenseForm();\n    renderExpenses();\n    renderBalances();\n  }\n  renderAll();\n})();\n</script>\n</body>\n</html>"

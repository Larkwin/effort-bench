    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0}\nbody{background:#F6F3EC;color:#1F3A4D;font-family:\"IBM Plex Sans\",system-ui,sans-serif;font-size:16px;line-height:1.5}\nmain{max-width:720px;margin:0 auto;padding:40px 24px}\n@media (max-width:480px){main{padding:24px 16px}}\nh1,h2{font-family:Fraunces,Georgia,serif;font-weight:600;margin:0}\nh1{font-size:40px;line-height:1.2;display:flex;align-items:center;gap:16px}\nh1::before{content:\"\";width:24px;height:3px;background:#C2462B;flex:none}\nh2{font-size:28px;margin-bottom:16px}\n.tag{color:#5B6B75;margin:8px 0 0}\nheader{margin-bottom:32px}\nsection{background:#FFFFFF;border:1px solid #D9D2C3;border-radius:6px;padding:24px;margin-bottom:24px}\n@media (max-width:480px){section{padding:16px}}\nlabel,.lbl{display:block;font-weight:500;margin-bottom:4px}\n.field{margin-bottom:16px}\ninput[type=text],select{width:100%;font:inherit;color:#1F3A4D;background:#FFFFFF;border:1px solid #D9D2C3;border-radius:6px;padding:8px 12px;min-height:40px}\n.row{display:flex;gap:8px;flex-wrap:wrap}\n.row input{flex:1 1 160px;min-width:0}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}\n@media (max-width:480px){.grid{grid-template-columns:1fr}}\nbutton{font:inherit;font-weight:500;border-radius:6px;padding:8px 16px;min-height:40px;cursor:pointer;transition:background-color 150ms,border-color 150ms}\n.primary{background:#C2462B;color:#FFFFFF;border:1px solid #C2462B}\n.secondary{background:#FFFFFF;color:#1F3A4D;border:1px solid #D9D2C3}\n.secondary:hover{border-color:#1F3A4D}\n:focus-visible{outline:2px solid #1F3A4D;outline-offset:2px}\nfieldset{border:none;padding:0;margin:0 0 16px}\nlegend{font-weight:500;padding:0;margin-bottom:4px}\n.checks{display:flex;flex-wrap:wrap;gap:8px 16px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:400;margin:0}\n.checks input{width:18px;height:18px;accent-color:#1F3A4D}\n.err{color:#1F3A4D;font-weight:500;border-left:3px solid #1F3A4D;padding-left:8px;margin:8px 0 0}\nul{list-style:none;margin:0;padding:0}\nli.item{border-top:1px solid #D9D2C3;padding:12px 0;display:flex;justify-content:space-between;gap:16px;align-items:flex-start;flex-wrap:wrap}\nli.item:first-child{border-top:none}\n.meta{color:#5B6B75;font-size:14px;overflow-wrap:anywhere}\n.money{font-variant-numeric:tabular-nums;white-space:nowrap}\n.pos{color:#2F6B4F;font-weight:500}\n.neg{color:#1F3A4D;font-weight:500}\n.empty{color:#5B6B75;margin:0}\n.grow{flex:1 1 200px;min-width:0;overflow-wrap:anywhere}\n.right{display:flex;gap:16px;align-items:center}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n<header>\n<h1>Even Keel</h1>\n<p class=\"tag\">Split trip costs fairly and settle up.</p>\n</header>\n\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People</h2>\n<form id=\"personForm\" novalidate>\n<label for=\"pname\">Name</label>\n<div class=\"row\">\n<input type=\"text\" id=\"pname\" data-testid=\"person-name\" autocomplete=\"off\" aria-describedby=\"perr\">\n<button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n</div>\n<div id=\"perr\" aria-live=\"polite\"></div>\n</form>\n<ul id=\"people\" style=\"margin-top:16px\"></ul>\n</section>\n\n<section aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Expenses</h2>\n<form id=\"expForm\" novalidate>\n<div class=\"grid\">\n<div class=\"field\"><label for=\"edesc\">Description</label><input type=\"text\" id=\"edesc\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"eamt\">Amount (CAD)</label><input type=\"text\" id=\"eamt\" inputmode=\"decimal\" data-testid=\"expense-amount\" autocomplete=\"off\"></div>\n</div>\n<div class=\"field\"><label for=\"epayer\">Paid by</label><select id=\"epayer\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend>Split between</legend><div class=\"checks\" id=\"esplit\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n<div id=\"eerr\" aria-live=\"polite\"></div>\n</form>\n<ul id=\"expenses\" style=\"margin-top:16px\"></ul>\n</section>\n\n<section aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<ul id=\"balances\"></ul>\n</section>\n\n<section aria-labelledby=\"h-set\">\n<h2 id=\"h-set\">Settle up</h2>\n<ul id=\"transfers\"></ul>\n</section>\n</main>\n<script>\n(function(){\nconst KEY='even-keel-v1';\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nlet state={people:[],expenses:[],nextId:1};\ntry{const s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=Object.assign({nextId:1},s);}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};\nconst $=id=>document.getElementById(id);\nconst el=(t,a,txt)=>{const e=document.createElement(t);if(a)for(const k in a)e.setAttribute(k,a[k]);if(txt!=null)e.textContent=txt;return e;};\n\nfunction showErr(box,msg,input){\n  box.innerHTML='';\n  if(msg){const p=el('p',{class:'err','data-testid':'form-error',id:box.id+'-m'},msg);box.appendChild(p);\n    if(input){input.setAttribute('aria-invalid','true');input.focus();}}\n}\nfunction shares(exp){\n  const order=state.people.filter(p=>exp.split.includes(p));\n  const n=order.length,base=Math.floor(exp.cents/n);let rem=exp.cents-base*n;\n  const m={};order.forEach(p=>{m[p]=base+(rem>0?1:0);if(rem>0)rem--;});return m;\n}\nfunction balances(){\n  const b={};state.people.forEach(p=>b[p]=0);\n  state.expenses.forEach(e=>{\n    if(b[e.payer]!==undefined)b[e.payer]+=e.cents;\n    const s=shares(e);for(const p in s)b[p]-=s[p];\n  });return b;\n}\nfunction settle(b){\n  const cr=[],db=[];\n  state.people.forEach(p=>{if(b[p]>0)cr.push({p,c:b[p]});else if(b[p]<0)db.push({p,c:-b[p]});});\n  cr.sort((a,b)=>b.c-a.c);db.sort((a,b)=>b.c-a.c);\n  const t=[];let i=0,j=0;\n  while(i<db.length&&j<cr.length){\n    const x=Math.min(db[i].c,cr[j].c);\n    t.push({from:db[i].p,to:cr[j].p,c:x});\n    db[i].c-=x;cr[j].c-=x;if(!db[i].c)i++;if(!cr[j].c)j++;\n  }return t;\n}\nfunction render(){\n  const pl=$('people');pl.innerHTML='';\n  if(!state.people.length)pl.appendChild(el('p',{class:'empty'},'Add the people on your trip to get started.'));\n  state.people.forEach(p=>pl.appendChild(el('li',{class:'item','data-testid':'person'},p)));\n\n  const sel=$('epayer'),prevPayer=sel.value;sel.innerHTML='';\n  state.people.forEach(p=>{const o=el('option',{value:p},p);sel.appendChild(o);});\n  if(state.people.includes(prevPayer))sel.value=prevPayer;\n  const sp=$('esplit');const prev={};sp.querySelectorAll('input').forEach(c=>prev[c.value]=c.checked);\n  sp.innerHTML='';\n  if(!state.people.length)sp.appendChild(el('p',{class:'empty'},'Add people first, then choose who shares each expense.'));\n  state.people.forEach((p,i)=>{const l=el('label');const c=el('input',{type:'checkbox',value:p,id:'sp'+i});\n    c.checked=prev[p]!==undefined?prev[p]:true;l.appendChild(c);l.appendChild(document.createTextNode(p));sp.appendChild(l);});\n\n  const xl=$('expenses');xl.innerHTML='';\n  if(!state.expenses.length)xl.appendChild(el('p',{class:'empty'},'Log an expense above to see it here.'));\n  state.expenses.slice().reverse().forEach(e=>{\n    const li=el('li',{class:'item','data-testid':'expense'});\n    const d=el('div',{class:'grow'});d.appendChild(el('div',{style:'font-weight:500'},e.desc));\n    d.appendChild(el('div',{class:'meta'},'Paid by '+e.payer+' · Split between '+state.people.filter(p=>e.split.includes(p)).join(', ')));\n    const r=el('div',{class:'right'});r.appendChild(el('span',{class:'money',style:'font-weight:500'},money(e.cents)));\n    const btn=el('button',{type:'button',class:'secondary','data-testid':'delete-expense','aria-label':'Remove '+e.desc},'Remove');\n    btn.onclick=()=>{state.expenses=state.expenses.filter(x=>x.id!==e.id);save();render();$('edesc').focus();};\n    r.appendChild(btn);li.appendChild(d);li.appendChild(r);xl.appendChild(li);\n  });\n\n  const b=balances(),bl=$('balances');bl.innerHTML='';\n  if(!state.people.length)bl.appendChild(el('p',{class:'empty'},'Balances appear once you add people.'));\n  state.people.forEach(p=>{\n    const c=b[p];const li=el('li',{class:'item','data-testid':'balance','data-person':p,'data-cents':String(c)});\n    li.appendChild(el('span',{class:'grow'},p));\n    const txt=c>0?'is owed '+money(c):c<0?'owes −'+money(-c).replace('-',''):'is even, '+money(0);\n    li.appendChild(el('span',{class:'money '+(c>0?'pos':c<0?'neg':'meta')},txt));bl.appendChild(li);\n  });\n\n  const tl=$('transfers');tl.innerHTML='';const t=settle(b);\n  if(!t.length)tl.appendChild(el('p',{class:'empty'},state.expenses.length?'Everyone is even. There is nothing to settle.':'Add expenses to see who pays whom.'));\n  t.forEach(x=>{const li=el('li',{class:'item','data-testid':'transfer','data-from':x.from,'data-to':x.to,'data-cents':String(x.c)});\n    li.appendChild(el('span',{class:'grow'},x.from+' pays '+x.to));li.appendChild(el('span',{class:'money',style:'font-weight:500'},money(x.c)));tl.appendChild(li);});\n}\n\n$('personForm').addEventListener('submit',ev=>{\n  ev.preventDefault();const inp=$('pname'),name=inp.value.trim();inp.removeAttribute('aria-invalid');\n  if(!name)return showErr($('perr'),'Enter a name.',inp);\n  if(state.people.some(p=>p.toLowerCase()===name.toLowerCase()))return showErr($('perr'),name+' is already on the trip. Enter a different name.',inp);\n  state.people.push(name);save();showErr($('perr'),'');inp.value='';render();\n  const c=$('esplit').querySelector('input[value=\"'+CSS.escape(name)+'\"]');if(c)c.checked=true;inp.focus();\n});\n$('expForm').addEventListener('submit',ev=>{\n  ev.preventDefault();const box=$('eerr');['edesc','eamt'].forEach(i=>$(i).removeAttribute('aria-invalid'));\n  if(!state.people.length)return showErr(box,'Add at least one person before adding an expense.',$('pname'));\n  const desc=$('edesc').value.trim();if(!desc)return showErr(box,'Enter a description.',$('edesc'));\n  const raw=$('eamt').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  if(!raw)return showErr(box,'Enter an amount.',$('eamt'));\n  if(!/^\\d*(\\.\\d{0,2})?$/.test(raw)||raw==='.')return showErr(box,'Enter an amount as a number with at most 2 decimal places, like 12.50.',$('eamt'));\n  const [w,f='']=raw.split('.');const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(!(cents>0))return showErr(box,'Enter an amount greater than $0.',$('eamt'));\n  const payer=$('epayer').value;if(!state.people.includes(payer))return showErr(box,'Choose who paid.',$('epayer'));\n  const split=[...$('esplit').querySelectorAll('input:checked')].map(c=>c.value);\n  if(!split.length)return showErr(box,'Choose at least one person to split with.',$('esplit').querySelector('input'));\n  state.expenses.push({id:state.nextId++,desc,cents,payer,split});save();showErr(box,'');\n  $('edesc').value='';$('eamt').value='';render();$('esplit').querySelectorAll('input').forEach(c=>c.checked=true);$('edesc').focus();\n});\nrender();\n})();\n</script>\n</body>\n</html>"
    }

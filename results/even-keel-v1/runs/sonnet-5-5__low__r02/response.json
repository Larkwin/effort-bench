    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0;background:#F6F3EC;color:#1F3A4D;font:400 16px/1.5 'IBM Plex Sans',sans-serif}\nmain{max-width:720px;margin:0 auto;padding:32px 16px 48px}\n@media(min-width:600px){main{padding-left:24px;padding-right:24px}}\nh1,h2{font-family:Fraunces,serif;font-weight:600;margin:0}\nh1{font-size:28px;display:flex;align-items:center;gap:8px}\nh1:before{content:\"\";width:24px;height:3px;background:#C2462B;display:block}\nh2{font-size:20px;margin-bottom:16px}\n.sub{color:#5B6B75;font-size:14px;margin:4px 0 24px}\nsection{background:#fff;border:1px solid #D9D2C3;border-radius:6px;padding:16px;margin-bottom:24px}\nlabel,legend{display:block;font-weight:500;font-size:14px;margin-bottom:4px;padding:0}\ninput[type=text],input[type=number],select{width:100%;font:inherit;padding:8px;border:1px solid #D9D2C3;border-radius:6px;background:#fff;color:#1F3A4D;min-height:40px}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row>div{flex:1;min-width:160px}\n.field{margin-bottom:16px}\nbutton{font:500 16px 'IBM Plex Sans',sans-serif;border-radius:6px;padding:8px 16px;min-height:40px;cursor:pointer;border:1px solid #D9D2C3;background:#fff;color:#1F3A4D}\nbutton.primary{background:#C2462B;border-color:#C2462B;color:#fff}\nbutton.primary:hover{background:#A93A22}\nbutton:hover{border-color:#1F3A4D}\n:focus-visible{outline:2px solid #1F3A4D;outline-offset:2px}\nfieldset{border:0;padding:0;margin:0}\n.checks{display:flex;flex-wrap:wrap;gap:8px 16px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:400;font-size:16px;margin:0}\n.err{color:#1F3A4D;font-size:14px;font-weight:500;margin:8px 0 0;border-left:3px solid #1F3A4D;padding-left:8px}\n.err:empty{display:none}\nul{list-style:none;margin:0;padding:0}\nli{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:8px 0;border-top:1px solid #D9D2C3;flex-wrap:wrap}\nli:first-child{border-top:0}\n.meta{color:#5B6B75;font-size:14px}\n.m{font-variant-numeric:tabular-nums;font-weight:500}\n.pos{color:#2F6B4F}\n.empty{color:#5B6B75;margin:0}\nh3{font-size:16px;margin:24px 0 8px;font-weight:500}\n.grow{flex:1;min-width:0;overflow-wrap:anywhere}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n<h1>Even Keel</h1>\n<p class=\"sub\">Split trip costs so everyone ends up even.</p>\n\n<section aria-labelledby=\"hp\">\n<h2 id=\"hp\">People</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\"><div><label for=\"pn\">Name</label><input type=\"text\" id=\"pn\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button></div>\n<p class=\"err\" id=\"pe\" role=\"alert\"></p>\n</form>\n<ul id=\"pl\" style=\"margin-top:16px\"></ul>\n</section>\n\n<section aria-labelledby=\"he\">\n<h2 id=\"he\">Expenses</h2>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"ed\">Description</label><input type=\"text\" id=\"ed\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"row field\"><div><label for=\"ea\">Amount (CAD)</label><input type=\"text\" inputmode=\"decimal\" id=\"ea\" data-testid=\"expense-amount\" autocomplete=\"off\"></div>\n<div><label for=\"ep\">Paid by</label><select id=\"ep\" data-testid=\"expense-payer\"></select></div></div>\n<fieldset class=\"field\"><legend>Split between</legend><div class=\"checks\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"ee\" role=\"alert\"></p>\n</form>\n<ul id=\"el\" style=\"margin-top:16px\"></ul>\n</section>\n\n<section aria-labelledby=\"hb\">\n<h2 id=\"hb\">Balances</h2>\n<ul id=\"bl\"></ul>\n<h3>Settle up</h3>\n<ul id=\"tl\"></ul>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst $=id=>document.getElementById(id);\nlet S={people:[],expenses:[]};\ntry{const x=JSON.parse(localStorage.getItem('evenkeel'));if(x&&Array.isArray(x.people)&&Array.isArray(x.expenses))S=x}catch(e){}\nconst save=()=>localStorage.setItem('evenkeel',JSON.stringify(S));\nconst money=c=>(c<0?'−':'')+fmt.format(Math.abs(c)/100);\nfunction esc(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML}\nfunction setErr(id,m){const e=$(id);e.textContent=m;if(m)e.setAttribute('data-testid','form-error');else e.removeAttribute('data-testid')}\nfunction shares(ex){\n const order=S.people.filter(p=>ex.split.includes(p));\n const n=order.length,base=Math.floor(ex.cents/n),r=ex.cents-base*n,o={};\n order.forEach((p,i)=>o[p]=base+(i<r?1:0));return o}\nfunction balances(){\n const b={};S.people.forEach(p=>b[p]=0);\n S.expenses.forEach(ex=>{b[ex.payer]=(b[ex.payer]||0)+ex.cents;const s=shares(ex);for(const p in s)b[p]-=s[p]});\n return b}\nfunction transfers(b){\n const cr=[],de=[];\n S.people.forEach(p=>{if(b[p]>0)cr.push([p,b[p]]);else if(b[p]<0)de.push([p,-b[p]])});\n const t=[];cr.sort((a,b)=>b[1]-a[1]);de.sort((a,b)=>b[1]-a[1]);\n let i=0,j=0;\n while(i<cr.length&&j<de.length){const m=Math.min(cr[i][1],de[j][1]);\n  t.push({from:de[j][0],to:cr[i][0],c:m});cr[i][1]-=m;de[j][1]-=m;\n  if(!cr[i][1])i++;if(!de[j][1])j++}\n return t}\nfunction render(){\n const pl=$('pl');\n pl.innerHTML=S.people.length?S.people.map(p=>`<li data-testid=\"person\">${esc(p)}</li>`).join(''):'<li><p class=\"empty\">Add the first person on your trip.</p></li>';\n const keep=$('ep').value;\n $('ep').innerHTML=S.people.map(p=>`<option value=\"${esc(p)}\">${esc(p)}</option>`).join('');\n if(S.people.includes(keep))$('ep').value=keep;\n const chk=new Set([...document.querySelectorAll('#es input:checked')].map(i=>i.value));\n const had=new Set([...document.querySelectorAll('#es input')].map(i=>i.value));\n $('es').innerHTML=S.people.length?S.people.map(p=>`<label><input type=\"checkbox\" value=\"${esc(p)}\" ${(!had.has(p)||chk.has(p))?'checked':''}>${esc(p)}</label>`).join(''):'<span class=\"meta\">Add people to choose who shares the cost.</span>';\n const el=$('el');\n el.innerHTML=S.expenses.length?[...S.expenses].reverse().map(ex=>`<li data-testid=\"expense\"><div class=\"grow\"><div><strong style=\"font-weight:500\">${esc(ex.desc)}</strong> · <span class=\"m\">${money(ex.cents)}</span></div><div class=\"meta\">Paid by ${esc(ex.payer)}. Split between ${ex.split.map(esc).join(', ')}.</div></div><button type=\"button\" data-testid=\"delete-expense\" data-id=\"${ex.id}\" aria-label=\"Remove ${esc(ex.desc)}\">Remove</button></li>`).join(''):'<li><p class=\"empty\">'+(S.people.length?'Log the first expense when someone pays for something.':'Add people first, then log what you spend.')+'</p></li>';\n const b=balances();\n $('bl').innerHTML=S.people.length?S.people.map(p=>{const c=b[p];return `<li data-testid=\"balance\" data-person=\"${esc(p)}\" data-cents=\"${c}\"><span>${esc(p)}</span><span class=\"m ${c>0?'pos':''}\">${c>0?'is owed ':c<0?'owes ':'even '}${c?money(Math.abs(c)):''}${c<0?' ('+money(c)+')':''}</span></li>`}).join(''):'<li><p class=\"empty\">Balances appear once you add people.</p></li>';\n const t=transfers(b);\n $('tl').innerHTML=t.length?t.map(x=>`<li data-testid=\"transfer\" data-from=\"${esc(x.from)}\" data-to=\"${esc(x.to)}\" data-cents=\"${x.c}\"><span>${esc(x.from)} pays ${esc(x.to)}</span><span class=\"m\">${money(x.c)}</span></li>`).join(''):'<li><p class=\"empty\">'+(S.expenses.length?'Everyone is even.':'Nothing to settle yet.')+'</p></li>';\n}\n$('pf').addEventListener('submit',e=>{\n e.preventDefault();const n=$('pn').value.trim();\n if(!n)return setErr('pe','Enter a name.');\n if(S.people.some(p=>p.toLowerCase()===n.toLowerCase()))return setErr('pe',n+' is already on the trip. Use a different name.');\n S.people.push(n);save();setErr('pe','');$('pn').value='';render()});\n$('ef').addEventListener('submit',e=>{\n e.preventDefault();\n const desc=$('ed').value.trim(),a=$('ea').value.trim(),payer=$('ep').value;\n const split=[...document.querySelectorAll('#es input:checked')].map(i=>i.value);\n if(!desc)return setErr('ee','Enter a description.');\n if(!/^\\d*\\.?\\d+$|^\\d+\\.$/.test(a)||!(parseFloat(a)>0))return setErr('ee','Enter an amount greater than $0.');\n if(!/^\\d*(\\.\\d{0,2})?$/.test(a))return setErr('ee','Use at most 2 decimal places in the amount.');\n if(!payer)return setErr('ee','Add a person to choose who paid.');\n if(!split.length)return setErr('ee','Choose at least one person to split between.');\n const [w,f='']=a.split('.');const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n if(cents<1)return setErr('ee','Enter an amount greater than $0.');\n S.expenses.push({id:Date.now()+Math.random(),desc,cents,payer,split});\n save();setErr('ee','');$('ed').value='';$('ea').value='';render()});\n$('el').addEventListener('click',e=>{\n const b=e.target.closest('[data-id]');if(!b)return;\n S.expenses=S.expenses.filter(x=>String(x.id)!==b.dataset.id);save();render()});\nrender();\n</script>\n</body>\n</html>"
    }

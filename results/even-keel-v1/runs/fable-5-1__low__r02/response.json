    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --harbour:#1F3A4D; --fog:#5B6B75; --sailcloth:#F6F3EC; --paper:#FFFFFF;\n    --rope:#D9D2C3; --signal:#C2462B; --kelp:#2F6B4F;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0}\n  body{\n    background:var(--sailcloth); color:var(--harbour);\n    font-family:\"IBM Plex Sans\",system-ui,sans-serif; font-size:16px; line-height:1.5;\n  }\n  main{max-width:720px;margin:0 auto;padding:32px 16px 48px}\n  @media (min-width:600px){ main{padding:48px 24px 64px} }\n  header{margin-bottom:32px}\n  .wordmark{display:flex;align-items:center;gap:12px;margin:0;font-family:Fraunces,serif;font-weight:600;font-size:28px;line-height:1.2}\n  .wordmark::before{content:\"\";display:block;width:24px;height:3px;background:var(--signal);flex:none}\n  .tagline{margin:4px 0 0 36px;color:var(--fog);font-size:16px}\n  h2{font-family:Fraunces,serif;font-weight:600;font-size:20px;line-height:1.3;margin:0 0 16px}\n  section{background:var(--paper);border:1px solid var(--rope);border-radius:6px;padding:16px;margin-bottom:24px}\n  @media (min-width:600px){ section{padding:24px} }\n  label{display:block;font-weight:500;font-size:14px;margin-bottom:4px}\n  .hint{color:var(--fog);font-size:14px;margin:4px 0 0}\n  input[type=text],input[type=number],select{\n    width:100%;font:inherit;color:var(--harbour);background:var(--paper);\n    border:1px solid var(--rope);border-radius:6px;padding:8px 12px;min-height:44px;\n    transition:border-color 150ms;\n  }\n  input[type=text]:hover,select:hover{border-color:var(--harbour)}\n  :focus-visible{outline:2px solid var(--harbour);outline-offset:2px}\n  button{font:inherit;font-weight:500;font-size:16px;border-radius:6px;padding:8px 16px;min-height:44px;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms}\n  .primary{background:var(--signal);color:var(--paper);border:1px solid var(--signal)}\n  .primary:hover{background:var(--harbour);border-color:var(--harbour)}\n  .secondary{background:var(--paper);color:var(--harbour);border:1px solid var(--rope)}\n  .secondary:hover{border-color:var(--harbour)}\n  .row{display:flex;flex-direction:column;gap:8px}\n  @media (min-width:600px){\n    .row{flex-direction:row;align-items:flex-end}\n    .row .grow{flex:1}\n    .row button{flex:none}\n  }\n  .field{margin-bottom:16px}\n  .error{color:var(--harbour);font-size:14px;margin:8px 0 0;font-weight:500}\n  ul{list-style:none;margin:0;padding:0}\n  .list li{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:12px 0;border-top:1px solid var(--rope)}\n  .list li:first-child{border-top:0}\n  .people li{padding:8px 0}\n  .empty{color:var(--fog);margin:0}\n  .checks{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;border:1px solid var(--rope);border-radius:6px;padding:12px}\n  .checks label{display:flex;align-items:center;gap:8px;font-weight:400;font-size:16px;margin:0;min-height:24px;cursor:pointer}\n  .checks input{width:18px;height:18px;margin:0;accent-color:var(--harbour);flex:none}\n  .money{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:500}\n  .owed{color:var(--kelp)}\n  .meta{color:var(--fog);font-size:14px;margin:4px 0 0;word-break:break-word}\n  .desc{font-weight:500;word-break:break-word}\n  .exp-main{flex:1;min-width:0}\n  .exp-side{display:flex;flex-direction:column;align-items:flex-end;gap:8px}\n  .exp-side button{min-height:36px;padding:4px 12px;font-size:14px}\n  .transfer{flex-wrap:wrap}\n  fieldset{border:0;padding:0;margin:0 0 16px}\n  legend{font-weight:500;font-size:14px;margin-bottom:4px;padding:0}\n  .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header>\n    <h1 class=\"wordmark\">Even Keel</h1>\n    <p class=\"tagline\">Split trip costs so everyone ends up even.</p>\n  </header>\n\n  <section aria-labelledby=\"people-h\">\n    <h2 id=\"people-h\">People</h2>\n    <form id=\"person-form\" novalidate>\n      <div class=\"row\">\n        <div class=\"grow\">\n          <label for=\"person-name\">Name</label>\n          <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\">\n        </div>\n        <button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n      </div>\n      <div id=\"person-error\"></div>\n    </form>\n    <div id=\"people-list\" style=\"margin-top:16px\"></div>\n  </section>\n\n  <section aria-labelledby=\"expense-h\">\n    <h2 id=\"expense-h\">Expenses</h2>\n    <form id=\"expense-form\" novalidate>\n      <div class=\"field\">\n        <label for=\"expense-desc\">Description</label>\n        <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\">\n      </div>\n      <div class=\"field\">\n        <label for=\"expense-amount\">Amount (CAD)</label>\n        <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\">\n        <p class=\"hint\">Dollars and cents, for example 42.50.</p>\n      </div>\n      <div class=\"field\">\n        <label for=\"expense-payer\">Paid by</label>\n        <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n      </div>\n      <fieldset>\n        <legend>Split between</legend>\n        <div id=\"expense-split\" class=\"checks\" data-testid=\"expense-split\"></div>\n      </fieldset>\n      <button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n      <div id=\"expense-error\"></div>\n    </form>\n    <div id=\"expense-list\" style=\"margin-top:24px\"></div>\n  </section>\n\n  <section aria-labelledby=\"balance-h\">\n    <h2 id=\"balance-h\">Balances</h2>\n    <div id=\"balance-list\"></div>\n  </section>\n\n  <section aria-labelledby=\"settle-h\">\n    <h2 id=\"settle-h\">Settle up</h2>\n    <div id=\"settle-list\"></div>\n  </section>\n</main>\n\n<script>\n(function(){\n  const STORE_KEY='even-keel-v1';\n  const fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\n  const money=c=>fmt.format(c/100);\n\n  let state={people:[],expenses:[]};\n  try{\n    const raw=localStorage.getItem(STORE_KEY);\n    if(raw){const p=JSON.parse(raw); if(p&&Array.isArray(p.people)&&Array.isArray(p.expenses)) state=p;}\n  }catch(e){}\n  const save=()=>{try{localStorage.setItem(STORE_KEY,JSON.stringify(state))}catch(e){}};\n\n  const $=id=>document.getElementById(id);\n  const el=(tag,attrs,...kids)=>{\n    const n=document.createElement(tag);\n    for(const k in attrs||{}){ if(k==='text') n.textContent=attrs[k]; else n.setAttribute(k,attrs[k]); }\n    kids.forEach(k=>n.appendChild(typeof k==='string'?document.createTextNode(k):k));\n    return n;\n  };\n\n  function setError(container,msg){\n    container.textContent='';\n    if(msg){\n      container.appendChild(el('p',{class:'error','data-testid':'form-error',role:'alert',text:msg}));\n    }\n  }\n\n  function shares(exp){\n    const sel=state.people.filter(p=>exp.split.includes(p));\n    const k=sel.length, out={};\n    if(!k) return out;\n    const base=Math.floor(exp.cents/k), rem=exp.cents%k;\n    sel.forEach((p,i)=>{out[p]=base+(i<rem?1:0)});\n    return out;\n  }\n\n  function balances(){\n    const b={}; state.people.forEach(p=>b[p]=0);\n    state.expenses.forEach(e=>{\n      if(e.payer in b) b[e.payer]+=e.cents;\n      const s=shares(e); for(const p in s) b[p]-=s[p];\n    });\n    return b;\n  }\n\n  function settle(b){\n    const debt=[],cred=[];\n    state.people.forEach(p=>{ if(b[p]<0) debt.push({p,c:-b[p]}); else if(b[p]>0) cred.push({p,c:b[p]}); });\n    debt.sort((a,b)=>b.c-a.c); cred.sort((a,b)=>b.c-a.c);\n    const out=[]; let i=0,j=0;\n    while(i<debt.length&&j<cred.length){\n      const amt=Math.min(debt[i].c,cred[j].c);\n      if(amt>0) out.push({from:debt[i].p,to:cred[j].p,cents:amt});\n      debt[i].c-=amt; cred[j].c-=amt;\n      if(debt[i].c===0) i++; if(cred[j].c===0) j++;\n    }\n    return out;\n  }\n\n  function renderPeople(){\n    const c=$('people-list'); c.textContent='';\n    if(!state.people.length){ c.appendChild(el('p',{class:'empty',text:'Add the first person on your trip to get started.'})); return; }\n    const ul=el('ul',{class:'list people'});\n    state.people.forEach(p=>ul.appendChild(el('li',{'data-testid':'person',text:p})));\n    c.appendChild(ul);\n  }\n\n  function renderForm(resetSplit){\n    const sel=$('expense-payer'); const prev=sel.value; sel.textContent='';\n    if(!state.people.length){ sel.appendChild(el('option',{value:'',text:'Add a person first'})); sel.disabled=true; }\n    else{\n      sel.disabled=false;\n      state.people.forEach(p=>sel.appendChild(el('option',{value:p,text:p})));\n      if(state.people.includes(prev)) sel.value=prev;\n    }\n    const split=$('expense-split');\n    const prevChecked={};\n    if(!resetSplit) split.querySelectorAll('input').forEach(i=>prevChecked[i.value]=i.checked);\n    split.textContent='';\n    if(!state.people.length){ split.appendChild(el('p',{class:'empty',text:'Add a person before logging an expense.'})); return; }\n    state.people.forEach((p,i)=>{\n      const id='split-'+i;\n      const input=el('input',{type:'checkbox',id,value:p});\n      input.checked=(p in prevChecked)?prevChecked[p]:true;\n      split.appendChild(el('label',{for:id},input,el('span',{text:p})));\n    });\n  }\n\n  function renderExpenses(){\n    const c=$('expense-list'); c.textContent='';\n    if(!state.expenses.length){ c.appendChild(el('p',{class:'empty',text:'Log the first thing someone paid for and it will appear here.'})); return; }\n    const ul=el('ul',{class:'list'});\n    [...state.expenses].reverse().forEach(e=>{\n      const main=el('div',{class:'exp-main'},\n        el('div',{class:'desc',text:e.desc}),\n        el('p',{class:'meta',text:'Paid by '+e.payer}),\n        el('p',{class:'meta',text:'Split between '+state.people.filter(p=>e.split.includes(p)).join(', ')})\n      );\n      const btn=el('button',{type:'button',class:'secondary','data-testid':'delete-expense','aria-label':'Remove '+e.desc,text:'Remove'});\n      btn.addEventListener('click',()=>{ state.expenses=state.expenses.filter(x=>x.id!==e.id); save(); renderAll(); });\n      const side=el('div',{class:'exp-side'},el('span',{class:'money',text:money(e.cents)}),btn);\n      ul.appendChild(el('li',{'data-testid':'expense'},main,side));\n    });\n    c.appendChild(ul);\n  }\n\n  function renderBalances(){\n    const c=$('balance-list'); c.textContent='';\n    if(!state.people.length){ c.appendChild(el('p',{class:'empty',text:'Balances appear once you add people and expenses.'})); return; }\n    const b=balances(); const ul=el('ul',{class:'list'});\n    state.people.forEach(p=>{\n      const v=b[p];\n      const amt=el('span',{class:'money'+(v>0?' owed':''),text:v<0?'-'+money(-v):money(v)});\n      const label=v>0?'is owed':v<0?'owes':'is even';\n      ul.appendChild(el('li',{'data-testid':'balance','data-person':p,'data-cents':String(v)},\n        el('div',{},el('span',{class:'desc',text:p}),el('p',{class:'meta',text:label})),amt));\n    });\n    c.appendChild(ul);\n  }\n\n  function renderSettle(){\n    const c=$('settle-list'); c.textContent='';\n    if(!state.expenses.length){ c.appendChild(el('p',{class:'empty',text:'Add an expense to see who should pay whom.'})); return; }\n    const t=settle(balances());\n    if(!t.length){ c.appendChild(el('p',{class:'empty',text:'Everyone is even. Nothing to settle.'})); return; }\n    const ul=el('ul',{class:'list'});\n    t.forEach(x=>ul.appendChild(el('li',{class:'transfer','data-testid':'transfer','data-from':x.from,'data-to':x.to,'data-cents':String(x.cents)},\n      el('span',{},el('span',{class:'desc',text:x.from}),' pays ',el('span',{class:'desc',text:x.to})),\n      el('span',{class:'money',text:money(x.cents)}))));\n    c.appendChild(ul);\n  }\n\n  function renderAll(resetSplit){ renderPeople(); renderForm(resetSplit); renderExpenses(); renderBalances(); renderSettle(); }\n\n  $('person-form').addEventListener('submit',e=>{\n    e.preventDefault();\n    const input=$('person-name'); const name=input.value.trim(); const err=$('person-error');\n    if(!name){ setError(err,'Enter a name.'); input.focus(); return; }\n    if(state.people.some(p=>p.toLowerCase()===name.toLowerCase())){ setError(err,name+' is already on the trip. Use a different name.'); input.focus(); return; }\n    setError(err,''); state.people.push(name); save(); input.value=''; renderAll(false); input.focus();\n  });\n\n  function parseCents(str){\n    let s=str.trim().replace(/^\\$/,'').replace(/,/g,'');\n    if(!/^\\d+(\\.\\d{1,2})?$/.test(s)) return null;\n    const [d,c='']=s.split('.');\n    return parseInt(d,10)*100+parseInt((c+'00').slice(0,2),10);\n  }\n\n  $('expense-form').addEventListener('submit',e=>{\n    e.preventDefault();\n    const err=$('expense-error');\n    const desc=$('expense-desc').value.trim();\n    const amtStr=$('expense-amount').value;\n    const payer=$('expense-payer').value;\n    const split=[...$('expense-split').querySelectorAll('input:checked')].map(i=>i.value);\n    if(!state.people.length){ setError(err,'Add at least one person before adding an expense.'); return; }\n    if(!desc){ setError(err,'Enter a description.'); $('expense-desc').focus(); return; }\n    const t=amtStr.trim().replace(/^\\$/,'').replace(/,/g,'');\n    if(/^\\d+\\.\\d{3,}$/.test(t)){ setError(err,'Use at most 2 decimal places for the amount.'); $('expense-amount').focus(); return; }\n    const cents=parseCents(amtStr);\n    if(cents===null||cents<=0){ setError(err,'Enter an amount greater than $0.'); $('expense-amount').focus(); return; }\n    if(!state.people.includes(payer)){ setError(err,'Choose who paid.'); $('expense-payer').focus(); return; }\n    if(!split.length){ setError(err,'Select at least one person to split between.'); const f=$('expense-split').querySelector('input'); if(f) f.focus(); return; }\n    setError(err,'');\n    state.expenses.push({id:Date.now()+'-'+Math.random().toString(36).slice(2),desc,cents,payer,split});\n    save();\n    $('expense-desc').value=''; $('expense-amount').value='';\n    renderAll(true); $('expense-desc').focus();\n  });\n\n  renderAll(true);\n})();\n</script>\n</body>\n</html>"
    }

    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\">\n<style>\n*{box-sizing:border-box}\nhtml{font-size:16px}\nbody{margin:0;background:#F6F3EC;color:#1F3A4D;font-family:'IBM Plex Sans',sans-serif;font-size:16px;line-height:1.5}\nmain{max-width:720px;margin:0 auto;padding:32px 16px 48px}\n@media(min-width:600px){main{padding-left:24px;padding-right:24px}}\nheader{margin-bottom:32px}\n.brand{display:flex;align-items:center;gap:8px}\n.brand::before{content:\"\";width:24px;height:3px;background:#C2462B;flex:none}\nh1,h2{font-family:'Fraunces',serif;font-weight:600;margin:0;color:#1F3A4D}\nh1{font-size:28px;line-height:1.2}\nh2{font-size:20px;margin-bottom:16px}\n.tag{color:#5B6B75;margin:8px 0 0;font-size:16px}\nsection{background:#fff;border:1px solid #D9D2C3;border-radius:6px;padding:24px 16px;margin-bottom:24px}\n@media(min-width:600px){section{padding:24px}}\nlabel,legend{display:block;font-weight:500;font-size:14px;margin-bottom:4px;padding:0}\ninput[type=text],input[type=number],select{width:100%;font:inherit;font-size:16px;color:#1F3A4D;background:#fff;border:1px solid #5B6B75;border-radius:6px;padding:8px 12px;min-height:44px}\n:focus-visible{outline:2px solid #1F3A4D;outline-offset:2px}\nbutton{font:inherit;font-weight:500;border-radius:6px;min-height:44px;padding:8px 16px;cursor:pointer;transition:background-color .15s}\n.primary{background:#C2462B;color:#fff;border:1px solid #C2462B}\n.primary:hover{background:#A93A22;border-color:#A93A22}\n.ghost{background:#fff;color:#1F3A4D;border:1px solid #D9D2C3}\n.ghost:hover{background:#F6F3EC}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row .grow{flex:1 1 200px}\n.field{margin-bottom:16px}\n.grid{display:grid;grid-template-columns:1fr;gap:0 16px}\n@media(min-width:600px){.grid{grid-template-columns:1fr 1fr}}\nfieldset{border:0;margin:0 0 16px;padding:0;min-width:0}\n.checks{display:flex;flex-wrap:wrap;gap:8px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:400;font-size:16px;margin:0;border:1px solid #D9D2C3;border-radius:6px;padding:8px 12px;min-height:44px}\n.checks input{width:20px;height:20px;accent-color:#1F3A4D;margin:0}\n.err{color:#1F3A4D;font-weight:500;font-size:14px;margin:8px 0 0;padding:8px 12px;border:1px solid #1F3A4D;border-radius:6px;background:#fff}\n.err[hidden]{display:none}\nul{list-style:none;margin:0;padding:0}\nli{border-top:1px solid #D9D2C3;padding:12px 0;display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}\nli:first-child{border-top:0}\n.empty,.meta{color:#5B6B75;font-size:14px;margin:0}\n.empty{font-size:16px}\n.money{font-variant-numeric:tabular-nums;font-weight:500;white-space:nowrap}\n.pos{color:#2F6B4F}\n.info{min-width:0;flex:1 1 200px;overflow-wrap:anywhere}\n.title{font-weight:500}\n.sub{font-size:20px;margin:24px 0 8px;font-family:'Fraunces',serif;font-weight:600}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n<header>\n<div class=\"brand\"><h1>Even Keel</h1></div>\n<p class=\"tag\">Split trip costs and end up even.</p>\n</header>\n\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\">\n<div class=\"grow\"><label for=\"pn\">Name</label><input type=\"text\" id=\"pn\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n</div>\n<p class=\"err\" id=\"pe\" data-testid=\"form-error\" role=\"alert\" hidden></p>\n</form>\n<div id=\"plist\" style=\"margin-top:16px\"></div>\n</section>\n\n<section aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Expenses</h2>\n<form id=\"ef\" novalidate>\n<div class=\"grid\">\n<div class=\"field\"><label for=\"ed\">Description</label><input type=\"text\" id=\"ed\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"ea\">Amount (CAD)</label><input type=\"text\" inputmode=\"decimal\" id=\"ea\" data-testid=\"expense-amount\" autocomplete=\"off\"></div>\n</div>\n<div class=\"field\"><label for=\"ep\">Paid by</label><select id=\"ep\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend>Split between</legend><div class=\"checks\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"ee\" data-testid=\"form-error\" role=\"alert\" hidden></p>\n</form>\n<div id=\"elist\" style=\"margin-top:16px\"></div>\n</section>\n\n<section aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<div id=\"blist\"></div>\n<div class=\"sub\" role=\"heading\" aria-level=\"3\">Settle up</div>\n<div id=\"tlist\"></div>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>(c<0?'−':'')+fmt.format(Math.abs(c)/100);\nlet S={people:[],expenses:[]};\ntry{const d=JSON.parse(localStorage.getItem('evenkeel'));if(d&&Array.isArray(d.people)&&Array.isArray(d.expenses))S=d}catch(e){}\nconst save=()=>{try{localStorage.setItem('evenkeel',JSON.stringify(S))}catch(e){}};\nconst $=id=>document.getElementById(id);\nconst esc=s=>s.replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction show(el,msg){if(msg){el.textContent=msg;el.hidden=false}else{el.hidden=true;el.textContent=''}}\n\nfunction shares(e){\n  const order=S.people.filter(p=>e.split.includes(p)); const n=order.length;\n  const out={}; if(!n)return out;\n  const base=Math.floor(e.cents/n); let rem=e.cents-base*n;\n  order.forEach(p=>{out[p]=base+(rem>0?1:0); if(rem>0)rem--});\n  return out;\n}\nfunction balances(){\n  const b={}; S.people.forEach(p=>b[p]=0);\n  S.expenses.forEach(e=>{\n    if(e.payer in b)b[e.payer]+=e.cents;\n    const sh=shares(e); for(const p in sh)b[p]-=sh[p];\n  });\n  return b;\n}\nfunction settle(b){\n  const cr=[],db=[];\n  S.people.forEach(p=>{if(b[p]>0)cr.push({p,c:b[p]});else if(b[p]<0)db.push({p,c:-b[p]})});\n  const t=[];\n  cr.sort((a,b)=>b.c-a.c);db.sort((a,b)=>b.c-a.c);\n  let i=0,j=0;\n  while(i<cr.length&&j<db.length){\n    const m=Math.min(cr[i].c,db[j].c);\n    t.push({from:db[j].p,to:cr[i].p,c:m});\n    cr[i].c-=m;db[j].c-=m;\n    if(!cr[i].c)i++; if(!db[j].c)j++;\n  }\n  return t;\n}\nfunction render(){\n  $('plist').innerHTML=S.people.length?'<ul>'+S.people.map(p=>`<li data-testid=\"person\"><span class=\"title\">${esc(p)}</span></li>`).join('')+'</ul>':'<p class=\"empty\">Add the first person on your trip.</p>';\n  const sel=$('ep').value;\n  $('ep').innerHTML=S.people.map(p=>`<option value=\"${esc(p)}\">${esc(p)}</option>`).join('');\n  if(S.people.includes(sel))$('ep').value=sel;\n  const checked=new Set([...document.querySelectorAll('#es input:checked')].map(i=>i.value));\n  const had=new Set([...document.querySelectorAll('#es input')].map(i=>i.value));\n  $('es').innerHTML=S.people.length?S.people.map((p,i)=>`<label for=\"sp${i}\"><input type=\"checkbox\" id=\"sp${i}\" value=\"${esc(p)}\"${(!had.has(p)||checked.has(p))?' checked':''}>${esc(p)}</label>`).join(''):'<p class=\"empty\">Add people to choose who shares the cost.</p>';\n  $('elist').innerHTML=S.expenses.length?'<ul>'+[...S.expenses].reverse().map(e=>`<li data-testid=\"expense\"><div class=\"info\"><div class=\"title\">${esc(e.desc)}</div><p class=\"meta\">Paid by ${esc(e.payer)}. Split between ${e.split.map(esc).join(', ')}.</p></div><span class=\"money\">${money(e.cents)}</span><button type=\"button\" class=\"ghost\" data-testid=\"delete-expense\" data-id=\"${e.id}\" aria-label=\"Remove ${esc(e.desc)}\">Remove</button></li>`).join('')+'</ul>':'<p class=\"empty\">'+(S.people.length?'Add the first expense to start tracking who owes whom.':'Add people first, then log what you spend.')+'</p>';\n  const b=balances();\n  $('blist').innerHTML=S.people.length?'<ul>'+S.people.map(p=>{const c=b[p];\n    const txt=c>0?`is owed ${money(c)}`:c<0?`owes ${money(-c)}`:'is settled';\n    return `<li data-testid=\"balance\" data-person=\"${esc(p)}\" data-cents=\"${c}\"><span class=\"title\">${esc(p)}</span><span class=\"money ${c>0?'pos':''}\">${c>0?'+':''}${money(c)} <span class=\"meta\">${txt}</span></span></li>`}).join('')+'</ul>':'<p class=\"empty\">Balances appear once you add people.</p>';\n  const t=settle(b);\n  $('tlist').innerHTML=t.length?'<ul>'+t.map(x=>`<li data-testid=\"transfer\" data-from=\"${esc(x.from)}\" data-to=\"${esc(x.to)}\" data-cents=\"${x.c}\"><span><span class=\"title\">${esc(x.from)}</span> pays <span class=\"title\">${esc(x.to)}</span></span><span class=\"money\">${money(x.c)}</span></li>`).join('')+'</ul>':'<p class=\"empty\">'+(S.expenses.length?'Everyone is even. Nobody needs to pay anyone.':'Add an expense and the transfers to even up will show here.')+'</p>';\n}\n$('pf').addEventListener('submit',e=>{\n  e.preventDefault();\n  const v=$('pn').value.trim();\n  if(!v)return show($('pe'),'Enter a name.');\n  if(S.people.some(p=>p.toLowerCase()===v.toLowerCase()))return show($('pe'),`${v} is already on the trip. Use a different name.`);\n  S.people.push(v);save();show($('pe'));$('pn').value='';render();$('pn').focus();\n});\n$('ef').addEventListener('submit',e=>{\n  e.preventDefault();\n  const desc=$('ed').value.trim(),amt=$('ea').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  const er=$('ee');\n  if(!desc)return show(er,'Enter a description.');\n  if(!/^\\d*\\.?\\d*$/.test(amt)||amt===''||amt==='.'||!(parseFloat(amt)>0))return show(er,'Enter an amount greater than $0.');\n  if(/\\.\\d{3,}/.test(amt))return show(er,'Use at most 2 decimal places in the amount.');\n  const [w,f='']=amt.split('.');\n  const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(cents<=0)return show(er,'Enter an amount greater than $0.');\n  if(!S.people.length)return show(er,'Add at least one person first.');\n  const payer=$('ep').value;\n  if(!payer)return show(er,'Choose who paid.');\n  const split=[...document.querySelectorAll('#es input:checked')].map(i=>i.value);\n  if(!split.length)return show(er,'Choose at least one person to split with.');\n  S.expenses.push({id:Date.now()+Math.random(),desc,cents,payer,split});\n  save();show(er);$('ed').value='';$('ea').value='';render();$('ed').focus();\n});\n$('elist').addEventListener('click',e=>{\n  const b=e.target.closest('[data-id]');if(!b)return;\n  S.expenses=S.expenses.filter(x=>String(x.id)!==b.dataset.id);save();render();\n});\nrender();\n</script>\n</body>\n</html>"
    }

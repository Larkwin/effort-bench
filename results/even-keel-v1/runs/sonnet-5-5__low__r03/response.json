    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0;background:#F6F3EC;color:#1F3A4D;font:400 16px/1.5 'IBM Plex Sans',sans-serif}\nmain{max-width:720px;margin:0 auto;padding:32px 16px 48px}\n@media(min-width:600px){main{padding-left:24px;padding-right:24px}}\nh1,h2{font-family:'Fraunces',serif;font-weight:600;margin:0}\nh1{font-size:28px;display:flex;align-items:center;gap:12px}\nh1:before{content:\"\";width:24px;height:3px;background:#C2462B;flex:none}\nh2{font-size:20px;margin-bottom:16px}\n.sub{color:#5B6B75;margin:4px 0 24px;font-size:16px}\nsection{background:#fff;border:1px solid #D9D2C3;border-radius:6px;padding:24px 16px;margin-bottom:24px}\n@media(min-width:600px){section{padding:24px}}\nlabel,legend{display:block;font-weight:500;margin-bottom:4px;font-size:14px;padding:0}\ninput[type=text],input[type=number],select{width:100%;font:inherit;color:#1F3A4D;background:#fff;border:1px solid #D9D2C3;border-radius:6px;padding:8px 12px;min-height:40px}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row>div{flex:1;min-width:160px}\n.field{margin-bottom:16px}\nbutton{font:500 16px 'IBM Plex Sans',sans-serif;border-radius:6px;min-height:40px;padding:8px 16px;cursor:pointer;transition:background-color 150ms}\n.primary{background:#C2462B;color:#fff;border:1px solid #C2462B}\n.primary:hover{background:#A93A22}\n.ghost{background:#fff;color:#1F3A4D;border:1px solid #D9D2C3;font-size:14px}\n.ghost:hover{background:#F6F3EC}\n:focus-visible{outline:2px solid #1F3A4D;outline-offset:2px}\n.err{color:#1F3A4D;border:1px solid #1F3A4D;border-radius:6px;padding:8px 12px;margin:8px 0;font-weight:500;font-size:14px}\n.err[hidden]{display:none}\nul{list-style:none;margin:0;padding:0}\nli{border-top:1px solid #D9D2C3;padding:12px 0;display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}\nli:first-child{border-top:0}\n.meta,.empty{color:#5B6B75;font-size:14px}\n.empty{margin:0;font-size:16px}\n.money{font-variant-numeric:tabular-nums;font-weight:500}\n.pos{color:#2F6B4F}\n.checks{display:flex;flex-wrap:wrap;gap:8px 16px}\n.checks label{font-weight:400;font-size:16px;display:flex;gap:8px;align-items:center;margin:0;min-height:32px}\n.checks input{width:18px;height:18px;accent-color:#1F3A4D}\nfieldset{border:0;padding:0;margin:0 0 16px;min-width:0}\n.grow{flex:1;min-width:0;overflow-wrap:anywhere}\nh3{font:500 16px 'IBM Plex Sans';margin:24px 0 8px}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n<header><h1>Even Keel</h1><p class=\"sub\">Split trip costs so everyone ends up even.</p></header>\n\n<section aria-labelledby=\"hp\">\n<h2 id=\"hp\">People</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\"><div><label for=\"pn\">Name</label><input type=\"text\" id=\"pn\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button class=\"primary\" type=\"submit\" data-testid=\"add-person\">Add person</button></div>\n<div class=\"err\" id=\"pe\" data-testid=\"form-error\" role=\"alert\" hidden></div>\n</form>\n<div id=\"pl\" style=\"margin-top:16px\"></div>\n</section>\n\n<section aria-labelledby=\"he\">\n<h2 id=\"he\">Expenses</h2>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"ed\">Description</label><input type=\"text\" id=\"ed\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"row field\"><div><label for=\"ea\">Amount (CAD)</label><input type=\"text\" inputmode=\"decimal\" id=\"ea\" data-testid=\"expense-amount\" autocomplete=\"off\"></div>\n<div><label for=\"ep\">Paid by</label><select id=\"ep\" data-testid=\"expense-payer\"></select></div></div>\n<fieldset><legend>Split between</legend><div class=\"checks\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n<button class=\"primary\" type=\"submit\" data-testid=\"add-expense\">Add expense</button>\n<div class=\"err\" id=\"ee\" data-testid=\"form-error\" role=\"alert\" hidden></div>\n</form>\n<div id=\"xl\" style=\"margin-top:16px\"></div>\n</section>\n\n<section aria-labelledby=\"hb\">\n<h2 id=\"hb\">Balances</h2>\n<div id=\"bl\"></div>\n<h3>Settle up</h3>\n<div id=\"tl\"></div>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst $=id=>document.getElementById(id);\nconst K='evenkeel';\nlet S={people:[],expenses:[]};\ntry{const d=JSON.parse(localStorage.getItem(K));if(d&&Array.isArray(d.people)&&Array.isArray(d.expenses))S=d}catch(e){}\nconst save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};\nconst esc=s=>s.replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst money=c=>(c<0?'−':'')+fmt.format(Math.abs(c)/100);\nfunction showErr(el,m){el.textContent=m;el.hidden=false}\nfunction shares(e){\n const order=S.people.filter(p=>e.split.includes(p));\n const n=order.length,base=Math.floor(e.cents/n),r=e.cents-base*n,o={};\n order.forEach((p,i)=>o[p]=base+(i<r?1:0));return o}\nfunction balances(){\n const b={};S.people.forEach(p=>b[p]=0);\n S.expenses.forEach(e=>{if(b[e.payer]!==undefined)b[e.payer]+=e.cents;\n  const s=shares(e);for(const p in s)b[p]-=s[p]});\n return b}\nfunction transfers(b){\n const d=[],c=[];\n S.people.forEach(p=>{if(b[p]<0)d.push([p,-b[p]]);else if(b[p]>0)c.push([p,b[p]])});\n d.sort((a,b)=>b[1]-a[1]);c.sort((a,b)=>b[1]-a[1]);\n const t=[];let i=0,j=0;\n while(i<d.length&&j<c.length){\n  const m=Math.min(d[i][1],c[j][1]);\n  t.push({from:d[i][0],to:c[j][0],cents:m});\n  d[i][1]-=m;c[j][1]-=m;\n  if(!d[i][1])i++;if(!c[j][1])j++}\n return t}\nfunction render(){\n const P=S.people;\n $('pl').innerHTML=P.length?'<ul>'+P.map(p=>`<li data-testid=\"person\">${esc(p)}</li>`).join('')+'</ul>':'<p class=\"empty\">Add the first person on your trip.</p>';\n const sel=$('ep').value;\n $('ep').innerHTML=P.map(p=>`<option value=\"${esc(p)}\">${esc(p)}</option>`).join('');\n if(P.includes(sel))$('ep').value=sel;\n const ck=new Set([...$('es').querySelectorAll('input:not(:checked)')].map(i=>i.value));\n $('es').innerHTML=P.length?P.map((p,i)=>`<label><input type=\"checkbox\" value=\"${esc(p)}\" ${ck.has(p)?'':'checked'}>${esc(p)}</label>`).join(''):'<span class=\"empty\">Add people to choose who shares the cost.</span>';\n $('xl').innerHTML=S.expenses.length?'<ul>'+[...S.expenses].reverse().map(e=>`<li data-testid=\"expense\"><div class=\"grow\"><div><strong style=\"font-weight:500\">${esc(e.desc)}</strong> · <span class=\"money\">${money(e.cents)}</span></div><div class=\"meta\">Paid by ${esc(e.payer)}. Split between ${esc(e.split.join(', '))}.</div></div><button type=\"button\" class=\"ghost\" data-testid=\"delete-expense\" data-id=\"${e.id}\">Remove</button></li>`).join('')+'</ul>':'<p class=\"empty\">Log the first expense once you have added people.</p>';\n const b=balances();\n $('bl').innerHTML=P.length?'<ul>'+P.map(p=>`<li data-testid=\"balance\" data-person=\"${esc(p)}\" data-cents=\"${b[p]}\"><span>${esc(p)}</span><span class=\"money ${b[p]>0?'pos':''}\">${b[p]>0?'is owed ':b[p]<0?'owes ':''}${money(b[p]>0?b[p]:b[p]).replace(/^−/,'−')}</span></li>`).join('')+'</ul>':'<p class=\"empty\">Balances appear here once you add people.</p>';\n const t=transfers(b);\n $('tl').innerHTML=t.length?'<ul>'+t.map(x=>`<li data-testid=\"transfer\" data-from=\"${esc(x.from)}\" data-to=\"${esc(x.to)}\" data-cents=\"${x.cents}\"><span>${esc(x.from)} pays ${esc(x.to)}</span><span class=\"money\">${money(x.cents)}</span></li>`).join('')+'</ul>':`<p class=\"empty\">${S.expenses.length?'Everyone is even.':'Add an expense to see who owes whom.'}</p>`}\n$('pf').addEventListener('submit',ev=>{\n ev.preventDefault();\n const n=$('pn').value.trim(),er=$('pe');\n if(!n)return showErr(er,'Enter a name.');\n if(S.people.some(p=>p.toLowerCase()===n.toLowerCase()))return showErr(er,`${n} is already on the trip. Use a different name.`);\n er.hidden=true;S.people.push(n);save();$('pn').value='';render();$('pn').focus()});\n$('ef').addEventListener('submit',ev=>{\n ev.preventDefault();\n const d=$('ed').value.trim(),a=$('ea').value.trim().replace(/^\\$/,'').replace(/,/g,''),er=$('ee');\n const split=[...$('es').querySelectorAll('input:checked')].map(i=>i.value);\n if(!d)return showErr(er,'Enter a description.');\n if(!/^\\d*\\.?\\d*$/.test(a)||a===''||a==='.')return showErr(er,'Enter an amount greater than $0.');\n if(a.includes('.')&&a.split('.')[1].length>2)return showErr(er,'Use at most 2 decimal places in the amount.');\n const cents=Math.round(parseFloat(a)*100);\n if(!(cents>0))return showErr(er,'Enter an amount greater than $0.');\n if(!S.people.length)return showErr(er,'Add a person before logging an expense.');\n if(!$('ep').value)return showErr(er,'Choose who paid.');\n if(!split.length)return showErr(er,'Choose at least one person to split between.');\n er.hidden=true;\n S.expenses.push({id:Date.now()+Math.random(),desc:d,cents,payer:$('ep').value,split:S.people.filter(p=>split.includes(p))});\n save();$('ed').value='';$('ea').value='';\n $('es').querySelectorAll('input').forEach(i=>i.checked=true);\n render();$('ed').focus()});\n$('xl').addEventListener('click',ev=>{\n const b=ev.target.closest('[data-id]');if(!b)return;\n S.expenses=S.expenses.filter(e=>String(e.id)!==b.dataset.id);save();render()});\nrender();\n</script>\n</body>\n</html>"
    }

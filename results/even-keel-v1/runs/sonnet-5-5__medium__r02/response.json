    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0;background:#F6F3EC;color:#1F3A4D;font:400 16px/1.5 'IBM Plex Sans',sans-serif}\nmain{max-width:720px;margin:0 auto;padding:32px 16px 64px}\n@media(min-width:600px){main{padding-left:24px;padding-right:24px}}\nh1,h2{font-family:'Fraunces',serif;font-weight:600;margin:0}\nh1{font-size:28px;display:flex;align-items:center;gap:8px}\nh1:before{content:\"\";width:24px;height:3px;background:#C2462B;flex:none}\nh2{font-size:20px;margin-bottom:8px}\n.sub{color:#5B6B75;margin:4px 0 24px;font-size:16px}\nsection{background:#fff;border:1px solid #D9D2C3;border-radius:6px;padding:16px;margin-bottom:24px}\nlabel,legend{display:block;font-weight:500;font-size:14px;margin-bottom:4px;padding:0}\ninput[type=text],input[type=number],select{width:100%;height:40px;padding:0 8px;border:1px solid #D9D2C3;border-radius:6px;background:#fff;color:#1F3A4D;font:inherit}\ninput[type=text],input[type=number]{font-variant-numeric:tabular-nums}\nbutton{font:500 16px 'IBM Plex Sans',sans-serif;height:40px;padding:0 16px;border-radius:6px;cursor:pointer;border:1px solid #D9D2C3;background:#fff;color:#1F3A4D;transition:background-color .15s}\nbutton.primary{background:#C2462B;border-color:#C2462B;color:#fff}\nbutton.primary:hover{background:#A93A22}\nbutton:not(.primary):hover{background:#F6F3EC}\n:focus-visible{outline:2px solid #1F3A4D;outline-offset:2px}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row>div{flex:1;min-width:160px}\n.field{margin-bottom:16px}\n.err{color:#1F3A4D;border:1px solid #1F3A4D;border-radius:6px;padding:8px;margin:8px 0;font-size:14px;font-weight:500}\n.err[hidden]{display:none}\nul{list-style:none;margin:0;padding:0}\nli{border-top:1px solid #D9D2C3;padding:8px 0;display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap}\nli:first-child{border-top:0}\n.empty,.meta{color:#5B6B75;font-size:14px;margin:0}\n.money{font-variant-numeric:tabular-nums;font-weight:500}\n.pos{color:#2F6B4F}\n.split{display:flex;flex-wrap:wrap;gap:8px 16px;border:0;padding:0;margin:0}\n.split label{font-weight:400;font-size:16px;display:flex;gap:8px;align-items:center;margin:0}\n.split input{width:18px;height:18px;accent-color:#1F3A4D}\nfieldset{border:0;padding:0;margin:0}\n.grow{flex:1;min-width:0;overflow-wrap:anywhere}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n<header>\n<h1>Even Keel</h1>\n<p class=\"sub\">Split trip costs so everyone ends up even.</p>\n</header>\n\n<section aria-labelledby=\"hp\">\n<h2 id=\"hp\">People</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\">\n<div><label for=\"pn\">Name</label><input type=\"text\" id=\"pn\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n</div>\n<div class=\"err\" id=\"pe\" data-testid=\"form-error\" role=\"alert\" hidden></div>\n</form>\n<ul id=\"pl\"></ul>\n<p class=\"empty\" id=\"pempty\">Add the first person on your trip.</p>\n</section>\n\n<section aria-labelledby=\"he\">\n<h2 id=\"he\">Add expense</h2>\n<p class=\"empty\" id=\"eform-empty\">Add at least one person before logging an expense.</p>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"ed\">Description</label><input type=\"text\" id=\"ed\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"row field\">\n<div><label for=\"ea\">Amount (CAD)</label><input type=\"text\" inputmode=\"decimal\" id=\"ea\" data-testid=\"expense-amount\" autocomplete=\"off\"></div>\n<div><label for=\"ep\">Paid by</label><select id=\"ep\" data-testid=\"expense-payer\"></select></div>\n</div>\n<fieldset class=\"field\"><legend>Split between</legend><div class=\"split\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n<div class=\"err\" id=\"ee\" data-testid=\"form-error\" role=\"alert\" hidden></div>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n</form>\n</section>\n\n<section aria-labelledby=\"hx\">\n<h2 id=\"hx\">Expenses</h2>\n<ul id=\"xl\"></ul>\n<p class=\"empty\" id=\"xempty\">Expenses you add will appear here.</p>\n</section>\n\n<section aria-labelledby=\"hb\">\n<h2 id=\"hb\">Balances</h2>\n<ul id=\"bl\"></ul>\n<p class=\"empty\" id=\"bempty\">Balances appear once you add people.</p>\n</section>\n\n<section aria-labelledby=\"hs\">\n<h2 id=\"hs\">Settle up</h2>\n<ul id=\"tl\"></ul>\n<p class=\"empty\" id=\"tempty\"></p>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst $=id=>document.getElementById(id);\nconst money=c=>fmt.format(c/100);\nlet st={people:[],expenses:[]};\ntry{const s=JSON.parse(localStorage.getItem('evenkeel'));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))st=s}catch(e){}\nlet nid=st.expenses.reduce((m,x)=>Math.max(m,x.id||0),0)+1;\nconst save=()=>{try{localStorage.setItem('evenkeel',JSON.stringify(st))}catch(e){}};\nconst el=(t,p={},txt)=>{const e=document.createElement(t);Object.assign(e,p);if(txt!=null)e.textContent=txt;return e};\nfunction showErr(id,m){const e=$(id);e.textContent=m;e.hidden=false}\nfunction hideErr(id){$(id).hidden=true}\n\nfunction shares(x){\n  const order=st.people.filter(p=>x.split.includes(p));\n  const n=order.length,base=Math.floor(x.cents/n),rem=x.cents-base*n;\n  const r={};order.forEach((p,i)=>r[p]=base+(i<rem?1:0));return r;\n}\nfunction balances(){\n  const b={};st.people.forEach(p=>b[p]=0);\n  st.expenses.forEach(x=>{\n    if(!(x.payer in b))return;\n    b[x.payer]+=x.cents;\n    const s=shares(x);for(const p in s)b[p]-=s[p];\n  });\n  return b;\n}\nfunction transfers(b){\n  const cr=[],db=[];\n  st.people.forEach(p=>{if(b[p]>0)cr.push({p,c:b[p]});else if(b[p]<0)db.push({p,c:-b[p]})});\n  cr.sort((a,b)=>b.c-a.c);db.sort((a,b)=>b.c-a.c);\n  const out=[];let i=0,j=0;\n  while(i<cr.length&&j<db.length){\n    const m=Math.min(cr[i].c,db[j].c);\n    out.push({from:db[j].p,to:cr[i].p,c:m});\n    cr[i].c-=m;db[j].c-=m;\n    if(!cr[i].c)i++;if(!db[j].c)j++;\n  }\n  return out;\n}\n\nfunction render(){\n  const P=st.people;\n  const pl=$('pl');pl.textContent='';\n  P.forEach(p=>{const li=el('li',{});li.dataset.testid='person';li.setAttribute('data-testid','person');li.appendChild(el('span',{},p));pl.appendChild(li)});\n  $('pempty').hidden=P.length>0;\n\n  // form\n  const has=P.length>0;\n  $('ef').hidden=!has;$('eform-empty').hidden=has;\n  const sel=$('ep'),prev=sel.value;sel.textContent='';\n  P.forEach(p=>sel.appendChild(el('option',{value:p},p)));\n  if(P.includes(prev))sel.value=prev;\n  const sp=$('es');\n  const checked=new Set([...sp.querySelectorAll('input:checked')].map(i=>i.value));\n  const known=new Set([...sp.querySelectorAll('input')].map(i=>i.value));\n  sp.textContent='';\n  P.forEach((p,i)=>{\n    const l=el('label');const c=el('input',{type:'checkbox',value:p});\n    c.checked=known.has(p)?checked.has(p):true;\n    l.appendChild(c);l.appendChild(el('span',{},p));sp.appendChild(l);\n  });\n\n  // expenses\n  const xl=$('xl');xl.textContent='';\n  [...st.expenses].reverse().forEach(x=>{\n    const li=el('li');li.setAttribute('data-testid','expense');\n    const d=el('div',{className:'grow'});\n    d.appendChild(el('div',{},x.desc));\n    d.appendChild(el('p',{className:'meta'},'Paid by '+x.payer+' · Split between '+x.split.join(', ')));\n    li.appendChild(d);\n    li.appendChild(el('span',{className:'money'},money(x.cents)));\n    const b=el('button',{type:'button'},'Remove');b.setAttribute('data-testid','delete-expense');\n    b.setAttribute('aria-label','Remove '+x.desc);\n    b.onclick=()=>{st.expenses=st.expenses.filter(e=>e.id!==x.id);save();render()};\n    li.appendChild(b);xl.appendChild(li);\n  });\n  $('xempty').hidden=st.expenses.length>0;\n\n  // balances\n  const b=balances(),bl=$('bl');bl.textContent='';\n  P.forEach(p=>{\n    const li=el('li');li.setAttribute('data-testid','balance');li.dataset.person=p;li.dataset.cents=b[p];\n    li.appendChild(el('span',{},p));\n    const v=b[p];\n    const s=el('span',{className:'money'+(v>0?' pos':'')},\n      v>0?money(v)+' is owed':v<0?'\\u2212'+money(-v)+' owes':money(0)+' even');\n    li.appendChild(s);bl.appendChild(li);\n  });\n  $('bempty').hidden=P.length>0;\n\n  // transfers\n  const t=transfers(b),tl=$('tl');tl.textContent='';\n  t.forEach(x=>{\n    const li=el('li');li.setAttribute('data-testid','transfer');\n    li.dataset.from=x.from;li.dataset.to=x.to;li.dataset.cents=x.c;\n    li.appendChild(el('span',{className:'grow'},x.from+' pays '+x.to));\n    li.appendChild(el('span',{className:'money'},money(x.c)));\n    tl.appendChild(li);\n  });\n  const te=$('tempty');\n  te.hidden=t.length>0;\n  te.textContent=st.expenses.length?'Everyone is even. Nobody needs to pay anyone.':'Add an expense to see who pays whom.';\n}\n\n$('pf').addEventListener('submit',e=>{\n  e.preventDefault();\n  const n=$('pn').value.trim();\n  if(!n)return showErr('pe','Enter a name.');\n  if(st.people.some(p=>p.toLowerCase()===n.toLowerCase()))return showErr('pe',n+' is already on the trip. Use a different name.');\n  st.people.push(n);save();$('pn').value='';hideErr('pe');render();$('pn').focus();\n});\n$('pn').addEventListener('input',()=>hideErr('pe'));\n\n$('ef').addEventListener('submit',e=>{\n  e.preventDefault();\n  const desc=$('ed').value.trim(),raw=$('ea').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  const payer=$('ep').value;\n  const split=[...$('es').querySelectorAll('input:checked')].map(i=>i.value);\n  if(!desc)return showErr('ee','Enter a description.');\n  if(!/^\\d*\\.?\\d+$|^\\d+\\.$/.test(raw)||!(parseFloat(raw)>0)){\n    if(/^\\d*\\.\\d{3,}$/.test(raw))return showErr('ee','Use at most 2 decimal places.');\n    return showErr('ee','Enter an amount greater than $0.');\n  }\n  if(/\\.\\d{3,}$/.test(raw))return showErr('ee','Use at most 2 decimal places.');\n  const [w,f='']=raw.split('.');\n  const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n  if(cents<=0)return showErr('ee','Enter an amount greater than $0.');\n  if(!payer)return showErr('ee','Choose who paid.');\n  if(!split.length)return showErr('ee','Select at least one person to split between.');\n  st.expenses.push({id:nid++,desc,cents,payer,split:st.people.filter(p=>split.includes(p))});\n  save();hideErr('ee');$('ed').value='';$('ea').value='';render();$('ed').focus();\n});\n['ed','ea','ep','es'].forEach(i=>{$(i).addEventListener('input',()=>hideErr('ee'));$(i).addEventListener('change',()=>hideErr('ee'))});\nrender();\n</script>\n</body>\n</html>"
    }

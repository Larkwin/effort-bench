      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--harbour:#1F3A4D;--fog:#5B6B75;--sail:#F6F3EC;--paper:#FFFFFF;--rope:#D9D2C3;--signal:#C2462B;--kelp:#2F6B4F}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--sail);color:var(--harbour);font-family:\"IBM Plex Sans\",system-ui,sans-serif;font-size:16px;line-height:1.5;font-weight:400}\nmain{max-width:720px;margin:0 auto;padding:24px 16px 48px;overflow-wrap:anywhere}\n@media (min-width:600px){main{padding:32px 24px 64px}}\n.wordmark{display:flex;align-items:center;gap:8px}\n.rule{display:inline-block;width:24px;height:3px;background:var(--signal);flex:none}\nh1{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:28px;line-height:1.2;margin:0;color:var(--harbour)}\n.tagline{color:var(--fog);font-size:14px;margin:8px 0 0}\nsection{background:var(--paper);border:1px solid var(--rope);border-radius:6px;padding:16px;margin-top:24px}\nh2{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:20px;line-height:1.3;margin:0 0 16px;color:var(--harbour)}\nlabel,.lbl{display:block;font-weight:500;font-size:14px;margin-bottom:4px}\n.hint{color:var(--fog);font-size:14px;margin:0}\n.empty{color:var(--fog);margin:0}\ninput[type=text],input[type=number],select{width:100%;font:inherit;font-size:16px;color:var(--harbour);background:var(--paper);border:1px solid var(--rope);border-radius:6px;padding:8px 12px;min-height:40px}\nbutton{font:inherit;font-size:16px;font-weight:500;min-height:40px;padding:8px 16px;border-radius:6px;cursor:pointer;border:1px solid var(--rope);background:var(--paper);color:var(--harbour);transition:background-color 150ms,border-color 150ms}\nbutton:hover{border-color:var(--harbour)}\nbutton.primary{background:var(--signal);border-color:var(--signal);color:var(--paper)}\nbutton.primary:hover{border-color:var(--harbour);background:var(--harbour)}\n:focus-visible{outline:2px solid var(--harbour);outline-offset:2px}\n.row{display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end}\n.row>.grow{flex:1 1 200px;min-width:0}\n.stack>*+*{margin-top:16px}\n.error{border:1px solid var(--harbour);border-radius:6px;padding:8px 12px;margin:0 0 16px;font-size:14px;color:var(--harbour);background:var(--paper)}\nfieldset{border:1px solid var(--rope);border-radius:6px;margin:0;padding:8px 12px 12px;min-width:0}\nlegend{font-size:14px;font-weight:500;padding:0 4px}\n.checks{display:flex;flex-wrap:wrap;gap:4px 16px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:400;font-size:16px;margin:0;min-height:40px;cursor:pointer}\ninput[type=checkbox]{width:18px;height:18px;margin:0;accent-color:var(--harbour)}\nul{list-style:none;margin:0;padding:0}\nli{display:flex;justify-content:space-between;align-items:center;gap:8px 16px;flex-wrap:wrap;padding:12px 0;border-top:1px solid var(--rope)}\nli:first-child{border-top:0;padding-top:0}\nli:last-child{padding-bottom:0}\n.grp{min-width:0;flex:1 1 160px}\n.name{font-weight:500}\n.meta{color:var(--fog);font-size:14px;margin:4px 0 0}\n.money{font-variant-numeric:tabular-nums;font-weight:500;white-space:nowrap}\n.pos{color:var(--kelp)}\n.neg{color:var(--harbour)}\n.zero{color:var(--fog)}\n.bal-note{color:var(--fog);font-size:14px;margin-left:8px;font-weight:400}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header>\n    <div class=\"wordmark\"><span class=\"rule\" aria-hidden=\"true\"></span><h1>Even Keel</h1></div>\n    <p class=\"tagline\">Split trip costs so everyone ends up even.</p>\n  </header>\n\n  <section aria-labelledby=\"people-h\">\n    <h2 id=\"people-h\">People</h2>\n    <div class=\"stack\">\n      <form id=\"person-form\" novalidate>\n        <div class=\"row\">\n          <div class=\"grow\">\n            <label for=\"person-name\">Name</label>\n            <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" maxlength=\"60\">\n          </div>\n          <button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n        </div>\n        <div id=\"person-err\"></div>\n      </form>\n      <div id=\"people-wrap\"></div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"expenses-h\">\n    <h2 id=\"expenses-h\">Expenses</h2>\n    <form id=\"expense-form\" novalidate class=\"stack\">\n      <div class=\"row\">\n        <div class=\"grow\">\n          <label for=\"expense-desc\">Description</label>\n          <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\" maxlength=\"80\">\n        </div>\n        <div class=\"grow\">\n          <label for=\"expense-amount\">Amount (CAD)</label>\n          <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"0.00\">\n        </div>\n      </div>\n      <div class=\"row\">\n        <div class=\"grow\">\n          <label for=\"expense-payer\">Paid by</label>\n          <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n        </div>\n      </div>\n      <fieldset>\n        <legend>Split between</legend>\n        <div class=\"checks\" data-testid=\"expense-split\" id=\"expense-split\"></div>\n      </fieldset>\n      <div><button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button></div>\n      <div id=\"expense-err\"></div>\n    </form>\n    <div id=\"expenses-wrap\" style=\"margin-top:24px\"></div>\n  </section>\n\n  <section aria-labelledby=\"balances-h\">\n    <h2 id=\"balances-h\">Balances</h2>\n    <div id=\"balances-wrap\"></div>\n  </section>\n\n  <section aria-labelledby=\"settle-h\">\n    <h2 id=\"settle-h\">Settle up</h2>\n    <div id=\"settle-wrap\"></div>\n  </section>\n</main>\n\n<script>\n(function () {\n  const KEY = 'even-keel-v1';\n  const fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  const money = c => fmt.format(c / 100);\n\n  let state = load();\n  const unchecked = new Set();\n\n  function load() {\n    try {\n      const s = JSON.parse(localStorage.getItem(KEY));\n      if (s && Array.isArray(s.people) && Array.isArray(s.expenses)) return s;\n    } catch (e) {}\n    return { people: [], expenses: [] };\n  }\n  function save() { localStorage.setItem(KEY, JSON.stringify(state)); }\n\n  function el(tag, props, ...kids) {\n    const n = document.createElement(tag);\n    if (props) for (const [k, v] of Object.entries(props)) {\n      if (v === false || v == null) continue;\n      if (k === 'text') n.textContent = v;\n      else if (k === 'class') n.className = v;\n      else if (v === true) n.setAttribute(k, '');\n      else n.setAttribute(k, v);\n    }\n    for (const c of kids) if (c) n.append(c);\n    return n;\n  }\n\n  const $ = id => document.getElementById(id);\n  const personForm = $('person-form'), nameInput = $('person-name');\n  const expenseForm = $('expense-form'), descInput = $('expense-desc'), amountInput = $('expense-amount');\n  const payerSel = $('expense-payer'), splitBox = $('expense-split');\n  const personErr = $('person-err'), expenseErr = $('expense-err');\n\n  function showErr(container, msg, focusEl) {\n    container.replaceChildren(el('div', { class: 'error', role: 'alert', 'data-testid': 'form-error' }, msg));\n    if (focusEl) focusEl.focus();\n  }\n  function clearErr(container) { container.replaceChildren(); }\n\n  function parseAmount(raw) {\n    const s = raw.trim().replace(/^\\$/, '').replace(/,/g, '').trim();\n    const m = /^(\\d+)(?:\\.(\\d{1,2}))?$/.exec(s);\n    if (!m) return null;\n    const cents = parseInt(m[1], 10) * 100 + (m[2] ? parseInt(m[2].padEnd(2, '0'), 10) : 0);\n    if (!Number.isSafeInteger(cents) || cents <= 0) return null;\n    return cents;\n  }\n\n  function addPerson() {\n    const raw = nameInput.value.trim();\n    if (!raw) return showErr(personErr, 'Enter a name for the person.', nameInput);\n    if (state.people.some(p => p.toLowerCase() === raw.toLowerCase()))\n      return showErr(personErr, `${raw} is already on the trip. Use a different name.`, nameInput);\n    state.people.push(raw);\n    save();\n    nameInput.value = '';\n    clearErr(personErr);\n    renderAll();\n    nameInput.focus();\n  }\n\n  function addExpense() {\n    const desc = descInput.value.trim();\n    if (!desc) return showErr(expenseErr, 'Enter a description for the expense.', descInput);\n    const cents = parseAmount(amountInput.value);\n    if (cents === null) return showErr(expenseErr, 'Enter an amount greater than $0 with at most 2 decimal places.', amountInput);\n    const payer = payerSel.value;\n    if (!payer || !state.people.includes(payer))\n      return showErr(expenseErr, 'Add a person before you log an expense.', nameInput);\n    const split = state.people.filter(p => !unchecked.has(p));\n    if (!split.length) return showErr(expenseErr, 'Select at least one person to split between.', splitBox.querySelector('input'));\n    state.expenses.push({\n      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7),\n      desc, cents, payer, split\n    });\n    save();\n    descInput.value = '';\n    amountInput.value = '';\n    unchecked.clear();\n    clearErr(expenseErr);\n    renderAll();\n    descInput.focus();\n  }\n\n  function deleteExpense(id) {\n    state.expenses = state.expenses.filter(e => e.id !== id);\n    save();\n    renderAll();\n  }\n\n  // Integer-cent split; leftover cents go one each to selected people in trip order.\n  function shares(e) {\n    const sel = state.people.filter(p => e.split.includes(p));\n    const n = sel.length;\n    const map = new Map();\n    if (!n) return map;\n    const base = Math.floor(e.cents / n);\n    let rem = e.cents - base * n;\n    for (const p of sel) {\n      map.set(p, base + (rem > 0 ? 1 : 0));\n      if (rem > 0) rem--;\n    }\n    return map;\n  }\n\n  function balances() {\n    const bal = new Map(state.people.map(p => [p, 0]));\n    for (const e of state.expenses) {\n      bal.set(e.payer, (bal.get(e.payer) || 0) + e.cents);\n      for (const [p, s] of shares(e)) bal.set(p, (bal.get(p) || 0) - s);\n    }\n    return bal;\n  }\n\n  function settle(bal) {\n    const cred = [], debt = [];\n    for (const p of state.people) {\n      const c = bal.get(p) || 0;\n      if (c > 0) cred.push({ name: p, c });\n      else if (c < 0) debt.push({ name: p, c: -c });\n    }\n    cred.sort((a, b) => b.c - a.c);\n    debt.sort((a, b) => b.c - a.c);\n    const out = [];\n    let i = 0, j = 0;\n    while (i < cred.length && j < debt.length) {\n      const amt = Math.min(cred[i].c, debt[j].c);\n      out.push({ from: debt[j].name, to: cred[i].name, cents: amt });\n      cred[i].c -= amt;\n      debt[j].c -= amt;\n      if (cred[i].c === 0) i++;\n      if (debt[j].c === 0) j++;\n    }\n    return out;\n  }\n\n  function renderPeople() {\n    const wrap = $('people-wrap');\n    if (!state.people.length) {\n      wrap.replaceChildren(el('p', { class: 'empty', text: 'No one is on the trip yet. Add the first person to start splitting costs.' }));\n      return;\n    }\n    wrap.replaceChildren(el('ul', { 'aria-label': 'People on the trip' },\n      ...state.people.map(p => el('li', { 'data-testid': 'person', 'data-person': p }, el('span', { class: 'name', text: p })))));\n  }\n\n  function renderForm() {\n    const prevPayer = payerSel.value;\n    payerSel.replaceChildren(...state.people.map(p => el('option', { value: p, text: p })));\n    if (state.people.includes(prevPayer)) payerSel.value = prevPayer;\n    splitBox.replaceChildren(...state.people.map(p => {\n      const cb = el('input', { type: 'checkbox', value: p });\n      cb.checked = !unchecked.has(p);\n      cb.addEventListener('change', () => {\n        if (cb.checked) unchecked.delete(p); else unchecked.add(p);\n      });\n      return el('label', null, cb, el('span', { text: p }));\n    }));\n  }\n\n  function renderExpenses() {\n    const wrap = $('expenses-wrap');\n    if (!state.expenses.length) {\n      wrap.replaceChildren(el('p', { class: 'empty', text: 'No expenses yet. Add one above to start tracking who paid.' }));\n      return;\n    }\n    const items = state.expenses.slice().reverse().map(e => {\n      const sel = state.people.filter(p => e.split.includes(p));\n      return el('li', { 'data-testid': 'expense' },\n        el('div', { class: 'grp' },\n          el('div', { class: 'name', text: e.desc }),\n          el('p', { class: 'meta', text: `Paid by ${e.payer}. Split between ${sel.join(', ')}.` })),\n        el('span', { class: 'money', text: money(e.cents) }),\n        el('button', { type: 'button', 'data-testid': 'delete-expense', 'aria-label': `Remove ${e.desc}`, onclick: null }, 'Remove'));\n    });\n    items.forEach((li, idx) => {\n      const e = state.expenses.slice().reverse()[idx];\n      li.querySelector('button').addEventListener('click', () => deleteExpense(e.id));\n    });\n    wrap.replaceChildren(el('ul', { 'aria-label': 'Expenses, newest first' }, ...items));\n  }\n\n  function renderBalances() {\n    const wrap = $('balances-wrap');\n    if (!state.people.length) {\n      wrap.replaceChildren(el('p', { class: 'empty', text: 'Balances appear once you add people and expenses.' }));\n      return;\n    }\n    const bal = balances();\n    wrap.replaceChildren(el('ul', { 'aria-label': 'Balances' }, ...state.people.map(p => {\n      const c = bal.get(p) || 0;\n      const cls = c > 0 ? 'pos' : c < 0 ? 'neg' : 'zero';\n      const note = c > 0 ? 'is owed' : c < 0 ? 'owes' : 'even';\n      const shown = c < 0 ? '-' + money(-c) : money(c);\n      return el('li', { 'data-testid': 'balance', 'data-person': p, 'data-cents': String(c) },\n        el('span', { class: 'name', text: p }),\n        el('span', null,\n          el('span', { class: 'money ' + cls, text: shown }),\n          el('span', { class: 'bal-note', text: note })));\n    })));\n  }\n\n  function renderSettle() {\n    const wrap = $('settle-wrap');\n    if (!state.people.length) {\n      wrap.replaceChildren(el('p', { class: 'empty', text: 'Add people and expenses to see who pays whom.' }));\n      return;\n    }\n    const ts = settle(balances());\n    if (!ts.length) {\n      wrap.replaceChildren(el('p', { class: 'empty', text: 'Everyone is even. No transfers needed.' }));\n      return;\n    }\n    wrap.replaceChildren(el('ul', { 'aria-label': 'Transfers' }, ...ts.map(t =>\n      el('li', { 'data-testid': 'transfer', 'data-from': t.from, 'data-to': t.to, 'data-cents': String(t.cents) },\n        el('span', { text: `${t.from} pays ${t.to}` }),\n        el('span', { class: 'money', text: money(t.cents) })))));\n  }\n\n  function renderAll() {\n    renderPeople();\n    renderForm();\n    renderExpenses();\n    renderBalances();\n    renderSettle();\n  }\n\n  personForm.addEventListener('submit', e => { e.preventDefault(); addPerson(); });\n  expenseForm.addEventListener('submit', e => { e.preventDefault(); addExpense(); });\n\n  renderAll();\n})();\n</script>\n</body>\n</html>"
    }

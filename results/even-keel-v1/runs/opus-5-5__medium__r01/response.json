      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel: split trip expenses</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Sans:wght@400;500&display=swap\">\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html { -webkit-text-size-adjust: 100%; }\n  body {\n    margin: 0;\n    background: #F6F3EC;\n    color: #1F3A4D;\n    font-family: \"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    font-weight: 400;\n    font-size: 16px;\n    line-height: 1.5;\n  }\n  main {\n    max-width: 720px;\n    margin: 0 auto;\n    padding: 40px 24px 48px;\n  }\n  h1, h2 {\n    font-family: \"Fraunces\", Georgia, serif;\n    font-weight: 600;\n    color: #1F3A4D;\n    margin: 0;\n    line-height: 1.2;\n  }\n  .wordmark {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    font-size: 40px;\n  }\n  .wordmark-rule {\n    display: inline-block;\n    width: 24px;\n    height: 3px;\n    background: #C2462B;\n    flex: none;\n  }\n  .tagline {\n    margin: 8px 0 0;\n    color: #5B6B75;\n    font-size: 16px;\n  }\n  header { margin-bottom: 32px; }\n  h2 { font-size: 20px; margin-bottom: 16px; }\n  h2:focus { outline: none; }\n  h2:focus-visible { outline: 2px solid #1F3A4D; outline-offset: 2px; border-radius: 6px; }\n  .panel {\n    background: #FFFFFF;\n    border: 1px solid #D9D2C3;\n    border-radius: 6px;\n    padding: 24px;\n    margin-bottom: 24px;\n  }\n  .field { margin-bottom: 16px; }\n  label, legend {\n    display: block;\n    font-weight: 500;\n    font-size: 16px;\n    margin-bottom: 4px;\n    color: #1F3A4D;\n  }\n  .hint {\n    display: block;\n    color: #5B6B75;\n    font-size: 14px;\n    margin: 0 0 4px;\n  }\n  input[type=\"text\"], select {\n    width: 100%;\n    min-height: 44px;\n    padding: 8px 12px;\n    font: inherit;\n    color: #1F3A4D;\n    background: #FFFFFF;\n    border: 1px solid #D9D2C3;\n    border-radius: 6px;\n    transition: border-color 150ms ease;\n  }\n  input[type=\"text\"]:hover, select:hover { border-color: #5B6B75; }\n  input[aria-invalid=\"true\"] { border-color: #1F3A4D; border-width: 2px; padding: 7px 11px; }\n  select { appearance: auto; }\n  .inline-row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    align-items: flex-end;\n  }\n  .inline-row .grow { flex: 1 1 200px; min-width: 0; }\n  .two-col {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n  }\n  .two-col .field { margin-bottom: 0; min-width: 0; }\n  .two-col { margin-bottom: 16px; }\n  button {\n    font: inherit;\n    font-weight: 500;\n    min-height: 44px;\n    padding: 8px 16px;\n    border-radius: 6px;\n    cursor: pointer;\n    transition: border-color 150ms ease, text-decoration-color 150ms ease;\n  }\n  .btn-primary {\n    background: #C2462B;\n    color: #FFFFFF;\n    border: 1px solid #C2462B;\n    text-decoration: underline;\n    text-decoration-color: transparent;\n    text-underline-offset: 3px;\n  }\n  .btn-primary:hover { text-decoration-color: #FFFFFF; }\n  .btn-secondary {\n    background: #FFFFFF;\n    color: #1F3A4D;\n    border: 1px solid #D9D2C3;\n    min-height: 36px;\n    padding: 4px 12px;\n    font-size: 14px;\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .btn-secondary:hover { border-color: #1F3A4D; }\n  :focus-visible { outline: 2px solid #1F3A4D; outline-offset: 2px; }\n  input:focus, select:focus { outline: 2px solid #1F3A4D; outline-offset: 2px; }\n  fieldset {\n    border: 0;\n    margin: 0 0 16px;\n    padding: 0;\n    min-width: 0;\n  }\n  .checks {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px 16px;\n  }\n  .check {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-weight: 400;\n    margin: 0;\n    min-height: 32px;\n    cursor: pointer;\n    overflow-wrap: anywhere;\n    max-width: 100%;\n  }\n  .check input {\n    width: 20px;\n    height: 20px;\n    margin: 0;\n    accent-color: #1F3A4D;\n    flex: none;\n  }\n  .error {\n    margin: 8px 0 0;\n    padding: 8px 12px;\n    border: 1px solid #D9D2C3;\n    border-left: 4px solid #1F3A4D;\n    border-radius: 6px;\n    background: #FFFFFF;\n    color: #1F3A4D;\n    font-weight: 500;\n    font-size: 16px;\n  }\n  .error[hidden] { display: none; }\n  .empty { color: #5B6B75; margin: 0; }\n  ul.list { list-style: none; margin: 0; padding: 0; }\n  .people-list {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin-top: 16px;\n  }\n  .people-list li {\n    border: 1px solid #D9D2C3;\n    border-radius: 6px;\n    padding: 4px 12px;\n    background: #FFFFFF;\n    overflow-wrap: anywhere;\n    max-width: 100%;\n  }\n  .people-count { color: #5B6B75; font-size: 14px; margin: 16px 0 0; }\n  .expense {\n    border-top: 1px solid #D9D2C3;\n    padding: 16px 0;\n  }\n  .expense:first-child { border-top: 0; padding-top: 0; }\n  .expense:last-child { padding-bottom: 0; }\n  .expense-top {\n    display: flex;\n    justify-content: space-between;\n    gap: 16px;\n    align-items: baseline;\n  }\n  .expense-desc { font-weight: 500; overflow-wrap: anywhere; min-width: 0; }\n  .money { font-variant-numeric: tabular-nums; white-space: nowrap; }\n  .expense-amount { font-weight: 500; }\n  .meta { color: #5B6B75; font-size: 14px; margin: 4px 0 8px; overflow-wrap: anywhere; }\n  .balance {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 12px 0;\n    border-top: 1px solid #D9D2C3;\n  }\n  .balance:first-child { border-top: 0; padding-top: 0; }\n  .balance:last-child { padding-bottom: 0; }\n  .balance-name { font-weight: 500; overflow-wrap: anywhere; min-width: 0; }\n  .balance-right { text-align: right; flex: none; }\n  .balance-status { display: block; font-size: 14px; color: #5B6B75; }\n  .balance-amount { font-weight: 500; }\n  .pos .balance-amount, .pos .balance-status { color: #2F6B4F; }\n  .neg .balance-amount { color: #1F3A4D; }\n  .transfer {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    gap: 16px;\n    padding: 12px 0;\n    border-top: 1px solid #D9D2C3;\n  }\n  .transfer:first-child { border-top: 0; padding-top: 0; }\n  .transfer:last-child { padding-bottom: 0; }\n  .transfer-text { overflow-wrap: anywhere; min-width: 0; }\n  .transfer-text strong { font-weight: 500; }\n  .transfer-amount { font-weight: 500; }\n  .settle-note { color: #5B6B75; font-size: 14px; margin: 16px 0 0; }\n  .visually-hidden {\n    position: absolute !important;\n    width: 1px; height: 1px;\n    padding: 0; margin: -1px;\n    overflow: hidden; clip: rect(0 0 0 0);\n    white-space: nowrap; border: 0;\n  }\n  svg.icon { width: 16px; height: 16px; stroke: #1F3A4D; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }\n  @media (max-width: 560px) {\n    main { padding: 24px 16px 40px; }\n    .panel { padding: 16px; }\n    .wordmark { font-size: 28px; }\n    .two-col { grid-template-columns: 1fr; }\n    .inline-row button { width: 100%; }\n    #add-expense-btn { width: 100%; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    * { transition: none !important; }\n  }\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header>\n    <h1 class=\"wordmark\"><span class=\"wordmark-rule\" aria-hidden=\"true\"></span>Even Keel</h1>\n    <p class=\"tagline\">Log who paid for what and see how everyone ends up even.</p>\n  </header>\n\n  <section class=\"panel\" aria-labelledby=\"people-heading\">\n    <h2 id=\"people-heading\">People on the trip</h2>\n    <form id=\"person-form\" novalidate>\n      <div class=\"inline-row\">\n        <div class=\"grow\">\n          <label for=\"person-name\">Name</label>\n          <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" maxlength=\"40\" aria-describedby=\"person-error\">\n        </div>\n        <button type=\"submit\" class=\"btn-primary\" data-testid=\"add-person\">Add person</button>\n      </div>\n      <p class=\"error\" id=\"person-error\" role=\"alert\" hidden></p>\n    </form>\n    <div id=\"people-area\"></div>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"add-expense-heading\">\n    <h2 id=\"add-expense-heading\">Add an expense</h2>\n    <form id=\"expense-form\" novalidate>\n      <p class=\"empty\" id=\"expense-form-empty\" hidden>Add people to the trip first, then log what each of you paid.</p>\n      <div class=\"field\">\n        <label for=\"expense-desc\">Description</label>\n        <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\" maxlength=\"80\" aria-describedby=\"expense-error\">\n      </div>\n      <div class=\"two-col\">\n        <div class=\"field\">\n          <label for=\"expense-amount\">Amount in Canadian dollars</label>\n          <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\" aria-describedby=\"amount-hint expense-error\">\n          <span class=\"hint\" id=\"amount-hint\">For example 42.50</span>\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-payer\">Paid by</label>\n          <select id=\"expense-payer\" data-testid=\"expense-payer\" aria-describedby=\"expense-error\"></select>\n        </div>\n      </div>\n      <fieldset aria-describedby=\"split-hint expense-error\">\n        <legend>Split between</legend>\n        <span class=\"hint\" id=\"split-hint\">The amount is shared equally between the people you select.</span>\n        <div class=\"checks\" id=\"expense-split\" data-testid=\"expense-split\"></div>\n      </fieldset>\n      <button type=\"submit\" class=\"btn-primary\" id=\"add-expense-btn\" data-testid=\"add-expense\">Add expense</button>\n      <p class=\"error\" id=\"expense-error\" role=\"alert\" hidden></p>\n    </form>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"expenses-heading\">\n    <h2 id=\"expenses-heading\" tabindex=\"-1\">Expenses</h2>\n    <div id=\"expenses-area\"></div>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"balances-heading\">\n    <h2 id=\"balances-heading\">Balances</h2>\n    <div id=\"balances-area\"></div>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"settle-heading\">\n    <h2 id=\"settle-heading\">Settle up</h2>\n    <div id=\"settle-area\"></div>\n  </section>\n\n  <div class=\"visually-hidden\" aria-live=\"polite\" id=\"status\"></div>\n</main>\n\n<script>\n(function () {\n  'use strict';\n\n  var KEY = 'even-keel-trip-v1';\n  var fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  function money(cents) { return fmt.format(cents / 100); }\n\n  /* ---------- State ---------- */\n  function emptyState() { return { people: [], expenses: [], nextId: 1 }; }\n\n  function load() {\n    try {\n      var raw = localStorage.getItem(KEY);\n      if (!raw) return emptyState();\n      var d = JSON.parse(raw);\n      if (!d || !Array.isArray(d.people) || !Array.isArray(d.expenses)) return emptyState();\n      var people = [];\n      var seen = {};\n      d.people.forEach(function (p) {\n        if (typeof p !== 'string') return;\n        var n = p.trim();\n        if (!n || seen[n.toLowerCase()]) return;\n        seen[n.toLowerCase()] = true;\n        people.push(n);\n      });\n      var maxId = 0;\n      var expenses = d.expenses.filter(function (e) {\n        return e && typeof e.desc === 'string' && Number.isSafeInteger(e.cents) && e.cents > 0 &&\n          people.indexOf(e.payer) !== -1 && Array.isArray(e.split) && e.split.length > 0 &&\n          e.split.every(function (s) { return people.indexOf(s) !== -1; });\n      }).map(function (e, i) {\n        var id = Number.isSafeInteger(e.id) ? e.id : (i + 1);\n        if (id > maxId) maxId = id;\n        return { id: id, desc: e.desc, cents: e.cents, payer: e.payer, split: e.split.slice() };\n      });\n      var nextId = Number.isSafeInteger(d.nextId) && d.nextId > maxId ? d.nextId : maxId + 1;\n      return { people: people, expenses: expenses, nextId: nextId };\n    } catch (err) {\n      return emptyState();\n    }\n  }\n\n  function save() {\n    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (err) { /* storage unavailable */ }\n  }\n\n  var state = load();\n\n  /* ---------- Money logic ---------- */\n  function parseAmount(text) {\n    var t = text.trim().replace(/^\\$/, '').replace(/,/g, '').trim();\n    if (t === '') return { error: 'Enter an amount.' };\n    if (!/^(\\d+(\\.\\d*)?|\\.\\d+)$/.test(t)) return { error: 'Enter the amount as a number, for example 42.50.' };\n    var parts = t.split('.');\n    var frac = parts[1] || '';\n    if (frac.length > 2) return { error: 'Enter an amount with at most 2 decimal places.' };\n    var whole = parts[0] === '' ? 0 : Number(parts[0]);\n    var cents = whole * 100 + Number((frac + '00').slice(0, 2));\n    if (!Number.isSafeInteger(cents)) return { error: 'Enter a smaller amount.' };\n    if (cents <= 0) return { error: 'Enter an amount greater than $0.' };\n    return { cents: cents };\n  }\n\n  function shares(exp) {\n    var ordered = state.people.filter(function (p) { return exp.split.indexOf(p) !== -1; });\n    var n = ordered.length;\n    var result = {};\n    if (!n) return result;\n    var base = Math.floor(exp.cents / n);\n    var rem = exp.cents - base * n;\n    ordered.forEach(function (p, i) { result[p] = base + (i < rem ? 1 : 0); });\n    return result;\n  }\n\n  function balances() {\n    var b = {};\n    state.people.forEach(function (p) { b[p] = 0; });\n    state.expenses.forEach(function (e) {\n      b[e.payer] += e.cents;\n      var s = shares(e);\n      Object.keys(s).forEach(function (p) { b[p] -= s[p]; });\n    });\n    return b;\n  }\n\n  function settle(b) {\n    var order = function (name) { return state.people.indexOf(name); };\n    var creditors = [], debtors = [];\n    state.people.forEach(function (p) {\n      if (b[p] > 0) creditors.push({ name: p, amt: b[p] });\n      else if (b[p] < 0) debtors.push({ name: p, amt: -b[p] });\n    });\n    var sorter = function (a, c) { return c.amt - a.amt || order(a.name) - order(c.name); };\n    creditors.sort(sorter);\n    debtors.sort(sorter);\n    var transfers = [];\n    var i = 0, j = 0;\n    while (i < debtors.length && j < creditors.length) {\n      var amt = Math.min(debtors[i].amt, creditors[j].amt);\n      if (amt > 0) transfers.push({ from: debtors[i].name, to: creditors[j].name, cents: amt });\n      debtors[i].amt -= amt;\n      creditors[j].amt -= amt;\n      if (debtors[i].amt === 0) i++;\n      if (creditors[j].amt === 0) j++;\n    }\n    return transfers;\n  }\n\n  /* ---------- DOM helpers ---------- */\n  function $(id) { return document.getElementById(id); }\n  function el(tag, attrs, children) {\n    var node = document.createElement(tag);\n    if (attrs) Object.keys(attrs).forEach(function (k) {\n      if (k === 'text') node.textContent = attrs[k];\n      else if (k === 'class') node.className = attrs[k];\n      else node.setAttribute(k, attrs[k]);\n    });\n    (children || []).forEach(function (c) {\n      if (c == null) return;\n      node.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);\n    });\n    return node;\n  }\n  function listNames(names) {\n    if (names.length <= 1) return names.join('');\n    if (names.length === 2) return names[0] + ' and ' + names[1];\n    return names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];\n  }\n  function announce(msg) {\n    var s = $('status');\n    s.textContent = '';\n    setTimeout(function () { s.textContent = msg; }, 50);\n  }\n\n  function showError(id, msg, field) {\n    var p = $(id);\n    p.textContent = msg;\n    p.setAttribute('data-testid', 'form-error');\n    p.hidden = false;\n    var form = p.closest('form');\n    form.querySelectorAll('[aria-invalid]').forEach(function (n) { n.removeAttribute('aria-invalid'); });\n    if (field) {\n      if (field.tagName === 'INPUT' && field.type === 'text') field.setAttribute('aria-invalid', 'true');\n      field.focus();\n    }\n  }\n  function clearError(id) {\n    var p = $(id);\n    p.textContent = '';\n    p.removeAttribute('data-testid');\n    p.hidden = true;\n    p.closest('form').querySelectorAll('[aria-invalid]').forEach(function (n) { n.removeAttribute('aria-invalid'); });\n  }\n\n  /* ---------- Rendering ---------- */\n  var resetSplit = false;\n\n  function renderPeople() {\n    var area = $('people-area');\n    area.textContent = '';\n    if (!state.people.length) {\n      area.appendChild(el('p', { class: 'empty', style: 'margin-top:16px', text: 'Add the first person on your trip to get started.' }));\n      return;\n    }\n    var ul = el('ul', { class: 'list people-list', 'aria-label': 'People on the trip' });\n    state.people.forEach(function (p) {\n      ul.appendChild(el('li', { 'data-testid': 'person', text: p }));\n    });\n    area.appendChild(ul);\n    var n = state.people.length;\n    area.appendChild(el('p', { class: 'people-count', text: n === 1 ? '1 person on this trip.' : n + ' people on this trip.' }));\n  }\n\n  function renderExpenseForm() {\n    var hasPeople = state.people.length > 0;\n    $('expense-form-empty').hidden = hasPeople;\n    if (!hasPeople) $('expense-form-empty').style.marginBottom = '16px';\n\n    var payer = $('expense-payer');\n    var prev = payer.value;\n    payer.textContent = '';\n    if (!hasPeople) {\n      payer.appendChild(el('option', { value: '', text: 'Add people first' }));\n    }\n    state.people.forEach(function (p) {\n      payer.appendChild(el('option', { value: p, text: p }));\n    });\n    if (prev && state.people.indexOf(prev) !== -1) payer.value = prev;\n\n    var box = $('expense-split');\n    var prevChecked = {};\n    box.querySelectorAll('input[type=\"checkbox\"]').forEach(function (c) { prevChecked[c.value] = c.checked; });\n    box.textContent = '';\n    if (!hasPeople) {\n      box.appendChild(el('span', { class: 'hint', text: 'People you add will appear here.' }));\n    }\n    state.people.forEach(function (p, i) {\n      var id = 'split-' + i;\n      var cb = el('input', { type: 'checkbox', id: id, value: p });\n      cb.checked = resetSplit || !(p in prevChecked) ? true : prevChecked[p];\n      box.appendChild(el('label', { class: 'check', for: id }, [cb, el('span', { text: p })]));\n    });\n    resetSplit = false;\n  }\n\n  function renderExpenses() {\n    var area = $('expenses-area');\n    area.textContent = '';\n    if (!state.expenses.length) {\n      area.appendChild(el('p', { class: 'empty', text: state.people.length\n        ? 'Add an expense above when someone pays for something.'\n        : 'Add people to the trip, then log the first expense.' }));\n      return;\n    }\n    var ul = el('ul', { class: 'list', 'aria-label': 'Expenses, newest first' });\n    state.expenses.slice().reverse().forEach(function (e) {\n      var split = state.people.filter(function (p) { return e.split.indexOf(p) !== -1; });\n      var splitText = split.length === state.people.length && split.length > 1\n        ? 'everyone (' + listNames(split) + ')'\n        : listNames(split);\n      var icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n      icon.setAttribute('class', 'icon');\n      icon.setAttribute('viewBox', '0 0 16 16');\n      icon.setAttribute('aria-hidden', 'true');\n      icon.setAttribute('focusable', 'false');\n      var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n      path.setAttribute('d', 'M4 4l8 8M12 4l-8 8');\n      icon.appendChild(path);\n      var btn = el('button', {\n        type: 'button', class: 'btn-secondary', 'data-testid': 'delete-expense',\n        'data-id': String(e.id), 'aria-label': 'Remove expense: ' + e.desc + ', 
    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel – split trip expenses</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --harbour: #1F3A4D;\n    --fog: #5B6B75;\n    --sailcloth: #F6F3EC;\n    --paper: #FFFFFF;\n    --rope: #D9D2C3;\n    --signal: #C2462B;\n    --kelp: #2F6B4F;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; }\n  body {\n    background: var(--sailcloth);\n    color: var(--harbour);\n    font-family: \"IBM Plex Sans\", system-ui, sans-serif;\n    font-size: 16px;\n    line-height: 1.5;\n  }\n  main {\n    max-width: 720px;\n    margin: 0 auto;\n    padding: 32px 16px 64px;\n  }\n  @media (min-width: 600px) {\n    main { padding: 48px 24px 80px; }\n  }\n  header { margin-bottom: 32px; }\n  .wordmark {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin: 0;\n    font-family: \"Fraunces\", Georgia, serif;\n    font-weight: 600;\n    font-size: 40px;\n    line-height: 1.1;\n    color: var(--harbour);\n  }\n  .wordmark::before {\n    content: \"\";\n    display: block;\n    width: 24px;\n    height: 3px;\n    background: var(--signal);\n    flex: none;\n  }\n  .tagline { margin: 8px 0 0 36px; color: var(--fog); font-size: 16px; }\n  h2 {\n    font-family: \"Fraunces\", Georgia, serif;\n    font-weight: 600;\n    font-size: 28px;\n    line-height: 1.2;\n    margin: 0 0 16px;\n  }\n  h3 {\n    font-family: \"Fraunces\", Georgia, serif;\n    font-weight: 600;\n    font-size: 20px;\n    margin: 24px 0 8px;\n  }\n  section { margin-bottom: 40px; }\n  .panel {\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 16px;\n  }\n  @media (min-width: 600px) { .panel { padding: 24px; } }\n  label, legend { display: block; font-weight: 500; font-size: 14px; margin-bottom: 4px; }\n  .field { margin-bottom: 16px; }\n  input[type=\"text\"], select {\n    width: 100%;\n    font: inherit;\n    font-size: 16px;\n    color: var(--harbour);\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 8px 12px;\n    margin: 0;\n  }\n  input[type=\"text\"]:hover, select:hover { border-color: var(--harbour); transition: border-color 150ms; }\n  .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; }\n  .row .field { flex: 1 1 200px; margin-bottom: 0; }\n  button {\n    font: inherit;\n    font-size: 16px;\n    font-weight: 500;\n    border-radius: 6px;\n    padding: 8px 16px;\n    cursor: pointer;\n    transition: background-color 150ms, border-color 150ms;\n    border: 1px solid transparent;\n  }\n  .primary { background: var(--signal); color: var(--paper); border-color: var(--signal); }\n  .primary:hover { background: var(--harbour); border-color: var(--harbour); }\n  .secondary { background: var(--paper); color: var(--harbour); border-color: var(--rope); font-size: 14px; padding: 4px 12px; }\n  .secondary:hover { border-color: var(--harbour); }\n  :focus-visible { outline: 2px solid var(--harbour); outline-offset: 2px; }\n  .error { margin: 8px 0 0; font-weight: 500; font-size: 14px; color: var(--harbour); }\n  .hint { color: var(--fog); font-size: 14px; margin: 4px 0 0; }\n  .empty { color: var(--fog); margin: 0; }\n  ul { list-style: none; padding: 0; margin: 0; }\n  .list li {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 16px;\n    padding: 12px 0;\n    border-top: 1px solid var(--rope);\n  }\n  .list li:first-child { border-top: 0; padding-top: 0; }\n  .list li:last-child { padding-bottom: 0; }\n  .meta { color: var(--fog); font-size: 14px; margin: 4px 0 0; overflow-wrap: anywhere; }\n  .money { font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 500; }\n  .owed { color: var(--kelp); }\n  .chips { display: flex; flex-wrap: wrap; gap: 8px 16px; }\n  .chips label { display: flex; align-items: center; gap: 8px; font-weight: 400; font-size: 16px; margin: 0; }\n  input[type=\"checkbox\"] { width: 20px; height: 20px; margin: 0; accent-color: var(--harbour); }\n  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }\n  .title { font-weight: 500; overflow-wrap: anywhere; }\n  .actions { margin-top: 16px; }\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header>\n    <h1 class=\"wordmark\">Even Keel</h1>\n    <p class=\"tagline\">Split trip costs so everyone ends up even.</p>\n  </header>\n\n  <section aria-labelledby=\"people-heading\">\n    <h2 id=\"people-heading\">People</h2>\n    <div class=\"panel\">\n      <form id=\"person-form\" novalidate>\n        <div class=\"row\">\n          <div class=\"field\">\n            <label for=\"person-name\">Name</label>\n            <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\">\n          </div>\n          <button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n        </div>\n        <div id=\"person-error\" aria-live=\"polite\"></div>\n      </form>\n      <h3>On the trip</h3>\n      <div id=\"people-list\"></div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"expenses-heading\">\n    <h2 id=\"expenses-heading\">Expenses</h2>\n    <div class=\"panel\">\n      <form id=\"expense-form\" novalidate>\n        <div class=\"field\">\n          <label for=\"expense-desc\">Description</label>\n          <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\">\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-amount\">Amount (CAD)</label>\n          <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\">\n          <p class=\"hint\">Dollars and cents, for example 42.50.</p>\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-payer\">Paid by</label>\n          <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n        </div>\n        <fieldset class=\"field\">\n          <legend>Split between</legend>\n          <div id=\"expense-split\" class=\"chips\" data-testid=\"expense-split\"></div>\n        </fieldset>\n        <div id=\"expense-error\" aria-live=\"polite\"></div>\n        <div class=\"actions\">\n          <button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n        </div>\n      </form>\n      <h3>Logged so far</h3>\n      <div id=\"expense-list\"></div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"balances-heading\">\n    <h2 id=\"balances-heading\">Balances</h2>\n    <div class=\"panel\">\n      <div id=\"balance-list\"></div>\n      <h3>Settle up</h3>\n      <div id=\"transfer-list\"></div>\n    </div>\n  </section>\n</main>\n\n<script>\n(function () {\n  var STORAGE_KEY = 'even-keel-trip';\n  var fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  var state = load();\n\n  function load() {\n    try {\n      var raw = localStorage.getItem(STORAGE_KEY);\n      if (raw) {\n        var s = JSON.parse(raw);\n        if (s && Array.isArray(s.people) && Array.isArray(s.expenses)) return s;\n      }\n    } catch (e) {}\n    return { people: [], expenses: [] };\n  }\n  function save() {\n    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}\n  }\n\n  function el(tag, attrs, children) {\n    var n = document.createElement(tag);\n    if (attrs) Object.keys(attrs).forEach(function (k) {\n      if (k === 'text') n.textContent = attrs[k];\n      else if (k === 'className') n.className = attrs[k];\n      else n.setAttribute(k, attrs[k]);\n    });\n    (children || []).forEach(function (c) { n.appendChild(c); });\n    return n;\n  }\n  function money(cents) { return fmt.format(cents / 100); }\n  function signedMoney(cents) {\n    return cents < 0 ? '\\u2212' + money(-cents) : money(cents);\n  }\n  function listNames(names) {\n    if (names.length === 1) return names[0];\n    if (names.length === 2) return names[0] + ' and ' + names[1];\n    return names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];\n  }\n\n  function showError(container, msg) {\n    container.innerHTML = '';\n    if (msg) container.appendChild(el('p', { className: 'error', 'data-testid': 'form-error', role: 'alert', text: msg }));\n  }\n\n  // Shares in integer cents, leftover cents to people in trip order.\n  function shares(expense) {\n    var order = state.people.filter(function (p) { return expense.split.indexOf(p) !== -1; });\n    var n = order.length;\n    var base = Math.floor(expense.cents / n);\n    var extra = expense.cents - base * n;\n    var out = {};\n    order.forEach(function (p, i) { out[p] = base + (i < extra ? 1 : 0); });\n    return out;\n  }\n\n  function balances() {\n    var b = {};\n    state.people.forEach(function (p) { b[p] = 0; });\n    state.expenses.forEach(function (e) {\n      b[e.payer] += e.cents;\n      var s = shares(e);\n      Object.keys(s).forEach(function (p) { b[p] -= s[p]; });\n    });\n    return b;\n  }\n\n  function transfers(b) {\n    var creditors = [], debtors = [];\n    state.people.forEach(function (p) {\n      if (b[p] > 0) creditors.push({ name: p, cents: b[p] });\n      else if (b[p] < 0) debtors.push({ name: p, cents: -b[p] });\n    });\n    creditors.sort(function (x, y) { return y.cents - x.cents; });\n    debtors.sort(function (x, y) { return y.cents - x.cents; });\n    var out = [], i = 0, j = 0;\n    while (i < debtors.length && j < creditors.length) {\n      var amt = Math.min(debtors[i].cents, creditors[j].cents);\n      out.push({ from: debtors[i].name, to: creditors[j].name, cents: amt });\n      debtors[i].cents -= amt;\n      creditors[j].cents -= amt;\n      if (debtors[i].cents === 0) i++;\n      if (creditors[j].cents === 0) j++;\n    }\n    return out;\n  }\n\n  // Rendering\n  function renderPeople() {\n    var c = document.getElementById('people-list');\n    c.innerHTML = '';\n    if (!state.people.length) {\n      c.appendChild(el('p', { className: 'empty', text: 'Add everyone on the trip to get started.' }));\n      return;\n    }\n    var ul = el('ul', { className: 'list' });\n    state.people.forEach(function (p) {\n      ul.appendChild(el('li', { 'data-testid': 'person' }, [el('span', { className: 'title', text: p })]));\n    });\n    c.appendChild(ul);\n  }\n\n  function renderExpenseForm() {\n    var sel = document.getElementById('expense-payer');\n    var prev = sel.value;\n    sel.innerHTML = '';\n    if (!state.people.length) {\n      sel.appendChild(el('option', { value: '', text: 'Add a person first' }));\n      sel.disabled = true;\n    } else {\n      sel.disabled = false;\n      state.people.forEach(function (p) { sel.appendChild(el('option', { value: p, text: p })); });\n      if (state.people.indexOf(prev) !== -1) sel.value = prev;\n    }\n    var split = document.getElementById('expense-split');\n    var checked = {};\n    Array.prototype.forEach.call(split.querySelectorAll('input'), function (i) { checked[i.value] = i.checked; });\n    split.innerHTML = '';\n    if (!state.people.length) {\n      split.appendChild(el('p', { className: 'empty', text: 'Add a person to choose who shares this expense.' }));\n      return;\n    }\n    state.people.forEach(function (p, idx) {\n      var id = 'split-' + idx;\n      var box = el('input', { type: 'checkbox', id: id, value: p });\n      box.checked = (p in checked) ? checked[p] : true;\n      split.appendChild(el('label', { for: id }, [box, el('span', { text: p })]));\n    });\n  }\n\n  function renderExpenses() {\n    var c = document.getElementById('expense-list');\n    c.innerHTML = '';\n    if (!state.expenses.length) {\n      c.appendChild(el('p', { className: 'empty', text: state.people.length ? 'Log the first thing someone paid for.' : 'Add people, then log what they paid for.' }));\n      return;\n    }\n    var ul = el('ul', { className: 'list' });\n    state.expenses.slice().reverse().forEach(function (e) {\n      var order = state.people.filter(function (p) { return e.split.indexOf(p) !== -1; });\n      var left = el('div', {}, [\n        el('div', { className: 'title' }, [\n          el('span', { text: e.desc + ' ' }),\n          el('span', { className: 'money', text: money(e.cents) })\n        ]),\n        el('p', { className: 'meta', text: 'Paid by ' + e.payer + ', split between ' + listNames(order) })\n      ]);\n      var btn = el('button', { type: 'button', className: 'secondary', 'data-testid': 'delete-expense', 'aria-label': 'Remove ' + e.desc, text: 'Remove' });\n      btn.addEventListener('click', function () {\n        state.expenses = state.expenses.filter(function (x) { return x.id !== e.id; });\n        save(); render();\n      });\n      ul.appendChild(el('li', { 'data-testid': 'expense' }, [left, btn]));\n    });\n    c.appendChild(ul);\n  }\n\n  function renderBalances() {\n    var bc = document.getElementById('balance-list');\n    var tc = document.getElementById('transfer-list');\n    bc.innerHTML = ''; tc.innerHTML = '';\n    if (!state.people.length) {\n      bc.appendChild(el('p', { className: 'empty', text: 'Balances appear once you add people and expenses.' }));\n      tc.appendChild(el('p', { className: 'empty', text: 'Transfers appear once someone owes money.' }));\n      return;\n    }\n    var b = balances();\n    var ul = el('ul', { className: 'list' });\n    state.people.forEach(function (p) {\n      var cents = b[p];\n      var label = cents > 0 ? 'is owed' : cents < 0 ? 'owes' : 'is even';\n      ul.appendChild(el('li', { 'data-testid': 'balance', 'data-person': p, 'data-cents': String(cents) }, [\n        el('div', {}, [el('span', { className: 'title', text: p }), el('p', { className: 'meta', text: label })]),\n        el('span', { className: 'money' + (cents > 0 ? ' owed' : ''), text: signedMoney(cents) })\n      ]));\n    });\n    bc.appendChild(ul);\n    var t = transfers(b);\n    if (!t.length) {\n      tc.appendChild(el('p', { className: 'empty', text: state.expenses.length ? 'Everyone is even. Nothing to settle.' : 'Log an expense to see who should pay whom.' }));\n      return;\n    }\n    var tul = el('ul', { className: 'list' });\n    t.forEach(function (x) {\n      tul.appendChild(el('li', { 'data-testid': 'transfer', 'data-from': x.from, 'data-to': x.to, 'data-cents': String(x.cents) }, [\n        el('span', { className: 'title', text: x.from + ' pays ' + x.to }),\n        el('span', { className: 'money', text: money(x.cents) })\n      ]));\n    });\n    tc.appendChild(tul);\n  }\n\n  function render() {\n    renderPeople();\n    renderExpenseForm();\n    renderExpenses();\n    renderBalances();\n  }\n\n  // Person form\n  document.getElementById('person-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var input = document.getElementById('person-name');\n    var errBox = document.getElementById('person-error');\n    var name = input.value.trim();\n    if (!name) { showError(errBox, 'Enter a name.'); input.focus(); return; }\n    var dup = state.people.some(function (p) { return p.toLowerCase() === name.toLowerCase(); });\n    if (dup) { showError(errBox, 'Someone named ' + name + ' is already on the trip. Use a different name.'); input.focus(); return; }\n    state.people.push(name);\n    save();\n    showError(errBox, '');\n    input.value = '';\n    render();\n    input.focus();\n  });\n\n  function parseCents(str) {\n    var s = str.trim().replace(/^\\$/, '').replace(/,/g, '');\n    if (!/^\\d+(\\.\\d*)?$/.test(s) && !/^\\.\\d+$/.test(s)) return { error: 'Enter an amount greater than $0.' };\n    var parts = s.split('.');\n    var whole = parts[0] || '0';\n    var frac = parts[1] || '';\n    if (frac.length > 2) return { error: 'Enter an amount with at most 2 decimal places.' };\n    var cents = parseInt(whole, 10) * 100 + parseInt((frac + '00').slice(0, 2), 10);\n    if (!(cents > 0)) return { error: 'Enter an amount greater than $0.' };\n    return { cents: cents };\n  }\n\n  // Expense form\n  document.getElementById('expense-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var errBox = document.getElementById('expense-error');\n    var descIn = document.getElementById('expense-desc');\n    var amtIn = document.getElementById('expense-amount');\n    var sel = document.getElementById('expense-payer');\n    if (!state.people.length) { showError(errBox, 'Add at least one person before logging an expense.'); return; }\n    var desc = descIn.value.trim();\n    if (!desc) { showError(errBox, 'Enter a description.'); descIn.focus(); return; }\n    var parsed = parseCents(amtIn.value);\n    if (parsed.error) { showError(errBox, parsed.error); amtIn.focus(); return; }\n    var payer = sel.value;\n    if (state.people.indexOf(payer) === -1) { showError(errBox, 'Choose who paid.'); sel.focus(); return; }\n    var split = [];\n    Array.prototype.forEach.call(document.querySelectorAll('#expense-split input:checked'), function (i) { split.push(i.value); });\n    if (!split.length) {\n      showError(errBox, 'Choose at least one person to split between.');\n      var first = document.querySelector('#expense-split input');\n      if (first) first.focus();\n      return;\n    }\n    state.expenses.push({ id: Date.now() + '-' + Math.random().toString(36).slice(2), desc: desc, cents: parsed.cents, payer: payer, split: split });\n    save();\n    showError(errBox, '');\n    descIn.value = '';\n    amtIn.value = '';\n    Array.prototype.forEach.call(document.querySelectorAll('#expense-split input'), function (i) { i.checked = true; });\n    render();\n    descIn.focus();\n  });\n\n  render();\n})();\n</script>\n</body>\n</html>"
    }

      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=IBM+Plex+Sans:wght@400;500&display=swap\">\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0}\nbody{background:#F6F3EC;color:#1F3A4D;font-family:\"IBM Plex Sans\",system-ui,sans-serif;font-size:16px;line-height:1.5}\nmain{max-width:720px;margin:0 auto;padding:40px 24px}\n@media (max-width:480px){main{padding:24px 16px}}\nheader{margin-bottom:32px}\n.wordmark{display:flex;align-items:center;gap:8px;font-family:Fraunces,serif;font-weight:600;font-size:40px;line-height:1.2;margin:0}\n.wordmark::before{content:\"\";width:24px;height:3px;background:#C2462B;flex:none}\n.tagline{color:#5B6B75;margin:4px 0 0}\nh2{font-family:Fraunces,serif;font-weight:600;font-size:28px;line-height:1.25;margin:0 0 16px}\nsection{background:#FFFFFF;border:1px solid #D9D2C3;border-radius:6px;padding:24px;margin-bottom:24px}\n@media (max-width:480px){section{padding:16px}}\nlabel,legend{display:block;font-weight:500;margin-bottom:4px}\n.field{margin-bottom:16px}\ninput[type=text],select{width:100%;font:inherit;color:#1F3A4D;background:#FFFFFF;border:1px solid #D9D2C3;border-radius:6px;padding:8px 12px;min-height:40px}\n.row{display:flex;gap:8px;flex-wrap:wrap}\n.row input{flex:1 1 160px;min-width:0}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}\n@media (max-width:520px){.grid{grid-template-columns:1fr}}\nfieldset{border:1px solid #D9D2C3;border-radius:6px;padding:8px 16px 16px;margin:0 0 16px;min-width:0}\nlegend{padding:0 4px}\n.checks{display:flex;flex-wrap:wrap;gap:8px 24px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:400;margin:0}\n.checks input{width:18px;height:18px;margin:0;accent-color:#1F3A4D}\n.hint{color:#5B6B75;font-size:14px;margin:4px 0 0}\nbutton{font:inherit;font-weight:500;border-radius:6px;cursor:pointer;min-height:40px;padding:8px 16px;transition:background-color .15s,border-color .15s}\n.primary{background:#C2462B;color:#FFFFFF;border:1px solid #C2462B}\n.secondary{background:#FFFFFF;color:#1F3A4D;border:1px solid #D9D2C3}\n.secondary:hover{border-color:#1F3A4D}\n:focus-visible{outline:2px solid #1F3A4D;outline-offset:2px}\n.error{color:#1F3A4D;font-weight:500;margin:8px 0 0;border-left:3px solid #1F3A4D;padding-left:8px}\nul{list-style:none;margin:0;padding:0}\n.people li{display:inline-block;border:1px solid #D9D2C3;border-radius:6px;padding:4px 12px;margin:0 8px 8px 0}\n.list li{border-top:1px solid #D9D2C3;padding:16px 0;display:flex;gap:16px;justify-content:space-between;align-items:flex-start}\n.list li:first-child{border-top:0;padding-top:0}\n.list li:last-child{padding-bottom:0}\n.grow{flex:1;min-width:0;overflow-wrap:anywhere}\n.meta{color:#5B6B75;font-size:14px;margin:4px 0 0}\n.money{font-variant-numeric:tabular-nums;white-space:nowrap}\n.pos{color:#2F6B4F}\n.label{font-size:14px;color:#5B6B75;display:block;text-align:right}\n.list li.bal,.list li.tr{align-items:center}\n.empty{color:#5B6B75;margin:0}\nh3{font-family:Fraunces,serif;font-weight:600;font-size:20px;margin:24px 0 8px}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n<header>\n<h1 class=\"wordmark\">Even Keel</h1>\n<p class=\"tagline\">Split trip costs fairly and see who owes whom.</p>\n</header>\n\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People</h2>\n<form id=\"person-form\" novalidate>\n<label for=\"person-name\">Name</label>\n<div class=\"row\">\n<input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" aria-describedby=\"person-error\">\n<button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n</div>\n<div id=\"person-error\" aria-live=\"polite\"></div>\n</form>\n<div id=\"people-out\" style=\"margin-top:16px\"></div>\n</section>\n\n<section aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Expenses</h2>\n<form id=\"expense-form\" novalidate>\n<div class=\"grid\">\n<div class=\"field\"><label for=\"expense-desc\">Description</label>\n<input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"field\"><label for=\"expense-amount\">Amount (CAD)</label>\n<input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\"></div>\n</div>\n<div class=\"field\"><label for=\"expense-payer\">Paid by</label>\n<select id=\"expense-payer\" data-testid=\"expense-payer\"></select></div>\n<fieldset><legend>Split between</legend>\n<div class=\"checks\" id=\"expense-split\" data-testid=\"expense-split\"></div>\n</fieldset>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n<div id=\"expense-error\" aria-live=\"polite\"></div>\n</form>\n<div id=\"expenses-out\" style=\"margin-top:24px\"></div>\n</section>\n\n<section aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<div id=\"balances-out\"></div>\n<h3>Settle up</h3>\n<div id=\"settle-out\"></div>\n</section>\n</main>\n\n<script>\n(function(){\nvar KEY='even-keel-v1';\nvar fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nvar state={people:[],expenses:[],nextId:1};\ntry{var s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=s;if(!state.nextId)state.nextId=1;}catch(e){}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(state));}catch(e){}}\nfunction money(c){return fmt.format(c/100);}\nfunction el(t,a,txt){var e=document.createElement(t);if(a)for(var k in a){if(k==='class')e.className=a[k];else e.setAttribute(k,a[k]);}if(txt!=null)e.textContent=txt;return e;}\nvar $=function(id){return document.getElementById(id);};\n\nfunction showError(box,input,msg){\n  box.innerHTML='';\n  if(input)input.removeAttribute('aria-invalid');\n  if(!msg)return;\n  var p=el('p',{'class':'error','data-testid':'form-error',role:'alert'},msg);\n  box.appendChild(p);\n  if(input){input.setAttribute('aria-invalid','true');input.focus();}\n}\n\nfunction shares(exp){\n  var order=state.people.filter(function(p){return exp.split.indexOf(p)>=0;});\n  var n=order.length,base=Math.floor(exp.cents/n),rem=exp.cents-base*n,r={};\n  order.forEach(function(p,i){r[p]=base+(i<rem?1:0);});\n  return r;\n}\nfunction balances(){\n  var b={};state.people.forEach(function(p){b[p]=0;});\n  state.expenses.forEach(function(e){\n    if(b[e.payer]!==undefined)b[e.payer]+=e.cents;\n    var s=shares(e);for(var p in s)if(b[p]!==undefined)b[p]-=s[p];\n  });\n  return b;\n}\nfunction settle(b){\n  var cred=[],deb=[];\n  state.people.forEach(function(p){if(b[p]>0)cred.push({p:p,c:b[p]});else if(b[p]<0)deb.push({p:p,c:-b[p]});});\n  var out=[],i=0,j=0;\n  while(i<deb.length&&j<cred.length){\n    var m=Math.min(deb[i].c,cred[j].c);\n    out.push({from:deb[i].p,to:cred[j].p,c:m});\n    deb[i].c-=m;cred[j].c-=m;\n    if(!deb[i].c)i++;if(!cred[j].c)j++;\n  }\n  return out;\n}\n\nfunction renderForm(){\n  var payer=$('expense-payer'),prev=payer.value;\n  payer.innerHTML='';\n  var splitBox=$('expense-split');\n  var checked={};var had=splitBox.querySelectorAll('input').length>0;\n  splitBox.querySelectorAll('input').forEach(function(c){checked[c.value]=c.checked;});\n  splitBox.innerHTML='';\n  if(!state.people.length){\n    payer.appendChild(el('option',{value:''},'Add people first'));\n    splitBox.appendChild(el('p',{'class':'empty'},'Add people above to choose who shares each expense.'));\n  }\n  state.people.forEach(function(p,i){\n    payer.appendChild(el('option',{value:p},p));\n    var id='split-'+i,lab=el('label',{'for':id});\n    var cb=el('input',{type:'checkbox',id:id,value:p});\n    cb.checked=had&&p in checked?checked[p]:true;\n    lab.appendChild(cb);lab.appendChild(document.createTextNode(p));\n    splitBox.appendChild(lab);\n  });\n  if(state.people.indexOf(prev)>=0)payer.value=prev;\n}\n\nfunction render(){\n  var po=$('people-out');po.innerHTML='';\n  if(!state.people.length)po.appendChild(el('p',{'class':'empty'},'Add the first person on your trip to get started.'));\n  else{var ul=el('ul',{'class':'people','aria-label':'People on this trip'});\n    state.people.forEach(function(p){ul.appendChild(el('li',{'data-testid':'person'},p));});po.appendChild(ul);}\n\n  var eo=$('expenses-out');eo.innerHTML='';\n  if(!state.expenses.length)eo.appendChild(el('p',{'class':'empty'},state.people.length?'Add an expense above when someone pays for something.':'Once you add people, log what each person paid.'));\n  else{var ul2=el('ul',{'class':'list','aria-label':'Expenses, newest first'});\n    state.expenses.slice().reverse().forEach(function(e){\n      var li=el('li',{'data-testid':'expense'});\n      var d=el('div',{'class':'grow'});\n      d.appendChild(el('div',{style:'font-weight:500'},e.desc));\n      var splitNames=state.people.filter(function(p){return e.split.indexOf(p)>=0;});\n      d.appendChild(el('p',{'class':'meta'},'Paid by '+e.payer+' · Split between '+splitNames.join(', ')));\n      li.appendChild(d);\n      li.appendChild(el('span',{'class':'money',style:'font-weight:500'},money(e.cents)));\n      var btn=el('button',{type:'button','class':'secondary','data-testid':'delete-expense','aria-label':'Remove '+e.desc+', '+money(e.cents)},'Remove');\n      btn.addEventListener('click',function(){\n        state.expenses=state.expenses.filter(function(x){return x.id!==e.id;});save();render();\n        var b=document.querySelector('[data-testid=delete-expense]');(b||$('expense-desc')).focus();\n      });\n      li.appendChild(btn);ul2.appendChild(li);\n    });eo.appendChild(ul2);}\n\n  var b=balances(),bo=$('balances-out');bo.innerHTML='';\n  if(!state.people.length)bo.appendChild(el('p',{'class':'empty'},'Add people and expenses to see balances.'));\n  else{var ul3=el('ul',{'class':'list'});\n    state.people.forEach(function(p){\n      var c=b[p];\n      var li=el('li',{'class':'bal','data-testid':'balance','data-person':p,'data-cents':String(c)});\n      li.appendChild(el('span',{'class':'grow'},p));\n      var r=el('div');\n      var amt=el('span',{'class':'money'+(c>0?' pos':''),style:'display:block;text-align:right;font-weight:500'},c<0?'−'+money(-c):money(c));\n      r.appendChild(amt);\n      r.appendChild(el('span',{'class':'label'},c>0?'is owed':c<0?'owes':'is even'));\n      li.appendChild(r);ul3.appendChild(li);\n    });bo.appendChild(ul3);}\n\n  var so=$('settle-out');so.innerHTML='';\n  var t=settle(b);\n  if(!t.length)so.appendChild(el('p',{'class':'empty'},state.expenses.length?'Everyone is even. You have nothing to settle.':'Add expenses to see who should pay whom.'));\n  else{var ul4=el('ul',{'class':'list'});\n    t.forEach(function(x){\n      var li=el('li',{'class':'tr','data-testid':'transfer','data-from':x.from,'data-to':x.to,'data-cents':String(x.c)});\n      li.appendChild(el('span',{'class':'grow'},x.from+' pays '+x.to));\n      li.appendChild(el('span',{'class':'money',style:'font-weight:500'},money(x.c)));\n      ul4.appendChild(li);\n    });so.appendChild(ul4);}\n\n  renderForm();\n}\n\n$('person-form').addEventListener('submit',function(ev){\n  ev.preventDefault();\n  var inp=$('person-name'),box=$('person-error'),name=inp.value.trim();\n  if(!name)return showError(box,inp,'Enter a name.');\n  if(name.length>60)return showError(box,inp,'Enter a name of 60 characters or fewer.');\n  var low=name.toLowerCase();\n  if(state.people.some(function(p){return p.toLowerCase()===low;}))return showError(box,inp,name+' is already on the trip. Enter a different name.');\n  state.people.push(name);save();showError(box,inp,'');inp.value='';render();inp.focus();\n});\n\n$('expense-form').addEventListener('submit',function(ev){\n  ev.preventDefault();\n  var box=$('expense-error'),d=$('expense-desc'),a=$('expense-amount'),py=$('expense-payer');\n  if(!state.people.length)return showError(box,$('person-name'),'Add at least one person before adding an expense.');\n  var desc=d.value.trim();\n  if(!desc)return showError(box,d,'Enter a description.');\n  var raw=a.value.trim().replace(/^\\$/,'').replace(/,/g,'');\n  if(!raw)return showError(box,a,'Enter an amount.');\n  if(!/^\\d*(\\.\\d*)?$/.test(raw)||raw==='.')return showError(box,a,'Enter the amount as a number, for example 24.50.');\n  var parts=raw.split('.');\n  if(parts[1]&&parts[1].length>2)return showError(box,a,'Enter an amount with at most 2 decimal places.');\n  var cents=parseInt(parts[0]||'0',10)*100+parseInt(((parts[1]||'')+'00').slice(0,2),10);\n  if(!(cents>0))return showError(box,a,'Enter an amount greater than $0.');\n  if(cents>100000000000)return showError(box,a,'Enter a smaller amount.');\n  if(state.people.indexOf(py.value)<0)return showError(box,py,'Choose who paid.');\n  var split=[];$('expense-split').querySelectorAll('input:checked').forEach(function(c){split.push(c.value);});\n  if(!split.length)return showError(box,$('expense-split').querySelector('input'),'Choose at least one person to split with.');\n  state.expenses.push({id:state.nextId++,desc:desc,cents:cents,payer:py.value,split:split});\n  save();showError(box,null,'');d.removeAttribute('aria-invalid');a.removeAttribute('aria-invalid');\n  d.value='';a.value='';\n  $('expense-split').querySelectorAll('input').forEach(function(c){c.checked=true;});\n  render();d.focus();\n});\n\nrender();\n})();\n</script>\n</body>\n</html>"

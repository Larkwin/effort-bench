    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n*{box-sizing:border-box}\nhtml{font-size:16px}\nbody{margin:0;background:#F6F3EC;color:#1F3A4D;font-family:'IBM Plex Sans',sans-serif;font-size:16px;line-height:1.5}\nmain{max-width:720px;margin:0 auto;padding:32px 16px 48px}\n@media(min-width:600px){main{padding-left:24px;padding-right:24px}}\nh1,h2{font-family:'Fraunces',serif;font-weight:600;margin:0;color:#1F3A4D}\nh1{font-size:28px;display:flex;align-items:center;gap:12px;line-height:1.2}\nh1::before{content:\"\";width:24px;height:3px;background:#C2462B;flex:none}\nh2{font-size:20px;margin-bottom:16px}\n.tag{color:#5B6B75;margin:8px 0 32px;font-size:16px}\nsection{background:#fff;border:1px solid #D9D2C3;border-radius:6px;padding:24px 16px;margin-bottom:24px}\n@media(min-width:600px){section{padding:24px}}\nlabel,legend{display:block;font-weight:500;margin-bottom:4px;font-size:16px;padding:0}\ninput[type=text],input[type=number],select{width:100%;font:inherit;color:#1F3A4D;background:#fff;border:1px solid #5B6B75;border-radius:6px;padding:8px 12px;min-height:44px}\n:focus-visible{outline:2px solid #1F3A4D;outline-offset:2px}\nbutton{font:inherit;font-weight:500;border-radius:6px;min-height:44px;padding:8px 16px;cursor:pointer;transition:background-color .15s}\n.primary{background:#C2462B;color:#fff;border:1px solid #C2462B}\n.primary:hover{background:#A93A22;border-color:#A93A22}\n.ghost{background:#fff;color:#1F3A4D;border:1px solid #D9D2C3;min-height:36px;padding:4px 12px;font-size:14px}\n.ghost:hover{border-color:#1F3A4D}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row>div{flex:1 1 200px}\n.field{margin-bottom:16px}\n.err{color:#1F3A4D;font-weight:500;font-size:14px;margin:8px 0 0;padding:8px 12px;border:1px solid #1F3A4D;border-radius:6px;background:#fff}\n.err[hidden]{display:none}\n.hint,.empty,.meta{color:#5B6B75;font-size:14px}\n.empty{margin:0}\nul{list-style:none;margin:0;padding:0}\nli{border-top:1px solid #D9D2C3;padding:12px 0;display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}\nli:first-child{border-top:0}\n.money{font-variant-numeric:tabular-nums;font-weight:500}\n.pos{color:#2F6B4F}\n.grow{flex:1 1 200px;min-width:0;overflow-wrap:anywhere}\nfieldset{border:0;margin:0 0 16px;padding:0}\n.checks{display:flex;flex-wrap:wrap;gap:8px 16px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:400;margin:0;min-height:32px}\n.checks input{width:20px;height:20px;accent-color:#1F3A4D}\n.sub{font-size:14px;color:#5B6B75;margin:0 0 16px}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n<header>\n<h1>Even Keel</h1>\n<p class=\"tag\">Split trip costs and settle up fairly.</p>\n</header>\n\n<section aria-labelledby=\"h-people\">\n<h2 id=\"h-people\">People</h2>\n<form id=\"pform\" novalidate>\n<div class=\"row\">\n<div><label for=\"pname\">Name</label><input type=\"text\" id=\"pname\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n</div>\n<p class=\"err\" id=\"perr\" data-testid=\"form-error\" role=\"alert\" hidden></p>\n</form>\n<ul id=\"plist\" style=\"margin-top:16px\"></ul>\n<p class=\"empty\" id=\"pempty\">Add the first person on your trip.</p>\n</section>\n\n<section aria-labelledby=\"h-exp\">\n<h2 id=\"h-exp\">Add expense</h2>\n<p class=\"empty\" id=\"eform-empty\">Add at least one person before you log an expense.</p>\n<form id=\"eform\" novalidate>\n<div class=\"field\"><label for=\"desc\">Description</label><input type=\"text\" id=\"desc\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"row field\">\n<div><label for=\"amt\">Amount (CAD)</label><input type=\"text\" inputmode=\"decimal\" id=\"amt\" data-testid=\"expense-amount\" autocomplete=\"off\"></div>\n<div><label for=\"payer\">Paid by</label><select id=\"payer\" data-testid=\"expense-payer\"></select></div>\n</div>\n<fieldset><legend>Split between</legend><div class=\"checks\" id=\"split\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"eerr\" data-testid=\"form-error\" role=\"alert\" hidden></p>\n</form>\n</section>\n\n<section aria-labelledby=\"h-list\">\n<h2 id=\"h-list\">Expenses</h2>\n<ul id=\"elist\"></ul>\n<p class=\"empty\" id=\"eempty\">Expenses you add will appear here.</p>\n</section>\n\n<section aria-labelledby=\"h-bal\">\n<h2 id=\"h-bal\">Balances</h2>\n<ul id=\"blist\"></ul>\n<p class=\"empty\" id=\"bempty\">Balances show up once you add people.</p>\n</section>\n\n<section aria-labelledby=\"h-set\">\n<h2 id=\"h-set\">Settle up</h2>\n<ul id=\"tlist\"></ul>\n<p class=\"empty\" id=\"tempty\"></p>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst money=c=>fmt.format(c/100);\nconst KEY='evenkeel-v1';\nlet state={people:[],expenses:[]};\ntry{const s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.people)&&Array.isArray(s.expenses))state=s}catch(e){}\nconst save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};\nconst $=id=>document.getElementById(id);\nfunction el(t,props,...kids){const e=document.createElement(t);for(const k in props||{}){if(k==='text')e.textContent=props[k];else if(k==='class')e.className=props[k];else e.setAttribute(k,props[k])}kids.forEach(k=>e.append(k));return e}\nfunction showErr(id,msg){const e=$(id);e.textContent=msg;e.hidden=false}\nfunction hideErr(id){$(id).hidden=true}\n\nfunction shares(e){\n  const order=state.people.filter(p=>e.split.includes(p));\n  const n=order.length,base=Math.floor(e.cents/n),rem=e.cents-base*n;\n  const out={};order.forEach((p,i)=>out[p]=base+(i<rem?1:0));return out;\n}\nfunction balances(){\n  const b={};state.people.forEach(p=>b[p]=0);\n  state.expenses.forEach(e=>{\n    if(b[e.payer]!==undefined)b[e.payer]+=e.cents;\n    const s=shares(e);for(const p in s)b[p]-=s[p];\n  });return b;\n}\nfunction transfers(b){\n  const cr=[],db=[];\n  state.people.forEach(p=>{if(b[p]>0)cr.push({p,c:b[p]});else if(b[p]<0)db.push({p,c:-b[p]})});\n  const out=[];\n  while(cr.length&&db.length){\n    cr.sort((a,b)=>b.c-a.c);db.sort((a,b)=>b.c-a.c);\n    const c=cr[0],d=db[0],m=Math.min(c.c,d.c);\n    out.push({from:d.p,to:c.p,c:m});c.c-=m;d.c-=m;\n    if(!c.c)cr.shift();if(!d.c)db.shift();\n  }\n  return out;\n}\n\nfunction render(){\n  const P=state.people;\n  const pl=$('plist');pl.textContent='';\n  P.forEach(p=>pl.append(el('li',{'data-testid':'person'},el('span',{class:'grow',text:p}))));\n  $('pempty').hidden=P.length>0;\n\n  // form\n  $('eform').hidden=!P.length;$('eform-empty').hidden=P.length>0;\n  const payer=$('payer'),prev=payer.value;\n  payer.textContent='';\n  P.forEach(p=>{const o=el('option',{value:p,text:p});payer.append(o)});\n  if(P.includes(prev))payer.value=prev;\n  const sp=$('split');\n  const checked=new Set([...sp.querySelectorAll('input:checked')].map(i=>i.value));\n  const known=new Set([...sp.querySelectorAll('input')].map(i=>i.value));\n  sp.textContent='';\n  P.forEach((p,i)=>{\n    const cb=el('input',{type:'checkbox',value:p,id:'sp'+i});\n    cb.checked=known.has(p)?checked.has(p):true;\n    sp.append(el('label',{for:'sp'+i},cb,el('span',{text:p})));\n  });\n\n  // expenses\n  const el_=$('elist');el_.textContent='';\n  [...state.expenses].reverse().forEach(e=>{\n    const del=el('button',{type:'button',class:'ghost','data-testid':'delete-expense','aria-label':'Remove '+e.desc,text:'Remove'});\n    del.onclick=()=>{state.expenses=state.expenses.filter(x=>x.id!==e.id);save();render()};\n    el_.append(el('li',{'data-testid':'expense'},\n      el('div',{class:'grow'},\n        el('div',{text:e.desc,style:'font-weight:500'}),\n        el('div',{class:'meta',text:'Paid by '+e.payer+' · Split between '+e.split.join(', ')})),\n      el('span',{class:'money',text:money(e.cents)}),del));\n  });\n  $('eempty').hidden=state.expenses.length>0;\n\n  // balances\n  const b=balances();\n  const bl=$('blist');bl.textContent='';\n  P.forEach(p=>{\n    const c=b[p];\n    const txt=c>0?money(c)+' is owed':c<0?'−'+money(-c)+' owes':money(0)+' even';\n    bl.append(el('li',{'data-testid':'balance','data-person':p,'data-cents':c},\n      el('span',{class:'grow',text:p}),\n      el('span',{class:'money'+(c>0?' pos':''),text:txt})));\n  });\n  $('bempty').hidden=P.length>0;\n\n  const t=transfers(b),tl=$('tlist');tl.textContent='';\n  t.forEach(x=>tl.append(el('li',{'data-testid':'transfer','data-from':x.from,'data-to':x.to,'data-cents':x.c},\n    el('span',{class:'grow',text:x.from+' pays '+x.to}),\n    el('span',{class:'money',text:money(x.c)}))));\n  const te=$('tempty');\n  te.hidden=t.length>0;\n  te.textContent=!P.length?'Add people and expenses to see who pays whom.':!state.expenses.length?'Log an expense to see who pays whom.':'Everyone is even. Nobody needs to pay anyone.';\n}\n\n$('pform').addEventListener('submit',ev=>{\n  ev.preventDefault();\n  const name=$('pname').value.trim();\n  if(!name)return showErr('perr','Enter a name.');\n  if(state.people.some(p=>p.toLowerCase()===name.toLowerCase()))return showErr('perr',name+' is already on the trip. Enter a different name.');\n  hideErr('perr');state.people.push(name);save();$('pname').value='';render();$('pname').focus();\n});\n\n$('eform').addEventListener('submit',ev=>{\n  ev.preventDefault();\n  const desc=$('desc').value.trim(),raw=$('amt').value.trim();\n  const split=[...$('split').querySelectorAll('input:checked')].map(i=>i.value);\n  if(!desc)return showErr('eerr','Enter a description.');\n  if(!/^\\d*\\.?\\d*$/.test(raw.replace(/^\\$/,''))||raw.replace(/^\\$/,'')===''||raw.replace(/^\\$/,'')==='.')return showErr('eerr','Enter an amount greater than $0.');\n  const num=raw.replace(/^\\$/,'');\n  const parts=num.split('.');\n  if(parts[1]&&parts[1].length>2)return showErr('eerr','Use at most 2 decimal places in the amount.');\n  const cents=parseInt(parts[0]||'0',10)*100+parseInt((parts[1]||'').padEnd(2,'0')||'0',10);\n  if(!(cents>0))return showErr('eerr','Enter an amount greater than $0.');\n  if(!Number.isSafeInteger(cents))return showErr('eerr','Enter a smaller amount.');\n  const payer=$('payer').value;\n  if(!payer)return showErr('eerr','Choose who paid.');\n  if(!split.length)return showErr('eerr','Choose at least one person to split between.');\n  hideErr('eerr');\n  state.expenses.push({id:Date.now()+Math.random(),desc,cents,payer,split:state.people.filter(p=>split.includes(p))});\n  save();$('desc').value='';$('amt').value='';\n  $('split').querySelectorAll('input').forEach(i=>i.checked=true);\n  render();$('desc').focus();\n});\nrender();\n</script>\n</body>\n</html>"
    }

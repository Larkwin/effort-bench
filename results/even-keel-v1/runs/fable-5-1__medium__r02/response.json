      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --harbour: #1F3A4D;\n    --fog: #5B6B75;\n    --sailcloth: #F6F3EC;\n    --paper: #FFFFFF;\n    --rope: #D9D2C3;\n    --signal: #C2462B;\n    --kelp: #2F6B4F;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    background: var(--sailcloth);\n    color: var(--harbour);\n    font-family: \"IBM Plex Sans\", system-ui, sans-serif;\n    font-size: 16px;\n    line-height: 1.5;\n    -webkit-text-size-adjust: 100%;\n  }\n  main {\n    max-width: 720px;\n    margin: 0 auto;\n    padding: 32px 24px 48px;\n  }\n  @media (max-width: 480px) {\n    main { padding: 24px 16px 40px; }\n  }\n  h1, h2 {\n    font-family: \"Fraunces\", Georgia, serif;\n    font-weight: 600;\n    margin: 0;\n    line-height: 1.2;\n  }\n  h1 { font-size: 28px; display: flex; align-items: center; gap: 12px; }\n  h1 .rule { display: inline-block; width: 24px; height: 3px; background: var(--signal); flex: none; }\n  h2 { font-size: 20px; margin-bottom: 16px; }\n  .tagline { margin: 4px 0 0 36px; color: var(--fog); font-size: 16px; }\n  header { margin-bottom: 32px; }\n  section.panel {\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 24px;\n    margin-bottom: 24px;\n  }\n  @media (max-width: 480px) {\n    section.panel { padding: 16px; }\n  }\n  label, legend {\n    display: block;\n    font-weight: 500;\n    font-size: 14px;\n    margin-bottom: 4px;\n  }\n  .hint { color: var(--fog); font-size: 14px; margin: 4px 0 0; }\n  input[type=\"text\"], select {\n    width: 100%;\n    font: inherit;\n    color: var(--harbour);\n    background: var(--paper);\n    border: 1px solid var(--rope);\n    border-radius: 6px;\n    padding: 8px 12px;\n    min-height: 44px;\n    transition: border-color 150ms;\n  }\n  input[type=\"text\"]:hover, select:hover { border-color: var(--harbour); }\n  :focus-visible { outline: 2px solid var(--harbour); outline-offset: 2px; }\n  button {\n    font: inherit;\n    font-weight: 500;\n    border-radius: 6px;\n    padding: 8px 16px;\n    min-height: 44px;\n    cursor: pointer;\n    transition: border-color 150ms;\n  }\n  .primary {\n    background: var(--signal);\n    color: var(--paper);\n    border: 1px solid var(--signal);\n  }\n  .secondary {\n    background: var(--paper);\n    color: var(--harbour);\n    border: 1px solid var(--rope);\n    min-height: 36px;\n    padding: 4px 12px;\n    font-size: 14px;\n  }\n  .secondary:hover { border-color: var(--harbour); }\n  .row { display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap; }\n  .row .field { flex: 1 1 200px; }\n  .field { margin-bottom: 16px; }\n  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n  @media (max-width: 480px) { .two { grid-template-columns: 1fr; gap: 0; } }\n  fieldset { border: 0; padding: 0; margin: 0 0 16px; }\n  .checks { display: flex; flex-wrap: wrap; gap: 8px 16px; }\n  .checks label {\n    display: inline-flex; align-items: center; gap: 8px;\n    font-weight: 400; font-size: 16px; margin: 0; min-height: 32px;\n  }\n  input[type=\"checkbox\"] { width: 20px; height: 20px; accent-color: var(--harbour); margin: 0; }\n  .error {\n    margin: 0 0 16px;\n    padding: 8px 12px;\n    border: 1px solid var(--harbour);\n    border-radius: 6px;\n    font-size: 14px;\n  }\n  ul { list-style: none; margin: 0; padding: 0; }\n  li { padding: 12px 0; border-top: 1px solid var(--rope); }\n  li:first-child { border-top: 0; padding-top: 0; }\n  li:last-child { padding-bottom: 0; }\n  .people li { display: flex; align-items: center; padding: 8px 0; }\n  .empty { color: var(--fog); margin: 0; }\n  .money { font-variant-numeric: tabular-nums; }\n  .exp-head { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }\n  .exp-desc { font-weight: 500; overflow-wrap: anywhere; }\n  .meta { color: var(--fog); font-size: 14px; margin: 4px 0 8px; overflow-wrap: anywhere; }\n  .bal { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; flex-wrap: wrap; }\n  .bal .name { overflow-wrap: anywhere; }\n  .bal .status { color: var(--fog); font-size: 14px; margin-left: 8px; }\n  .pos { color: var(--kelp); }\n  .neg, .zero { color: var(--harbour); }\n  .transfer { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }\n  .sr-only {\n    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;\n  }\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n  <header>\n    <h1><span class=\"rule\" aria-hidden=\"true\"></span>Even Keel</h1>\n    <p class=\"tagline\">Split trip costs so everyone ends up even.</p>\n  </header>\n\n  <section class=\"panel\" aria-labelledby=\"people-heading\">\n    <h2 id=\"people-heading\">People</h2>\n    <form id=\"person-form\" novalidate>\n      <div class=\"row\">\n        <div class=\"field\">\n          <label for=\"person-name\">Name</label>\n          <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\" maxlength=\"60\">\n        </div>\n        <div class=\"field\">\n          <button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button>\n        </div>\n      </div>\n      <div id=\"person-error\" aria-live=\"polite\"></div>\n    </form>\n    <ul id=\"people-list\" class=\"people\" aria-label=\"People on the trip\"></ul>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"expenses-heading\">\n    <h2 id=\"expenses-heading\">Expenses</h2>\n    <form id=\"expense-form\" novalidate>\n      <div class=\"field\">\n        <label for=\"expense-desc\">Description</label>\n        <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\" maxlength=\"120\">\n      </div>\n      <div class=\"two\">\n        <div class=\"field\">\n          <label for=\"expense-amount\">Amount (CAD)</label>\n          <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\">\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-payer\">Paid by</label>\n          <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n        </div>\n      </div>\n      <fieldset>\n        <legend>Split between</legend>\n        <div id=\"expense-split\" class=\"checks\" data-testid=\"expense-split\"></div>\n        <p id=\"split-hint\" class=\"hint\" hidden>Add people above and they will appear here.</p>\n      </fieldset>\n      <div id=\"expense-error\" aria-live=\"polite\"></div>\n      <button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n    </form>\n    <ul id=\"expense-list\" aria-label=\"Expenses\" style=\"margin-top:24px\"></ul>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"balances-heading\">\n    <h2 id=\"balances-heading\">Balances</h2>\n    <ul id=\"balance-list\" aria-label=\"Balances\"></ul>\n  </section>\n\n  <section class=\"panel\" aria-labelledby=\"settle-heading\">\n    <h2 id=\"settle-heading\">Settle up</h2>\n    <ul id=\"transfer-list\" aria-label=\"Transfers\"></ul>\n  </section>\n</main>\n\n<script>\n(function () {\n  'use strict';\n  var STORAGE_KEY = 'even-keel-trip';\n  var fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  function money(cents) { return fmt.format(cents / 100); }\n\n  var state = load();\n\n  function load() {\n    var fallback = { people: [], expenses: [], nextId: 1 };\n    try {\n      var raw = localStorage.getItem(STORAGE_KEY);\n      if (!raw) return fallback;\n      var data = JSON.parse(raw);\n      if (!data || !Array.isArray(data.people) || !Array.isArray(data.expenses)) return fallback;\n      data.people = data.people.filter(function (p) { return typeof p === 'string'; });\n      data.expenses = data.expenses.filter(function (e) {\n        return e && typeof e.desc === 'string' && Number.isInteger(e.cents) &&\n          typeof e.payer === 'string' && Array.isArray(e.split);\n      });\n      data.nextId = Number.isInteger(data.nextId) ? data.nextId : data.expenses.length + 1;\n      return data;\n    } catch (err) {\n      return fallback;\n    }\n  }\n  function save() {\n    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (err) { /* storage unavailable */ }\n  }\n\n  function el(tag, attrs, children) {\n    var node = document.createElement(tag);\n    if (attrs) Object.keys(attrs).forEach(function (k) {\n      if (k === 'text') node.textContent = attrs[k];\n      else if (k === 'class') node.className = attrs[k];\n      else node.setAttribute(k, attrs[k]);\n    });\n    (children || []).forEach(function (c) { node.appendChild(c); });\n    return node;\n  }\n  function $(id) { return document.getElementById(id); }\n\n  function showError(containerId, msg) {\n    var c = $(containerId);\n    c.textContent = '';\n    if (msg) c.appendChild(el('p', { class: 'error', 'data-testid': 'form-error', role: 'alert', text: msg }));\n  }\n\n  function listPeople(names) {\n    if (names.length <= 2) return names.join(' and ');\n    return names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];\n  }\n\n  // Shares in cents, keyed by name; leftover cents go to earliest-added people.\n  function shares(expense) {\n    var order = state.people.filter(function (p) { return expense.split.indexOf(p) !== -1; });\n    var n = order.length;\n    var out = {};\n    if (n === 0) return out;\n    var base = Math.floor(expense.cents / n);\n    var rem = expense.cents % n;\n    order.forEach(function (p, i) { out[p] = base + (i < rem ? 1 : 0); });\n    return out;\n  }\n\n  function balances() {\n    var bal = {};\n    state.people.forEach(function (p) { bal[p] = 0; });\n    state.expenses.forEach(function (e) {\n      if (bal.hasOwnProperty(e.payer)) bal[e.payer] += e.cents;\n      var s = shares(e);\n      Object.keys(s).forEach(function (p) { bal[p] -= s[p]; });\n    });\n    return bal;\n  }\n\n  function transfers(bal) {\n    var creditors = [], debtors = [];\n    state.people.forEach(function (p) {\n      if (bal[p] > 0) creditors.push({ name: p, cents: bal[p] });\n      else if (bal[p] < 0) debtors.push({ name: p, cents: -bal[p] });\n    });\n    creditors.sort(function (a, b) { return b.cents - a.cents; });\n    debtors.sort(function (a, b) { return b.cents - a.cents; });\n    var out = [], i = 0, j = 0;\n    while (i < debtors.length && j < creditors.length) {\n      var amt = Math.min(debtors[i].cents, creditors[j].cents);\n      out.push({ from: debtors[i].name, to: creditors[j].name, cents: amt });\n      debtors[i].cents -= amt;\n      creditors[j].cents -= amt;\n      if (debtors[i].cents === 0) i++;\n      if (creditors[j].cents === 0) j++;\n    }\n    return out;\n  }\n\n  function renderPeople() {\n    var ul = $('people-list');\n    ul.textContent = '';\n    if (state.people.length === 0) {\n      ul.appendChild(el('li', {}, [el('p', { class: 'empty', text: 'Add everyone on the trip to get started.' })]));\n      return;\n    }\n    state.people.forEach(function (p) {\n      ul.appendChild(el('li', { 'data-testid': 'person', text: p }));\n    });\n  }\n\n  function renderExpenseForm(newPerson) {\n    var select = $('expense-payer');\n    var prev = select.value;\n    select.textContent = '';\n    if (state.people.length === 0) {\n      select.appendChild(el('option', { value: '', text: 'Add a person first' }));\n      select.disabled = true;\n    } else {\n      select.disabled = false;\n      state.people.forEach(function (p) { select.appendChild(el('option', { value: p, text: p })); });\n      select.value = state.people.indexOf(prev) !== -1 ? prev : state.people[0];\n    }\n    var split = $('expense-split');\n    var checked = {};\n    Array.prototype.forEach.call(split.querySelectorAll('input'), function (cb) { checked[cb.value] = cb.checked; });\n    split.textContent = '';\n    state.people.forEach(function (p, i) {\n      var cb = el('input', { type: 'checkbox', value: p, id: 'split-' + i });\n      cb.checked = checked.hasOwnProperty(p) ? checked[p] : true;\n      if (p === newPerson) cb.checked = true;\n      split.appendChild(el('label', { for: 'split-' + i }, [cb, document.createTextNode(p)]));\n    });\n    $('split-hint').hidden = state.people.length > 0;\n  }\n\n  function renderExpenses() {\n    var ul = $('expense-list');\n    ul.textContent = '';\n    if (state.expenses.length === 0) {\n      ul.appendChild(el('li', {}, [el('p', { class: 'empty', text: state.people.length ? 'Log the first thing someone paid for.' : 'Add people first, then log what they paid for.' })]));\n      return;\n    }\n    state.expenses.slice().reverse().forEach(function (e) {\n      var order = state.people.filter(function (p) { return e.split.indexOf(p) !== -1; });\n      var btn = el('button', { type: 'button', class: 'secondary', 'data-testid': 'delete-expense', 'aria-label': 'Remove ' + e.desc, text: 'Remove' });\n      btn.addEventListener('click', function () { removeExpense(e.id); });\n      ul.appendChild(el('li', { 'data-testid': 'expense' }, [\n        el('div', { class: 'exp-head' }, [\n          el('span', { class: 'exp-desc', text: e.desc }),\n          el('span', { class: 'money', text: money(e.cents) })\n        ]),\n        el('p', { class: 'meta', text: 'Paid by ' + e.payer + '. Split between ' + listPeople(order) + '.' }),\n        btn\n      ]));\n    });\n  }\n\n  function renderBalances(bal) {\n    var ul = $('balance-list');\n    ul.textContent = '';\n    if (state.people.length === 0) {\n      ul.appendChild(el('li', {}, [el('p', { class: 'empty', text: 'Balances appear here once you add people and expenses.' })]));\n      return;\n    }\n    state.people.forEach(function (p) {\n      var c = bal[p];\n      var cls = c > 0 ? 'pos' : (c < 0 ? 'neg' : 'zero');\n      var status = c > 0 ? 'is owed' : (c < 0 ? 'owes' : 'is even');\n      ul.appendChild(el('li', { 'data-testid': 'balance', 'data-person': p, 'data-cents': String(c) }, [\n        el('div', { class: 'bal' }, [\n          el('span', {}, [el('span', { class: 'name', text: p }), el('span', { class: 'status', text: status })]),\n          el('span', { class: 'money ' + cls, text: money(c) })\n        ])\n      ]));\n    });\n  }\n\n  function renderTransfers(bal) {\n    var ul = $('transfer-list');\n    ul.textContent = '';\n    if (state.people.length === 0 || state.expenses.length === 0) {\n      ul.appendChild(el('li', {}, [el('p', { class: 'empty', text: 'Transfers appear here once there are expenses to settle.' })]));\n      return;\n    }\n    var list = transfers(bal);\n    if (list.length === 0) {\n      ul.appendChild(el('li', {}, [el('p', { class: 'empty', text: 'Everyone is even. Nothing to settle.' })]));\n      return;\n    }\n    list.forEach(function (t) {\n      ul.appendChild(el('li', { 'data-testid': 'transfer', 'data-from': t.from, 'data-to': t.to, 'data-cents': String(t.cents) }, [\n        el('div', { class: 'transfer' }, [\n          el('span', { text: t.from + ' pays ' + t.to }),\n          el('span', { class: 'money', text: money(t.cents) })\n        ])\n      ]));\n    });\n  }\n\n  function renderAll(newPerson) {\n    renderPeople();\n    renderExpenseForm(newPerson);\n    renderExpenses();\n    var bal = balances();\n    renderBalances(bal);\n    renderTransfers(bal);\n  }\n\n  function removeExpense(id) {\n    state.expenses = state.expenses.filter(function (e) { return e.id !== id; });\n    save();\n    renderAll();\n    $('expense-desc').focus();\n  }\n\n  $('person-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var input = $('person-name');\n    var name = input.value.trim();\n    if (!name) { showError('person-error', 'Enter a name.'); input.focus(); return; }\n    var dup = state.people.some(function (p) { return p.toLowerCase() === name.toLowerCase(); });\n    if (dup) { showError('person-error', 'Someone named \"' + name + '\" is already on the trip. Choose a different name.'); input.focus(); return; }\n    showError('person-error', '');\n    state.people.push(name);\n    save();\n    renderAll(name);\n    input.value = '';\n    input.focus();\n  });\n\n  function parseCents(raw) {\n    var s = raw.trim().replace(/^\\$/, '').replace(/,/g, '');\n    if (!s) return { error: 'Enter an amount.' };\n    if (!/^\\d+(\\.\\d{1,2})?$/.test(s)) return { error: 'Enter an amount greater than $0 with at most two decimal places, like 12.50.' };\n    var parts = s.split('.');\n    var cents = parseInt(parts[0], 10) * 100 + parseInt((parts[1] || '').padEnd(2, '0'), 10);\n    if (!(cents > 0)) return { error: 'Enter an amount greater than $0.' };\n    if (!Number.isSafeInteger(cents)) return { error: 'Enter a smaller amount.' };\n    return { cents: cents };\n  }\n\n  $('expense-form').addEventListener('submit', function (ev) {\n    ev.preventDefault();\n    var descInput = $('expense-desc'), amountInput = $('expense-amount'), payerSelect = $('expense-payer');\n    if (state.people.length === 0) { showError('expense-error', 'Add at least one person before adding an expense.'); $('person-name').focus(); return; }\n    var desc = descInput.value.trim();\n    if (!desc) { showError('expense-error', 'Enter a description.'); descInput.focus(); return; }\n    var parsed = parseCents(amountInput.value);\n    if (parsed.error) { showError('expense-error', parsed.error); amountInput.focus(); return; }\n    var payer = payerSelect.value;\n    if (state.people.indexOf(payer) === -1) { showError('expense-error', 'Choose who paid.'); payerSelect.focus(); return; }\n    var checked = Array.prototype.filter.call($('expense-split').querySelectorAll('input'), function (cb) { return cb.checked; })\n      .map(function (cb) { return cb.value; });\n    if (checked.length === 0) {\n      showError('expense-error', 'Choose at least one person to split this between.');\n      var first = $('expense-split').querySelector('input'); if (first) first.focus();\n      return;\n    }\n    showError('expense-error', '');\n    state.expenses.push({ id: state.nextId++, desc: desc, cents: parsed.cents, payer: payer, split: checked });\n    save();\n    descInput.value = '';\n    amountInput.value = '';\n    Array.prototype.forEach.call($('expense-split').querySelectorAll('input'), function (cb) { cb.checked = true; });\n    renderAll();\n    descInput.focus();\n  });\n\n  renderAll();\n})();\n</script>\n</body>\n</html>"

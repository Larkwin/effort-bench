      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0;background:#F6F3EC;color:#1F3A4D;font:400 16px/1.5 'IBM Plex Sans',sans-serif}\nmain{max-width:720px;margin:0 auto;padding:32px 16px 48px}\n@media(min-width:600px){main{padding-left:24px;padding-right:24px}}\nh1,h2{font-family:Fraunces,serif;font-weight:600;margin:0}\nh1{font-size:28px;display:flex;align-items:center;gap:8px}\nh1:before{content:\"\";width:24px;height:3px;background:#C2462B;flex:none}\nh2{font-size:20px;margin-bottom:16px}\n.sub{color:#5B6B75;margin:4px 0 32px;font-size:16px}\nsection{background:#fff;border:1px solid #D9D2C3;border-radius:6px;padding:24px 16px;margin-bottom:24px}\n@media(min-width:600px){section{padding:24px}}\nlabel,legend{display:block;font-weight:500;font-size:14px;margin-bottom:4px;padding:0}\ninput[type=text],input[type=number],select{width:100%;font:inherit;color:#1F3A4D;background:#fff;border:1px solid #D9D2C3;border-radius:6px;padding:8px 12px;min-height:44px}\n.row{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}\n.row>div{flex:1;min-width:160px}\n.field{margin-bottom:16px}\nbutton{font:500 16px 'IBM Plex Sans',sans-serif;border-radius:6px;min-height:44px;padding:8px 16px;cursor:pointer;border:1px solid #D9D2C3;background:#fff;color:#1F3A4D;transition:background-color .15s}\nbutton.primary{background:#C2462B;color:#fff;border-color:#C2462B}\nbutton:hover{background:#F6F3EC}button.primary:hover{background:#C2462B;opacity:1;text-decoration:underline}\n:focus-visible{outline:2px solid #1F3A4D;outline-offset:2px}\nfieldset{border:1px solid #D9D2C3;border-radius:6px;margin:0 0 16px;padding:8px 12px}\n.checks{display:flex;flex-wrap:wrap;gap:4px 16px}\n.checks label{display:flex;align-items:center;gap:8px;font-weight:400;font-size:16px;margin:0;min-height:32px}\n.checks input{width:18px;height:18px;accent-color:#1F3A4D}\nul{list-style:none;margin:0;padding:0}\nli{border-top:1px solid #D9D2C3;padding:12px 0;display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap}\nli:first-child{border-top:0}\n.meta{color:#5B6B75;font-size:14px}\n.money{font-variant-numeric:tabular-nums;font-weight:500}\n.pos{color:#2F6B4F}\n.err{color:#1F3A4D;font-weight:500;font-size:14px;margin:8px 0 0;border-left:3px solid #1F3A4D;padding-left:8px}\n.err:empty{display:none}\n.empty{color:#5B6B75;margin:0}\n.grow{flex:1;min-width:0;overflow-wrap:anywhere}\n</style>\n</head>\n<body>\n<main data-testid=\"app\">\n<h1>Even Keel</h1>\n<p class=\"sub\">Split trip costs and see who owes whom.</p>\n\n<section aria-labelledby=\"hp\">\n<h2 id=\"hp\">People</h2>\n<form id=\"pf\" novalidate>\n<div class=\"row\"><div><label for=\"pn\">Name</label><input type=\"text\" id=\"pn\" data-testid=\"person-name\" autocomplete=\"off\"></div>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-person\">Add person</button></div>\n<p class=\"err\" id=\"pe\" role=\"alert\"></p>\n</form>\n<ul id=\"pl\" style=\"margin-top:16px\"></ul>\n</section>\n\n<section aria-labelledby=\"he\">\n<h2 id=\"he\">Expenses</h2>\n<form id=\"ef\" novalidate>\n<div class=\"field\"><label for=\"ed\">Description</label><input type=\"text\" id=\"ed\" data-testid=\"expense-desc\" autocomplete=\"off\"></div>\n<div class=\"row field\"><div><label for=\"ea\">Amount (CAD)</label><input type=\"text\" inputmode=\"decimal\" id=\"ea\" data-testid=\"expense-amount\" autocomplete=\"off\"></div>\n<div><label for=\"ep\">Paid by</label><select id=\"ep\" data-testid=\"expense-payer\"></select></div></div>\n<fieldset><legend>Split between</legend><div class=\"checks\" id=\"es\" data-testid=\"expense-split\"></div></fieldset>\n<button type=\"submit\" class=\"primary\" data-testid=\"add-expense\">Add expense</button>\n<p class=\"err\" id=\"ee\" role=\"alert\"></p>\n</form>\n<ul id=\"el\" style=\"margin-top:16px\"></ul>\n</section>\n\n<section aria-labelledby=\"hb\">\n<h2 id=\"hb\">Balances</h2>\n<ul id=\"bl\"></ul>\n</section>\n\n<section aria-labelledby=\"hs\">\n<h2 id=\"hs\">Settle up</h2>\n<ul id=\"tl\"></ul>\n</section>\n</main>\n<script>\nconst fmt=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});\nconst $=id=>document.getElementById(id);\nlet S={people:[],expenses:[]};\ntry{const d=JSON.parse(localStorage.getItem('evenkeel'));if(d&&Array.isArray(d.people)&&Array.isArray(d.expenses))S=d}catch(e){}\nlet nid=Math.max(0,...S.expenses.map(e=>e.id||0))+1;\nconst save=()=>{try{localStorage.setItem('evenkeel',JSON.stringify(S))}catch(e){}};\nconst esc=s=>s.replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction shares(e){\n const order=S.people.filter(p=>e.split.includes(p));\n const n=order.length,base=Math.floor(e.cents/n),extra=e.cents-base*n;\n const r={};order.forEach((p,i)=>r[p]=base+(i<extra?1:0));return r;\n}\nfunction balances(){\n const b={};S.people.forEach(p=>b[p]=0);\n S.expenses.forEach(e=>{\n  if(b[e.payer]!==undefined)b[e.payer]+=e.cents;\n  const s=shares(e);for(const p in s)b[p]-=s[p];\n });return b;\n}\nfunction transfers(b){\n const cr=[],db=[];\n S.people.forEach(p=>{if(b[p]>0)cr.push([p,b[p]]);else if(b[p]<0)db.push([p,-b[p]])});\n cr.sort((a,b)=>b[1]-a[1]);db.sort((a,b)=>b[1]-a[1]);\n const t=[];let i=0,j=0;\n while(i<cr.length&&j<db.length){\n  const m=Math.min(cr[i][1],db[j][1]);\n  t.push({from:db[j][0],to:cr[i][0],c:m});\n  cr[i][1]-=m;db[j][1]-=m;\n  if(!cr[i][1])i++;if(!db[j][1])j++;\n }return t;\n}\nfunction render(){\n const P=S.people;\n $('pl').innerHTML=P.length?P.map(p=>`<li data-testid=\"person\"><span class=\"grow\">${esc(p)}</span></li>`).join(''):'<p class=\"empty\">Add the first person on your trip to get started.</p>';\n const sel=$('ep').value;\n $('ep').innerHTML=P.map(p=>`<option value=\"${esc(p)}\">${esc(p)}</option>`).join('');\n if(P.includes(sel))$('ep').value=sel;\n const checked=new Set([...document.querySelectorAll('#es input:checked')].map(i=>i.value));\n const had=new Set([...document.querySelectorAll('#es input')].map(i=>i.value));\n $('es').innerHTML=P.length?P.map((p,i)=>`<label><input type=\"checkbox\" value=\"${esc(p)}\" ${(!had.has(p)||checked.has(p))?'checked':''}>${esc(p)}</label>`).join(''):'<span class=\"meta\">Add people to choose who shares the cost.</span>';\n const E=[...S.expenses].reverse();\n $('el').innerHTML=E.length?E.map(e=>`<li data-testid=\"expense\"><div class=\"grow\"><div>${esc(e.desc)} · <span class=\"money\">${fmt.format(e.cents/100)}</span></div><div class=\"meta\">Paid by ${esc(e.payer)}. Split between ${e.split.map(esc).join(', ')}.</div></div><button type=\"button\" data-testid=\"delete-expense\" data-id=\"${e.id}\" aria-label=\"Remove ${esc(e.desc)}\">Remove</button></li>`).join(''):'<p class=\"empty\">'+(P.length?'Log the first thing someone paid for.':'Add people first, then log what you paid for.')+'</p>';\n const b=balances();\n $('bl').innerHTML=P.length?P.map(p=>{const c=b[p];\n  const txt=c>0?`is owed ${fmt.format(c/100)}`:c<0?`owes ${fmt.format(-c/100)}`:'is settled';\n  const amt=(c<0?'\\u2212':'')+fmt.format(Math.abs(c)/100);\n  return `<li data-testid=\"balance\" data-person=\"${esc(p)}\" data-cents=\"${c}\"><span class=\"grow\">${esc(p)} <span class=\"meta\">${txt}</span></span><span class=\"money ${c>0?'pos':''}\">${amt}</span></li>`}).join(''):'<p class=\"empty\">Balances appear once you add people.</p>';\n const T=transfers(b);\n $('tl').innerHTML=T.length?T.map(t=>`<li data-testid=\"transfer\" data-from=\"${esc(t.from)}\" data-to=\"${esc(t.to)}\" data-cents=\"${t.c}\"><span class=\"grow\">${esc(t.from)} pays ${esc(t.to)}</span><span class=\"money\">${fmt.format(t.c/100)}</span></li>`).join(''):'<p class=\"empty\">'+(S.expenses.length?'Everyone is even.':'Add an expense to see who pays whom.')+'</p>';\n}\nfunction showErr(id,msg,input){const el=$(id);el.textContent=msg;if(msg)el.setAttribute('data-testid','form-error');else el.removeAttribute('data-testid');if(msg&&input)input.focus()}\n$('pf').addEventListener('submit',e=>{\n e.preventDefault();\n const v=$('pn').value.trim();\n if(!v)return showErr('pe','Enter a name.',$('pn'));\n if(S.people.some(p=>p.toLowerCase()===v.toLowerCase()))return showErr('pe',`${v} is already on the trip. Use a different name.`,$('pn'));\n S.people.push(v);save();showErr('pe','');$('pn').value='';render();$('pn').focus();\n});\n$('ef').addEventListener('submit',e=>{\n e.preventDefault();\n const d=$('ed').value.trim(),a=$('ea').value.trim().replace(/^\\$/,'').replace(/,/g,'');\n const split=[...document.querySelectorAll('#es input:checked')].map(i=>i.value);\n if(!S.people.length)return showErr('ee','Add at least one person first.',$('pn'));\n if(!d)return showErr('ee','Enter a description.',$('ed'));\n if(!/^\\d*\\.?\\d+$|^\\d+\\.$/.test(a)||!(parseFloat(a)>0)){\n  return showErr('ee',/^\\d+\\.\\d{3,}$/.test(a)?'Use no more than 2 decimal places.':'Enter an amount greater than $0.',$('ea'));}\n if(/\\.\\d{3,}/.test(a))return showErr('ee','Use no more than 2 decimal places.',$('ea'));\n const [w,f='']=a.split('.');const cents=parseInt(w||'0',10)*100+parseInt((f+'00').slice(0,2),10);\n if(cents<=0)return showErr('ee','Enter an amount greater than $0.',$('ea'));\n const payer=$('ep').value;\n if(!payer)return showErr('ee','Choose who paid.',$('ep'));\n if(!split.length)return showErr('ee','Choose at least one person to split between.');\n S.expenses.push({id:nid++,desc:d,cents,payer,split});save();showErr('ee','');\n $('ed').value='';$('ea').value='';render();$('ed').focus();\n});\n$('el').addEventListener('click',e=>{\n const b=e.target.closest('[data-testid=delete-expense]');if(!b)return;\n S.expenses=S.expenses.filter(x=>x.id!=b.dataset.id);save();render();\n});\nrender();\n</script>\n</body>\n</html>"
    }

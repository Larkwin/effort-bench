    {
      "type": "text",
      "text": "<!doctype html>\n<html lang=\"en-CA\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Even Keel – trip expense splitter</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=IBM+Plex+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --harbour:#1F3A4D;\n    --fog:#5B6B75;\n    --sailcloth:#F6F3EC;\n    --paper:#FFFFFF;\n    --rope:#D9D2C3;\n    --signal:#C2462B;\n    --kelp:#2F6B4F;\n  }\n  *{box-sizing:border-box}\n  html{background:var(--sailcloth)}\n  body{\n    margin:0;\n    font-family:\"IBM Plex Sans\",system-ui,sans-serif;\n    font-size:16px;\n    line-height:1.5;\n    color:var(--harbour);\n    background:var(--sailcloth);\n  }\n  .page{max-width:720px;margin:0 auto;padding:32px 16px 48px}\n  @media (min-width:600px){.page{padding:48px 24px 64px}}\n  header{margin-bottom:32px}\n  .wordmark{display:flex;align-items:center;gap:12px;margin:0;font-family:\"Fraunces\",serif;font-weight:600;font-size:28px;line-height:1.2}\n  .wordmark::before{content:\"\";display:block;width:24px;height:3px;background:var(--signal);flex:none}\n  .tagline{margin:4px 0 0 36px;color:var(--fog);font-size:16px}\n  h2{font-family:\"Fraunces\",serif;font-weight:600;font-size:20px;line-height:1.3;margin:0 0 16px}\n  section{margin-bottom:32px}\n  .panel{background:var(--paper);border:1px solid var(--rope);border-radius:6px;padding:16px}\n  @media (min-width:600px){.panel{padding:24px}}\n  label,legend{display:block;font-weight:500;font-size:14px;margin-bottom:4px}\n  .hint{color:var(--fog);font-size:14px;margin:4px 0 0}\n  input[type=text],select{\n    width:100%;font:inherit;color:var(--harbour);background:var(--paper);\n    border:1px solid var(--rope);border-radius:6px;padding:8px 12px;height:44px;\n    transition:border-color 150ms;\n  }\n  input[type=text]:hover,select:hover{border-color:var(--harbour)}\n  input[type=text]:focus-visible,select:focus-visible,button:focus-visible,input[type=checkbox]:focus-visible{outline:2px solid var(--harbour);outline-offset:2px}\n  button{font:inherit;font-weight:500;border-radius:6px;cursor:pointer;height:44px;padding:0 16px;transition:background-color 150ms,border-color 150ms,color 150ms}\n  .btn-primary{background:var(--signal);color:var(--paper);border:1px solid var(--signal)}\n  .btn-primary:hover{background:var(--harbour);border-color:var(--harbour)}\n  .btn-secondary{background:var(--paper);color:var(--harbour);border:1px solid var(--rope);height:36px;padding:0 12px;font-size:14px}\n  .btn-secondary:hover{border-color:var(--harbour)}\n  .row{display:flex;flex-direction:column;gap:8px}\n  @media (min-width:480px){.row{flex-direction:row;align-items:flex-end}.row .grow{flex:1}}\n  .grid{display:grid;grid-template-columns:1fr;gap:16px}\n  @media (min-width:600px){.grid{grid-template-columns:1fr 1fr}}\n  fieldset{border:0;padding:0;margin:0;min-width:0}\n  .checks{display:flex;flex-wrap:wrap;gap:8px 16px}\n  .checks label{display:flex;align-items:center;gap:8px;font-weight:400;font-size:16px;margin:0}\n  .checks input{width:20px;height:20px;margin:0;accent-color:var(--harbour)}\n  .error{margin:8px 0 0;font-size:14px;font-weight:500;color:var(--harbour);border-left:3px solid var(--harbour);padding-left:8px}\n  .actions{margin-top:16px}\n  ul{list-style:none;margin:0;padding:0}\n  .list li{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:12px 0;border-top:1px solid var(--rope)}\n  .list li:first-child{border-top:0;padding-top:0}\n  .list li:last-child{padding-bottom:0}\n  .people li{padding:8px 0}\n  .exp-main{display:flex;justify-content:space-between;gap:16px;font-weight:500}\n  .exp-body{flex:1;min-width:0}\n  .meta{color:var(--fog);font-size:14px;margin-top:4px;overflow-wrap:anywhere}\n  .amount{font-variant-numeric:tabular-nums;white-space:nowrap}\n  .pos{color:var(--kelp);font-weight:500}\n  .neg{color:var(--harbour);font-weight:500}\n  .zero{color:var(--fog)}\n  .empty{color:var(--fog);margin:0}\n  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <header>\n    <h1 class=\"wordmark\">Even Keel</h1>\n    <p class=\"tagline\">Split trip costs so everyone ends up even.</p>\n  </header>\n\n  <main data-testid=\"app\">\n    <section aria-labelledby=\"people-heading\">\n      <h2 id=\"people-heading\">People</h2>\n      <div class=\"panel\">\n        <form id=\"person-form\" novalidate>\n          <div class=\"row\">\n            <div class=\"grow\">\n              <label for=\"person-name\">Name</label>\n              <input type=\"text\" id=\"person-name\" data-testid=\"person-name\" autocomplete=\"off\">\n            </div>\n            <button type=\"submit\" class=\"btn-primary\" data-testid=\"add-person\">Add person</button>\n          </div>\n          <div id=\"person-error\" aria-live=\"polite\"></div>\n        </form>\n        <div id=\"people-list\" style=\"margin-top:16px\"></div>\n      </div>\n    </section>\n\n    <section aria-labelledby=\"expenses-heading\">\n      <h2 id=\"expenses-heading\">Expenses</h2>\n      <div class=\"panel\">\n        <form id=\"expense-form\" novalidate>\n          <div class=\"grid\">\n            <div>\n              <label for=\"expense-desc\">Description</label>\n              <input type=\"text\" id=\"expense-desc\" data-testid=\"expense-desc\" autocomplete=\"off\">\n            </div>\n            <div>\n              <label for=\"expense-amount\">Amount (CAD)</label>\n              <input type=\"text\" id=\"expense-amount\" data-testid=\"expense-amount\" inputmode=\"decimal\" autocomplete=\"off\">\n              <p class=\"hint\">Up to two decimal places, for example 42.50.</p>\n            </div>\n            <div>\n              <label for=\"expense-payer\">Paid by</label>\n              <select id=\"expense-payer\" data-testid=\"expense-payer\"></select>\n            </div>\n            <fieldset>\n              <legend>Split between</legend>\n              <div class=\"checks\" id=\"expense-split\" data-testid=\"expense-split\"></div>\n            </fieldset>\n          </div>\n          <div id=\"expense-error\" aria-live=\"polite\"></div>\n          <div class=\"actions\">\n            <button type=\"submit\" class=\"btn-primary\" data-testid=\"add-expense\">Add expense</button>\n          </div>\n        </form>\n        <div id=\"expense-list\" style=\"margin-top:24px\"></div>\n      </div>\n    </section>\n\n    <section aria-labelledby=\"balances-heading\">\n      <h2 id=\"balances-heading\">Balances</h2>\n      <div class=\"panel\" id=\"balances\"></div>\n    </section>\n\n    <section aria-labelledby=\"settle-heading\">\n      <h2 id=\"settle-heading\">Settle up</h2>\n      <div class=\"panel\" id=\"settle\"></div>\n    </section>\n  </main>\n</div>\n\n<script>\n(function(){\n  'use strict';\n  const KEY = 'even-keel-trip';\n  const fmt = new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' });\n  const money = c => fmt.format(c / 100);\n\n  let state = load();\n  let unchecked = new Set();\n\n  function load(){\n    try {\n      const raw = localStorage.getItem(KEY);\n      if (!raw) return { people: [], expenses: [] };\n      const s = JSON.parse(raw);\n      if (!Array.isArray(s.people) || !Array.isArray(s.expenses)) throw new Error();\n      return s;\n    } catch (e) { return { people: [], expenses: [] }; }\n  }\n  function save(){ try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }\n\n  const $ = id => document.getElementById(id);\n  function el(tag, attrs, children){\n    const n = document.createElement(tag);\n    if (attrs) for (const k in attrs) {\n      if (k === 'class') n.className = attrs[k];\n      else if (k === 'text') n.textContent = attrs[k];\n      else n.setAttribute(k, attrs[k]);\n    }\n    if (children) children.forEach(c => n.appendChild(typeof c === 'string' ? document.createTextNode(c) : c));\n    return n;\n  }\n  function setError(container, msg){\n    container.textContent = '';\n    if (msg) container.appendChild(el('p', { class: 'error', 'data-testid': 'form-error', role: 'alert', text: msg }));\n  }\n  function listNames(names){\n    if (names.length <= 1) return names.join('');\n    return names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];\n  }\n\n  function parseAmount(str){\n    const s = str.trim().replace(/^\\$/, '').replace(/,/g, '');\n    if (!/^\\d+(\\.\\d{1,2})?$/.test(s)) return null;\n    const parts = s.split('.');\n    const frac = ((parts[1] || '') + '00').slice(0, 2);\n    return parseInt(parts[0], 10) * 100 + parseInt(frac, 10);\n  }\n\n  function shares(expense){\n    const sel = state.people.filter(p => expense.split.includes(p));\n    const n = sel.length;\n    const out = {};\n    if (!n) return out;\n    const base = Math.floor(expense.cents / n);\n    let rem = expense.cents - base * n;\n    sel.forEach(p => { out[p] = base + (rem > 0 ? 1 : 0); if (rem > 0) rem--; });\n    return out;\n  }\n\n  function balances(){\n    const b = {};\n    state.people.forEach(p => b[p] = 0);\n    state.expenses.forEach(e => {\n      if (e.payer in b) b[e.payer] += e.cents;\n      const sh = shares(e);\n      for (const p in sh) b[p] -= sh[p];\n    });\n    return state.people.map(p => ({ name: p, cents: b[p] }));\n  }\n\n  function settle(bal){\n    const cred = bal.filter(b => b.cents > 0).map(b => ({ name: b.name, cents: b.cents })).sort((a, b) => b.cents - a.cents);\n    const debt = bal.filter(b => b.cents < 0).map(b => ({ name: b.name, cents: -b.cents })).sort((a, b) => b.cents - a.cents);\n    const out = []; let i = 0, j = 0;\n    while (i < debt.length && j < cred.length) {\n      const amt = Math.min(debt[i].cents, cred[j].cents);\n      out.push({ from: debt[i].name, to: cred[j].name, cents: amt });\n      debt[i].cents -= amt; cred[j].cents -= amt;\n      if (debt[i].cents === 0) i++;\n      if (cred[j].cents === 0) j++;\n    }\n    return out;\n  }\n\n  /* Rendering */\n  function renderPeople(){\n    const box = $('people-list');\n    box.textContent = '';\n    if (!state.people.length) {\n      box.appendChild(el('p', { class: 'empty', text: 'Add the people on your trip to get started.' }));\n      return;\n    }\n    box.appendChild(el('ul', { class: 'list people', 'aria-label': 'People on the trip' },\n      state.people.map(p => el('li', { 'data-testid': 'person', text: p }))));\n  }\n\n  function renderExpenseForm(){\n    const sel = $('expense-payer');\n    const prev = sel.value;\n    sel.textContent = '';\n    if (!state.people.length) {\n      sel.appendChild(el('option', { value: '', text: 'Add a person first' }));\n      sel.disabled = true;\n    } else {\n      sel.disabled = false;\n      state.people.forEach(p => sel.appendChild(el('option', { value: p, text: p })));\n      if (state.people.includes(prev)) sel.value = prev;\n    }\n    const split = $('expense-split');\n    split.textContent = '';\n    if (!state.people.length) {\n      split.appendChild(el('p', { class: 'hint', style: 'margin:0', text: 'Add a person first.' }));\n      return;\n    }\n    state.people.forEach((p, i) => {\n      const id = 'split-' + i;\n      const cb = el('input', { type: 'checkbox', id: id, value: p });\n      cb.checked = !unchecked.has(p);\n      cb.addEventListener('change', () => { if (cb.checked) unchecked.delete(p); else unchecked.add(p); });\n      split.appendChild(el('label', { for: id }, [cb, p]));\n    });\n  }\n\n  function renderExpenses(){\n    const box = $('expense-list');\n    box.textContent = '';\n    if (!state.expenses.length) {\n      box.appendChild(el('p', { class: 'empty', text: state.people.length ? 'Log an expense to see who paid for what.' : 'Add a person, then log the first expense.' }));\n      return;\n    }\n    const ul = el('ul', { class: 'list', 'aria-label': 'Expenses' });\n    state.expenses.slice().reverse().forEach(e => {\n      const sel = state.people.filter(p => e.split.includes(p));\n      const remove = el('button', { type: 'button', class: 'btn-secondary', 'data-testid': 'delete-expense', 'aria-label': 'Remove ' + e.desc, text: 'Remove' });\n      remove.addEventListener('click', () => {\n        state.expenses = state.expenses.filter(x => x.id !== e.id);\n        save(); renderAll();\n      });\n      ul.appendChild(el('li', { 'data-testid': 'expense' }, [\n        el('div', { class: 'exp-body' }, [\n          el('div', { class: 'exp-main' }, [\n            el('span', { text: e.desc }),\n            el('span', { class: 'amount', text: money(e.cents) })\n          ]),\n          el('div', { class: 'meta', text: 'Paid by ' + e.payer + ' · split between ' + listNames(sel) })\n        ]),\n        remove\n      ]));\n    });\n    box.appendChild(ul);\n  }\n\n  function renderBalances(){\n    const box = $('balances');\n    box.textContent = '';\n    if (!state.people.length) { box.appendChild(el('p', { class: 'empty', text: 'Balances appear once you add people and expenses.' })); return; }\n    const bal = balances();\n    const ul = el('ul', { class: 'list', 'aria-label': 'Balances' });\n    bal.forEach(b => {\n      const cls = b.cents > 0 ? 'pos' : b.cents < 0 ? 'neg' : 'zero';\n      const note = b.cents > 0 ? 'is owed' : b.cents < 0 ? 'owes' : 'is even';\n      ul.appendChild(el('li', { 'data-testid': 'balance', 'data-person': b.name, 'data-cents': String(b.cents) }, [\n        el('div', {}, [el('span', { text: b.name }), el('span', { class: 'meta', style: 'display:inline;margin-left:8px', text: note })]),\n        el('span', { class: 'amount ' + cls, text: money(b.cents) })\n      ]));\n    });\n    box.appendChild(ul);\n    const total = state.expenses.reduce((s, e) => s + e.cents, 0);\n    box.appendChild(el('p', { class: 'hint', style: 'margin-top:16px', text: 'Total spent: ' + money(total) }));\n  }\n\n  function renderSettle(){\n    const box = $('settle');\n    box.textContent = '';\n    if (!state.expenses.length) { box.appendChild(el('p', { class: 'empty', text: 'Transfers appear here once there is something to settle.' })); return; }\n    const tr = settle(balances());\n    if (!tr.length) { box.appendChild(el('p', { class: 'empty', text: 'Everyone is even. There is nothing to settle.' })); return; }\n    const ul = el('ul', { class: 'list', 'aria-label': 'Transfers' });\n    tr.forEach(t => {\n      ul.appendChild(el('li', { 'data-testid': 'transfer', 'data-from': t.from, 'data-to': t.to, 'data-cents': String(t.cents) }, [\n        el('span', {}, [el('strong', { text: t.from }), ' pays ', el('strong', { text: t.to })]),\n        el('span', { class: 'amount', text: money(t.cents) })\n      ]));\n    });\n    box.appendChild(ul);\n    box.appendChild(el('p', { class: 'hint', style: 'margin-top:16px', text: tr.length === 1 ? 'One transfer settles the trip.' : tr.length + ' transfers settle the trip.' }));\n  }\n\n  function renderAll(){ renderPeople(); renderExpenseForm(); renderExpenses(); renderBalances(); renderSettle(); }\n\n  /* Events */\n  $('person-form').addEventListener('submit', ev => {\n    ev.preventDefault();\n    const input = $('person-name');\n    const name = input.value.trim();\n    const errBox = $('person-error');\n    if (!name) { setError(errBox, 'Enter a name.'); input.focus(); return; }\n    if (state.people.some(p => p.toLowerCase() === name.toLowerCase())) {\n      setError(errBox, name + ' is already on the trip. Choose a different name.'); input.focus(); return;\n    }\n    state.people.push(name);\n    save();\n    setError(errBox, '');\n    input.value = '';\n    renderAll();\n    input.focus();\n  });\n\n  $('expense-form').addEventListener('submit', ev => {\n    ev.preventDefault();\n    const errBox = $('expense-error');\n    const descEl = $('expense-desc'), amtEl = $('expense-amount'), payerEl = $('expense-payer');\n    const desc = descEl.value.trim();\n    if (!state.people.length) { setError(errBox, 'Add a person before logging an expense.'); $('person-name').focus(); return; }\n    if (!desc) { setError(errBox, 'Enter a description.'); descEl.focus(); return; }\n    const cents = parseAmount(amtEl.value);\n    if (cents === null || cents <= 0) {\n      setError(errBox, cents === null && amtEl.value.trim() ? 'Enter an amount with at most two decimal places, for example 42.50.' : 'Enter an amount greater than $0.');\n      amtEl.focus(); return;\n    }\n    const payer = payerEl.value;\n    if (!state.people.includes(payer)) { setError(errBox, 'Choose who paid.'); payerEl.focus(); return; }\n    const split = Array.from($('expense-split').querySelectorAll('input[type=checkbox]')).filter(c => c.checked).map(c => c.value);\n    if (!split.length) {\n      setError(errBox, 'Choose at least one person to split this expense between.');\n      const first = $('expense-split').querySelector('input'); if (first) first.focus(); return;\n    }\n    state.expenses.push({ id: Date.now() + '-' + Math.random().toString(36).slice(2, 8), desc, cents, payer, split: state.people.filter(p => split.includes(p)) });\n    save();\n    setError(errBox, '');\n    descEl.value = ''; amtEl.value = '';\n    unchecked = new Set();\n    renderAll();\n    descEl.focus();\n  });\n\n  renderAll();\n})();\n</script>\n</body>\n</html>"
    }
